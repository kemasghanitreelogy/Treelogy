    })();
    /* Accordion: <details> native (aksesibel, jalan tanpa JS), tingginya dianimasikan dengan WAAPI. Transisi CSS murni
       (interpolate-size / ::details-content) belum ada di Safari iOS, padahal mayoritas pengunjung pakai iPhone.
       Klik di tengah animasi membalik arah dari tinggi saat itu, tanpa lompatan. Reduced motion: buka/tutup instan.
       Tinggi awal saat tertutup = 0: isi <details> tertutup tetap melaporkan tingginya di Chrome. */
    root.querySelectorAll('.p5s-acc__item').forEach(function (d) {
      var body = d.querySelector('.p5s-acc__body'), anim = null;
      d.querySelector('summary').addEventListener('click', function (e) {
        if (reduce.matches || !body.animate) return;
        e.preventDefault();
        var closing = d.open && !d.classList.contains('is-closing');
        var from = d.open ? body.getBoundingClientRect().height : 0, pad = getComputedStyle(body).paddingBottom;
        if (anim) anim.cancel();
        if (closing) {
          d.classList.add('is-closing');
          anim = body.animate([{ height: from + 'px' }, { height: '0px', paddingBottom: '0px' }], { duration: 260, easing: 'cubic-bezier(.4,0,.2,1)' });
          anim.onfinish = function () { d.open = false; d.classList.remove('is-closing'); anim = null; };
        } else {
          d.classList.remove('is-closing');
          d.open = true;
          var to = body.getBoundingClientRect().height;
          anim = body.animate([{ height: (from || 0) + 'px', paddingBottom: from ? pad : '0px' }, { height: to + 'px', paddingBottom: pad }], { duration: 300, easing: 'cubic-bezier(.2,.7,.2,1)' });
          anim.onfinish = function () { anim = null; };
        }
      });
    });
    /* Sekuens foto "Our process" (pengganti GIF Figma, 1 dtk/frame). Hanya berputar saat kartunya terlihat dan tab
       aktif; frame berikut ditampilkan hanya bila sudah selesai dimuat, jadi tidak pernah ada kotak kosong.
       Reduced motion: tetap di frame pertama. */
    /* Scope sendiri: blok testimoni di bawah juga memakai nama timer/step — dengan var/function bersama, timer
       sekuens tertimpa dan foto berhenti di frame pertama. */
    (function () {
      var seqs = root.querySelectorAll('[data-p5s-seq]'), seen = [], timer = null;
      function step() {
        seen.forEach(function (s) {
          var f = s.children, k = +s.getAttribute('data-k') || 0, n = (k + 1) % f.length;
          if (f.length < 2 || !f[n].complete || !f[n].naturalWidth) return;
          f[k].classList.remove('is-on');
          f[n].classList.add('is-on');
          s.setAttribute('data-k', n);
        });
      }
      function sync() {
        var run = seen.length && !document.hidden && !reduce.matches;
        if (run && !timer) timer = setInterval(step, 1000);
        if (!run && timer) { clearInterval(timer); timer = null; }
      }
      if (seqs.length && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var at = seen.indexOf(e.target);
            if (e.isIntersecting && at < 0) seen.push(e.target);
            if (!e.isIntersecting && at > -1) seen.splice(at, 1);
          });
          sync();
        }, { threshold: 0.25 });
        seqs.forEach(function (s) { io.observe(s); });
        document.addEventListener('visibilitychange', sync);
      }
    })();
    if (!show) return;
    /* Testimoni: track scroll-snap native (drag jari di ponsel), drag mouse di desktop, auto-slide tiap DUR ms.
       Interaksi (sentuh, drag, ketuk titik, geser horizontal trackpad) = jeda, lanjut sendiri IDLE ms kemudian;
       scroll vertikal halaman tidak dihitung. Titik aktif dihitung dari posisi scroll, jadi selalu cocok dengan kartu
       yang terlihat. Auto-slide hanya saat terlihat & tab aktif; reduced motion = tanpa auto-slide, geser instan. */
    var track = show.querySelector('[data-p5s-track]');
    var DUR = 3000, IDLE = 6000;
    var real = [].slice.call(track.children), N = real.length, dots = [].slice.call(show.querySelectorAll('.p5s-rev__dot'));
    if (!N) return;
    /* Putaran tanpa ujung: salinan kartu terakhir di depan + salinan kartu pertama di belakang (aria-hidden). Geser
       dari kartu 5 ke salinan kartu 1 tetap MAJU; begitu geseran berhenti di salinan, posisi dipindah diam-diam
       (tanpa animasi) ke kartu aslinya. Posisi track: 0 = salinan terakhir, 1..N = kartu asli, N+1 = salinan pertama. */
    if (N > 1) {
      var head = real[N - 1].cloneNode(true), tail = real[0].cloneNode(true);
      [head, tail].forEach(function (c) { c.setAttribute('aria-hidden', 'true'); c.setAttribute('data-clone', ''); c.removeAttribute('aria-label'); });
      track.insertBefore(head, real[0]);
      track.appendChild(tail);
    }
    var cards = [].slice.call(track.children), off = N > 1 ? 1 : 0;
    var cur = 0, timer = null, idle = null, held = false, inView = false, raf = 0, settle = 0;
    function step() { return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth; }
    function pos() { return Math.round(track.scrollLeft / step()); }
    function jump(p) { track.scrollTo({ left: p * step(), behavior: 'instant' }); }
    function to(p, smooth) { track.scrollTo({ left: p * step(), behavior: smooth && !reduce.matches ? 'smooth' : 'instant' }); }
    jump(off);
    function mark() {
      raf = 0;
      var n = ((pos() - off) % N + N) % N;
      if (n === cur) return;
      dots[cur].classList.remove('is-on'); dots[cur].removeAttribute('aria-current');
      real[cur].setAttribute('aria-hidden', 'true');
      cur = n;
      dots[n].classList.add('is-on'); dots[n].setAttribute('aria-current', 'true');
      real[n].removeAttribute('aria-hidden');
    }
    function settled() {
      settle = 0;
      if (track.classList.contains('is-dragging')) return;
      var p = pos();
      if (off && p === 0) jump(N);
      else if (off && p === N + 1) jump(1);
      arm();
    }
    real.forEach(function (c, k) { if (k) c.setAttribute('aria-hidden', 'true'); });
    track.addEventListener('scroll', function () {
      if (!raf) raf = requestAnimationFrame(mark);
      clearTimeout(settle); settle = setTimeout(settled, 140);
    }, { passive: true });
    function arm() {
      clearTimeout(timer);
      if (!inView || held || document.hidden || reduce.matches) return;
      timer = setTimeout(function () { to(pos() + 1, true); }, DUR);
    }
    function hold() {
      held = true; clearTimeout(timer); clearTimeout(idle);
      idle = setTimeout(function () { held = false; arm(); }, IDLE);
    }
    dots.forEach(function (d, k) { d.addEventListener('click', function () { hold(); to(k + off, true); }); });
    ['touchstart', 'touchmove'].forEach(function (ev) { track.addEventListener(ev, hold, { passive: true }); });
    track.addEventListener('wheel', function (e) { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) hold(); }, { passive: true });
    /* Drag mouse (desktop). Sentuhan memakai scroll native, jadi hanya pointerType mouse/pen yang ditangani. */
    var drag = null;
    track.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch' || e.button !== 0) return;
      hold();
      drag = { x: e.clientX, left: track.scrollLeft, id: e.pointerId, moved: false };
    });
    track.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var dx = e.clientX - drag.x;
      if (!drag.moved && Math.abs(dx) > 4) { drag.moved = true; track.classList.add('is-dragging'); track.setPointerCapture(drag.id); }
      if (drag.moved) track.scrollLeft = drag.left - dx;
    });
    function endDrag(e) {
      if (!drag) return;
      var d = drag, dx = e.clientX - d.x; drag = null;
      if (!d.moved) return;
      track.classList.remove('is-dragging');
      var base = Math.round(d.left / step());
      to(Math.abs(dx) > step() * 0.15 ? base + (dx < 0 ? 1 : -1) : base, true);
    }
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);
    track.addEventListener('click', function (e) { if (track.classList.contains('is-dragging')) e.preventDefault(); }, true);
    document.addEventListener('visibilitychange', arm);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { inView = es[0].isIntersecting; arm(); }, { threshold: 0.5 }).observe(show);
    } else { inView = true; arm(); }
  })();
</script>
{%- endif -%}

