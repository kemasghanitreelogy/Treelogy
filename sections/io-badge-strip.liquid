{% render 'io-base' %}

<div class="io-section io-section--flush io-badges io-badges--{{ section.settings.layout }} io-section--{{ section.settings.color_scheme }}">
  {%- if section.settings.layout == 'marquee' -%}
    <div class="io-badges__viewport">
      <div class="io-badges__track" style="--io-marquee-duration: {{ section.settings.speed }}s;">
        {%- for pass in (1..2) -%}
          <ul class="io-badges__list" {% if pass == 2 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <li class="io-badges__item" {{ block.shopify_attributes }}>
                {% render 'io-icon', name: block.settings.icon, size: 18 %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="io-container">
      <ul class="io-badges__list io-badges__list--grid">
        {%- for block in section.blocks -%}
          <li class="io-badges__item" {{ block.shopify_attributes }}>
            {% render 'io-icon', name: block.settings.icon, size: 20 %}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .io-badges {
    padding-block: 1rem;
    border-block: 1px solid var(--io-border);
    font-family: var(--io-font-body);
  }

  .io-badges--marquee {
    overflow: hidden;
  }

  .io-badges__viewport {
    overflow: hidden;
  }

  .io-badges__track {
    display: flex;
    width: max-content;
    animation: io-marquee var(--io-marquee-duration, 34s) linear infinite;
  }

  .io-badges__viewport:hover .io-badges__track,
  .io-badges__viewport:focus-within .io-badges__track {
    animation-play-state: paused;
  }

  .io-badges__list {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin: 0;
    padding: 0 1.25rem;
    list-style: none;
  }

  .io-badges__list--grid {
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    padding: 0;
  }

  .io-badges__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--io-text-mid);
  }

  .io-badges__item .io-icon {
    color: var(--io-forest);
  }

  .io-section--forest.io-badges {
    border-color: rgba(248, 248, 242, 0.18);
  }

  .io-section--forest .io-badges__item,
  .io-section--forest .io-badges__item .io-icon {
    color: rgba(248, 248, 242, 0.92);
  }

  @keyframes io-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .io-badges__track {
      animation: none;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .io-badges__track > ul[aria-hidden='true'] {
      display: none;
    }

    .io-badges__list {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IO badge strip",
  "tag": "section",
  "class": "io-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Static row" },
        { "value": "marquee", "label": "Scrolling ticker" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "bloom", "label": "Alternate" },
        { "value": "forest", "label": "Deep green" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Ticker speed",
      "info": "Higher is slower. Only used by the scrolling ticker.",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "flask", "label": "Lab" },
            { "value": "award", "label": "Award" },
            { "value": "truck", "label": "Delivery" },
            { "value": "gift", "label": "Gift" },
            { "value": "lock", "label": "Lock" },
            { "value": "cross", "label": "Cross" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Terdaftar BPOM"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IO badge strip",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shield", "text": "Terdaftar BPOM" } },
        { "type": "badge", "settings": { "icon": "award", "text": "Halal" } },
        { "type": "badge", "settings": { "icon": "sprout", "text": "Organik" } },
        { "type": "badge", "settings": { "icon": "leaf", "text": "Bebas Batang" } },
        { "type": "badge", "settings": { "icon": "flask", "text": "Teruji Lab" } },
        { "type": "badge", "settings": { "icon": "cross", "text": "Tanpa Hormon" } }
      ]
    }
  ]
}
{% endschema %}
