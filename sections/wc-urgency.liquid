<section class="wc-urgency og-section">
  <div class="og-container wc-urgency__wrap">
    <img
      src="{{ 'why-capsules-icon-clock.png' | asset_url }}"
      alt=""
      width="160"
      height="160"
      loading="lazy"
      decoding="async"
      class="wc-urgency__clock"
    >

    <h2 class="wc-urgency__heading">{{ 'why_capsules.urgency.heading' | t }}</h2>

    <p class="wc-urgency__sub">{{ 'why_capsules.urgency.sub_html' | t }}</p>

    <div class="wc-urgency__cta-row">
      <a class="wc-cta" href="{{ pages['founder-letter'].url }}">{{ 'why_capsules.urgency.cta_letter' | t }}</a>
    </div>
  </div>
</section>

{% style %}
  .wc-urgency {
    padding-top: calc(85 * var(--og-u));
    padding-bottom: calc(85 * var(--og-u));
    font-family: var(--og-font);
  }

  .wc-urgency__wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .wc-urgency__clock {
    width: calc(97 * var(--og-u));
    height: auto;
  }

  .wc-urgency__heading {
    margin: calc(30 * var(--og-u)) 0 0;
    font-size: calc(70 * var(--og-u));
    font-weight: 400;
    line-height: 1.21;
    color: var(--og-ink);
  }

  .wc-urgency__sub {
    margin: calc(30 * var(--og-u)) 0 0;
    max-width: calc(880 * var(--og-u));
    font-size: calc(45 * var(--og-u));
    line-height: normal;
    color: var(--og-ink);
  }

  .wc-urgency__cta-row {
    margin-top: calc(73 * var(--og-u));
  }
{% endstyle %}

{% schema %}
{
  "name": "WC Urgency",
  "settings": [],
  "presets": [
    {
      "name": "WC Urgency"
    }
  ]
}
{% endschema %}
