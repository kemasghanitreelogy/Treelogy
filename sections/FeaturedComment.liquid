<div class="main-grid" data-cs-capture>
  <div class="inner">
    <div class="header">
      <div class="review-rating technical">
        {%- liquid
          comment
            Total toko = jumlah metafield standar reviews.* (ditulis Klaviyo
            Reviews) atas semua produk katalog. Klaviyo tidak punya metafield
            level toko; koleksi all-products berisi ±10 produk, jadi murah dan
            ikut cache halaman. Rata-rata = rata-rata berbobot jumlah ulasan.
          endcomment
          assign fc_count = 0
          assign fc_sum = 0.0
          for fc_p in collections['all-products'].products
            assign fc_n = fc_p.metafields.reviews.rating_count.value | plus: 0
            if fc_n > 0 and fc_p.metafields.reviews.rating != blank
              assign fc_count = fc_count | plus: fc_n
              assign fc_sum = fc_p.metafields.reviews.rating.value.rating | times: fc_n | plus: fc_sum
            endif
          endfor
        -%}
        {%- if fc_count > 0 -%}
          {%- liquid
            assign fc_avg = fc_sum | divided_by: fc_count | round: 2 | append: ''
            assign fc_sep = 'products.rating.decimal_separator' | t
            if fc_sep.size == 1
              assign fc_avg = fc_avg | replace: '.', fc_sep
            endif
          -%}
          <div class="klr-widget klr-all-reviews-text">
            {% render 'StarReview', color: '#2B3C35' %}
            <span class="klr-all-reviews-text__text">{{ 'reviews.all_summary' | t: rating: fc_avg, count: fc_count }}</span>
          </div>
        {%- endif -%}
      </div>
      <div class="h1">
        {{ section.settings.title | newline_to_br }}
      </div>
    </div>
    <div class="card">
      {% for block in section.blocks %}
        <div class="card__item">
          <div class="thumb">
            <img
              src="{{ block.settings.thumb | image_url:width:'310x' }}"
              width="310"
              height="310"
              alt="{{ block.settings.thumb.alt | default: 'Treelogy customer review' | escape }}"
              loading="lazy">
          </div>
          <div class="reivew">
            <a href="{{ block.settings.product.url }}" class="product">
              {% if block.settings.product %}
                <img
                  src="{{ block.settings.product.featured_image | image_url:width: '100x' }}"
                  width="100"
                  height="100"
                  alt="{{ block.settings.product.title | default: 'Treelogy moringa product' | escape }}"
                  loading="lazy">
              {% endif %}
            </a>
            <div class="detail">
              <div class="rating technical">
                {% render 'Rating'
                  , product: block.settings.product %}
              </div>
              <div class="user">
                <div class="sub-head-alt">{{ block.settings.user_name }}</div>
                <div class="commebt body-s">
                  {{ block.settings.user_comment | truncate: 60 }}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .commebt.body-s {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    /* Limits text to 2 lines */
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
    /* Prevents long words from breaking the layout */


    /*
   Optional: Set a min-height if you want all cards to stay uniform
   even if a comment is only 1 line long
*/
    line-height: 1.4;
    max-height: 2.8em;
  }
</style>
{% schema %}
  {
    "name": "Featured Comment",
    "tag": "section",
    "class": "section featured-comment",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Title"
      }, {
        "type": "text",
        "id": "review_text",
        "label": "Review label"
      }
    ],

    "blocks": [
      {
        "type": "image_picker",
        "name": "User Review",
        "limit": 3,
        "settings": [
          {
            "id": "thumb",
            "type": "image_picker",
            "label": "Thumbnail"
          }, {
            "type": "product",
            "id": "product",
            "label": "Product"
          }, {
            "type": "text",
            "id": "user_name",
            "label": "User name"
          }, {
            "type": "textarea",
            "id": "user_comment",
            "label": "Comment"
          }
        ]
      }
    ],

    "presets": [
      {
        "name": "Featured reviews"
      }
    ]
  }
{% endschema %}