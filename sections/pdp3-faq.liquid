{%- comment -%}
  pdp3 — pertanyaan. Salinan DOM `<section class="faq">` dari mockup.

  Tetap `<details>`/`<summary>` asli, bukan tombol + div: itu satu-satunya
  bentuk yang bisa dibuka tanpa JavaScript, bisa dicari Ctrl+F saat tertutup,
  dan sudah dimengerti pembaca layar tanpa satu pun atribut aria.

  Panahnya digambar CSS lewat `summary i::before` — elemen `<i>`-nya sengaja
  kosong di markup, persis seperti mockup.
{%- endcomment -%}

{%- liquid
  comment
    Template produk hanya ada satu per tema, sedangkan desain ini ditulis untuk
    satu produk saja. Section JSON tidak bisa dipasang bersyarat, jadi
    gerbangnya ada di sini. Kosongkan setting `handles` untuk semua produk.
  endcomment
  assign pdp3_on = false
  if section.settings.handles == blank
    assign pdp3_on = true
  else
    assign pdp3_needle = product.handle | prepend: ',' | append: ','
    assign pdp3_hay = section.settings.handles | remove: ' ' | prepend: ',' | append: ','
    if pdp3_hay contains pdp3_needle
      assign pdp3_on = true
    endif
  endif
-%}
{%- if pdp3_on -%}
{%- capture t_eyebrow %}{% render 'pdp3-copy', value: section.settings.eyebrow, key: 'pdp3.faq.eyebrow' %}{% endcapture -%}
{%- capture t_heading %}{% render 'pdp3-copy', value: section.settings.heading, key: 'pdp3.faq.heading' %}{% endcapture -%}
<div class="pdp3-page">
<section class="p3-faq" id="p3-faq">
  {%- if t_eyebrow != blank -%}<p class="p3-eb p3-rv">{{ t_eyebrow }}</p>{%- endif -%}
  <h2 class="p3-rv">{% render 'pdp3-sentence-lines', text: t_heading %}</h2>
  {%- comment -%}
    Pertanyaan menempel pada PRODUKNYA, bukan pada template: satu tema hanya
    punya satu templates/product.json, jadi apa pun yang ditulis di setting
    akan sama untuk semua produk — dan halaman powder akan menjawab pertanyaan
    kapsul. Urutan sumbernya:

      1. `pdp3.faq`   — JSON dummy tema draft (title + answer teks polos).
      2. `product.faq` — metaobject `faq_group` yang dibaca tema live; `answer`
         bertipe rich_text, jadi harus lewat `metafield_tag`. Dicetak langsung
         ia keluar sebagai JSON mentah di halaman.
      3. blok template — cadangan untuk produk yang belum punya grup FAQ.
  {%- endcomment -%}
  {%- assign faq_json = product.metafields.pdp3.faq.value -%}
  {%- assign faq_group = product.metafields.product.faq.value -%}
  {%- assign faq_items = faq_group.faq_items.value -%}
  {%- if faq_json != blank and faq_json.size > 0 -%}
    {%- for item in faq_json -%}
      <details{% if forloop.first and section.settings.open_first %} open{% endif %}><summary><span>{{ item.title }}</span><i>{% render 'pdp3-chevron' %}</i></summary><div class="p3-a">{{ item.answer }}</div></details>
    {%- endfor -%}
  {%- elsif faq_items != blank and faq_items.size > 0 -%}
    {%- for item in faq_items -%}
      <details{% if forloop.first and section.settings.open_first %} open{% endif %}><summary><span>{{ item.title }}</span><i>{% render 'pdp3-chevron' %}</i></summary><div class="p3-a rte">{{ item.answer | metafield_tag }}</div></details>
    {%- endfor -%}
  {%- else -%}
    {%- for block in section.blocks -%}
      <details{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}><summary><span>{{ block.settings.question }}</span><i>{% render 'pdp3-chevron' %}</i></summary><div class="p3-a">{{ block.settings.answer }}</div></details>
    {%- endfor -%}
  {%- endif -%}
</section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PDP3 FAQ",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": true
    },
    {
      "type": "text",
      "id": "handles",
      "label": "Only show for these product handles (comma separated)",
      "default": "organic-moringa-capsules"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ]
}
{% endschema %}
