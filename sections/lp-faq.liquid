<div class="lp-faq lp-pad">
  <div class="lp-container lp-reveal">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-faq__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="lp-faq__list" data-lp-faq{% if section.settings.exclusive %} data-lp-faq-exclusive{% endif %}>
      {% for block in section.blocks %}
        <details class="lp-faq__item" {{ block.shopify_attributes }}>
          <summary class="lp-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="lp-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="lp-faq__a">
            <div class="lp-faq__a-inner">{{ block.settings.answer }}</div>
          </div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-faq {
    background: var(--lp-cream);
  }

  .lp-faq .lp-faq__eyebrow,
  .lp-faq .lp-faq__heading {
    text-align: center;
  }

  .lp-faq .lp-faq__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-faq .lp-faq__heading {
    margin-bottom: 2.5rem;
  }

  .lp-faq__list {
    max-width: 700px;
    margin-inline: auto;
  }

  .lp-faq__item {
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    color: var(--lp-forest);
    cursor: pointer;
    font-family: var(--lp-font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    list-style: none;
    text-align: left;
  }

  .lp-faq__q::-webkit-details-marker {
    display: none;
  }

  .lp-faq__q:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  .lp-faq__icon {
    flex-shrink: 0;
    transform-origin: center;
    color: var(--lp-text-light);
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .lp-faq__item[open] .lp-faq__icon {
    transform: rotate(45deg);
  }

  /* ===== Buka-tutup: grid 0fr → 1fr, BUKAN animasi height =====
     Versi sebelumnya mengukur `scrollHeight` tepat sebelum menganimasikan
     `height`. Dua masalah sekaligus: pengukuran itu memaksa reflow sinkron
     pada halaman sepanjang ini (marquee jalan, countdown berdetak tiap
     detik, belasan section ber-IntersectionObserver), dan tiap frame
     animasi height memicu layout ulang. Itulah rasa tersendat yang terlihat.

     Teknik grid tidak butuh angka sama sekali — browser yang menghitung,
     tanpa satu pun pembacaan DOM dari JavaScript. */
  .lp-faq__a {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 340ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 160ms linear;
    /* Isolasi: perubahan di dalam panel tidak menyeret sisa halaman ikut
       dihitung ulang. */
    contain: layout paint;
  }

  .lp-faq__a-inner {
    overflow: hidden;
    min-height: 0;
    padding-bottom: 1.25rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .lp-faq__item[open] .lp-faq__a {
    grid-template-rows: 1fr;
    opacity: 1;
    /* Teks muncul sesudah ruangnya terbuka, bukan bersamaan — kalau
       berbarengan, kalimat terbaca sambil melar dan itu yang membuat gerakan
       terasa berat. */
    transition:
      grid-template-rows 340ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 200ms linear 120ms;
  }

  /* Saat menutup, `open` sengaja masih menempel sampai transisinya selesai;
     atribut inilah yang membalik keadaannya. */
  .lp-faq__item[data-lp-closing] .lp-faq__a {
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 260ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 120ms linear;
  }

  .lp-faq__a-inner p {
    margin: 0 0 0.75rem;
  }

  .lp-faq__a-inner p:last-child {
    margin-bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-faq__a,
    .lp-faq__item[open] .lp-faq__a,
    .lp-faq__item[data-lp-closing] .lp-faq__a {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    /* Membuka = cukup men-set `open`; sisanya urusan CSS. Menutup butuh JS
       karena <details> membuang isinya SEKETIKA saat `open` dilepas — tidak
       ada yang tersisa untuk dianimasikan. Jadi atribut penanda dipasang
       dulu, `open` baru dilepas setelah transisinya benar-benar selesai.

       Tidak ada satu pun pembacaan geometri DOM di sini (scrollHeight,
       getBoundingClientRect) — itu yang dulu memaksa reflow sinkron dan
       membuat gerakannya tersendat di halaman sepanjang ini. */
    var CLOSING = 'lpClosing';

    function panel(item) {
      return item.querySelector('.lp-faq__a');
    }

    function collapse(item) {
      if (!item.open || item.dataset[CLOSING] !== undefined) return;
      var body = panel(item);
      if (!body) {
        item.open = false;
        return;
      }

      item.dataset[CLOSING] = '';

      var done = false;
      function finish() {
        if (done) return;
        done = true;
        body.removeEventListener('transitionend', onEnd);
        delete item.dataset[CLOSING];
        item.open = false;
      }
      function onEnd(e) {
        if (e.target === body && e.propertyName === 'grid-template-rows') finish();
      }

      body.addEventListener('transitionend', onEnd);
      /* Jaring pengaman: kalau transisinya tidak pernah berbunyi (tab di
         latar belakang, prefers-reduced-motion, transisi dibatalkan),
         panelnya tetap harus tertutup — bukan tersangkut terbuka. */
      setTimeout(finish, 420);
    }

    function init(list) {
      if (list.dataset.lpFaqBound === 'true') return;
      list.dataset.lpFaqBound = 'true';

      var exclusive = list.hasAttribute('data-lp-faq-exclusive');

      list.addEventListener('click', function (event) {
        var summary = event.target.closest ? event.target.closest('summary') : null;
        if (!summary || !list.contains(summary)) return;

        var item = summary.parentElement;
        if (!item || item.tagName !== 'DETAILS') return;

        event.preventDefault();

        if (item.open) {
          collapse(item);
          return;
        }

        if (exclusive) {
          list.querySelectorAll('details[open]').forEach(collapse);
        }

        delete item.dataset[CLOSING];
        item.open = true;
      });
    }

    function start() {
      document.querySelectorAll('[data-lp-faq]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · FAQ",
  "tag": "section",
  "class": "lp-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ada Pertanyaan?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Pertanyaan yang Sering Diajukan"
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Hanya satu jawaban terbuka",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pertanyaan",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pertanyaan",
          "default": "Bagaimana moringa membantu di masa menopause?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Jawaban",
          "default": "<p>Tulis jawaban di sini.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
