<div class="lp-faq lp-pad">
  <div class="lp-container lp-reveal">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-faq__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="lp-faq__list" data-lp-faq{% if section.settings.exclusive %} data-lp-faq-exclusive{% endif %}>
      {% for block in section.blocks %}
        <details class="lp-faq__item" {{ block.shopify_attributes }}>
          <summary class="lp-faq__q">
            <span>{{ block.settings.question }}</span>
            <span class="lp-faq__icon" aria-hidden="true">+</span>
          </summary>
          <div class="lp-faq__a">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-faq {
    background: var(--lp-cream);
  }

  .lp-faq .lp-faq__eyebrow,
  .lp-faq .lp-faq__heading {
    text-align: center;
  }

  .lp-faq .lp-faq__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-faq .lp-faq__heading {
    margin-bottom: 2.5rem;
  }

  .lp-faq__list {
    max-width: 700px;
    margin-inline: auto;
  }

  .lp-faq__item {
    border-bottom: 1px solid var(--lp-border);
  }

  .lp-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    color: var(--lp-forest);
    cursor: pointer;
    font-family: var(--lp-font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    list-style: none;
    text-align: left;
  }

  .lp-faq__q::-webkit-details-marker {
    display: none;
  }

  .lp-faq__q:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  .lp-faq__icon {
    flex-shrink: 0;
    transform-origin: center;
    color: var(--lp-text-light);
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .lp-faq__item[open] .lp-faq__icon {
    transform: rotate(45deg);
  }

  .lp-faq__a {
    padding-bottom: 1.25rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .lp-faq__a p {
    margin: 0 0 0.75rem;
  }

  .lp-faq__a p:last-child {
    margin-bottom: 0;
  }

  .lp-faq .lp-faq__a {
    overflow: hidden;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var EASE = 'cubic-bezier(0.2, 0, 0, 1)';
    var OPEN_MS = 420;
    var CLOSE_MS = 320;

    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function init(list) {
      if (list.dataset.lpFaqBound === 'true') return;
      list.dataset.lpFaqBound = 'true';

      var exclusive = list.hasAttribute('data-lp-faq-exclusive');
      var items = Array.prototype.slice.call(list.querySelectorAll('.lp-faq__item'));

      function panel(item) {
        return item.querySelector('.lp-faq__a');
      }

      function stop(item) {
        var body = panel(item);
        if (!body) return;
        body.getAnimations().forEach(function (a) { a.cancel(); });
      }

      function expand(item) {
        var body = panel(item);
        item.open = true;
        if (!body || reducedMotion()) return;
        stop(item);
        var height = body.scrollHeight;
        body.animate(
          [
            { height: '0px', opacity: 0, transform: 'translateY(-6px)', offset: 0 },
            { opacity: 1, offset: 0.55 },
            { height: height + 'px', opacity: 1, transform: 'none', offset: 1 }
          ],
          { duration: OPEN_MS, easing: EASE }
        );
      }

      function collapse(item) {
        var body = panel(item);
        if (!body || reducedMotion()) {
          item.open = false;
          return;
        }
        stop(item);
        var height = body.getBoundingClientRect().height || body.scrollHeight;
        var anim = body.animate(
          [
            { height: height + 'px', opacity: 1, transform: 'none', offset: 0 },
            { opacity: 0, offset: 0.45 },
            { height: '0px', opacity: 0, transform: 'translateY(-6px)', offset: 1 }
          ],
          { duration: CLOSE_MS, easing: EASE, fill: 'forwards' }
        );
        anim.finished.then(function () {
          item.open = false;
          anim.cancel();
        }).catch(function () {});
      }

      items.forEach(function (item) {
        var summary = item.querySelector('summary');
        if (!summary) return;

        summary.addEventListener('click', function (event) {
          event.preventDefault();

          if (item.open) {
            collapse(item);
            return;
          }

          if (exclusive) {
            items.forEach(function (other) {
              if (other !== item && other.open) collapse(other);
            });
          }

          expand(item);
        });
      });
    }

    function start() {
      document.querySelectorAll('[data-lp-faq]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · FAQ",
  "tag": "section",
  "class": "lp-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ada Pertanyaan?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Pertanyaan yang Sering Diajukan"
    },
    {
      "type": "checkbox",
      "id": "exclusive",
      "label": "Hanya satu jawaban terbuka",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Pertanyaan",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pertanyaan",
          "default": "Bagaimana moringa membantu di masa menopause?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Jawaban",
          "default": "<p>Tulis jawaban di sini.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
