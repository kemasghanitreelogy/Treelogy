{% style %}
  #landing-page {
    --og-bg: {{ section.settings.color_bg }};
    --og-ink: {{ section.settings.color_ink }};
    --og-card: {{ section.settings.color_card }};
    --og-accent: {{ section.settings.color_accent }};
    --og-cream: {{ section.settings.color_cream }};
    --og-container: {{ section.settings.container_width }}px;
    --og-font: var(--font-base, 'Inter', 'Inter Fallback', sans-serif);
    --og-fs-display: clamp(2.125rem, 1.5rem + 2vw, 2.75rem);
    --og-fs-title: clamp(1.75rem, 1.3rem + 1.6vw, 2.25rem);
    --og-fs-lead: clamp(1.25rem, 1rem + 0.95vw, 1.6875rem);
    --og-fs-sub: clamp(1.0625rem, 0.85rem + 0.85vw, 1.5rem);
    --og-fs-small: clamp(0.9375rem, 0.78rem + 0.6vw, 1.25rem);
    --og-radius-hero: clamp(18px, 2.6vw, 24px);
    --og-radius-card: clamp(24px, 4vw, 40px);
    --og-gap-section: clamp(32px, 4.4vw, 48px);
    --og-gap-block: clamp(40px, 6vw, 64px);
    --og-outer: {{ section.settings.color_outer }};
    --og-canvas: calc(var(--og-container) + 32px);
    background-color: {{ section.settings.color_outer }};
    background-image: linear-gradient({{ section.settings.color_bg }}, {{ section.settings.color_bg }});
    background-size: min(100%, var(--og-canvas)) 100%;
    background-position: top center;
    background-repeat: no-repeat;
  }

  .og-section {
    background: transparent;
    font-family: var(--og-font);
    color: var(--og-ink);
  }

  .og-container {
    width: min(100% - 32px, var(--og-container));
    margin-inline: auto;
  }

  .og-h2 {
    margin: 0;
    font-size: var(--og-fs-display);
    font-weight: 300;
    line-height: 1.25;
    text-align: center;
    color: var(--og-ink);
  }

  .og-h2 b,
  .og-h2 strong {
    font-weight: 700;
  }

  .og-lead {
    margin: 0 auto;
    max-width: 640px;
    font-size: var(--og-fs-lead);
    line-height: 1.3;
    text-align: center;
    color: var(--og-ink);
  }

  .og-lead b,
  .og-lead strong {
    font-weight: 700;
  }

  .og-arrow {
    display: block;
    width: clamp(36px, 5vw, 44px);
    height: auto;
    margin: 0 auto var(--og-gap-section);
    transform: rotate(90deg);
  }

  .og-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Tokens",
  "settings": [
    {
      "type": "header",
      "content": "Palet Moringa Seed Oil Guide"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Latar kanvas konten",
      "default": "#fbfcf7"
    },
    {
      "type": "color",
      "id": "color_outer",
      "label": "Latar luar kanvas",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Teks utama",
      "default": "#2a3b34"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Latar kartu",
      "default": "#bacba1"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Aksen (bintang)",
      "default": "#a5bb86"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Teks di atas gelap",
      "default": "#f8f8f2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Lebar konten maksimum",
      "min": 600,
      "max": 1360,
      "step": 8,
      "unit": "px",
      "default": 760
    }
  ],
  "presets": [
    {
      "name": "OG Tokens"
    }
  ]
}
{% endschema %}
