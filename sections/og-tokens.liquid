{% style %}
  #landing-page {
    --og-bg: {{ section.settings.color_bg }};
    --og-ink: {{ section.settings.color_ink }};
    --og-card: {{ section.settings.color_card }};
    --og-accent: {{ section.settings.color_accent }};
    --og-cream: {{ section.settings.color_cream }};
    --og-container: {{ section.settings.container_width }}px;
    --og-font: var(--font-base, 'Inter', 'Inter Fallback', sans-serif);
    --og-outer: {{ section.settings.color_outer }};
    --og-canvas: var(--og-container);
    --og-u: calc(min(100vw, var(--og-canvas)) / 1200);
    --og-fs-display: calc(75 * var(--og-u));
    --og-fs-title: calc(60 * var(--og-u));
    --og-fs-lead: calc(45 * var(--og-u));
    --og-fs-sub: calc(39 * var(--og-u));
    --og-fs-small: calc(35 * var(--og-u));
    --og-radius-hero: calc(30 * var(--og-u));
    --og-radius-card: calc(60 * var(--og-u));
    --og-gap-section: calc(65 * var(--og-u));
    --og-gap-block: calc(85 * var(--og-u));
    background-color: {{ section.settings.color_outer }};
    background-image: linear-gradient({{ section.settings.color_bg }}, {{ section.settings.color_bg }});
    background-size: min(100%, var(--og-canvas)) 100%;
    background-position: top center;
    background-repeat: no-repeat;
  }

  .og-section {
    background: transparent;
    font-family: var(--og-font);
    color: var(--og-ink);
  }

  .og-container {
    width: calc(1151 * var(--og-u));
    margin-inline: auto;
  }

  .og-h2 {
    margin: 0;
    font-size: var(--og-fs-display);
    font-weight: 300;
    line-height: 1.25;
    text-align: center;
    color: var(--og-ink);
  }

  .og-h2 b,
  .og-h2 strong {
    font-weight: 700;
  }

  .og-lead {
    margin: 0 auto;
    max-width: calc(968 * var(--og-u));
    font-size: var(--og-fs-lead);
    line-height: 1.25;
    text-align: center;
    color: var(--og-ink);
  }

  .og-lead b,
  .og-lead strong {
    font-weight: 700;
  }

  .og-arrow {
    display: block;
    width: calc(70 * var(--og-u));
    height: auto;
    margin: 0 auto var(--og-gap-section);
    transform: rotate(90deg);
  }

  /* --- Primitif desain email (harga-lama, hari-terakhir) -----------------
     Kartu hero, pil CTA, dan panah pemisah dipakai lebih dari satu halaman,
     jadi definisinya tinggal di sini — satu-satunya section yang PASTI ada di
     setiap halaman keluarga og-*. Menaruhnya di section masing-masing berarti
     CSS yang sama dikirim dua kali. */
  .og-hero-card {
    width: calc(1151 * var(--og-u));
    margin-inline: auto;
    aspect-ratio: 1151 / 670;
    overflow: hidden;
    border-radius: var(--og-radius-hero);
    background: linear-gradient(180deg, #f9f9f9 0%, #f8f8fa 29.463%, #e6e1de 100%);
  }

  .og-hero-card__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .og-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: calc(22 * var(--og-u)) calc(60 * var(--og-u));
    border-radius: calc(150 * var(--og-u));
    background: var(--og-ink);
    color: var(--og-bg);
    font-family: var(--og-font);
    font-size: var(--og-fs-lead);
    font-weight: 400;
    line-height: normal;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  .og-cta--fixed {
    width: var(--og-cta-w);
  }

  .og-cta:hover,
  .og-cta:focus-visible {
    opacity: 0.9;
  }

  .og-arrow--flow {
    margin-bottom: 0;
  }

  .og-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Tokens",
  "settings": [
    {
      "type": "header",
      "content": "Palet Moringa Seed Oil Guide"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Latar kanvas konten",
      "default": "#fbfcf7"
    },
    {
      "type": "color",
      "id": "color_outer",
      "label": "Latar luar kanvas",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_ink",
      "label": "Teks utama",
      "default": "#2a3b34"
    },
    {
      "type": "color",
      "id": "color_card",
      "label": "Latar kartu",
      "default": "#bacba1"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Aksen (bintang)",
      "default": "#a5bb86"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Teks di atas gelap",
      "default": "#f8f8f2"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Lebar kanvas",
      "min": 400,
      "max": 1200,
      "step": 8,
      "unit": "px",
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "OG Tokens"
    }
  ]
}
{% endschema %}
