{% liquid
  assign body_font = section.settings.body_font
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign heading_font = section.settings.heading_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'
%}

{% capture lp_dark_palette %}
  --lp-forest: #a5bb86;
  --lp-forest-deep: #141e16;
  --lp-leaf-hover: #8fa872;
  --lp-cream: #141e16;
  --lp-bloom: #1e2820;
  --lp-surface: #1a221c;
  --lp-text: #eae9dc;
  --lp-text-mid: #a5bb86;
  --lp-text-light: #8f9561;
  --lp-border: #2a3b34;
  --lp-alert: #d4705e;
{% endcapture %}

{% capture lp_dark_rules %}
  .lp-btn:not(.lp-btn--gold) { background: #3d5a3e; }
  .lp-btn:not(.lp-btn--gold):hover { background: #4a6b4a; }
  .lp-stats .lp-btn--gold,
  .lp-final .lp-btn { color: #1a2b24; }
  .lp-badge__icon img { filter: brightness(1.6) saturate(0.7); }
{% endcapture %}

{% style %}
  {% unless section.settings.use_theme_font %}
    {{ body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ heading_font_bold | font_face: font_display: 'swap' }}
    {{ heading_font_italic | font_face: font_display: 'swap' }}
  {% endunless %}

  :root {
    --lp-forest: {{ section.settings.color_forest }};
    --lp-forest-deep: {{ section.settings.color_forest_deep }};
    --lp-leaf-hover: {{ section.settings.color_forest_deep }};
    --lp-gold: {{ section.settings.color_gold }};
    --lp-gold-light: {{ section.settings.color_gold_light }};
    --lp-cream: {{ section.settings.color_cream }};
    --lp-bloom: {{ section.settings.color_bloom }};
    --lp-surface: {{ section.settings.color_surface }};
    --lp-text: {{ section.settings.color_text }};
    --lp-text-mid: {{ section.settings.color_text_mid }};
    --lp-text-light: {{ section.settings.color_text_light }};
    --lp-border: {{ section.settings.color_border }};
    --lp-alert: {{ section.settings.color_alert }};
    --lp-on-dark: {{ section.settings.color_on_dark }};
    {% if section.settings.use_theme_font %}
      --lp-font-display: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif;
      --lp-font-body: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif;
    {% else %}
      --lp-font-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --lp-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    {% endif %}
    --lp-max-w: {{ section.settings.container_width }}px;
    --lp-max-w-narrow: {{ section.settings.container_width_narrow }}px;
    --lp-radius: {{ section.settings.radius }}px;
    --lp-radius-lg: {{ section.settings.radius_large }}px;
    --lp-pad-block: {{ section.settings.section_padding }}px;
    --lp-pad-block-mobile: {{ section.settings.section_padding_mobile }}px;
  }

  {% if section.settings.color_mode == 'system' %}
    @media (prefers-color-scheme: dark) {
      :root { {{ lp_dark_palette }} }
      {{ lp_dark_rules }}
    }
    :root[data-theme='dark'] { {{ lp_dark_palette }} }
  {% elsif section.settings.color_mode == 'dark' %}
    :root { {{ lp_dark_palette }} }
    {{ lp_dark_rules }}
  {% endif %}
{% endstyle %}

{% if section.settings.chromeless %}
  <div class="lp-chromeless" hidden></div>
{% endif %}

{% stylesheet %}
  body:has(.lp-chromeless) [id^='shopify-section-header' i],
  body:has(.lp-chromeless) [id^='shopify-section-footer' i],
  body:has(.lp-chromeless) [id^='shopify-section-announcement' i],
  body:has(.lp-chromeless) #utm-toast {
    display: none !important;
  }

  body:has(.lp-tokens) {
    font-size: 1.0625rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  html:has(.lp-chromeless) {
    overflow-x: clip;
  }

  body:has(.lp-chromeless) {
    overflow-x: clip;
    margin: 0 !important;
    padding: 0 !important;
    background: var(--lp-cream);
  }

  body:has(.lp-chromeless) #landing-page,
  body:has(.lp-chromeless) main#landing-page {
    display: block;
    min-height: 100dvh;
    margin: 0 !important;
    padding: 0 !important;
  }

  .lp-container {
    width: 100%;
    min-width: 0;
    max-width: min(var(--lp-max-w), 100%);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .lp-container--narrow {
    max-width: min(var(--lp-max-w-narrow), 100%);
  }

  .lp-pad {
    padding-block: var(--lp-pad-block);
  }

  .lp-eyebrow {
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lp-gold);
  }

  .lp-h1, .lp-h2, .lp-h3 {
    font-family: var(--lp-font-display);
    line-height: 1.15;
    text-wrap: balance;
    color: var(--lp-forest);
    margin: 0;
  }

  .lp-h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .lp-h2 {
    font-size: clamp(1.6rem, 4vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .lp-h3 {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    background: var(--lp-forest);
    color: #fff;
    font-family: var(--lp-font-body);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--lp-radius);
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .lp-btn:hover {
    background: var(--lp-leaf-hover);
    transform: translateY(-1px);
  }

  .lp-btn:active {
    transform: translateY(0);
  }

  .lp-btn:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 3px;
  }

  .lp-btn--gold {
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
  }

  .lp-btn--gold:hover {
    background: var(--lp-gold-light);
  }

  .lp-note {
    font-size: 0.8125rem;
    color: var(--lp-text-light);
    margin: 0.75rem 0 0;
  }

  .lp-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--lp-bloom);
    fill: color-mix(in srgb, var(--lp-forest) 22%, transparent);
  }

  .lp-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .lp-reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media screen and (max-width: 768px) {
    .lp-pad {
      padding-block: var(--lp-pad-block-mobile);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reveal() {
      var nodes = document.querySelectorAll('.lp-reveal:not(.is-visible)');
      if (!nodes.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        nodes.forEach(function (el) {
          el.classList.add('is-visible');
        });
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.1 }
      );

      nodes.forEach(function (el) {
        observer.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', reveal);
    } else {
      reveal();
    }

    document.addEventListener('shopify:section:load', reveal);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Design tokens",
  "tag": "div",
  "class": "lp-tokens",
  "settings": [
    {
      "type": "paragraph",
      "content": "Atur warna dan font untuk seluruh seksi LP di halaman ini. Letakkan seksi ini paling atas."
    },
    {
      "type": "checkbox",
      "id": "chromeless",
      "label": "Sembunyikan header dan footer toko",
      "default": true,
      "info": "Halaman tampil penuh tanpa navigasi, seperti landing page berdiri sendiri."
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Mode warna",
      "options": [
        { "value": "system", "label": "Ikut perangkat pengunjung" },
        { "value": "light", "label": "Selalu terang" },
        { "value": "dark", "label": "Selalu gelap" }
      ],
      "default": "system",
      "info": "Palet gelap mengikuti desain asli dan tidak dapat diubah di sini."
    },
    {
      "type": "header",
      "content": "Font"
    },
    {
      "type": "checkbox",
      "id": "use_theme_font",
      "label": "Pakai Inter bawaan theme",
      "default": true,
      "info": "Sesuai desain asli dan tanpa unduhan font tambahan. Matikan untuk memilih font Shopify."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font judul",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.use_theme_font == false }}"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font teks",
      "default": "assistant_n4",
      "visible_if": "{{ section.settings.use_theme_font == false }}"
    },
    {
      "type": "header",
      "content": "Warna utama"
    },
    {
      "type": "color",
      "id": "color_forest",
      "label": "Hijau utama",
      "default": "#2a3b34"
    },
    {
      "type": "color",
      "id": "color_forest_deep",
      "label": "Hijau gelap",
      "default": "#1a2b24"
    },
    {
      "type": "color",
      "id": "color_gold",
      "label": "Aksen emas",
      "default": "#f5d053"
    },
    {
      "type": "color",
      "id": "color_gold_light",
      "label": "Aksen emas terang",
      "default": "#f8dc6d"
    },
    {
      "type": "color",
      "id": "color_alert",
      "label": "Warna peringatan",
      "default": "#c45b4a"
    },
    {
      "type": "header",
      "content": "Latar dan permukaan"
    },
    {
      "type": "color",
      "id": "color_cream",
      "label": "Latar terang",
      "default": "#f8f8f2"
    },
    {
      "type": "color",
      "id": "color_bloom",
      "label": "Latar alternatif",
      "default": "#eae9dc"
    },
    {
      "type": "color",
      "id": "color_surface",
      "label": "Permukaan kartu",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_border",
      "label": "Garis tepi",
      "default": "#d6d4c8"
    },
    {
      "type": "header",
      "content": "Teks"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Teks utama",
      "default": "#2a3b34"
    },
    {
      "type": "color",
      "id": "color_text_mid",
      "label": "Teks sekunder",
      "default": "#6c7257"
    },
    {
      "type": "color",
