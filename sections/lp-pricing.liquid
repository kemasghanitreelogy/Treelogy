<div class="lp-pricing lp-pad" id="{{ section.settings.anchor_id | default: 'pricing' }}">
  <div class="lp-container">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-pricing__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-pricing__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.show_countdown %}
      <div class="lp-pricing__urgency">
        <div
          class="lp-pricing__badge"
          data-lp-countdown
          data-mode="{{ section.settings.countdown_mode }}"
          data-deadline="{{ section.settings.end_date }}"
          data-hours="{{ section.settings.evergreen_hours }}"
          data-storage-key="{{ section.settings.storage_key }}"
        >
          {{ section.settings.countdown_label }}
          <span class="lp-pricing__timer">
            <span data-lp-countdown-part="days">--</span>d
            <span data-lp-countdown-part="hours">--</span>j
            <span data-lp-countdown-part="minutes">--</span>m
            <span data-lp-countdown-part="seconds">--</span>d
          </span>
        </div>
      </div>
    {% endif %}

    {% if section.settings.scarcity != blank or section.settings.scarcity_note != blank %}
      <p class="lp-pricing__scarcity">
        {%- if section.settings.scarcity != blank -%}
          <strong>{{ section.settings.scarcity }}</strong>
        {%- endif -%}
        {%- if section.settings.scarcity_note != blank -%}
          <span class="lp-pricing__scarcity-note"> {{ section.settings.scarcity_note }}</span>
        {%- endif -%}
      </p>
    {% endif %}

    {% if section.settings.quote != blank %}
      <p class="lp-pricing__quote">
        {{ section.settings.quote }}
        {% if section.settings.quote_author != blank %}
          <span>· {{ section.settings.quote_author }}</span>
        {% endif %}
      </p>
    {% endif %}

    <div class="lp-pricing__cards">
      {% for block in section.blocks %}
        <div
          class="lp-plan{% if block.settings.featured %} lp-plan--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.tag != blank %}
            <div class="lp-plan__tag lp-plan__tag--{{ block.settings.tag_style }}">{{ block.settings.tag }}</div>
          {% endif %}

          <div class="lp-plan__body">
            {% if block.settings.title != blank %}
              <div class="lp-plan__title">{{ block.settings.title }}</div>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="lp-plan__desc">{{ block.settings.description }}</p>
            {% endif %}

            {% if block.settings.variants != blank %}
              <div class="lp-plan__variants">
                {%- assign variant_lines = block.settings.variants | strip | newline_to_br | split: '<br />' -%}
                {% for line in variant_lines %}
                  {%- assign parts = line | split: '|' -%}
                  {% if parts.size > 1 %}
                    {%- liquid
                      assign row_tag = 'div'
                      assign row_href = ''
                      if parts.size > 2
                        assign row_variant = parts[2] | strip
                        if row_variant != blank
                          assign row_tag = 'a'
                          assign row_href = '/cart/' | append: row_variant
                          unless row_variant contains ':'
                            assign row_href = row_href | append: ':1'
                          endunless
                        endif
                      endif
                    -%}
                    <{{ row_tag }}
                      class="lp-plan__variant{% if row_tag == 'a' %} lp-plan__variant--link{% endif %}"
                      {% if row_tag == 'a' %}href="{{ row_href }}"{% endif %}
                    >
                      <span>{{ parts[0] | strip }}</span>
                      <span class="lp-plan__price">{{ parts[1] | strip }}</span>
                    </{{ row_tag }}>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.stack != blank %}
              <div class="lp-plan__stack">
                {%- assign stack_lines = block.settings.stack | strip | newline_to_br | split: '<br />' -%}
                {% for line in stack_lines %}
                  {%- assign parts = line | split: '|' -%}
                  {% if parts.size > 1 %}
                    <div class="lp-plan__row">
                      <span>{{ parts[0] | strip }}</span>
                      {% if parts.size > 2 %}
                        <span class="lp-plan__free">
                          <s>{{- parts[1] | strip -}}</s>{{ parts[2] | strip }}
                        </span>
                      {% else %}
                        <span class="lp-plan__value">{{ parts[1] | strip }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.total_value != blank %}
              <div class="lp-plan__total">
                <span>{{ block.settings.total_label }}</span>
                <span><s>{{ block.settings.total_value }}</s></span>
              </div>
            {% endif %}

            {% if block.settings.price != blank %}
              <div class="lp-plan__now">
                <span>{{ block.settings.price_label }}</span>
                <span class="lp-plan__price">{{ block.settings.price }}</span>
              </div>
            {% endif %}

            {% if block.settings.per_day != blank %}
              <p class="lp-plan__perday">{{ block.settings.per_day }}</p>
            {% endif %}

            {% if block.settings.guarantee != blank or block.settings.guarantee_marker != blank %}
              <p class="lp-plan__guarantee-line">
                {%- if block.settings.guarantee_marker != blank -%}
                  <strong>{{ block.settings.guarantee_marker }}</strong>
                {%- endif -%}
                {{ block.settings.guarantee }}
              </p>
            {% endif %}

            <div class="lp-plan__footer">
              {% if block.settings.cta_label != blank %}
                {%- liquid
                  assign plan_href = block.settings.cta_url | default: '#'
                  if block.settings.variant_id != blank
                    assign qty = block.settings.quantity | default: 1
                    if block.settings.variant_id contains ':'
                      assign plan_href = '/cart/' | append: block.settings.variant_id
                    else
                      assign plan_href = '/cart/' | append: block.settings.variant_id | append: ':' | append: qty
                    endif
                    if block.settings.discount_code != blank
                      assign plan_href = plan_href | append: '?discount=' | append: block.settings.discount_code
                    endif
                  endif
                -%}
                <a
                  class="lp-btn{% if block.settings.featured %} lp-btn--gold{% endif %} lp-plan__cta"
                  href="{{ plan_href }}"
                >
                  {{- block.settings.cta_label -}}
                </a>
              {% endif %}

              {% if block.settings.footer_note != blank %}
                <p class="lp-plan__note">{{ block.settings.footer_note }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.pledge_text != blank %}
      <div class="lp-pledge">
        {% if section.settings.pledge_icon != blank %}
          <div class="lp-pledge__icon" aria-hidden="true">{{ section.settings.pledge_icon }}</div>
        {% endif %}
        <div>
          {% if section.settings.pledge_title != blank %}
            <strong>{{ section.settings.pledge_title }}</strong>
          {% endif %}
          {{ section.settings.pledge_text }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .lp-pricing {
    background: var(--lp-cream);
    scroll-margin-top: calc(var(--lp-urgency-height, 0px) + 1.5rem);
  }

  .lp-pricing .lp-pricing__eyebrow,
  .lp-pricing .lp-pricing__heading,
  .lp-pricing__urgency,
  .lp-pricing__scarcity {
    text-align: center;
  }

  .lp-pricing .lp-pricing__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-pricing .lp-pricing__heading {
    margin-bottom: 0.5rem;
  }

  .lp-pricing__urgency {
    margin-bottom: 2.5rem;
  }

  .lp-pricing__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    background: var(--lp-forest-deep);
    color: var(--lp-on-dark);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .lp-pricing__timer {
    display: inline-flex;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-pricing__timer span {
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .lp-pricing__scarcity-note {
    color: var(--lp-text-light);
    font-weight: 400;
  }

  .lp-pricing__scarcity {
    margin: 0 0 2rem;
    color: var(--lp-alert);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lp-pricing__quote {
    max-width: 440px;
    margin: 0 auto 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-style: italic;
    text-align: center;
  }

  .lp-pricing__quote span {
    color: var(--lp-text-light);
    font-size: 0.8125rem;
    font-style: normal;
  }

  .lp-pricing__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    max-width: 1140px;
    margin-inline: auto;
  }

  .lp-plan {
    display: flex;
    position: relative;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
  }

  .lp-plan--featured {
    border-color: var(--lp-gold);
  }

  .lp-plan__tag {
    padding: 0.4rem;
    background: var(--lp-surface-dark);
    color: var(--lp-on-dark);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .lp-plan__tag--gold {
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
  }

  .lp-plan__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }

  .lp-plan__title {
    margin-bottom: 0.25rem;
    color: var(--lp-forest);
    font-family: var(--lp-font-display);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .lp-plan__desc {
    margin: 0 0 1rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .lp-plan__variants {
    margin-bottom: 1rem;
  }

  .lp-plan__variant {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--lp-border);
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.875rem;
  }

  .lp-plan__variant:last-child {
    border-bottom: none;
  }

  .lp-pricing .lp-plan__variant--link {
    color: var(--lp-text);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .lp-pricing .lp-plan__variant--link:hover {
    background: color-mix(in srgb, var(--lp-gold) 12%, transparent);
  }

  .lp-pricing .lp-plan__variant--link:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  .lp-plan__stack {
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--lp-border);
    border-radius: var(--lp-radius);
  }

  .lp-plan__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--lp-border);
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__row:last-child {
    border-bottom: none;
  }

  .lp-plan__row > span:first-child {
    flex: 1;
    min-width: 0;
  }

  .lp-plan__value {
    white-space: nowrap;
  }

  .lp-plan__free {
    color: var(--lp-forest);
    font-weight: 700;
    white-space: nowrap;
  }

  .lp-plan__free s {
    margin-right: 0.3rem;
    color: var(--lp-text-light);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .lp-plan__total,
  .lp-plan__now {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__total {
    margin-bottom: 0.35rem;
    color: var(--lp-text-mid);
  }

  .lp-plan__total s {
    color: var(--lp-text-light);
  }

  .lp-plan__now {
    margin-bottom: 1rem;
    color: var(--lp-forest);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .lp-plan__price {
    color: var(--lp-forest);
    font-weight: 700;
  }

  .lp-plan__now .lp-plan__price {
    font-size: 1.125rem;
  }

  .lp-plan__perday {
    margin: -0.75rem 0 1rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    text-align: right;
  }

  .lp-plan__guarantee-line {
    margin: 0 0 1rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__footer {
    margin-top: auto;
  }

  .lp-pricing .lp-plan__cta {
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
  }

  .lp-plan__note {
    margin: 0;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    text-align: center;
  }

  .lp-pledge {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 560px;
    margin: 2rem auto 0;
    padding: 1.1rem 1.25rem;
    border: 1.5px solid var(--lp-gold);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .lp-pledge__icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .lp-pledge strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--lp-text);
  }

  @media screen and (max-width: 820px) {
    .lp-pricing__cards {
      display: flex;
      overflow-x: auto;
      max-width: none;
      gap: 1rem;
      padding-inline: 0.25rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .lp-pricing__cards::-webkit-scrollbar {
      display: none;
    }

    .lp-plan {
      flex: 0 0 92%;
      min-width: 0;
      scroll-snap-align: start;
    }

    .lp-plan__row {
      gap: 0.5rem;
      padding: 0.35rem 0;
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Pricing",
  "tag": "section",
  "class": "lp-pricing-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID anchor",
      "default": "pricing",
      "info": "Dipakai tombol lain untuk melompat ke sini, mis. #pricing."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Offer Terbatas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Pilih Protokol"
    },
    {
      "type": "header",
      "content": "Hitung mundur"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Tampilkan hitung mundur",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Label",
      "default": "Offer Berakhir Dalam:"
    },
    {
      "type": "select",
      "id": "countdown_mode",
      "label": "Mode",
      "options": [
        { "value": "evergreen", "label": "Evergreen (per pengunjung)" },
        { "value": "fixed", "label": "Tanggal tetap" }
      ],
      "default": "evergreen"
    },
    {
      "type": "range",
      "id": "evergreen_hours",
      "label": "Durasi evergreen",
      "min": 6,
      "max": 168,
      "step": 6,
      "unit": "jam",
      "default": 72,
      "visible_if": "{{ section.settings.countdown_mode == 'evergreen' }}"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Tanggal berakhir",
      "default": "2026-12-31 23:59",
      "visible_if": "{{ section.settings.countdown_mode == 'fixed' }}"
    },
    {
      "type": "text",
      "id": "storage_key",
      "label": "Kunci penyimpanan",
      "default": "lp-offer",
      "info": "Samakan dengan urgency bar agar hitung mundurnya sinkron."
    },
    {
      "type": "header",
      "content": "Dorongan tambahan"
    },
    {
      "type": "text",
      "id": "scarcity",
      "label": "Teks kelangkaan (tebal)"
    },
    {
      "type": "text",
      "id": "scarcity_note",
      "label": "Lanjutan teks kelangkaan"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Kutipan pelanggan"
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Sumber kutipan"
    },
    {
      "type": "header",
      "content": "Janji garansi"
    },
    {
      "type": "text",
      "id": "pledge_icon",
      "label": "Emoji"
    },
    {
      "type": "text",
      "id": "pledge_title",
      "label": "Judul",
      "default": "Nggak Terasa? Uang Kembali."
    },
    {
      "type": "textarea",
      "id": "pledge_text",
      "label": "Teks"
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Paket",
      "limit": 4,
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Sorot paket ini",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label atas",
          "default": "Terpopuler"
        },
        {
          "type": "select",
          "id": "tag_style",
          "label": "Warna label",
          "options": [
            { "value": "dark", "label": "Hijau" },
            { "value": "gold", "label": "Emas" }
          ],
          "default": "dark"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nama paket",
          "default": "Protokol Inside Out 30 Hari"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Deskripsi"
        },
        {
          "type": "textarea",
          "id": "variants",
          "label": "Baris varian",
          "info": "Satu baris per item. Format: Nama | Harga — tambahkan | IDvarian agar baris itu langsung ke checkout."
        },
        {
          "type": "textarea",
          "id": "stack",
          "label": "Rincian nilai",
          "info": "Satu baris per item. Format: Nama | Harga — atau Nama | Harga coret | GRATIS"
        },
        {
          "type": "text",
          "id": "total_label",
          "label": "Label total",
          "default": "Total nilai:"
        },
        {
          "type": "text",
          "id": "total_value",
          "label": "Nilai total (dicoret)"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Label harga",
          "default": "Hari ini saja:"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Harga"
        },
        {
          "type": "text",
          "id": "per_day",
          "label": "Harga per hari"
        },
        {
          "type": "text",
          "id": "guarantee_marker",
          "label": "Penanda garansi (tebal)",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "guarantee",
          "label": "Baris garansi",
          "default": "Garansi uang kembali 30 hari"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Label tombol",
          "default": "Ambil Protokol"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "ID varian (langsung ke checkout)",
          "info": "Isi untuk melewati halaman produk. Bisa beberapa item sekaligus, mis. 123:1,456:1 (hadiah otomatis jadi Rp 0). Kosongkan untuk memakai Tautan tombol."
        },
        {
          "type": "range",
          "id": "quantity",
          "label": "Jumlah",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1
        },
        {
          "type": "text",
          "id": "discount_code",
          "label": "Kode diskon otomatis",
          "info": "Kosongkan bila harga varian sudah sama dengan harga di kartu ini. Mengisinya membuat pelanggan membayar LEBIH MURAH dari yang tertulis."
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Tautan tombol"
        },
        {
          "type": "text",
          "id": "footer_note",
          "label": "Catatan bawah",
          "default": "Pesan hari ini, dikirim besok"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Pricing",
      "blocks": [
        { "type": "plan" },
        { "type": "plan" },
        { "type": "plan" }
      ]
    }
  ]
}
{% endschema %}
