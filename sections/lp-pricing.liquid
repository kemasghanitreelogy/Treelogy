{%- liquid
  # Bahasa halaman checkout mengikuti awalan lokal di URL keranjang. Tanpa
  # awalan, pembeli mendarat di checkout bahasa utama toko (Inggris) meskipun
  # halaman ini berbahasa Indonesia.
  assign lp_locale = section.settings.checkout_locale
  if lp_locale == 'auto'
    assign lp_root = routes.root_url
    if lp_root == '/'
      assign cart_root = '/cart/'
    else
      assign cart_root = lp_root | append: '/cart/'
    endif
  else
    assign cart_root = '/' | append: lp_locale | append: '/cart/'
  endif
-%}

<div class="lp-pricing lp-pad" id="{{ section.settings.anchor_id | default: 'pricing' }}">
  <div class="lp-container">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-pricing__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-pricing__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.show_countdown %}
      <div class="lp-pricing__urgency">
        <div
          class="lp-pricing__badge"
          data-lp-countdown
          data-mode="{{ section.settings.countdown_mode }}"
          data-deadline="{{ section.settings.end_date }}"
          data-hours="{{ section.settings.evergreen_hours }}"
          data-storage-key="{{ section.settings.storage_key }}"
        >
          {{ section.settings.countdown_label }}
          <span class="lp-pricing__timer">
            <span data-lp-countdown-part="days">--</span>d
            <span data-lp-countdown-part="hours">--</span>j
            <span data-lp-countdown-part="minutes">--</span>m
            <span data-lp-countdown-part="seconds">--</span>d
          </span>
        </div>
      </div>
    {% endif %}

    {% if section.settings.scarcity != blank or section.settings.scarcity_note != blank %}
      <p class="lp-pricing__scarcity">
        {%- if section.settings.scarcity != blank -%}
          <strong>{{ section.settings.scarcity }}</strong>
        {%- endif -%}
        {%- if section.settings.scarcity_note != blank -%}
          <span class="lp-pricing__scarcity-note"> {{ section.settings.scarcity_note }}</span>
        {%- endif -%}
      </p>
    {% endif %}

    {% if section.settings.quote != blank %}
      <p class="lp-pricing__quote">
        {{ section.settings.quote }}
        {% if section.settings.quote_author != blank %}
          <span>· {{ section.settings.quote_author }}</span>
        {% endif %}
      </p>
    {% endif %}

    {%- liquid
      assign lp_visible_plans = 0
      for lp_block in section.blocks
        unless lp_block.settings.hidden
          assign lp_visible_plans = lp_visible_plans | plus: 1
        endunless
      endfor
    -%}
    <div
      class="lp-pricing__cards"
      style="--lp-plan-count: {{ lp_visible_plans | at_least: 1 }};"
    >
      {% for block in section.blocks %}
        {%- if block.settings.hidden -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          # Semua angka rupiah pada kartu ini diturunkan dari produk asli ketika
          # "Produk utama" diisi, supaya isi kartu tidak pernah bisa berbeda dari
          # yang dilihat pembeli di keranjang dan checkout.
          assign lp_product = block.settings.product
          assign lp_live = false

          if lp_product != blank
            assign lp_live = true
            assign lp_variant = lp_product.selected_or_first_available_variant
            assign lp_pos = block.settings.variant_position | default: 0
            if lp_pos > 0
              assign lp_idx = lp_pos | minus: 1
              if lp_product.variants[lp_idx] != blank
                assign lp_variant = lp_product.variants[lp_idx]
              endif
            endif

            assign lp_separate = 0
            assign lp_comp1 = block.settings.component_1
            if lp_comp1 != blank
              assign lp_c1v = lp_comp1.selected_or_first_available_variant
              assign lp_c1pos = block.settings.component_1_variant | default: 0
              if lp_c1pos > 0
                assign lp_c1i = lp_c1pos | minus: 1
                if lp_comp1.variants[lp_c1i] != blank
                  assign lp_c1v = lp_comp1.variants[lp_c1i]
                endif
              endif
              assign lp_separate = lp_separate | plus: lp_c1v.price
            endif

            assign lp_comp2 = block.settings.component_2
            if lp_comp2 != blank
              assign lp_c2v = lp_comp2.selected_or_first_available_variant
              assign lp_c2pos = block.settings.component_2_variant | default: 0
              if lp_c2pos > 0
                assign lp_c2i = lp_c2pos | minus: 1
                if lp_comp2.variants[lp_c2i] != blank
                  assign lp_c2v = lp_comp2.variants[lp_c2i]
                endif
              endif
              assign lp_separate = lp_separate | plus: lp_c2v.price
            endif

            # Hadiah dijual seharga nol agar selalu gratis tanpa bergantung pada
            # diskon otomatis: paket toko ini hanya menerapkan satu diskon produk
            # otomatis per pesanan, sehingga diskon hadiah akan kalah oleh
            # potongan bundel. Nilai aslinya disimpan sebagai harga coret.
            # Satu varian hadiah boleh diberikan lebih dari satu (metafield
            # eligible_gifts memuat varian yang sama dua kali → engine menambah
            # dua baris). Jumlahnya ditulis di sini supaya kartu menyebut angka
            # yang SAMA dengan yang benar-benar masuk keranjang; kalau tidak,
            # nilai hadiah di kartu lebih kecil daripada yang diterima pembeli.
            assign lp_gift_total = 0
            assign lp_gift1 = block.settings.gift_1
            assign lp_g1_qty = block.settings.gift_1_qty | default: 1
            if lp_g1_qty < 1
              assign lp_g1_qty = 1
            endif
            if lp_gift1 != blank
              assign lp_g1v = lp_gift1.selected_or_first_available_variant
              assign lp_g1_value = lp_g1v.price
              if lp_g1v.price == 0 and lp_g1v.compare_at_price > 0
                assign lp_g1_value = lp_g1v.compare_at_price
              endif
              assign lp_g1_value = lp_g1_value | times: lp_g1_qty
              assign lp_gift_total = lp_gift_total | plus: lp_g1_value
            endif
            assign lp_gift2 = block.settings.gift_2
            assign lp_g2_qty = block.settings.gift_2_qty | default: 1
            if lp_g2_qty < 1
              assign lp_g2_qty = 1
            endif
            if lp_gift2 != blank
              assign lp_g2v = lp_gift2.selected_or_first_available_variant
              assign lp_g2_value = lp_g2v.price
              if lp_g2v.price == 0 and lp_g2v.compare_at_price > 0
                assign lp_g2_value = lp_g2v.compare_at_price
              endif
              assign lp_g2_value = lp_g2_value | times: lp_g2_qty
              assign lp_gift_total = lp_gift_total | plus: lp_g2_value
            endif

            # Harga jual varian sudah disamakan dengan penjumlahan komponen, lalu
            # dipotong diskon otomatis di checkout. Liquid tidak bisa membaca
            # diskon otomatis, jadi besarnya dititipkan lewat setting agar kartu
            # menampilkan angka yang sama dengan yang ditagih checkout.
            assign lp_promo = block.settings.promo_discount | default: 0 | times: 100
            assign lp_final = lp_variant.price
            if lp_promo > 0 and lp_promo < lp_variant.price
              assign lp_final = lp_variant.price | minus: lp_promo
            else
              assign lp_promo = 0
            endif

            assign lp_anchor = lp_separate
            if lp_promo > 0
              assign lp_anchor = lp_variant.price
            endif

            assign lp_savings = lp_promo
            if lp_promo == 0 and lp_separate > lp_variant.price
              assign lp_savings = lp_separate | minus: lp_variant.price
            endif

            # Permalink keranjang: produk utama lebih dulu, lalu hadiah. Urutan
            # dibalik di bawah karena permalink membangun baris dari belakang.
            assign lp_cart_line = lp_variant.id | append: ':1'
            if lp_gift1 != blank
              assign lp_cart_line = lp_cart_line | append: ',' | append: lp_g1v.id | append: ':' | append: lp_g1_qty
            endif
            if lp_gift2 != blank
              assign lp_cart_line = lp_cart_line | append: ',' | append: lp_g2v.id | append: ':' | append: lp_g2_qty
            endif
          endif
        -%}

        <div
          class="lp-plan{% if block.settings.featured %} lp-plan--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.tag != blank %}
            <div class="lp-plan__tag lp-plan__tag--{{ block.settings.tag_style }}">
              {{- block.settings.tag -}}
              {%- if lp_live and block.settings.tag_show_savings and lp_savings > 0 -%}
                {{ ' · ' }}{{ block.settings.savings_word }} {{ lp_savings | money }}
              {%- endif -%}
            </div>
          {% endif %}

          <div class="lp-plan__body">
            {% if block.settings.title != blank %}
              <div class="lp-plan__title">{{ block.settings.title }}</div>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="lp-plan__desc">{{ block.settings.description }}</p>
            {% endif %}

            {%- assign choice_href = '' -%}
            {% if lp_live and block.settings.variants_from_product and lp_product.variants.size > 1 %}
              {%- assign default_row = block.settings.variant_default | default: 1 -%}
              <div
                class="lp-plan__variants lp-plan__variants--choice"
                data-lp-plan-choice
                role="radiogroup"
                aria-label="{{ block.settings.variants_label | default: block.settings.title }}"
              >
                {% for lp_v in lp_product.variants %}
                  {%- liquid
                    assign lp_v_line = lp_v.id | append: ':1'
                    if lp_gift1 != blank
                      assign lp_v_line = lp_v_line | append: ',' | append: lp_g1v.id | append: ':1'
                    endif
                    if lp_gift2 != blank
                      assign lp_v_line = lp_v_line | append: ',' | append: lp_g2v.id | append: ':1'
                    endif
                    if lp_v_line contains ','
                      assign lp_v_line = lp_v_line | split: ',' | reverse | join: ','
                    endif
                    assign lp_v_href = cart_root | append: lp_v_line
                    if block.settings.discount_code != blank
                      assign lp_v_href = lp_v_href | append: '?discount=' | append: block.settings.discount_code
                    endif
                    if forloop.index == default_row
                      assign choice_href = lp_v_href
                    endif
                  -%}
                  <label class="lp-plan__variant lp-plan__variant--choice">
                    <input
                      class="lp-plan__radio"
                      type="radio"
                      name="lp-plan-choice-{{ block.id }}"
                      value="{{ lp_v_href }}"
                      {% if forloop.index == default_row %}checked{% endif %}
                      {% unless lp_v.available %}disabled{% endunless %}
                    >
                    <span class="lp-plan__mark" aria-hidden="true"></span>
                    <span class="lp-plan__variant-name">{{ lp_v.title }}</span>
                    <span class="lp-plan__price">{{ lp_v.price | money }}</span>
                  </label>
                {% endfor %}
              </div>
            {% elsif block.settings.variants != blank %}
              <div
                class="lp-plan__variants{% if block.settings.variants_as_radio %} lp-plan__variants--choice{% endif %}"
                {% if block.settings.variants_as_radio %}
                  data-lp-plan-choice
                  role="radiogroup"
                  aria-label="{{ block.settings.variants_label | default: block.settings.title }}"
                {% endif %}
              >
                {%- assign variant_lines = block.settings.variants | strip | newline_to_br | split: '<br />' -%}
                {%- assign default_row = block.settings.variant_default | default: 1 -%}
                {% for line in variant_lines %}
                  {%- assign parts = line | split: '|' -%}
                  {% if parts.size > 1 %}
                    {%- liquid
                      assign row_tag = 'div'
                      assign row_href = ''
                      if parts.size > 2
                        assign row_variant = parts[2] | strip
                        if row_variant != blank
                          assign row_tag = 'a'
                          assign row_href = cart_root | append: row_variant
                          unless row_variant contains ':'
                            assign row_href = row_href | append: ':1'
                          endunless
                          if block.settings.discount_code != blank
                            assign row_href = row_href | append: '?discount=' | append: block.settings.discount_code
                          endif
                        endif
                      endif
                    -%}

                    {% if block.settings.variants_as_radio and row_href != blank %}
                      {%- if forloop.index == default_row -%}
                        {%- assign choice_href = row_href -%}
                      {%- endif -%}
                      <label class="lp-plan__variant lp-plan__variant--choice">
                        <input
                          class="lp-plan__radio"
                          type="radio"
                          name="lp-plan-choice-{{ block.id }}"
                          value="{{ row_href }}"
                          {% if forloop.index == default_row %}checked{% endif %}
                        >
                        <span class="lp-plan__mark" aria-hidden="true"></span>
                        <span class="lp-plan__variant-name">{{ parts[0] | strip }}</span>
                        <span class="lp-plan__price">{{ parts[1] | strip }}</span>
                      </label>
                    {% else %}
                      <{{ row_tag }}
                        class="lp-plan__variant{% if row_tag == 'a' %} lp-plan__variant--link{% endif %}"
                        {% if row_tag == 'a' %}href="{{ row_href }}"{% endif %}
                      >
                        <span>{{ parts[0] | strip }}</span>
                        <span class="lp-plan__price">{{ parts[1] | strip }}</span>
                      </{{ row_tag }}>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if lp_live %}
              <div class="lp-plan__stack">
                {% if lp_comp1 != blank %}
                  <div class="lp-plan__row">
                    <span>
                      {%- render 'lp-icon', name: block.settings.component_1_icon -%}
                      {{ block.settings.component_1_label | default: lp_comp1.title }}
                    </span>
                    <span class="lp-plan__value">{{ lp_c1v.price | money }}</span>
                  </div>
                {% endif %}
                {% if lp_comp2 != blank %}
                  <div class="lp-plan__row">
                    <span>
                      {%- render 'lp-icon', name: block.settings.component_2_icon -%}
                      {{ block.settings.component_2_label | default: lp_comp2.title }}
                    </span>
                    <span class="lp-plan__value">{{ lp_c2v.price | money }}</span>
                  </div>
                {% endif %}
                {% if lp_gift1 != blank %}
                  <div class="lp-plan__row">
                    <span>
                      {%- render 'lp-icon', name: block.settings.gift_1_icon -%}
                      {%- if lp_g1_qty > 1 -%}{{ lp_g1_qty }}&times; {% endif -%}
                      {{ block.settings.gift_1_label | default: lp_gift1.title }}
                    </span>
                    <span class="lp-plan__free">
                      <s>{{- lp_g1_value | money -}}</s>{{ block.settings.free_word }}
                    </span>
                  </div>
                {% endif %}
                {% if lp_gift2 != blank %}
                  <div class="lp-plan__row">
                    <span>
                      {%- render 'lp-icon', name: block.settings.gift_2_icon -%}
                      {%- if lp_g2_qty > 1 -%}{{ lp_g2_qty }}&times; {% endif -%}
                      {{ block.settings.gift_2_label | default: lp_gift2.title }}
                    </span>
                    <span class="lp-plan__free">
                      <s>{{- lp_g2_value | money -}}</s>{{ block.settings.free_word }}
                    </span>
                  </div>
                {% endif %}
                {% if block.settings.show_free_shipping %}
                  <div class="lp-plan__row">
                    <span>
                      {%- render 'lp-icon', name: block.settings.shipping_icon -%}
                      {{ block.settings.shipping_label }}
                    </span>
                    <span class="lp-plan__free">
                      {%- if block.settings.shipping_compare != blank -%}
                        <s>{{ block.settings.shipping_compare }}</s>
                      {%- endif -%}
                      {{ block.settings.free_word }}
                    </span>
                  </div>
                {% endif %}
              </div>
            {% elsif block.settings.stack != blank %}
              <div class="lp-plan__stack">
                {%- assign stack_lines = block.settings.stack | strip | newline_to_br | split: '<br />' -%}
                {% for line in stack_lines %}
                  {%- assign parts = line | split: '|' -%}
                  {% if parts.size > 1 %}
                    <div class="lp-plan__row">
                      <span>{{ parts[0] | strip }}</span>
                      {% if parts.size > 2 %}
                        <span class="lp-plan__free">
                          <s>{{- parts[1] | strip -}}</s>{{ parts[2] | strip }}
                        </span>
                      {% else %}
                        <span class="lp-plan__value">{{ parts[1] | strip }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if lp_live and lp_anchor > lp_final %}
              <div class="lp-plan__total">
                <span>{{ block.settings.total_label }}</span>
                <span><s>{{ lp_anchor | money }}</s></span>
              </div>
            {% elsif block.settings.total_value != blank %}
              <div class="lp-plan__total">
                <span>{{ block.settings.total_label }}</span>
                <span><s>{{ block.settings.total_value }}</s></span>
              </div>
            {% endif %}

            {% if lp_live and block.settings.variants_from_product %}
              {%- comment -%}
                Harga sudah tertera pada tiap pilihan varian, jadi baris harga
                tunggal di sini hanya akan bertentangan dengan pilihan aktif.
              {%- endcomment -%}
            {% elsif lp_live %}
              <div class="lp-plan__now">
                <span>{{ block.settings.price_label }}</span>
                <span class="lp-plan__price">{{ lp_final | money }}</span>
              </div>
            {% elsif block.settings.price != blank %}
              <div class="lp-plan__now">
                <span>{{ block.settings.price_label }}</span>
                <span class="lp-plan__price">{{ block.settings.price }}</span>
              </div>
            {% endif %}

            {% if lp_live and block.settings.days > 0 %}
              <p class="lp-plan__perday">
                {{- block.settings.per_day_label }}
                {{ lp_final | divided_by: block.settings.days | money -}}
              </p>
            {% elsif block.settings.per_day != blank %}
              <p class="lp-plan__perday">{{ block.settings.per_day }}</p>
            {% endif %}

            {% if lp_live and lp_gift_total > 0 %}
              <p class="lp-plan__giftvalue">
                {{- block.settings.gift_value_label }} {{ lp_gift_total | money -}}
              </p>
            {% endif %}

            {% if block.settings.guarantee != blank or block.settings.guarantee_marker != blank %}
              <p class="lp-plan__guarantee-line">
                {%- if block.settings.guarantee_marker != blank -%}
                  <strong>{{ block.settings.guarantee_marker }}</strong>
                {%- endif -%}
                {{ block.settings.guarantee }}
              </p>
            {% endif %}

            <div class="lp-plan__footer">
              {% if block.settings.cta_label != blank %}
                {%- liquid
                  assign plan_href = block.settings.cta_url | default: '#'
                  if choice_href != blank
                    assign plan_href = choice_href
                  elsif lp_live
                    assign lp_line = lp_cart_line
                    if lp_line contains ','
                      assign lp_line = lp_line | split: ',' | reverse | join: ','
                    endif
                    assign plan_href = cart_root | append: lp_line
                    if block.settings.discount_code != blank
                      assign plan_href = plan_href | append: '?discount=' | append: block.settings.discount_code
                    endif
                  elsif block.settings.variant_id != blank
                    assign qty = block.settings.quantity | default: 1
                    assign cart_path = block.settings.variant_id
                    unless cart_path contains ':'
                      assign cart_path = cart_path | append: ':' | append: qty
                    endunless
                    # Permalink keranjang membangun baris dari belakang ke depan,
                    # jadi daftarnya dibalik supaya produk utama tetap paling atas
                    # di halaman checkout — merchant menulisnya dalam urutan wajar.
                    if cart_path contains ','
                      assign cart_path = cart_path | split: ',' | reverse | join: ','
                    endif
                    assign plan_href = cart_root | append: cart_path
                    if block.settings.discount_code != blank
                      assign plan_href = plan_href | append: '?discount=' | append: block.settings.discount_code
                    endif
                  endif
                -%}
                <a
                  class="lp-btn{% if block.settings.featured %} lp-btn--gold{% endif %} lp-plan__cta"
                  href="{{ plan_href }}"
                  {% if choice_href != blank %}data-lp-plan-cta{% endif %}
                >
                  {{- block.settings.cta_label -}}
                </a>
              {% endif %}

              {% if block.settings.footer_note != blank %}
                <p class="lp-plan__note">{{ block.settings.footer_note }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.pledge_text != blank %}
      <div class="lp-pledge">
        {% if section.settings.pledge_icon != blank %}
          <div class="lp-pledge__icon" aria-hidden="true">{{ section.settings.pledge_icon }}</div>
        {% endif %}
        <div>
          {% if section.settings.pledge_title != blank %}
            <strong>{{ section.settings.pledge_title }}</strong>
          {% endif %}
          {{ section.settings.pledge_text }}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Dikirim inline karena bundle compiled_assets tema ini sempat berhenti
  diperbarui, sehingga aturan baru tidak pernah sampai ke pengunjung.
{%- endcomment -%}

{% style %}
  .lp-pricing .lp-pricing__cards {
    grid-template-columns: repeat(var(--lp-plan-count, 3), minmax(0, 1fr));
    max-width: min(1140px, calc(var(--lp-plan-count, 3) * 380px));
  }

  .lp-pricing .lp-plan__variant .lp-plan__price {
    flex: 0 0 auto;
    margin-left: 0.75rem;
    white-space: nowrap;
  }

  .lp-pricing .lp-plan__giftvalue {
    margin: -0.5rem 0 1rem;
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
  }

  @media screen and (max-width: 900px) {
    .lp-pricing .lp-pricing__cards {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      max-width: 560px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .lp-pricing {
    background: var(--lp-cream);
    scroll-margin-top: calc(var(--lp-urgency-height, 0px) + 1.5rem);
  }

  .lp-pricing .lp-pricing__eyebrow,
  .lp-pricing .lp-pricing__heading,
  .lp-pricing__urgency,
  .lp-pricing__scarcity {
    text-align: center;
  }

  .lp-pricing .lp-pricing__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-pricing .lp-pricing__heading {
    margin-bottom: 0.5rem;
  }

  .lp-pricing__urgency {
    margin-bottom: 2.5rem;
  }

  .lp-pricing__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    background: var(--lp-forest-deep);
    color: var(--lp-on-dark);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .lp-pricing__timer {
    display: inline-flex;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .lp-pricing__timer span {
    padding: 0.1rem 0.35rem;
    border-radius: 2px;
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .lp-pricing__scarcity-note {
    color: var(--lp-text-light);
    font-weight: 400;
  }

  .lp-pricing__scarcity {
    margin: 0 0 2rem;
    color: var(--lp-alert);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lp-pricing__quote {
    max-width: 440px;
    margin: 0 auto 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-style: italic;
    text-align: center;
  }

  .lp-pricing__quote span {
    color: var(--lp-text-light);
    font-size: 0.8125rem;
    font-style: normal;
  }

  .lp-pricing__cards {
    display: grid;
    grid-template-columns: repeat(var(--lp-plan-count, 3), minmax(0, 1fr));
    gap: 1.25rem;
    max-width: min(1140px, calc(var(--lp-plan-count, 3) * 380px));
    margin-inline: auto;
  }

  @media screen and (max-width: 900px) {
    .lp-pricing__cards {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
      max-width: 560px;
    }
  }

  .lp-plan {
    display: flex;
    position: relative;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
  }

  .lp-plan--featured {
    border-color: var(--lp-gold);
  }

  .lp-plan__tag {
    padding: 0.4rem;
    background: var(--lp-surface-dark);
    color: var(--lp-on-dark);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .lp-plan__tag--gold {
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
  }

  .lp-plan__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.5rem;
  }

  .lp-plan__title {
    margin-bottom: 0.25rem;
    color: var(--lp-forest);
    font-family: var(--lp-font-display);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .lp-plan__desc {
    margin: 0 0 1rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .lp-plan__variants {
    margin-bottom: 1rem;
  }

  .lp-plan__variant {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--lp-border);
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.875rem;
  }

  .lp-plan__variant:last-child {
    border-bottom: none;
  }

  .lp-pricing .lp-plan__variant--link {
    color: var(--lp-text);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .lp-pricing .lp-plan__variant--link:hover {
    background: color-mix(in srgb, var(--lp-gold) 12%, transparent);
  }

  .lp-pricing .lp-plan__variant--link:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  .lp-plan__variants--choice {
    display: grid;
    gap: 0.5rem;
  }

  .lp-pricing .lp-plan__variant--choice {
    gap: 0.65rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--lp-border);
    border-bottom: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-md, 10px);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .lp-plan__variant-name {
    flex: 1 1 auto;
    min-width: 0;
  }

  .lp-plan__variant .lp-plan__price {
    flex: 0 0 auto;
    margin-left: 0.75rem;
    white-space: nowrap;
  }

  .lp-plan__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lp-plan__mark {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border: 2px solid var(--lp-border);
    border-radius: 50%;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .lp-pricing .lp-plan__variant--choice:hover {
    border-color: var(--lp-gold);
  }

  .lp-pricing .lp-plan__variant--choice:has(.lp-plan__radio:checked) {
    border-color: var(--lp-gold);
    background: color-mix(in srgb, var(--lp-gold) 12%, transparent);
  }

  .lp-plan__variant--choice:has(.lp-plan__radio:checked) .lp-plan__mark {
    border-color: var(--lp-gold);
    box-shadow: inset 0 0 0 4px var(--lp-gold);
  }

  .lp-plan__variant--choice:has(.lp-plan__radio:focus-visible) {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-pricing .lp-plan__variant--choice,
    .lp-plan__mark {
      transition: none;
    }
  }

  .lp-plan__stack {
    margin-bottom: 1rem;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--lp-border);
    border-radius: var(--lp-radius);
  }

  .lp-plan__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--lp-border);
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__row:last-child {
    border-bottom: none;
  }

  .lp-plan__row > span:first-child {
    flex: 1;
    min-width: 0;
  }

  /* Ikon disejajarkan ke baris teksnya, bukan ke tengah kotak: baris ini
     memakai align-items baseline, jadi SVG yang dibiarkan inline akan
     "menggantung" sedikit terlalu rendah. translateY kecil mengembalikannya
     ke garis mata. Ukurannya dikunci supaya nama hadiah yang panjang tidak
     pernah menggencet ikonnya. */
  .lp-plan__row .lp-icon {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
    margin-right: 0.5rem;
    vertical-align: -0.22em;
    opacity: 0.72;
  }

  .lp-plan--featured .lp-plan__row .lp-icon {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .lp-plan__row .lp-icon {
      width: 15px;
      height: 15px;
      margin-right: 0.4rem;
    }
  }

  .lp-plan__value {
    white-space: nowrap;
  }

  .lp-plan__free {
    color: var(--lp-forest);
    font-weight: 700;
    white-space: nowrap;
  }

  .lp-plan__free s {
    margin-right: 0.3rem;
    color: var(--lp-text-light);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .lp-plan__total,
  .lp-plan__now {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__total {
    margin-bottom: 0.35rem;
    color: var(--lp-text-mid);
  }

  .lp-plan__total s {
    color: var(--lp-text-light);
  }

  .lp-plan__now {
    margin-bottom: 1rem;
    color: var(--lp-forest);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .lp-plan__price {
    color: var(--lp-forest);
    font-weight: 700;
  }

  .lp-plan__now .lp-plan__price {
    font-size: 1.125rem;
  }

  .lp-plan__perday {
    margin: -0.75rem 0 1rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    text-align: right;
  }

  .lp-plan__giftvalue {
    margin: -0.5rem 0 1rem;
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: right;
  }

  .lp-plan__guarantee-line {
    margin: 0 0 1rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-plan__footer {
    margin-top: auto;
  }

  .lp-pricing .lp-plan__cta {
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0.85rem 1.5rem;
    font-size: 0.875rem;
  }

  .lp-plan__note {
    margin: 0;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    text-align: center;
  }

  .lp-pledge {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 560px;
    margin: 2rem auto 0;
    padding: 1.1rem 1.25rem;
    border: 1.5px solid var(--lp-gold);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .lp-pledge__icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .lp-pledge strong {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--lp-text);
  }

  @media screen and (max-width: 820px) {
    .lp-pricing__cards {
      display: flex;
      overflow-x: auto;
      max-width: none;
      gap: 1rem;
      padding-inline: 0.25rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .lp-pricing__cards::-webkit-scrollbar {
      display: none;
    }

    .lp-plan {
      flex: 0 0 92%;
      min-width: 0;
      scroll-snap-align: start;
    }

    .lp-plan__row {
      gap: 0.5rem;
      padding: 0.35rem 0;
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function bind(group) {
      if (group.dataset.lpChoiceBound === 'true') return;
      var plan = group.closest('.lp-plan');
      if (!plan) return;
      var cta = plan.querySelector('[data-lp-plan-cta]');
      if (!cta) return;

      group.dataset.lpChoiceBound = 'true';

      group.addEventListener('change', function (event) {
        var radio = event.target;
        if (!radio || radio.type !== 'radio' || !radio.value) return;
        cta.setAttribute('href', radio.value);
      });

      var checked = group.querySelector('.lp-plan__radio:checked');
      if (checked && checked.value) cta.setAttribute('href', checked.value);
    }

    // Permalink keranjang membuat keranjang baru, jadi atribut apa pun yang
    // dipasang sebelum pindah halaman akan ikut terhapus. Penanda dititipkan di
    // sessionStorage lebih dulu, lalu snippet lp-only-guard menukarnya menjadi
    // atribut keranjang setelah pembeli mendarat di /cart.
    function stampSource() {
      var handle = (window.location.pathname.split('/pages/')[1] || '').split(/[/?#]/)[0];
      if (!handle) return;

      document.querySelectorAll('.lp-plan__cta').forEach(function (cta) {
        if (cta.dataset.lpStamped === 'true') return;
        cta.dataset.lpStamped = 'true';
        cta.addEventListener('click', function () {
          try {
            sessionStorage.setItem('lp_source', handle);
          } catch (e) {
            /* mode privat: penegakan sisi server tetap menjaga */
          }
        });
      });
    }

    function start() {
      document.querySelectorAll('[data-lp-plan-choice]').forEach(bind);
      stampSource();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

