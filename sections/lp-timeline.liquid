<div class="lp-timeline lp-pad">
  <div class="lp-container lp-reveal">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-timeline__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-timeline__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="lp-timeline__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <ol class="lp-timeline__list" data-tl-token="IOTLTEST1785894539">
      {% for block in section.blocks %}
        <li class="lp-timeline__item lp-reveal" {{ block.shopify_attributes }}>
          <div class="lp-timeline__marker" aria-hidden="true">
            {% if block.settings.emoji != blank %}
              <span class="lp-timeline__icon">{{ block.settings.emoji }}</span>
            {% endif %}
          </div>
          <div class="lp-timeline__content">
            {% if block.settings.period != blank %}
              <p class="lp-timeline__period">{{ block.settings.period }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <p class="lp-timeline__title">{{ block.settings.title }}</p>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="lp-timeline__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ol>

    {% if section.settings.cta_label != blank %}
      <div class="lp-timeline__cta">
        <a class="lp-btn" href="{{ section.settings.cta_url | default: '#' }}">
          {{- section.settings.cta_label -}}
        </a>
        {% if section.settings.cta_note != blank %}
          <p class="lp-note">{{ section.settings.cta_note }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .lp-timeline {
    background: var(--lp-cream);
  }

  .lp-timeline .lp-timeline__eyebrow,
  .lp-timeline .lp-timeline__heading,
  .lp-timeline__sub {
    text-align: center;
  }

  .lp-timeline .lp-timeline__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-timeline .lp-timeline__heading {
    margin-bottom: 3rem;
  }

  .lp-timeline__sub {
    max-width: 520px;
    margin: 0.75rem auto 0;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
  }

  .lp-timeline__list {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .lp-timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 1.25rem;
    padding-bottom: 2.25rem;
  }

  .lp-timeline__item:last-child {
    padding-bottom: 0;
  }

  .lp-timeline__marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .lp-timeline__marker::before {
    content: '';
    position: absolute;
    top: 48px;
    bottom: -2.25rem;
    left: 50%;
    width: 1px;
    background: var(--lp-border);
    transform: translateX(-50%);
  }

  .lp-timeline__item:last-child .lp-timeline__marker::before {
    display: none;
  }

  .lp-timeline__icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex: none;
    border: 1px solid var(--lp-border);
    border-radius: 50%;
    background: var(--lp-cream);
    font-size: 1.15rem;
    line-height: 1;
    opacity: 0;
    transform: scale(0.6);
    transition: transform 0.5s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s 0.1s ease;
  }

  .lp-timeline__item.is-visible .lp-timeline__icon {
    opacity: 1;
    transform: none;
  }

  .lp-timeline__content {
    padding-top: 0.35rem;
  }

  .lp-timeline__content p {
    margin: 0;
  }

  .lp-timeline__period {
    margin-bottom: 0.4rem !important;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lp-timeline__title {
    margin-bottom: 0.3rem !important;
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .lp-timeline__text {
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .lp-timeline__item {
      grid-template-columns: 40px 1fr;
      gap: 1rem;
    }

    .lp-timeline__icon {
      width: 40px;
      height: 40px;
      font-size: 1rem;
    }

    .lp-timeline__marker::before {
      top: 40px;
    }
  }

  .lp-timeline__cta {
    margin-top: 2rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-timeline__icon {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "LP · Timeline",
  "tag": "section",
  "class": "lp-timeline-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Perjalanan Menopause"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Apa yang Akan Dirasakan Selama Protokol"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Deskripsi"
    },
    {
      "type": "header",
      "content": "Tombol"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol",
      "default": "Mulai Transformasi"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Catatan di bawah tombol",
      "default": "Garansi Uang Kembali 30 Hari · Gratis Ongkir"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Tahap",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "period",
          "label": "Periode",
          "default": "Minggu 1"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Judul tebal",
          "default": "Energi mulai terangkat."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Deskripsi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Timeline",
      "blocks": [
        { "type": "milestone" },
        { "type": "milestone" },
        { "type": "milestone" }
      ]
    }
  ]
}
{% endschema %}
