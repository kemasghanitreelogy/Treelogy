<div class="lp-hero">
  <div class="lp-hero__inner">
    <div class="lp-hero__copy">
      {% if section.settings.badge != blank %}
        <div class="lp-hero__badge">{{ section.settings.badge }}</div>
      {% endif %}

      {% if section.settings.pre_heading != blank %}
        <div class="lp-hero__pre">{{ section.settings.pre_heading }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="lp-h1 lp-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="lp-hero__sub">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="lp-btn lp-hero__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{- section.settings.cta_label -}}
        </a>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="lp-hero__proof">
          {% for block in section.blocks %}
            <div class="lp-hero__proof-item" {{ block.shopify_attributes }}>
              {% if block.settings.highlight != blank %}
                <strong>{{ block.settings.highlight }}</strong>
              {% endif %}
              {{ block.settings.text }}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="lp-hero__visual">
      <div class="lp-hero__frame">
        {% if section.settings.show_save_badge %}
          <div class="lp-hero__save">
            {{ section.settings.save_prefix }}
            <strong>{{ section.settings.save_amount }}</strong>
            {{ section.settings.save_suffix }}
          </div>
        {% endif %}

        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'lp-hero__img',
              widths: '380, 560, 760, 900',
              sizes: '(max-width: 768px) 280px, 380px',
              alt: section.settings.image.alt
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'lp-hero__img lp-placeholder' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-hero {
    background: var(--lp-cream);
    padding: 4.5rem 0 3.5rem;
    overflow: hidden;
  }

  .lp-hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    width: 100%;
    max-width: var(--lp-max-w);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .lp-hero__badge {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 0.4rem 1rem;
    border-radius: 2px;
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-hero__pre {
    margin-bottom: 0.25rem;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lp-hero__heading {
    margin-bottom: 1.25rem;
  }

  .lp-hero__sub {
    max-width: 540px;
    margin: 0 0 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .lp-hero__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-hero__proof-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lp-hero__proof-item strong {
    color: var(--lp-forest);
    font-weight: 700;
  }

  .lp-hero__visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lp-hero__frame {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
  }

  .lp-hero__frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px solid var(--lp-gold);
    border-radius: calc(var(--lp-radius-lg) - 3px);
    opacity: 0.25;
    pointer-events: none;
  }

  .lp-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--lp-radius-lg);
    object-fit: cover;
  }

  .lp-hero__save {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--lp-gold);
    box-shadow: 0 4px 14px rgb(0 0 0 / 18%);
    color: var(--lp-forest-deep);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transform: rotate(8deg);
  }

  .lp-hero__save strong {
    font-size: 0.8125rem;
    font-weight: 800;
  }

  @media screen and (max-width: 768px) {
    .lp-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lp-hero__visual {
      order: -1;
    }

    .lp-hero__frame {
      max-width: 280px;
    }

    .lp-hero__sub {
      margin-inline: auto;
    }

    .lp-hero__proof {
      justify-content: center;
    }

    .lp-hero__cta {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Hero",
  "tag": "section",
  "class": "lp-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Dukungan Menopause · Offer Terbatas"
    },
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Teks pembuka",
      "default": "Jangan Lagi Pasrah Pada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Nyeri Sendi, Mudah Lelah, dan Rasa Kehilangan Diri Saat Menopause"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Deskripsi",
      "default": "Inside Out Moringa Protocol. Cara perempuan Indonesia mendapatkan kembali sendi yang nyaman, energi, tidur nyenyak, dan rasa percaya diri. Tanpa hormon. Tanpa resep dokter."
    },
    {
      "type": "header",
      "content": "Tombol"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol",
      "default": "Mulai Protokol"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "header",
      "content": "Gambar"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Gambar produk"
    },
    {
      "type": "header",
      "content": "Badge hemat"
    },
    {
      "type": "checkbox",
      "id": "show_save_badge",
      "label": "Tampilkan badge hemat",
      "default": true
    },
    {
      "type": "text",
      "id": "save_prefix",
      "label": "Baris atas",
      "default": "Hemat hingga"
    },
    {
      "type": "text",
      "id": "save_amount",
      "label": "Nominal",
      "default": "Rp 464.500"
    },
    {
      "type": "text",
      "id": "save_suffix",
      "label": "Baris bawah",
      "default": "Hari Ini"
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Bukti sosial",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "highlight",
          "label": "Teks tebal"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Teks",
          "default": "Pelanggan Puas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Hero",
      "blocks": [
        { "type": "proof" },
        { "type": "proof" },
        { "type": "proof" },
        { "type": "proof" }
      ]
    }
  ]
}
{% endschema %}
