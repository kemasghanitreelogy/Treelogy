<div class="lp-hero">
  <div class="lp-hero__inner">
    <div class="lp-hero__copy">
      {% if section.settings.badge != blank %}
        <div class="lp-hero__badge">{{ section.settings.badge }}</div>
      {% endif %}

      {% if section.settings.pre_heading != blank %}
        <div class="lp-hero__pre">{{ section.settings.pre_heading }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="lp-h1 lp-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="lp-hero__sub">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="lp-hero__offer" data-lp-offer>
        {% if section.settings.offer_includes != blank %}
          <p class="lp-hero__includes">{{ section.settings.offer_includes }}</p>
        {% endif %}

        {% if section.settings.offer_plan != blank %}
          <p class="lp-hero__plan">{{ section.settings.offer_plan }}</p>
        {% endif %}

        {% if section.settings.offer_price != blank %}
          <p class="lp-hero__price">{{ section.settings.offer_price }}</p>
        {% endif %}

        {% if section.settings.offer_perday != blank %}
          <p class="lp-hero__perday">{{ section.settings.offer_perday }}</p>
        {% endif %}

        {% if section.settings.show_savings and section.settings.savings_text != blank %}
          <p class="lp-hero__savings">{{ section.settings.savings_text }}</p>
        {% endif %}

        {% if section.settings.cta_label != blank %}
          <a class="lp-btn lp-hero__cta" href="{{ section.settings.cta_url | default: '#' }}">
            {{- section.settings.cta_label -}}
          </a>
        {% endif %}

        {% if section.settings.offer_note != blank %}
          <p class="lp-hero__offer-note">{{ section.settings.offer_note }}</p>
        {% endif %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="lp-hero__proof">
          {% for block in section.blocks %}
            {%- liquid
              assign proof_tag = 'div'
              if block.settings.link_url != blank
                assign proof_tag = 'a'
              endif
            -%}
            <{{ proof_tag }}
              class="lp-hero__proof-item{% if block.settings.link_url != blank %} lp-hero__proof-item--link{% endif %}"
              {% if block.settings.link_url != blank %}
                href="{{ block.settings.link_url }}"
                {% if block.settings.link_label != blank %}aria-label="{{ block.settings.link_label }}"{% endif %}
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.prefix != blank %}
                <span>{{ block.settings.prefix }}</span>
              {% endif %}
              {% if block.settings.highlight != blank %}
                <strong class="lp-hero__count" data-lp-count="{{ block.settings.highlight | escape }}">
                  {{- block.settings.highlight -}}
                </strong>
              {% endif %}
              {{ block.settings.text }}
            </{{ proof_tag }}>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {%- assign gallery = section.blocks | where: 'type', 'media' -%}
    <div class="lp-hero__visual">
      <div class="lp-hero__frame">

        {% if gallery.size > 0 %}
          <div class="lp-hero__stack" data-lp-gallery>
            {% for block in gallery %}
              <div
                class="lp-hero__slide{% if forloop.first %} is-active{% endif %}"
                data-lp-slide="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.image %}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'lp-hero__img',
                      widths: '380, 560, 760, 900',
                      sizes: '(max-width: 768px) 280px, 380px',
                      loading: 'eager',
                      alt: block.settings.alt | default: block.settings.image.alt
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'lp-hero__img lp-placeholder' }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% elsif section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'lp-hero__img',
              widths: '380, 560, 760, 900',
              sizes: '(max-width: 768px) 280px, 380px',
              alt: section.settings.image.alt
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'lp-hero__img lp-placeholder' }}
        {% endif %}
      </div>

      {% if gallery.size > 1 %}
        <div class="lp-hero__thumbs" role="tablist" aria-label="{{ section.settings.gallery_label }}">
          {% for block in gallery %}
            <button
              type="button"
              role="tab"
              class="lp-hero__thumb{% if forloop.first %} is-active{% endif %}"
              data-lp-thumb="{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ block.settings.alt | default: forloop.index }}"
            >
              {% if block.settings.image %}
                {{
                  block.settings.image
                  | image_url: width: 180
                  | image_tag: widths: '90, 180', sizes: '64px', loading: 'lazy', alt: ''
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'lp-placeholder' }}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-hero {
    background: var(--lp-cream);
    padding: 4.5rem 0 3.5rem;
    overflow: clip;
  }

  .lp-hero__copy,
  .lp-hero__visual {
    min-width: 0;
    max-width: 100%;
  }

  .lp-hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    width: 100%;
    max-width: var(--lp-max-w);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .lp-hero__badge {
    display: inline-block;
    max-width: 100%;
    margin-bottom: 1.25rem;
    padding: 0.4rem 1rem;
    border-radius: 2px;
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-hero__pre {
    margin-bottom: 0.25rem;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lp-hero .lp-hero__heading {
    margin-bottom: 1.25rem;
  }

  .lp-hero__sub {
    max-width: 540px;
    margin: 0 0 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .lp-hero__offer {
    margin-bottom: 2rem;
    font-family: var(--lp-font-body);
  }

  .lp-hero__includes {
    margin: 0 0 0.75rem;
    color: var(--lp-text-mid);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .lp-hero__plan {
    margin: 0 0 0.35rem;
    color: var(--lp-text-mid);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-hero__price {
    margin: 0;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: clamp(1.75rem, 4vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    transform-origin: left center;
  }

  .lp-hero__perday {
    margin: 0.35rem 0 0;
    color: var(--lp-text-mid);
    font-size: 1rem;
  }

  .lp-hero__savings {
    margin: 0.5rem 0 0;
    color: var(--lp-text-mid);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .lp-hero__offer .lp-hero__cta {
    margin-top: 1.25rem;
  }

  .lp-hero__offer-note {
    margin: 0.75rem 0 0;
    color: var(--lp-text-light);
    font-size: 0.875rem;
  }

  .lp-hero__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-hero__proof-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lp-hero__count {
    display: inline-flex;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }

  .lp-hero__count-value {
    display: inline-block;
    text-align: right;
    transform-origin: left center;
  }

  .lp-hero__count-suffix {
    display: inline-block;
  }

  .lp-hero__proof-item--link {
    border-bottom: 1px solid transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lp-hero__proof-item--link:hover {
    border-bottom-color: currentcolor;
    color: var(--lp-forest);
  }

  .lp-hero__proof-item--link:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 4px;
  }

  .lp-hero__proof-item strong {
    color: var(--lp-forest);
    font-weight: 700;
  }

  .lp-hero__visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .lp-hero__stack {
    display: grid;
    width: 100%;
    height: 100%;
  }

  .lp-hero__slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
  }

  .lp-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .lp-hero__thumbs {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
    max-width: min(380px, 100%);
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .lp-hero__thumbs::-webkit-scrollbar {
    display: none;
  }

  .lp-hero__thumb {
    flex: 0 0 64px;
    overflow: hidden;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1.5px solid var(--lp-border);
    border-radius: var(--lp-radius);
    background: var(--lp-surface);
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.65;
  }

  .lp-hero__thumb img,
  .lp-hero__thumb svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lp-hero__thumb:hover {
    opacity: 1;
  }

  .lp-hero__thumb.is-active {
    border-color: var(--lp-gold);
    opacity: 1;
  }

  .lp-hero__thumb:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 2px;
  }

  .lp-hero__frame {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
  }

  .lp-hero__frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px solid var(--lp-gold);
    border-radius: calc(var(--lp-radius-lg) - 3px);
    opacity: 0.25;
    pointer-events: none;
  }

  .lp-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--lp-radius-lg);
    object-fit: cover;
  }







  @media screen and (max-width: 768px) {

    .lp-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lp-hero__visual {
      order: -1;
    }

    .lp-hero__frame {
      max-width: 280px;
    }

    .lp-hero__sub {
      margin-inline: auto;
    }

    .lp-hero__proof {
      justify-content: center;
    }

    .lp-hero .lp-hero__cta {
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var EASE = 'cubic-bezier(0.2, 0, 0, 1)';
    var BACK = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
    var COUNT_DURATION = 1700;
    var SUFFIX_DURATION = 420;
    var START_SCALE = 0.72;

    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function build(el) {
      var raw = el.dataset.lpCount || el.textContent || '';
      var parsed = raw.trim().match(/^(\D*?)([\d][\d.,\s\u00a0]*)(.*)$/);
      if (!parsed) return null;

      if (raw.indexOf(',') !== -1) return null;
      var digits = parsed[2].replace(/\D/g, '');
      var target = parseInt(digits, 10);
      if (!isFinite(target) || target < 1000) return null;

      el.textContent = '';
      if (parsed[1]) el.appendChild(document.createTextNode(parsed[1]));

      var value = document.createElement('span');
      value.className = 'lp-hero__count-value';
      value.textContent = target.toLocaleString('id-ID');
      el.appendChild(value);

      var suffix = null;
      if (parsed[3]) {
        suffix = document.createElement('span');
        suffix.className = 'lp-hero__count-suffix';
        suffix.textContent = parsed[3];
        el.appendChild(suffix);
      }

      return { value: value, suffix: suffix, target: target };
    }

    function run(parts) {
      var value = parts.value;
      var target = parts.target;
      var final = target.toLocaleString('id-ID');

      value.style.minWidth = value.getBoundingClientRect().width + 'px';

      if (reducedMotion()) {
        value.textContent = final;
        return;
      }

      value.textContent = '0';
      if (parts.suffix) parts.suffix.style.opacity = '0';

      var growth = value.animate(
        [{ transform: 'scale(' + START_SCALE + ')' }, { transform: 'scale(1)' }],
        { duration: COUNT_DURATION, easing: EASE, fill: 'both' }
      );

      function tick() {
        var timing = growth.effect.getComputedTiming();
        var progress = timing.progress;
        if (progress === null || growth.playState === 'finished') {
          value.textContent = final;
          growth.cancel();
          return;
        }
        value.textContent = Math.round(target * progress).toLocaleString('id-ID');
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      if (parts.suffix) {
        var suffix = parts.suffix;
        var reveal = suffix.animate(
          [
            { opacity: 0, transform: 'translateY(14px)' },
            { opacity: 1, transform: 'none' }
          ],
          { duration: SUFFIX_DURATION, delay: COUNT_DURATION, easing: BACK, fill: 'both' }
        );
        reveal.finished.then(function () {
          reveal.cancel();
          suffix.style.opacity = '';
        }).catch(function () {});
      }
    }

    function init(el) {
      if (el.dataset.lpCountBound === 'true') return;
      el.dataset.lpCountBound = 'true';

      var parts = build(el);
      if (!parts) return;

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          run(parts);
        });
      }, { threshold: 0.6 });

      observer.observe(el);
    }

    function initGallery(root) {
      var stack = root.querySelector('[data-lp-gallery]');
      if (!stack || stack.dataset.lpGalleryBound === 'true') return;
      stack.dataset.lpGalleryBound = 'true';

      var slides = Array.prototype.slice.call(stack.querySelectorAll('[data-lp-slide]'));
      var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-lp-thumb]'));
      if (slides.length < 2 || !thumbs.length) return;

      var current = 0;

      function show(index) {
        if (index === current || index < 0 || index >= slides.length) return;

        var from = slides[current];
        var to = slides[index];
        current = index;

        thumbs.forEach(function (thumb, i) {
          thumb.classList.toggle('is-active', i === index);
          thumb.setAttribute('aria-selected', i === index ? 'true' : 'false');
        });

        if (reducedMotion()) {
          from.classList.remove('is-active');
          to.classList.add('is-active');
          return;
        }

        to.classList.add('is-active');
        to.animate(
          [
            { opacity: 0, transform: 'scale(1.03)' },
            { opacity: 1, transform: 'none' }
          ],
          { duration: 380, easing: EASE, fill: 'both' }
        ).finished.then(function () {
          to.getAnimations().forEach(function (a) { a.cancel(); });
        }).catch(function () {});

        var out = from.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 260, easing: EASE, fill: 'both' }
        );
        out.finished.then(function () {
          from.classList.remove('is-active');
          out.cancel();
        }).catch(function () {});
      }

      thumbs.forEach(function (thumb, index) {
        thumb.addEventListener('click', function () {
          show(index);
        });
        thumb.addEventListener('keydown', function (event) {
          var next = null;
          if (event.key === 'ArrowRight') next = index + 1;
          if (event.key === 'ArrowLeft') next = index - 1;
          if (next === null) return;
          event.preventDefault();
          next = (next + thumbs.length) % thumbs.length;
          thumbs[next].focus();
          show(next);
        });
      });
    }

    function initOffer(group) {
      if (group.dataset.lpOfferBound === 'true') return;
      group.dataset.lpOfferBound = 'true';
      if (reducedMotion()) return;

      var price = group.querySelector('.lp-hero__price');

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          observer.disconnect();

          group.animate(
            [
              { opacity: 0, transform: 'translateY(12px)' },
              { opacity: 1, transform: 'none' }
            ],
            { duration: 520, easing: EASE, fill: 'both' }
          ).finished.then(function () {
            group.getAnimations().forEach(function (a) { a.cancel(); });
          }).catch(function () {});

          if (price) {
            price.animate(
              [{ transform: 'scale(0.94)' }, { transform: 'none' }],
              { duration: 520, easing: EASE, fill: 'both' }
            ).finished.then(function () {
              price.getAnimations().forEach(function (a) { a.cancel(); });
            }).catch(function () {});
          }
        });
      }, { threshold: 0.35 });

      observer.observe(group);
    }

    function start() {
      document.querySelectorAll('[data-lp-count]').forEach(init);
      document.querySelectorAll('[data-lp-offer]').forEach(initOffer);
      document.querySelectorAll('.lp-hero__visual').forEach(initGallery);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Hero",
  "tag": "section",
  "class": "lp-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Dukungan Menopause · Offer Terbatas"
    },
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Teks pembuka",
      "default": "Jangan Lagi Pasrah Pada"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Nyeri Sendi, Mudah Lelah, dan Rasa Kehilangan Diri Saat Menopause"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Deskripsi",
      "default": "Inside Out Moringa Protocol. Cara perempuan Indonesia mendapatkan kembali sendi yang nyaman, energi, tidur nyenyak, dan rasa percaya diri. Tanpa hormon. Tanpa resep dokter."
    },
    {
      "type": "header",
      "content": "Penawaran"
    },
    {
      "type": "textarea",
      "id": "offer_includes",
      "label": "Baris \"Termasuk\"",
      "default": "Termasuk: 90 kapsul (30 hari) · Seed Oil 30ml · Pengiriman ke seluruh Indonesia",
      "info": "Sebutkan isinya tanpa harga per item dan tanpa label gratis."
    },
    {
      "type": "text",
      "id": "offer_plan",
      "label": "Nama paket",
      "default": "PROTOKOL INSIDE OUT 30 HARI"
    },
    {
      "type": "text",
      "id": "offer_price",
      "label": "Harga",
      "default": "Rp 795.000"
    },
    {
      "type": "text",
      "id": "offer_perday",
      "label": "Setara per hari",
      "default": "Setara Rp 26.500 per hari"
    },
    {
      "type": "text",
      "id": "offer_note",
      "label": "Catatan di bawah tombol",
      "default": "Garansi 30 hari · Pengiriman ke seluruh Indonesia"
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Tampilkan baris hemat",
      "default": false,
      "info": "Hanya nyalakan bila harga pembanding pernah benar-benar ditawarkan. Untuk Obat Tradisional/Suplemen, klaim potongan harga di iklan dilarang PerBPOM 34/2022 Lampiran I III.1."
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Teks hemat",
      "default": "Hemat Rp 464.500",
      "visible_if": "{{ section.settings.show_savings }}"
    },
    {
      "type": "header",
      "content": "Tombol"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol",
      "default": "Mulai Protokol"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "header",
      "content": "Gambar"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Gambar produk",
      "info": "Dipakai bila belum ada blok Gambar galeri."
    },
    {
      "type": "text",
      "id": "gallery_label",
      "label": "Label galeri",
      "default": "Galeri produk"
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Gambar galeri",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gambar"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Deskripsi gambar",
          "info": "Untuk pembaca layar."
        }
      ]
    },
    {
      "type": "proof",
      "name": "Bukti sosial",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Teks awal"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Teks tebal",
          "info": "Angka bulat 1.000 ke atas otomatis dianimasikan hitung naik dari 0."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Teks",
          "default": "Pelanggan Puas"
        },
        {
          "type": "url",
