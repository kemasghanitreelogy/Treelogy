<div class="lp-hero">
  <div class="lp-hero__inner">
    <div class="lp-hero__copy">
      {% if section.settings.badge != blank %}
        <div class="lp-hero__badge">{{ section.settings.badge }}</div>
      {% endif %}

      {% if section.settings.pre_heading != blank %}
        <div class="lp-hero__pre">{{ section.settings.pre_heading }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="lp-h1 lp-hero__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="lp-hero__sub">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a class="lp-btn lp-hero__cta" href="{{ section.settings.cta_url | default: '#' }}">
          {{- section.settings.cta_label -}}
        </a>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="lp-hero__proof">
          {% for block in section.blocks %}
            {%- liquid
              assign proof_tag = 'div'
              if block.settings.link_url != blank
                assign proof_tag = 'a'
              endif
            -%}
            <{{ proof_tag }}
              class="lp-hero__proof-item{% if block.settings.link_url != blank %} lp-hero__proof-item--link{% endif %}"
              {% if block.settings.link_url != blank %}
                href="{{ block.settings.link_url }}"
                {% if block.settings.link_label != blank %}aria-label="{{ block.settings.link_label }}"{% endif %}
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {% if block.settings.prefix != blank %}
                <span>{{ block.settings.prefix }}</span>
              {% endif %}
              {% if block.settings.highlight != blank %}
                <strong class="lp-hero__count" data-lp-count="{{ block.settings.highlight | escape }}">
                  {{- block.settings.highlight -}}
                </strong>
              {% endif %}
              {{ block.settings.text }}
            </{{ proof_tag }}>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="lp-hero__visual">
      <div class="lp-hero__frame">
        {% if section.settings.show_save_badge %}
          <div class="lp-hero__save">
            {{ section.settings.save_prefix }}
            <strong>{{ section.settings.save_amount }}</strong>
            {{ section.settings.save_suffix }}
          </div>
        {% endif %}

        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              class: 'lp-hero__img',
              widths: '380, 560, 760, 900',
              sizes: '(max-width: 768px) 280px, 380px',
              alt: section.settings.image.alt
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'lp-hero__img lp-placeholder' }}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-hero {
    background: var(--lp-cream);
    padding: 4.5rem 0 3.5rem;
    overflow: hidden;
  }

  .lp-hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
    width: 100%;
    max-width: var(--lp-max-w);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .lp-hero__badge {
    display: inline-block;
    margin-bottom: 1.25rem;
    padding: 0.4rem 1rem;
    border-radius: 2px;
    background: var(--lp-gold);
    color: var(--lp-forest-deep);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lp-hero__pre {
    margin-bottom: 0.25rem;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .lp-hero .lp-hero__heading {
    margin-bottom: 1.25rem;
  }

  .lp-hero__sub {
    max-width: 540px;
    margin: 0 0 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .lp-hero__proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-hero__proof-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .lp-hero__count {
    display: inline-flex;
    align-items: baseline;
    font-variant-numeric: tabular-nums;
  }

  .lp-hero__count-value {
    display: inline-block;
    text-align: right;
    transform-origin: left center;
  }

  .lp-hero__count-suffix {
    display: inline-block;
  }

  .lp-hero__proof-item--link {
    border-bottom: 1px solid transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lp-hero__proof-item--link:hover {
    border-bottom-color: currentcolor;
    color: var(--lp-forest);
  }

  .lp-hero__proof-item--link:focus-visible {
    outline: 2px solid var(--lp-forest);
    outline-offset: 4px;
  }

  .lp-hero__proof-item strong {
    color: var(--lp-forest);
    font-weight: 700;
  }

  .lp-hero__visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lp-hero__frame {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1;
  }

  .lp-hero__frame::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px solid var(--lp-gold);
    border-radius: calc(var(--lp-radius-lg) - 3px);
    opacity: 0.25;
    pointer-events: none;
  }

  .lp-hero__img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--lp-radius-lg);
    object-fit: cover;
  }

  .lp-hero__save {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--lp-gold);
    box-shadow: 0 4px 14px rgb(0 0 0 / 18%);
    color: var(--lp-forest-deep);
    font-family: var(--lp-font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    transform: rotate(8deg);
  }

  .lp-hero__save strong {
    font-size: 0.8125rem;
    font-weight: 800;
  }

  @media screen and (max-width: 768px) {
    .lp-hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lp-hero__visual {
      order: -1;
    }

    .lp-hero__frame {
      max-width: 280px;
    }

    .lp-hero__sub {
      margin-inline: auto;
    }

    .lp-hero__proof {
      justify-content: center;
    }

    .lp-hero .lp-hero__cta {
      width: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var EASE = 'cubic-bezier(0.2, 0, 0, 1)';
    var BACK = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
    var COUNT_DURATION = 1700;
    var SUFFIX_DURATION = 420;
    var START_SCALE = 0.72;

    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function build(el) {
      var raw = el.dataset.lpCount || el.textContent || '';
      var parsed = raw.trim().match(/^(\D*?)([\d][\d.,\s\u00a0]*)(.*)$/);
      if (!parsed) return null;

      if (raw.indexOf(',') !== -1) return null;
      var digits = parsed[2].replace(/\D/g, '');
      var target = parseInt(digits, 10);
      if (!isFinite(target) || target < 1000) return null;

      el.textContent = '';
      if (parsed[1]) el.appendChild(document.createTextNode(parsed[1]));

      var value = document.createElement('span');
      value.className = 'lp-hero__count-value';
      value.textContent = target.toLocaleString('id-ID');
      el.appendChild(value);

      var suffix = null;
      if (parsed[3]) {
        suffix = document.createElement('span');
        suffix.className = 'lp-hero__count-suffix';
        suffix.textContent = parsed[3];
        el.appendChild(suffix);
      }

      return { value: value, suffix: suffix, target: target };
    }

    function run(parts) {
      var value = parts.value;
      var target = parts.target;
      var final = target.toLocaleString('id-ID');

      value.style.minWidth = value.getBoundingClientRect().width + 'px';

      if (reducedMotion()) {
        value.textContent = final;
        return;
      }

      value.textContent = '0';
      if (parts.suffix) parts.suffix.style.opacity = '0';

      var growth = value.animate(
        [{ transform: 'scale(' + START_SCALE + ')' }, { transform: 'scale(1)' }],
        { duration: COUNT_DURATION, easing: EASE, fill: 'both' }
      );

      function tick() {
        var timing = growth.effect.getComputedTiming();
        var progress = timing.progress;
        if (progress === null || growth.playState === 'finished') {
          value.textContent = final;
          growth.cancel();
          return;
        }
        value.textContent = Math.round(target * progress).toLocaleString('id-ID');
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);

      if (parts.suffix) {
        var suffix = parts.suffix;
        var reveal = suffix.animate(
          [
            { opacity: 0, transform: 'translateY(14px)' },
            { opacity: 1, transform: 'none' }
          ],
          { duration: SUFFIX_DURATION, delay: COUNT_DURATION, easing: BACK, fill: 'both' }
        );
        reveal.finished.then(function () {
          reveal.cancel();
          suffix.style.opacity = '';
        }).catch(function () {});
      }
    }

    function init(el) {
      if (el.dataset.lpCountBound === 'true') return;
      el.dataset.lpCountBound = 'true';

      var parts = build(el);
      if (!parts) return;

      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          run(parts);
        });
      }, { threshold: 0.6 });

      observer.observe(el);
    }

    function start() {
      document.querySelectorAll('[data-lp-count]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Hero",
  "tag": "section",
  "class": "lp-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Dukungan Menopause · Offer Terbatas"
