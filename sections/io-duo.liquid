{% render 'io-base' %}

<div class="io-section io-duo io-section--{{ section.settings.color_scheme }}">
  <div class="io-container">
    <div class="io-head io-head--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="io-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="io-h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="io-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="io-duo__grid io-duo__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- if forloop.index > 1 and section.settings.show_plus -%}
          <div class="io-duo__plus" aria-hidden="true">
            {% render 'io-icon', name: 'plus', size: 28 %}
          </div>
        {%- endif -%}

        <article class="io-duo__side io-reveal" {{ block.shopify_attributes }}>
          {% render 'io-image',
            image: block.settings.image,
            alt: block.settings.image_alt,
            placeholder: 'product-2',
            sizes: '(min-width: 900px) 44vw, 92vw',
            ratio: '1 / 1'
          %}

          {%- if block.settings.label != blank -%}
            <p class="io-duo__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="io-h3 io-duo__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- assign io_items = block.settings.benefits | strip | newline_to_br | split: '<br />' -%}
          {%- if io_items.size > 0 -%}
            <ul class="io-duo__benefits">
              {%- for item in io_items -%}
                {%- assign io_item = item | strip -%}
                {%- if io_item != blank -%}
                  <li>
                    {% render 'io-icon', name: 'check', size: 18 %}
                    <span>{{ io_item }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="io-cta">
        <a class="io-btn io-btn--{{ section.settings.cta_style }}" href="{{ section.settings.cta_url | default: '#io-pricing' }}">
          {{- section.settings.cta_label | escape -}}
        </a>
        {%- if section.settings.cta_note != blank -%}
          <p class="io-note">{{ section.settings.cta_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .io-duo__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(2.25rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .io-duo__grid--2 {
      grid-template-columns: 1fr auto 1fr;
    }

    .io-duo__grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .io-duo__grid--3 .io-duo__plus {
      display: none;
    }
  }

  .io-duo__plus {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--io-forest);
  }

  .io-duo__plus .io-icon {
    padding: 0.5rem;
    border: 2px solid currentcolor;
    border-radius: 50%;
    box-sizing: content-box;
  }

  .io-section--forest .io-duo__plus {
    color: var(--io-gold);
  }

  .io-duo__side .io-media-frame {
    margin-bottom: 1.25rem;
  }

  .io-duo__label {
    margin: 0 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--io-text-soft);
  }

  .io-section--forest .io-duo__label {
    color: var(--io-gold);
  }

  .io-duo__title {
    margin-bottom: 1rem;
  }

  .io-duo__benefits {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .io-duo__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--io-text-mid);
  }

  .io-duo__benefits .io-icon {
    flex: none;
    margin-top: 0.25rem;
    color: var(--io-forest);
  }

  .io-section--forest .io-duo__benefits li {
    color: rgba(248, 248, 242, 0.88);
  }

  .io-section--forest .io-duo__benefits .io-icon {
    color: var(--io-gold);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "IO product duo",
  "tag": "section",
  "class": "io-section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "bloom", "label": "Alternate" },
        { "value": "forest", "label": "Deep green" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pendekatan Menyeluruh"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Inside Out Moringa Protocol"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Dua produk. Satu ritual harian. Dukungan menopause yang menyeluruh."
    },
    {
      "type": "checkbox",
      "id": "show_plus",
      "label": "Show a plus sign between the two columns",
      "default": true
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Mulai Protokol"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Solid green" },
        { "value": "gold", "label": "Gold" },
        { "value": "ghost", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "cta_note",
      "label": "Text below button",
      "default": "Garansi Uang Kembali 30 Hari · Gratis Ongkir"
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "side",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description",
          "default": "Kapsul moringa organik Treelogy"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "Inside"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product name",
          "default": "Organic Moringa Capsules"
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "Benefits",
          "info": "One benefit per line.",
          "default": "Membantu meredakan nyeri sendi dengan senyawa antiinflamasi\nMelawan lelah dengan zat besi dan vitamin B\nMendukung tidur lebih dalam tanpa sering terbangun\nMembantu mengurangi frekuensi dan intensitas hot flashes\nMendukung mood stabil dan meredakan ketegangan\nMendukung kekuatan tulang dengan kalsium 17x lebih banyak dari susu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IO product duo",
      "blocks": [
        { "type": "side" },
        {
          "type": "side",
          "settings": {
            "label": "Outside",
            "title": "Moringa Cold-Pressed Seed Oil",
            "image_alt": "Botol minyak biji moringa Treelogy",
            "benefits": "Hidrasi mendalam untuk kulit kering saat menopause\nMembantu menyamarkan garis halus dengan vitamin E dan antioksidan\nMenguatkan rambut menipis dari akar sampai ujung\nNon-comedogenic, tidak menyumbat pori\nMenenangkan kemerahan dan iritasi\nRingan, cepat meresap, tanpa rasa lengket"
          }
        }
      ]
    }
  ]
}
{% endschema %}
