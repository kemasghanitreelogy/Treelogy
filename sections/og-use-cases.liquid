<section class="og-usecases og-section">
  <div class="og-container">
    <img
      class="og-arrow"
      src="{{ 'oil-guide-arrow.svg' | asset_url }}"
      alt=""
      width="70"
      height="70"
      loading="lazy"
      decoding="async"
    >

    <h2 class="og-h2 og-usecases__heading">{{ 'oil_guide.how.heading_html' | t }}</h2>

    <div class="og-usecases__list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_base = 'oil_guide.cards.' | append: block.settings.card_id
          assign title_key = card_base | append: '.title_html'
          assign benefit_key = card_base | append: '.benefit'
          assign where_key = card_base | append: '.where'
          assign when_key = card_base | append: '.when'
          assign how_key = card_base | append: '.how'
          assign alt_key = card_base | append: '.image_alt'
          assign card_alt = alt_key | t
        -%}
        <article
          class="og-usecase og-usecase--{{ block.settings.card_id }}"
          {{ block.shopify_attributes }}
        >
          <div class="og-usecase__media">
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '400, 600, 800, 1200',
                  sizes: 'auto',
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'og-usecase__img',
                  alt: card_alt
              }}
            {%- endif -%}
          </div>
          <div class="og-usecase__body">
            <h3 class="og-usecase__title">{{ title_key | t }}</h3>
            <p class="og-usecase__benefit">{{ benefit_key | t }}</p>
            <div class="og-usecase__facts">
              <p class="og-usecase__fact">
                <strong>{{ 'oil_guide.how.where_label' | t }}</strong>
                {{ where_key | t }}
              </p>
              <p class="og-usecase__fact">
                <strong>{{ 'oil_guide.how.when_label' | t }}</strong>
                {{ when_key | t }}
              </p>
              <p class="og-usecase__fact">
                <strong>{{ 'oil_guide.how.how_label' | t }}</strong>
                {{ how_key | t }}
              </p>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .og-usecases {
    padding-top: var(--og-gap-section);
  }

  .og-usecases__heading {
    margin-bottom: var(--og-gap-section);
  }

  .og-usecases__list {
    display: flex;
    flex-direction: column;
    gap: var(--og-gap-block);
  }

  .og-usecase {
    position: relative;
    overflow: hidden;
    border-radius: var(--og-radius-card);
    background: var(--og-card);
    color: #2b3c35;
  }

  .og-usecase__media {
    position: absolute;
  }

  .og-usecase__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .og-usecase__body {
    position: absolute;
    left: calc(594 * var(--og-u));
  }

  .og-usecase--face {
    height: calc(760 * var(--og-u));
  }

  .og-usecase--face .og-usecase__media {
    top: calc(24 * var(--og-u));
    left: calc(11 * var(--og-u));
    width: calc(555 * var(--og-u));
    height: calc(719 * var(--og-u));
  }

  .og-usecase--face .og-usecase__body {
    top: calc(90 * var(--og-u));
    width: calc(515 * var(--og-u));
  }

  .og-usecase--face .og-usecase__benefit {
    margin-top: calc(29 * var(--og-u));
    max-width: calc(493 * var(--og-u));
  }

  .og-usecase--face .og-usecase__facts {
    margin-top: calc(29 * var(--og-u));
    padding-top: calc(48 * var(--og-u));
  }

  .og-usecase--skin {
    height: calc(1150 * var(--og-u));
  }

  .og-usecase--skin .og-usecase__media {
    top: calc(62 * var(--og-u));
    left: calc(33.5 * var(--og-u));
    width: calc(527 * var(--og-u));
    height: calc(1010 * var(--og-u));
  }

  .og-usecase--skin .og-usecase__body {
    top: calc(62 * var(--og-u));
    width: calc(521 * var(--og-u));
  }

  .og-usecase--skin .og-usecase__benefit {
    margin-top: calc(19 * var(--og-u));
  }

  .og-usecase--skin .og-usecase__facts {
    margin-top: calc(32 * var(--og-u));
    padding-top: calc(54 * var(--og-u));
  }

  .og-usecase--hair {
    height: calc(1098 * var(--og-u));
  }

  .og-usecase--hair .og-usecase__media {
    top: 0;
    left: calc(17.5 * var(--og-u));
    width: calc(544 * var(--og-u));
    height: calc(923 * var(--og-u));
  }

  .og-usecase--hair .og-usecase__body {
    top: calc(75 * var(--og-u));
    width: calc(523 * var(--og-u));
  }

  .og-usecase--hair .og-usecase__benefit {
    margin-top: calc(19 * var(--og-u));
  }

  .og-usecase--hair .og-usecase__facts {
    margin-top: calc(49 * var(--og-u));
    padding-top: calc(60 * var(--og-u));
  }

  .og-usecase__title {
    margin: 0;
    font-size: calc(60 * var(--og-u));
    font-weight: 400;
    line-height: 1.35;
  }

  .og-usecase__title b {
    font-weight: 700;
  }

  .og-usecase__benefit {
    margin: 0;
    font-size: calc(39 * var(--og-u));
    line-height: 1.35;
  }

  .og-usecase__facts {
    position: relative;
  }

  .og-usecase__facts::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(5 * var(--og-u));
    width: calc(488 * var(--og-u));
    border-top: 2px solid #2b3c35;
  }

  .og-usecase__fact {
    margin: 0;
    font-size: calc(39 * var(--og-u));
    line-height: 1.39;
  }

  .og-usecase__fact + .og-usecase__fact {
    margin-top: calc(54 * var(--og-u));
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Use Cases",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Kartu cara pakai",
      "settings": [
        {
          "type": "select",
          "id": "card_id",
          "label": "Konten kartu",
          "options": [
            { "value": "face", "label": "Wajah" },
            { "value": "skin", "label": "Kulit" },
            { "value": "hair", "label": "Rambut" }
          ],
          "default": "face"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "OG Use Cases",
      "blocks": [
        { "type": "card", "settings": { "card_id": "face" } },
        { "type": "card", "settings": { "card_id": "skin" } },
        { "type": "card", "settings": { "card_id": "hair" } }
      ]
    }
  ]
}
{% endschema %}
