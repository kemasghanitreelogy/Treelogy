<div class="lp-richtext lp-richtext--{{ section.settings.background }} lp-pad">
  <div class="lp-container lp-container--narrow lp-richtext__inner lp-reveal">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-richtext__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.stat != blank %}
      <div class="lp-richtext__stat">{{ section.settings.stat }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-richtext__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.content != blank %}
      <div class="lp-richtext__body">{{ section.settings.content }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .lp-richtext--cream {
    background: var(--lp-cream);
  }

  .lp-richtext--bloom {
    background: var(--lp-bloom);
  }

  .lp-richtext--surface {
    background: var(--lp-surface);
  }

  .lp-richtext__inner {
    text-align: center;
  }

  .lp-richtext .lp-richtext__eyebrow {
    margin-bottom: 0.5rem;
  }

  .lp-richtext__stat {
    margin-bottom: 0.25rem;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 1;
  }

  .lp-richtext .lp-richtext__heading {
    margin-bottom: 1.5rem;
  }

  .lp-richtext__body {
    margin-top: 2rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
    line-height: 1.75;
    text-align: left;
  }

  .lp-richtext__body p {
    margin: 0 0 1.25rem;
  }

  .lp-richtext__body p:last-child {
    margin-bottom: 0;
  }

  .lp-richtext__body strong {
    color: var(--lp-forest);
  }

  .lp-richtext__body a {
    color: var(--lp-forest);
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Rich text",
  "tag": "section",
  "class": "lp-richtext-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kearifan Kuno, Sains Modern"
    },
    {
      "type": "text",
      "id": "stat",
      "label": "Angka besar",
      "default": "5.000",
      "info": "Kosongkan bila tidak dipakai."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Tahun Perempuan Indonesia Mengandalkan Moringa"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Isi",
      "default": "<p>Tulis cerita brand di sini.</p>"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Latar",
      "options": [
        { "value": "cream", "label": "Krem terang" },
        { "value": "bloom", "label": "Krem alternatif" },
        { "value": "surface", "label": "Putih" }
      ],
      "default": "cream"
    }
  ],
  "presets": [
    {
      "name": "LP · Rich text"
    }
  ]
}
{% endschema %}
