        },
        {
          "type": "header",
          "content": "Bottom text"
        },
        {
          "type": "richtext",
          "id": "unsubscribe_text",
          "label": "Small text",
          "default": "<p>Tidak ingin lagi menerima email ini? <a href=\"#\">Unsubscribe</a>.</p>"
        },
        {
          "type": "text",
          "id": "copyright",
          "label": "Copyright",
          "default": "© Treelogy 2026. All Rights Reserved."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background",
          "default": "#2A3B34"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#F8F8F2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founder Letter",
      "blocks": [
        { "type": "hero" },
        { "type": "heading" },
        { "type": "arrow" },
        { "type": "greeting" },
        { "type": "text" },
        { "type": "checklist" },
        { "type": "text" },
        { "type": "price_table" },
        { "type": "text" },
        { "type": "cta" },
        { "type": "footer" }
      ]
    }
  ]
}
{% endschema %}
