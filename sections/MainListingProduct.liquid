<div class="collection-listing" data-cs-capture>
  <div class="header box-container">
    <h2 class="h1">
      {{ section.settings.collection.title }}
    </h2>

    <div class="search-input">
      <input
        type="search"
        placeholder="Search"
        id="search-product-inline">
    </div>
  </div>

  <div class="product-listing box-container" id="products-listing">
    {% assign selected_collection = section.settings.collection %}
    {% assign product_limit = section.settings.product_limit | default: 20 %}
    {% assign order_handles = section.settings.custom_order | remove: ' ' | split: ',' %}

    {% if selected_collection != blank %}
      {% paginate selected_collection.products by product_limit %}
        {% if order_handles.size > 0 and paginate.pages <= 1 %}
          {% comment %}
            Curated order: listed handles first (in the given order),
            then any remaining collection products in their normal order.
            Only applies when everything fits on one page — with pagination
            a per-page reorder would shuffle items between pages.
          {% endcomment %}
          {% for handle in order_handles %}
            {% for product in selected_collection.products %}
              {% if product.handle == handle %}
                {% render 'ProductCard', item: product %}
              {% endif %}
            {% endfor %}
          {% endfor %}
          {% for product in selected_collection.products %}
            {% unless order_handles contains product.handle %}
              {% render 'ProductCard', item: product %}
            {% endunless %}
          {% endfor %}
        {% else %}
          {% for product in selected_collection.products %}
            {% render 'ProductCard'
              , item: product %}
          {% else %}
            <p>No product(s)</p>
          {% endfor %}
        {% endif %}

        {% if paginate.pages > 1 %}
          {{ paginate | default_pagination }}
        {% endif %}

        {%- liquid
          assign listing_currency = cart.currency.iso_code | default: shop.currency
          if listing_currency == 'XXX'
            assign listing_currency = shop.currency
          endif
          assign position_offset = paginate.current_offset | default: 0
        -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "ItemList",
            "@id": {{ canonical_url | append: '#collection-products' | json }},
            "name": {{ selected_collection.title | json }},
            "numberOfItems": {{ selected_collection.products_count }},
            "itemListElement": [
              {%- assign li_pos = position_offset -%}
              {%- if order_handles.size > 0 and paginate.pages <= 1 -%}
                {%- for handle in order_handles -%}
                  {%- for product in selected_collection.products -%}
                    {%- if product.handle == handle -%}
                      {%- assign li_pos = li_pos | plus: 1 -%}
                      {%- if li_pos == 1 -%}
                        {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: true -%}
                      {%- else -%}
                        {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: false -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
                {%- for product in selected_collection.products -%}
                  {%- unless order_handles contains product.handle -%}
                    {%- assign li_pos = li_pos | plus: 1 -%}
                    {%- if li_pos == 1 -%}
                      {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: true -%}
                    {%- else -%}
                      {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: false -%}
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
              {%- else -%}
                {%- for product in selected_collection.products -%}
                  {%- assign li_pos = li_pos | plus: 1 -%}
                  {%- if forloop.first -%}
                    {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: true -%}
                  {%- else -%}
                    {%- render 'ProductListItemSchema', product: product, pos: li_pos, listing_currency: listing_currency, is_first: false -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            ]
          }
        </script>
      {% endpaginate %}
    {% else %}
      <p>Please select a collection in the Customizer.</p>
    {% endif %}
  </div>
</div>


{% schema %}
  {
    "name": "Main Listing Product",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Choose collection"
      },
      {
        "type": "range",
        "id": "product_limit",
        "label": "Products per page",
        "default": 8,
        "min": 1,
        "step": 1,
        "max": 50
      },
      {
        "type": "textarea",
        "id": "custom_order",
        "label": "Custom product order (comma-separated handles)",
        "info": "Listed products appear first in this order; the rest follow in collection order. Leave empty to use the collection's own order."
      }
    ],
    "presets": [
      {
        "name": "Main Listing Product"
      }
    ]
  }
{% endschema %}
