<div class="collection-listing" data-cs-capture>
  <div class="header box-container">
    <h2 class="h1">
      {{ section.settings.collection.title }}
    </h2>

    <div class="search-input">
      <input
        type="search"
        placeholder="Search"
        id="search-product-inline">
    </div>
  </div>

  <div class="product-listing box-container" id="products-listing">
    {% assign selected_collection = section.settings.collection %}
    {% assign product_limit = section.settings.product_limit | default: 20 %}

    {% if selected_collection != blank %}
      {% paginate selected_collection.products by product_limit %}
        {% for product in selected_collection.products %}
          {% render 'ProductCard'
            , item: product %}
        {% else %}
          <p>No product(s)</p>
        {% endfor %}

        {% if paginate.pages > 1 %}
          {{ paginate | default_pagination }}
        {% endif %}

        {%- liquid
          assign listing_currency = cart.currency.iso_code | default: shop.currency
          assign position_offset = paginate.current_offset | default: 0
        -%}
        <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "ItemList",
            "@id": {{ canonical_url | append: '#collection-products' | json }},
            "name": {{ selected_collection.title | json }},
            "numberOfItems": {{ selected_collection.products_count }},
            "itemListElement": [
              {%- for product in selected_collection.products -%}
                {%- liquid
                  assign li_rating_meta = product.metafields.reviews.rating.value
                  assign li_rating_count = product.metafields.reviews.rating_count.value | plus: 0
                  assign li_show_rating = false
                  if li_rating_count > 0 and li_rating_meta != blank
                    assign li_show_rating = true
                  endif
                  assign li_reviews = product.metafields.custom.featured_reviews.value
                -%}
                {
                  "@type": "ListItem",
                  "position": {{ forloop.index | plus: position_offset }},
                  "item": {
                    "@type": "Product",
                    "@id": {{ request.origin | append: product.url | append: '#product' | json }},
                    "name": {{ product.title | json }},
                    "url": {{ request.origin | append: product.url | json }},
                    {%- if product.featured_image != blank -%}
                      "image": {{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }},
                    {%- endif -%}
                    "brand": { "@type": "Brand", "name": "Treelogy" },
                    {%- if li_show_rating -%}
                      "aggregateRating": {
                        "@type": "AggregateRating",
                        "ratingValue": {{ li_rating_meta.rating | json }},
                        "reviewCount": {{ li_rating_count }},
                        "bestRating": {{ li_rating_meta.scale_max | default: 5 | json }},
                        "worstRating": 1
                      },
                    {%- endif -%}
                    {%- if li_reviews != blank -%}
                      "review": [
                        {%- for fr in li_reviews -%}
                        {
                          "@type": "Review",
                          "author": { "@type": "Person", "name": {{ fr.author | json }} },
                          "reviewRating": { "@type": "Rating", "ratingValue": {{ fr.rating | json }}, "bestRating": 5, "worstRating": 1 },
                          "reviewBody": {{ fr.body | json }}
                          {%- if fr.date != blank -%},"datePublished": {{ fr.date | json }}{%- endif -%}
                        }{%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ],
                    {%- endif -%}
                    "offers": {
                      "@type": "AggregateOffer",
                      "priceCurrency": {{ listing_currency | json }},
                      "lowPrice": {{ product.price_min | divided_by: 100.0 }},
                      "highPrice": {{ product.price_max | divided_by: 100.0 }},
                      "offerCount": {{ product.variants.size }},
                      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
                    }
                  }
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        </script>
      {% endpaginate %}
    {% else %}
      <p>Please select a collection in the Customizer.</p>
    {% endif %}
  </div>
</div>


{% schema %}
  {
    "name": "Main Listing Product",
    "settings": [
      {
        "type": "collection",
        "id": "collection",
        "label": "Choose collection"
      }, 
      {
        "type": "range",
        "id": "product_limit",
        "label": "Products per page",
        "default": 8,
        "min": 1,
        "step": 1,
        "max": 50
      }
    ],
    "presets": [
      {
        "name": "Main Listing Product"
      }
    ]
  }
{% endschema %}