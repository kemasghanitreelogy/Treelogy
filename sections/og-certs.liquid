<section class="og-certs og-section">
  <div class="og-container">
    <ul class="og-certs__row" role="list" aria-label="{{ 'oil_guide.certs.heading_aria' | t }}">
      {%- assign certs = 'oil-guide-cert-halal.svg:halal:70:125,oil-guide-cert-usda.svg:usda:117:117,oil-guide-cert-eu.svg:eu:160:107,oil-guide-cert-organik.svg:organik:117:117,oil-guide-cert-pom.png:bpom:111:102' | split: ',' -%}
      {%- for cert in certs -%}
        {%- liquid
          assign parts = cert | split: ':'
          assign alt_key = 'oil_guide.certs.' | append: parts[1] | append: '_alt'
          assign cert_alt = alt_key | t
        -%}
        <li class="og-certs__item">
          <img
            src="{{ parts[0] | asset_url }}"
            alt="{{ cert_alt }}"
            width="{{ parts[2] }}"
            height="{{ parts[3] }}"
            loading="lazy"
            decoding="async"
            class="og-certs__logo"
            style="height: calc({{ parts[3] }} * var(--og-u))"
          >
        </li>
      {%- endfor -%}
    </ul>

    <img
      src="{{ 'oil-guide-treeline.svg' | asset_url }}"
      alt=""
      width="1154"
      height="103"
      loading="lazy"
      decoding="async"
      class="og-certs__treeline"
    >
  </div>
</section>

{% style %}
  .og-certs {
    padding-top: var(--og-gap-block);
    padding-bottom: var(--og-gap-block);
  }

  .og-certs__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: calc(98 * var(--og-u));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .og-certs__item {
    display: flex;
  }

  .og-certs__logo {
    width: auto;
  }

  .og-certs__treeline {
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(59 * var(--og-u));
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Certifications",
  "settings": [],
  "presets": [
    {
      "name": "OG Certifications"
    }
  ]
}
{% endschema %}
