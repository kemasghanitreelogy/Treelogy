{%- liquid
  assign hero_alt = 'oil_guide.hero.image_alt' | t
-%}
<section class="og-hero og-section">
  <div class="og-container">
    <div class="og-hero__card">
      {%- if section.settings.image -%}
        {{
          section.settings.image
          | image_url: width: 2304
          | image_tag:
            widths: '600, 900, 1150, 2304',
            sizes: '(min-width: 1200px) 1152px, calc(100vw - 32px)',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'og-hero__img',
            alt: hero_alt
        }}
      {%- endif -%}
      <div class="og-hero__overlay">
        <div class="og-hero__brand" aria-hidden="true">
          <img
            src="{{ 'oil-guide-logo-word.svg' | asset_url }}"
            alt=""
            width="234"
            height="42"
            class="og-hero__logo og-hero__logo--word"
          >
          <img
            src="{{ 'oil-guide-logo-mark.svg' | asset_url }}"
            alt=""
            width="81"
            height="41"
            class="og-hero__logo og-hero__logo--mark"
          >
        </div>
        <h1 class="og-hero__title">{{ 'oil_guide.hero.title_html' | t }}</h1>
        <span class="og-hero__pill">{{ 'oil_guide.hero.pill' | t }}</span>
      </div>
    </div>
  </div>
</section>

{% style %}
  .og-hero {
    padding-top: calc(201 * var(--og-u));
  }

  .og-hero__card {
    position: relative;
    overflow: hidden;
    border-radius: var(--og-radius-hero);
    aspect-ratio: 1151 / 760;
    background: #cdcdcd;
  }

  .og-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .og-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .og-hero__brand {
    position: absolute;
    top: calc(64 * var(--og-u));
    left: calc(50 * var(--og-u));
    display: flex;
    align-items: flex-start;
    gap: calc(14 * var(--og-u));
  }

  .og-hero__logo--word {
    width: calc(234.5 * var(--og-u));
    height: auto;
  }

  .og-hero__logo--mark {
    width: calc(80.7 * var(--og-u));
    height: auto;
  }

  .og-hero__title {
    position: absolute;
    top: calc(202 * var(--og-u));
    left: calc(62 * var(--og-u));
    margin: 0;
    font-size: calc(75 * var(--og-u));
    font-weight: 400;
    line-height: 1.25;
    color: #101010;
  }

  .og-hero__title b {
    font-weight: 700;
  }

  .og-hero__pill {
    position: absolute;
    top: calc(651 * var(--og-u));
    left: calc(50 * var(--og-u));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: calc(263 * var(--og-u));
    height: calc(68 * var(--og-u));
    padding: 0 calc(30 * var(--og-u));
    border: 1px solid #2b3c35;
    border-radius: calc(34 * var(--og-u));
    font-size: calc(35 * var(--og-u));
    line-height: 1.4;
    color: #2b3c35;
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto hero"
    }
  ],
  "presets": [
    {
      "name": "OG Hero"
    }
  ]
}
{% endschema %}
