            },
            {
              "value": "i-battery",
              "label": "Battery"
            },
            {
              "value": "i-moon",
              "label": "Moon"
            },
            {
              "value": "i-thermo",
              "label": "Thermometer"
            },
            {
              "value": "i-cal",
              "label": "Calendar"
            },
            {
              "value": "i-mother",
              "label": "Mother"
            },
            {
              "value": "i-drop",
              "label": "Drop"
            },
            {
              "value": "i-man",
              "label": "Man"
            },
            {
              "value": "i-parents",
              "label": "Parents"
            }
          ]
        },
        {
          "type": "text",
          "id": "chip",
          "label": "Chip label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card heading"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Card body"
        },
        {
          "type": "text",
          "id": "how",
          "label": "How to take it"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer quote"
