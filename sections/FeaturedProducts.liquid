{%- liquid
  comment
    Gerbang yang sama dengan sections/MainProductDetail.liquid: di template
    yang memuat section PDP v3 dan section lama berdampingan, section lama
    harus mundur untuk produk yang sudah dipegang desain baru. Setting-nya
    kosong secara bawaan, jadi di tema mana pun yang tidak mengisinya section
    ini berperilaku persis seperti sebelumnya — termasuk di luar halaman
    produk, tempat product.handle kosong dan gerbangnya tidak pernah menutup.
  endcomment
  assign pdp3_skip = false
  if section.settings.excluded_handles != blank
    assign pdp3_needle = product.handle | prepend: ',' | append: ','
    assign pdp3_hay = section.settings.excluded_handles | remove: ' ' | prepend: ',' | append: ','
    if pdp3_hay contains pdp3_needle
      assign pdp3_skip = true
    endif
  endif
-%}
{%- unless pdp3_skip -%}
{% render 'FeaturedCardSlider', card: 'product', section: section %}

{%- liquid
  assign featured_products = section.settings.products
  assign featured_count = featured_products | size
-%}
{%- if featured_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "@id": {{ canonical_url | append: '#featured-products-' | append: section.id | json }},
      {%- if section.settings.title != blank %}
      "name": {{ section.settings.title | strip_html | strip_newlines | strip | json }},
      {%- endif %}
      "numberOfItems": {{ featured_count }},
      "itemListElement": [
        {%- for featured_product in featured_products -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ featured_product.title | json }},
            "url": {{ request.origin | append: featured_product.url | json }}
          }
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "class": "section featured-slider",
  "settings": [
      {
        "type": "text",
        "id": "excluded_handles",
        "label": "Hide this section for these product handles (comma separated)"
      },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Different Forms of Moringa"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover what fits your routine and experience the powerful benefits of moringa with Treelogy's premium, handcrafted products."
    },

    {
      "type": "product_list",
      "id": "products",
      "label": "Selected products"
    },

    {
      "type": "header",
      "content": "Button"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Label"
    },

    {
      "type": "url",
      "id": "button_url",
      "label": "Url"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
