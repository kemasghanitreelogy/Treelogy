{%- liquid
  assign s = section.settings
  assign bg_overlay = s.bg_overlay | default: 35
  assign blur_strength = s.bg_blur | default: 18
  assign card_tint = s.card_tint | default: '#56734F'
  assign card_opacity = s.card_opacity | default: 60
  assign accent = s.accent_color | default: '#F8F8F2'
  assign title = s.title | default: 'TREELOGY'
  assign tagline = s.tagline | default: 'Nourishing You, Enriching Life'
-%}

<section
  class="lh"
  aria-label="{{ title | escape }} — link hub"
  style="
    --lh-overlay: {{ bg_overlay | divided_by: 100.0 }};
    --lh-blur: {{ blur_strength }}px;
    --lh-card-tint: {{ card_tint }};
    --lh-card-opacity: {{ card_opacity | divided_by: 100.0 }};
    --lh-accent: {{ accent }};
  "
>
  {%- if s.background != blank -%}
    <div class="lh__bg" aria-hidden="true">
      <img
        class="lh__bg-img"
        src="{{ s.background | image_url: width: 1600 }}"
        srcset="
          {{ s.background | image_url: width: 640 }} 640w,
          {{ s.background | image_url: width: 1024 }} 1024w,
          {{ s.background | image_url: width: 1600 }} 1600w,
          {{ s.background | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        width="{{ s.background.width }}"
        height="{{ s.background.height }}"
      >
      <div class="lh__bg-overlay"></div>
    </div>
  {%- else -%}
    <div class="lh__bg lh__bg--solid" aria-hidden="true"></div>
  {%- endif -%}

  <div class="lh__shell">
    <div class="lh__corner lh__corner--left">
      {%- if s.show_menu_button -%}
        <button
          type="button"
          class="lh__icon-btn"
          aria-label="{{ s.menu_label | default: 'Open menu' | escape }}"
          data-lh-menu-trigger
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5v13M1.5 8h13M3.2 3.2l9.6 9.6M3.2 12.8l9.6-9.6"
              stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <div class="lh__corner lh__corner--right">
      {%- if s.show_share_button -%}
        <button
          type="button"
          class="lh__icon-btn"
          aria-label="{{ 'Share this page' | escape }}"
          data-lh-share
          data-lh-share-title="{{ title | escape }}"
          data-lh-share-text="{{ tagline | escape }}"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 10.5V2M8 2L4.5 5.5M8 2l3.5 3.5M3 8.5v4a1 1 0 001 1h8a1 1 0 001-1v-4"
              stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <header class="lh__head">
      {%- if s.logo != blank -%}
        <div class="lh__avatar">
          <img
            src="{{ s.logo | image_url: width: 240 }}"
            srcset="{{ s.logo | image_url: width: 240 }} 1x, {{ s.logo | image_url: width: 480 }} 2x"
            alt="{{ title | escape }}"
            width="120"
            height="120"
            loading="eager"
          >
        </div>
      {%- endif -%}

      <h1 class="lh__title">{{ title }}</h1>
      {%- if tagline != blank -%}
        <p class="lh__tagline">{{ tagline }}</p>
      {%- endif -%}
    </header>

    {%- assign link_blocks = section.blocks | where: 'type', 'link' -%}
    {%- assign social_blocks = section.blocks | where: 'type', 'social' -%}
    {%- assign note_blocks = section.blocks | where: 'type', 'announcement' -%}

    {%- if note_blocks.size > 0 -%}
      <div class="lh__notes" role="region" aria-label="Announcements">
        {%- for block in note_blocks -%}
          <div class="lh__note" style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <img class="lh__note-icon"
                src="{{ block.settings.icon | image_url: width: 64 }}"
                alt=""
                width="20" height="20" loading="lazy">
            {%- endif -%}
            <span class="lh__note-text">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if link_blocks.size > 0 -%}
      <nav class="lh__links" aria-label="Primary links">
        {%- for block in link_blocks -%}
          {%- liquid
            assign label = block.settings.label | default: 'Untitled link'
            assign url = block.settings.url | default: '#'
            assign featured = block.settings.featured
          -%}
          <a
            class="lh__link{% if featured %} lh__link--featured{% endif %}"
            href="{{ url }}"
            target="_blank"
            rel="noopener"
            data-lh-link
            style="--i: {{ forloop.index0 }};"
            {{ block.shopify_attributes }}
          >
            <span class="lh__link-icon" aria-hidden="true">
              {%- if block.settings.icon != blank -%}
                <img
                  src="{{ block.settings.icon | image_url: width: 96 }}"
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M9 17l11-11M9 6h11v11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
            </span>
            <span class="lh__link-label">{{ label }}</span>
            <span class="lh__link-tail" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="lh__link-shine" aria-hidden="true"></span>
          </a>
        {%- endfor -%}
      </nav>
    {%- else -%}
      <p class="lh__empty">Add link blocks in the theme editor to populate this hub.</p>
    {%- endif -%}

    {%- if social_blocks.size > 0 -%}
      <ul class="lh__socials" aria-label="Social channels">
        {%- for block in social_blocks -%}
          {%- liquid
            assign platform = block.settings.platform
            assign url = block.settings.url | default: '#'
            assign label = block.settings.label | default: platform
          -%}
          <li style="--i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <a class="lh__social" href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ label | escape }}">
              {%- case platform -%}
                {%- when 'whatsapp' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M20.5 3.5A10.94 10.94 0 0 0 12 .25C5.92.25.99 5.18.99 11.27c0 2.06.55 4.06 1.6 5.83L1 23.75l6.78-1.78a11 11 0 0 0 4.21.84h.01c6.07 0 10.99-4.93 10.99-11.02 0-2.95-1.15-5.72-3.49-7.79zM12 21.05h-.01a9.05 9.05 0 0 1-4.6-1.26l-.33-.2-4.02 1.05 1.07-3.93-.21-.34a9.06 9.06 0 0 1-1.4-4.83c0-5.02 4.07-9.09 9.5-9.09 2.45 0 4.7.95 6.4 2.66a9.04 9.04 0 0 1 2.65 6.43c0 5.01-4.07 9.07-9.05 9.07zm5.18-6.79c-.28-.14-1.66-.82-1.92-.91-.26-.09-.45-.14-.64.14-.19.28-.74.92-.91 1.11-.17.19-.34.21-.62.07-.28-.14-1.18-.43-2.24-1.39a8.32 8.32 0 0 1-1.55-1.93c-.16-.28-.02-.43.12-.57.13-.13.28-.34.42-.51.14-.17.18-.28.28-.47.09-.19.05-.36-.02-.51-.07-.14-.64-1.55-.88-2.12-.23-.55-.46-.48-.64-.49-.16-.01-.36-.01-.55-.01-.19 0-.51.07-.78.36-.27.28-1.02 1-1.02 2.43 0 1.43 1.05 2.81 1.19 3 .14.19 2.07 3.16 5.01 4.43.7.3 1.25.48 1.68.61.7.22 1.34.19 1.85.12.56-.08 1.66-.68 1.9-1.34.24-.66.24-1.22.16-1.34-.07-.12-.26-.19-.54-.34z"/></svg>
                {%- when 'instagram' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.34 4.14.63a5.86 5.86 0 0 0-2.13 1.38A5.86 5.86 0 0 0 .63 4.14C.34 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.27 2.15.56 2.91.3.79.7 1.46 1.38 2.13.67.67 1.34 1.08 2.13 1.38.76.29 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.27 2.91-.56.79-.3 1.46-.71 2.13-1.38.67-.67 1.08-1.34 1.38-2.13.29-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.27-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.13A5.86 5.86 0 0 0 19.86.63C19.1.34 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.41-11.85a1.44 1.44 0 1 0 1.44 1.44 1.44 1.44 0 0 0-1.44-1.44z"/></svg>
                {%- when 'tiktok' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M19.32 5.55c-1.43-.93-2.39-2.43-2.62-4.16h-3.4v13.62a3.4 3.4 0 1 1-2.4-3.25v-3.49a6.86 6.86 0 1 0 5.8 6.74V8.55a8 8 0 0 0 4.7 1.5V6.62a4.84 4.84 0 0 1-2.08-1.07z"/></svg>
                {%- when 'facebook' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M22.68 0H1.32C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29H9.69v-3.62h3.13V8.41c0-3.1 1.89-4.79 4.66-4.79 1.32 0 2.46.1 2.79.14v3.24h-1.92c-1.5 0-1.79.71-1.79 1.76v2.31h3.59l-.47 3.62h-3.12V24h6.12c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.68 0z"/></svg>
                {%- when 'pinterest' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.94-.2-2.4.04-3.43.22-.93 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.66.97-2.91 2.17-2.91 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.2.6 2.18 1.79 2.18 2.15 0 3.8-2.27 3.8-5.54 0-2.9-2.08-4.92-5.06-4.92-3.45 0-5.47 2.58-5.47 5.25 0 1.04.4 2.16.9 2.77.1.12.11.22.08.34l-.34 1.36c-.05.22-.18.27-.4.16-1.5-.7-2.43-2.88-2.43-4.64 0-3.78 2.74-7.25 7.91-7.25 4.15 0 7.38 2.96 7.38 6.92 0 4.13-2.6 7.45-6.22 7.45-1.21 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.34-1.49 3.13A12 12 0 1 0 12 0z"/></svg>
                {%- when 'youtube' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.4-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
                {%- when 'email' -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20"/></svg>
              {%- endcase -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.show_credit -%}
      <p class="lh__credit">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}
      </p>
    {%- endif -%}
  </div>

  {%- if s.show_menu_button -%}
    <div class="lh__menu" data-lh-menu hidden>
      <div class="lh__menu-backdrop" data-lh-menu-close></div>
      <div class="lh__menu-card" role="dialog" aria-modal="true" aria-labelledby="lh-menu-headline">
        <button type="button" class="lh__menu-close" aria-label="Close" data-lh-menu-close>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>

        {%- if s.menu_kicker != blank -%}
          <span class="lh__menu-kicker">{{ s.menu_kicker | escape }}</span>
        {%- endif -%}

        {%- if s.menu_headline != blank -%}
          <h2 id="lh-menu-headline" class="lh__menu-headline">{{ s.menu_headline }}</h2>
        {%- endif -%}

        {%- if s.menu_body != blank -%}
          <div class="lh__menu-body rte">{{ s.menu_body }}</div>
        {%- endif -%}

        {%- if s.menu_product_title != blank -%}
          {%- assign p_url = s.menu_product_url | default: '#' -%}
          <a class="lh__menu-product"
             href="{{ p_url }}"
             {% if s.menu_product_url != blank %}target="_blank" rel="noopener"{% endif %}
             data-lh-product>
            <span class="lh__menu-product-shine" aria-hidden="true"></span>

            <span class="lh__menu-product-thumb">
              {%- if s.menu_product_image != blank -%}
                <img
                  src="{{ s.menu_product_image | image_url: width: 200 }}"
                  srcset="{{ s.menu_product_image | image_url: width: 200 }} 1x, {{ s.menu_product_image | image_url: width: 400 }} 2x"
                  alt="{{ s.menu_product_title | escape }}"
                  width="80" height="80" loading="lazy" decoding="async">
              {%- else -%}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 3c-3 5-5 8-5 11a5 5 0 0010 0c0-3-2-6-5-11z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M12 14v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              {%- endif -%}
            </span>

            <span class="lh__menu-product-body">
              {%- if s.menu_product_badge != blank -%}
                <span class="lh__menu-product-badge">
                  <span class="lh__menu-product-badge-dot" aria-hidden="true"></span>
                  {{ s.menu_product_badge | escape }}
                </span>
              {%- endif -%}
              <span class="lh__menu-product-title">{{ s.menu_product_title }}</span>
              {%- if s.menu_product_outcomes != blank -%}
                <span class="lh__menu-product-outcomes">{{ s.menu_product_outcomes }}</span>
              {%- endif -%}
              {%- if s.menu_product_pitch != blank -%}
                <span class="lh__menu-product-pitch">{{ s.menu_product_pitch }}</span>
              {%- endif -%}
            </span>

            <span class="lh__menu-product-cta">
              <span class="lh__menu-product-cta-label">{{ s.menu_product_cta | default: 'Start' }}</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if s.menu_secondary_url != blank -%}
          <a class="lh__menu-secondary" href="{{ s.menu_secondary_url }}">
            {{ s.menu_secondary_label | default: 'Learn more' }}
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if s.show_share_button -%}
    {%- assign share_kicker = s.share_kicker | default: 'SHARE TREELOGY' -%}
    {%- assign share_headline = s.share_headline | default: 'Pass it on.' -%}
    {%- assign share_sub = s.share_sub | default: 'Send the link, plant the idea.' -%}

    <div class="lh__share" data-lh-share-menu hidden>
      <div class="lh__share-backdrop" data-lh-share-close></div>
      <div class="lh__share-card" role="dialog" aria-modal="true" aria-labelledby="lh-share-headline">
        <button type="button" class="lh__menu-close" aria-label="Close" data-lh-share-close>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>

        <span class="lh__share-kicker">{{ share_kicker | escape }}</span>
        <h2 id="lh-share-headline" class="lh__share-headline">{{ share_headline }}</h2>
        {%- if share_sub != blank -%}
          <p class="lh__share-sub">{{ share_sub }}</p>
        {%- endif -%}

        <button type="button" class="lh__share-copy" data-lh-share-copy aria-label="Copy link to clipboard">
          <span class="lh__share-copy-icon" aria-hidden="true">
            <svg class="lh__share-copy-icon-default" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <rect x="5" y="5" width="9" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/>
              <path d="M4 11V4a1 1 0 011-1h7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <svg class="lh__share-copy-icon-success" width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M4 9.5l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="lh__share-copy-text">
            <span class="lh__share-copy-state lh__share-copy-state--idle">
              <span class="lh__share-copy-label">Copy link</span>
              <span class="lh__share-copy-url" data-lh-share-url>treelogy.com</span>
            </span>
            <span class="lh__share-copy-state lh__share-copy-state--done" aria-hidden="true">
              <span class="lh__share-copy-label">Copied</span>
              <span class="lh__share-copy-url">Paste it anywhere</span>
            </span>
          </span>
        </button>

        <div class="lh__share-divider" aria-hidden="true">
          <span>or send via</span>
        </div>

        <div class="lh__share-channels">
          {%- if s.share_show_whatsapp -%}
            <a class="lh__share-channel" data-lh-share-channel="whatsapp" href="#" target="_blank" rel="noopener" aria-label="Share on WhatsApp" style="--c: 0;">
              <span class="lh__share-channel-bubble" data-brand="whatsapp">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor"><path d="M20.5 3.5A10.94 10.94 0 0 0 12 .25C5.92.25.99 5.18.99 11.27c0 2.06.55 4.06 1.6 5.83L1 23.75l6.78-1.78a11 11 0 0 0 4.21.84h.01c6.07 0 10.99-4.93 10.99-11.02 0-2.95-1.15-5.72-3.49-7.79zM12 21.05h-.01a9.05 9.05 0 0 1-4.6-1.26l-.33-.2-4.02 1.05 1.07-3.93-.21-.34a9.06 9.06 0 0 1-1.4-4.83c0-5.02 4.07-9.09 9.5-9.09 2.45 0 4.7.95 6.4 2.66a9.04 9.04 0 0 1 2.65 6.43c0 5.01-4.07 9.07-9.05 9.07zm5.18-6.79c-.28-.14-1.66-.82-1.92-.91-.26-.09-.45-.14-.64.14-.19.28-.74.92-.91 1.11-.17.19-.34.21-.62.07-.28-.14-1.18-.43-2.24-1.39a8.32 8.32 0 0 1-1.55-1.93c-.16-.28-.02-.43.12-.57.13-.13.28-.34.42-.51.14-.17.18-.28.28-.47.09-.19.05-.36-.02-.51-.07-.14-.64-1.55-.88-2.12-.23-.55-.46-.48-.64-.49-.16-.01-.36-.01-.55-.01-.19 0-.51.07-.78.36-.27.28-1.02 1-1.02 2.43 0 1.43 1.05 2.81 1.19 3 .14.19 2.07 3.16 5.01 4.43.7.3 1.25.48 1.68.61.7.22 1.34.19 1.85.12.56-.08 1.66-.68 1.9-1.34.24-.66.24-1.22.16-1.34-.07-.12-.26-.19-.54-.34z"/></svg>
              </span>
              <span class="lh__share-channel-label">WhatsApp</span>
            </a>
          {%- endif -%}

          {%- if s.share_show_telegram -%}
            <a class="lh__share-channel" data-lh-share-channel="telegram" href="#" target="_blank" rel="noopener" aria-label="Share on Telegram" style="--c: 1;">
              <span class="lh__share-channel-bubble" data-brand="telegram">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor"><path d="M9.04 15.32 8.7 20a1 1 0 0 0 1.62.79l3.05-2.51 4.62 3.39c.85.47 1.45.22 1.66-.78l3.01-14.16c.31-1.42-.51-2.06-1.34-1.74L1.7 11.4c-1.4.55-1.38 1.34-.24 1.7l5.21 1.63 12.09-7.62c.57-.34 1.09-.16.66.22z"/></svg>
              </span>
              <span class="lh__share-channel-label">Telegram</span>
            </a>
          {%- endif -%}

          {%- if s.share_show_x -%}
            <a class="lh__share-channel" data-lh-share-channel="x" href="#" target="_blank" rel="noopener" aria-label="Share on X" style="--c: 2;">
              <span class="lh__share-channel-bubble" data-brand="x">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </span>
              <span class="lh__share-channel-label">X</span>
            </a>
          {%- endif -%}

          {%- if s.share_show_email -%}
            <a class="lh__share-channel" data-lh-share-channel="email" href="#" aria-label="Share via email" style="--c: 3;">
              <span class="lh__share-channel-bubble" data-brand="email">
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
              </span>
              <span class="lh__share-channel-label">Email</span>
            </a>
          {%- endif -%}
        </div>

        <button type="button" class="lh__share-native" data-lh-share-native hidden>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 10.5V2M8 2L4.5 5.5M8 2l3.5 3.5M3 8.5v4a1 1 0 001 1h8a1 1 0 001-1v-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>More options</span>
        </button>
      </div>
    </div>
  {%- endif -%}
</section>

{% style %}
  /* ========================================================================
     Treelogy Link Hub — premium choreographed motion
     - Spring entrance cascade + staggered orchestration
     - Perpetual micro-motion (avatar float, background drift, ambient shine)
     - Cursor-tracked spotlight on link buttons
     - Liquid Glass refraction edges (inner border + inner shadow)
     - Hardware-accelerated (transform / opacity only)
     - prefers-reduced-motion fully respected
     ======================================================================== */
  .lh {
    --lh-shell-w: 480px;
    --lh-radius: 24px;
    --lh-text: #F8F8F2;
    --lh-text-soft: rgba(248, 248, 242, 0.78);
    --lh-text-mute: rgba(248, 248, 242, 0.6);
    --lh-stroke: rgba(248, 248, 242, 0.2);
    --lh-stroke-soft: rgba(248, 248, 242, 0.1);
    --lh-shadow-card:
      0 32px 80px -28px rgba(15, 24, 20, 0.65),
      0 12px 28px -14px rgba(15, 24, 20, 0.4),
      inset 0 1px 0 rgba(248, 248, 242, 0.08);
    --lh-shadow-link:
      0 10px 24px -12px rgba(15, 24, 20, 0.5),
      inset 0 1px 0 rgba(248, 248, 242, 0.12);
    --lh-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --lh-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --lh-ease-soft: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding:
      calc(env(safe-area-inset-top, 0px) + clamp(28px, 6vw, 48px))
      clamp(16px, 5vw, 24px)
      calc(env(safe-area-inset-bottom, 0px) + clamp(28px, 6vw, 48px));
    color: var(--lh-text);
    isolation: isolate;
  }

  /* ===== Background ===== */
  .lh__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: -2;
    background: #1d2a24;
  }
  .lh__bg--solid {
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, #3a4f43 0%, transparent 70%),
      radial-gradient(ellipse 100% 70% at 50% 100%, rgba(17, 24, 20, 0.7) 0%, transparent 70%),
      #1d2a24;
  }
  .lh__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(var(--lh-blur)) saturate(110%);
    transform: scale(1.08) translate3d(0, 0, 0);
    will-change: transform;
    animation: lh-bg-drift 32s ease-in-out infinite alternate;
  }
  .lh__bg-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 35%, transparent 0%, rgba(15, 24, 20, calc(var(--lh-overlay) * 0.5)) 100%),
      linear-gradient(180deg,
        rgba(43, 60, 53, calc(var(--lh-overlay) * 0.85)) 0%,
        rgba(29, 42, 36, calc(var(--lh-overlay) * 1.05)) 60%,
        rgba(17, 24, 20, calc(var(--lh-overlay) * 1.2)) 100%);
  }

  /* ===== Shell — liquid glass card ===== */
  .lh__shell {
    position: relative;
    width: 100%;
    max-width: var(--lh-shell-w);
    margin: auto 0;
    border-radius: var(--lh-radius);
    padding: clamp(28px, 7vw, 40px) clamp(18px, 5vw, 26px) clamp(24px, 6vw, 32px);
    background: linear-gradient(180deg, rgba(248, 248, 242, 0.08), rgba(248, 248, 242, 0.02));
    border: 1px solid var(--lh-stroke-soft);
    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
    box-shadow: var(--lh-shadow-card);
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 4vw, 24px);
    z-index: 1;
    opacity: 0;
    transform: translate3d(0, 28px, 0);
    animation: lh-shell-rise 900ms var(--lh-ease) 60ms forwards;
  }
  .lh__shell::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(248, 248, 242, 0.07), transparent 45%);
    mix-blend-mode: overlay;
  }

  /* ===== Corners (menu / share) ===== */
  .lh__corner {
    position: absolute;
    top: clamp(12px, 3vw, 18px);
    z-index: 3;
    opacity: 0;
    animation: lh-fade 500ms var(--lh-ease) 720ms forwards;
  }
  .lh__corner--left { left: clamp(12px, 3vw, 18px); }
  .lh__corner--right { right: clamp(12px, 3vw, 18px); }

  .lh__icon-btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--lh-stroke);
    background: rgba(248, 248, 242, 0.18);
    color: var(--lh-text);
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      inset 0 1px 0 rgba(248, 248, 242, 0.2),
      0 4px 14px -6px rgba(15, 24, 20, 0.4);
    transition:
      background 280ms ease,
      transform 320ms var(--lh-spring),
      border-color 280ms ease;
    will-change: transform;
  }
  .lh__icon-btn:hover {
    background: rgba(248, 248, 242, 0.28);
    transform: scale(1.06);
    border-color: rgba(248, 248, 242, 0.32);
  }
  .lh__icon-btn:active { transform: scale(0.92); transition-duration: 120ms; }
  .lh__icon-btn:focus-visible { outline: 2px solid var(--lh-accent); outline-offset: 3px; }

  /* ===== Header ===== */
  .lh__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding-top: clamp(20px, 5vw, 28px);
  }
  .lh__avatar {
    width: clamp(96px, 26vw, 120px);
    height: clamp(96px, 26vw, 120px);
    border-radius: 50%;
    background: var(--lh-card-tint);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow:
      0 18px 40px -14px rgba(15, 24, 20, 0.7),
      inset 0 0 0 4px rgba(248, 248, 242, 0.08),
      inset 0 1px 0 rgba(248, 248, 242, 0.18);
    opacity: 0;
    transform: scale(0.6);
    animation:
      lh-avatar-pop 800ms var(--lh-spring) 220ms forwards,
      lh-avatar-float 6s ease-in-out 1.4s infinite;
    will-change: transform;
  }
  .lh__avatar img { width: 60%; height: 60%; object-fit: contain; }

  .lh__title {
    margin: 0;
    font-size: clamp(22px, 5.4vw, 28px);
    font-weight: 700;
    letter-spacing: 0.32em;
    line-height: 1.1;
    color: var(--lh-text);
    text-shadow: 0 2px 22px rgba(15, 24, 20, 0.4);
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    animation: lh-rise 700ms var(--lh-ease-soft) 400ms forwards;
  }
  .lh__tagline {
    margin: 0;
    font-size: clamp(11px, 3vw, 13px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lh-text-soft);
    opacity: 0;
    transform: translate3d(0, 8px, 0);
    animation: lh-rise 600ms var(--lh-ease-soft) 500ms forwards;
  }

  /* ===== Notes ===== */
  .lh__notes {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lh__note {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 999px;
    background: rgba(86, 115, 79, 0.22);
    border: 1px solid rgba(86, 115, 79, 0.45);
    box-shadow: inset 0 1px 0 rgba(248, 248, 242, 0.1);
    font-size: 13px;
    color: var(--lh-text);
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    animation: lh-rise 600ms var(--lh-ease-soft) calc(560ms + var(--i, 0) * 80ms) forwards;
  }
  .lh__note-icon { width: 20px; height: 20px; flex: 0 0 20px; }

  /* ===== Link buttons ===== */
  .lh__links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 4px;
  }
  .lh__link {
    --link-bg: color-mix(in srgb, var(--lh-card-tint) calc(var(--lh-card-opacity) * 100%), transparent);
    --mx: 50%;
    --my: 50%;

    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 24px;
    align-items: center;
    min-height: 64px;
    padding: 8px 14px 8px 8px;
    border-radius: 18px;
    background: var(--link-bg, rgba(86, 115, 79, 0.6));
    border: 1px solid rgba(248, 248, 242, 0.18);
    color: var(--lh-text);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    box-shadow: var(--lh-shadow-link);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    animation: lh-rise 650ms var(--lh-spring) calc(640ms + var(--i, 0) * 70ms) forwards;
    transition:
      transform 380ms var(--lh-spring),
      box-shadow 380ms var(--lh-ease),
      border-color 320ms ease;
    will-change: transform;
  }
  /* Cursor-tracked spotlight */
  .lh__link::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(180px circle at var(--mx) var(--my),
      rgba(248, 248, 242, 0.22), transparent 60%);
    opacity: 0;
    transition: opacity 320ms ease;
    z-index: 0;
  }
  .lh__link > * { position: relative; z-index: 1; }
  .lh__link:hover::before { opacity: 1; }
  .lh__link:hover {
    transform: translate3d(0, -3px, 0);
    box-shadow:
      0 20px 40px -16px rgba(15, 24, 20, 0.6),
      inset 0 1px 0 rgba(248, 248, 242, 0.2);
    border-color: rgba(248, 248, 242, 0.32);
  }
  .lh__link:active {
    transform: translate3d(0, 0, 0) scale(0.985);
    transition-duration: 140ms;
  }
  .lh__link:focus-visible { outline: 2px solid var(--lh-accent); outline-offset: 3px; }

  .lh__link--featured {
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--lh-card-tint) 88%, white 12%) 0%,
      var(--lh-card-tint) 100%);
    border-color: rgba(248, 248, 242, 0.42);
    box-shadow:
      0 16px 34px -14px rgba(15, 24, 20, 0.6),
      inset 0 1px 0 rgba(248, 248, 242, 0.24);
  }

  .lh__link-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(248, 248, 242, 0.92);
    color: #2B3C35;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
    transition: transform 360ms var(--lh-spring);
  }
  .lh__link:hover .lh__link-icon { transform: scale(1.06) rotate(-1.5deg); }
  .lh__link-icon img { width: 100%; height: 100%; object-fit: cover; }

  .lh__link-label {
    text-align: center;
    font-size: clamp(14px, 3.6vw, 15px);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.25;
    padding-inline: 8px;
  }

  .lh__link-tail {
    opacity: 0.6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 320ms var(--lh-spring), opacity 280ms ease;
  }
  .lh__link:hover .lh__link-tail { opacity: 1; transform: translateX(3px); }

  /* Shimmer sweep on hover */
  .lh__link-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(120deg,
      transparent 30%,
      rgba(248, 248, 242, 0.22) 50%,
      transparent 70%);
    transform: translateX(-120%);
    transition: transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }
  .lh__link:hover .lh__link-shine { transform: translateX(120%); }
  /* Featured: ambient auto-shimmer every ~7s */
  .lh__link--featured .lh__link-shine {
    animation: lh-shine-loop 7s cubic-bezier(0.4, 0, 0.2, 1) 3s infinite;
  }

  .lh__empty {
    text-align: center;
    color: var(--lh-text-mute);
    font-size: 13px;
    margin: 24px 0;
  }

  /* ===== Socials ===== */
  .lh__socials {
    list-style: none;
    margin: 14px auto 0;
    padding: 5px 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-wrap: wrap;
    width: fit-content;
    max-width: 100%;
    background: rgba(248, 248, 242, 0.05);
    border: 1px solid rgba(248, 248, 242, 0.08);
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .lh__socials li {
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    animation: lh-rise 500ms var(--lh-spring) calc(950ms + var(--i, 0) * 60ms) forwards;
  }
  .lh__social {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--lh-text);
    border-radius: 999px;
    transition:
      transform 360ms var(--lh-spring),
      color 240ms ease,
      background 240ms ease;
  }
  .lh__social svg { width: 18px; height: 18px; }
  .lh__social:hover {
    transform: translate3d(0, -2px, 0) scale(1.08);
    background: rgba(248, 248, 242, 0.12);
    color: #fff;
  }
  .lh__social:focus-visible { outline: 2px solid var(--lh-accent); outline-offset: 3px; }

  @media (max-width: 360px) {
    .lh__socials { padding: 4px 6px; gap: 2px; }
    .lh__social { width: 34px; height: 34px; }
    .lh__social svg { width: 16px; height: 16px; }
  }

  .lh__credit {
    margin: 8px 0 0;
    text-align: center;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lh-text-mute);
    opacity: 0;
    animation: lh-fade 500ms ease 1300ms forwards;
  }

  /* ===== Menu modal — upselling story panel ===== */
  .lh__menu {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .lh__menu[hidden] { display: none; }

  .lh__menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 24, 20, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
  }
  .lh__menu.is-open .lh__menu-backdrop { animation: lh-fade 260ms ease forwards; }

  .lh__menu-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    border-radius: 28px;
    padding: clamp(28px, 6vw, 36px) clamp(20px, 5vw, 28px) clamp(22px, 5vw, 28px);
    background: linear-gradient(180deg, #FBFBF5 0%, #F4F4EC 100%);
    color: #2B3C35;
    box-shadow:
      0 40px 100px -28px rgba(15, 24, 20, 0.55),
      0 16px 48px -20px rgba(15, 24, 20, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: scale(0.94) translate3d(0, 12px, 0);
    -webkit-overflow-scrolling: touch;
  }
  .lh__menu.is-open .lh__menu-card {
    animation: lh-menu-pop 460ms var(--lh-spring) forwards;
  }
  .lh__menu-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse 70% 40% at 50% 0%,
      rgba(86, 115, 79, 0.14), transparent 70%);
  }

  .lh__menu-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 0;
    background: rgba(43, 60, 53, 0.08);
    color: #2B3C35;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 220ms ease, transform 360ms var(--lh-spring);
    z-index: 2;
  }
  .lh__menu-close:hover { background: rgba(43, 60, 53, 0.16); transform: rotate(90deg); }
  .lh__menu-close:focus-visible { outline: 2px solid #56734F; outline-offset: 2px; }

  .lh__menu-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #56734F;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__menu-kicker::before {
    content: '';
    width: 22px;
    height: 1px;
    background: currentColor;
    display: inline-block;
    opacity: 0.6;
  }
  .lh__menu.is-open .lh__menu-kicker {
    animation: lh-rise 540ms var(--lh-ease) 160ms forwards;
  }

  .lh__menu-headline {
    margin: 0;
    font-size: clamp(22px, 5vw, 26px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: #1d2a24;
    text-wrap: balance;
    opacity: 0;
    transform: translate3d(0, 10px, 0);
  }
  .lh__menu.is-open .lh__menu-headline {
    animation: lh-rise 640ms var(--lh-ease) 240ms forwards;
  }

  .lh__menu-body {
    font-size: 14px;
    line-height: 1.65;
    color: #4F5C53;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__menu.is-open .lh__menu-body {
    animation: lh-rise 540ms var(--lh-ease) 320ms forwards;
  }
  .lh__menu-body p { margin: 0; }
  .lh__menu-body p + p { margin-top: 8px; }
  .lh__menu-body a { color: #56734F; text-decoration: underline; }

  /* Product upsell card */
  .lh__menu-product {
    position: relative;
    display: grid;
    grid-template-columns: 68px minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 14px;
    row-gap: 14px;
    align-items: start;
    padding: 16px 16px 14px;
    margin-top: 8px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(86, 115, 79, 0.1), rgba(86, 115, 79, 0.04));
    border: 1px solid rgba(86, 115, 79, 0.2);
    color: #2B3C35;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 6px 18px -10px rgba(15, 24, 20, 0.18);
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      transform 380ms var(--lh-spring),
      box-shadow 380ms var(--lh-ease),
      border-color 280ms ease;
    will-change: transform;
  }
  .lh__menu.is-open .lh__menu-product {
    animation: lh-rise 660ms var(--lh-spring) 400ms forwards;
  }
  .lh__menu-product:hover {
    transform: translate3d(0, -3px, 0);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      0 18px 36px -16px rgba(86, 115, 79, 0.4);
    border-color: rgba(86, 115, 79, 0.4);
  }
  .lh__menu-product:active {
    transform: translate3d(0, 0, 0) scale(0.99);
    transition-duration: 140ms;
  }
  .lh__menu-product:focus-visible { outline: 2px solid #56734F; outline-offset: 3px; }
  .lh__menu-product > *:not(.lh__menu-product-shine) { position: relative; z-index: 1; }

  .lh__menu-product-shine {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(120deg,
      transparent 30%,
      rgba(255, 255, 255, 0.45) 50%,
      transparent 70%);
    transform: translateX(-130%);
    z-index: 0;
  }
  .lh__menu.is-open .lh__menu-product-shine {
    animation: lh-shine-loop 6.5s cubic-bezier(0.4, 0, 0.2, 1) 1.6s infinite;
  }

  .lh__menu-product-thumb {
    grid-column: 1;
    grid-row: 1;
    width: 68px;
    height: 68px;
    border-radius: 14px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(86, 115, 79, 0.18), rgba(86, 115, 79, 0.08));
    color: #56734F;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
    transition: transform 380ms var(--lh-spring);
  }
  .lh__menu-product:hover .lh__menu-product-thumb { transform: scale(1.05) rotate(-2deg); }
  .lh__menu-product-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .lh__menu-product-body {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    padding-top: 2px;
  }
  .lh__menu-product-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #56734F;
    margin-bottom: 2px;
  }
  .lh__menu-product-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #56734F;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(86, 115, 79, 0.5);
    animation: lh-pulse 2.4s ease-in-out infinite;
  }
  .lh__menu-product-title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: #1d2a24;
    text-wrap: balance;
  }
  .lh__menu-product-outcomes {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #56734F;
    margin-top: 4px;
  }
  .lh__menu-product-pitch {
    font-size: 12px;
    line-height: 1.5;
    color: #5C6A60;
    margin-top: 2px;
  }
  .lh__menu-product-cta {
    grid-column: 1 / -1;
    grid-row: 2;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 11px 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FBFBF5;
    background: linear-gradient(135deg, #56734F 0%, #455e41 100%);
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 6px 14px -8px rgba(86, 115, 79, 0.55);
    transition:
      transform 320ms var(--lh-spring),
      box-shadow 280ms ease,
      background 280ms ease;
  }
  .lh__menu-product-cta svg { flex-shrink: 0; }
  .lh__menu-product-cta-label { display: inline-block; }
  .lh__menu-product:hover .lh__menu-product-cta {
    background: linear-gradient(135deg, #5f8057 0%, #4a6646 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 10px 22px -10px rgba(86, 115, 79, 0.7);
  }
  .lh__menu-product:hover .lh__menu-product-cta svg { transform: translateX(3px); }
  .lh__menu-product-cta svg { transition: transform 320ms var(--lh-spring); }

  .lh__menu-secondary {
    align-self: center;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #56734F;
    text-decoration: none;
    border-radius: 999px;
    transition: background 220ms ease, transform 320ms var(--lh-spring);
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__menu.is-open .lh__menu-secondary {
    animation: lh-rise 520ms var(--lh-ease) 520ms forwards;
  }
  .lh__menu-secondary:hover { background: rgba(86, 115, 79, 0.1); }
  .lh__menu-secondary svg { transition: transform 280ms var(--lh-spring); }
  .lh__menu-secondary:hover svg { transform: translateX(3px); }
  .lh__menu-secondary:focus-visible { outline: 2px solid #56734F; outline-offset: 2px; }

  /* ===== Share modal — branded share sheet ===== */
  .lh__share {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .lh__share[hidden] { display: none; }

  .lh__share-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 24, 20, 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
  }
  .lh__share.is-open .lh__share-backdrop { animation: lh-fade 260ms ease forwards; }

  .lh__share-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    border-radius: 28px;
    padding: clamp(28px, 6vw, 36px) clamp(20px, 5vw, 28px) clamp(22px, 5vw, 26px);
    background: linear-gradient(180deg, #FBFBF5 0%, #F4F4EC 100%);
    color: #2B3C35;
    box-shadow:
      0 40px 100px -28px rgba(15, 24, 20, 0.55),
      0 16px 48px -20px rgba(15, 24, 20, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    display: flex;
    flex-direction: column;
    gap: 14px;
    opacity: 0;
    transform: scale(0.94) translate3d(0, 12px, 0);
    -webkit-overflow-scrolling: touch;
  }
  .lh__share.is-open .lh__share-card {
    animation: lh-menu-pop 460ms var(--lh-spring) forwards;
  }
  .lh__share-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(ellipse 70% 40% at 50% 0%,
      rgba(86, 115, 79, 0.14), transparent 70%);
  }

  .lh__share-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #56734F;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__share-kicker::before {
    content: '';
    width: 22px;
    height: 1px;
    background: currentColor;
    display: inline-block;
    opacity: 0.6;
  }
  .lh__share.is-open .lh__share-kicker {
    animation: lh-rise 540ms var(--lh-ease) 160ms forwards;
  }

  .lh__share-headline {
    margin: 0;
    font-size: clamp(22px, 5vw, 26px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: #1d2a24;
    text-wrap: balance;
    opacity: 0;
    transform: translate3d(0, 10px, 0);
  }
  .lh__share.is-open .lh__share-headline {
    animation: lh-rise 640ms var(--lh-ease) 240ms forwards;
  }

  .lh__share-sub {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: #5C6A60;
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__share.is-open .lh__share-sub {
    animation: lh-rise 540ms var(--lh-ease) 320ms forwards;
  }

  /* Copy link button */
  .lh__share-copy {
    position: relative;
    display: grid;
    grid-template-columns: 40px 1fr;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
    padding: 12px 14px;
    border-radius: 16px;
    background: rgba(86, 115, 79, 0.08);
    border: 1px dashed rgba(86, 115, 79, 0.32);
    color: #2B3C35;
    cursor: pointer;
    text-align: left;
    overflow: hidden;
    isolation: isolate;
    transition:
      background 240ms ease,
      border-color 240ms ease,
      transform 320ms var(--lh-spring);
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    will-change: transform;
  }
  .lh__share.is-open .lh__share-copy {
    animation: lh-rise 600ms var(--lh-spring) 400ms forwards;
  }
  .lh__share-copy:hover {
    background: rgba(86, 115, 79, 0.14);
    border-color: rgba(86, 115, 79, 0.5);
    transform: translate3d(0, -2px, 0);
  }
  .lh__share-copy:active { transform: translate3d(0, 0, 0) scale(0.99); transition-duration: 140ms; }
  .lh__share-copy:focus-visible { outline: 2px solid #56734F; outline-offset: 3px; }
  .lh__share-copy.is-copied {
    background: rgba(86, 115, 79, 0.18);
    border-style: solid;
    border-color: rgba(86, 115, 79, 0.55);
  }

  .lh__share-copy-icon {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgba(86, 115, 79, 0.18);
    color: #56734F;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }
  .lh__share-copy-icon-default,
  .lh__share-copy-icon-success {
    position: absolute;
    inset: 0;
    margin: auto;
    transition: transform 360ms var(--lh-spring), opacity 240ms ease;
  }
  .lh__share-copy-icon-success {
    opacity: 0;
    transform: scale(0.4) rotate(-30deg);
  }
  .lh__share-copy.is-copied .lh__share-copy-icon-default {
    opacity: 0;
    transform: scale(0.4) rotate(30deg);
  }
  .lh__share-copy.is-copied .lh__share-copy-icon-success {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .lh__share-copy-text {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 38px;
  }
  .lh__share-copy-state {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    transition: opacity 240ms ease, transform 320ms var(--lh-spring);
  }
  .lh__share-copy-state--done {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(8px);
  }
  .lh__share-copy.is-copied .lh__share-copy-state--idle {
    opacity: 0;
    transform: translateY(-6px);
  }
  .lh__share-copy.is-copied .lh__share-copy-state--done {
    opacity: 1;
    transform: translateY(0);
  }
  .lh__share-copy-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #56734F;
  }
  .lh__share-copy-url {
    font-size: 13px;
    font-weight: 500;
    color: #4F5C53;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* "or send via" divider */
  .lh__share-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    color: rgba(43, 60, 53, 0.45);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0;
  }
  .lh__share.is-open .lh__share-divider {
    animation: lh-fade 400ms ease 520ms forwards;
  }
  .lh__share-divider::before,
  .lh__share-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(43, 60, 53, 0.18), transparent);
  }

  /* Channel buttons */
  .lh__share-channels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }
  .lh__share-channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #4F5C53;
    border-radius: 14px;
    padding: 6px 4px;
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition: transform 320ms var(--lh-spring), color 200ms ease;
  }
  .lh__share.is-open .lh__share-channel {
    animation: lh-rise 540ms var(--lh-spring) calc(580ms + var(--c, 0) * 70ms) forwards;
  }
  .lh__share-channel-bubble {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      0 8px 18px -10px rgba(15, 24, 20, 0.4);
    transition:
      transform 360ms var(--lh-spring),
      box-shadow 320ms var(--lh-ease);
    will-change: transform;
  }
  .lh__share-channel-bubble[data-brand="whatsapp"] { background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); }
  .lh__share-channel-bubble[data-brand="telegram"] { background: linear-gradient(135deg, #2AABEE 0%, #229ED9 100%); }
  .lh__share-channel-bubble[data-brand="x"]        { background: linear-gradient(135deg, #1d2a24 0%, #0f1814 100%); }
  .lh__share-channel-bubble[data-brand="email"]    { background: linear-gradient(135deg, #56734F 0%, #455e41 100%); }
  .lh__share-channel:hover .lh__share-channel-bubble {
    transform: translate3d(0, -4px, 0) scale(1.06) rotate(-3deg);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 16px 28px -12px rgba(15, 24, 20, 0.5);
  }
  .lh__share-channel:active .lh__share-channel-bubble {
    transform: translate3d(0, 0, 0) scale(0.95);
    transition-duration: 120ms;
  }
  .lh__share-channel:focus-visible { outline: 2px solid #56734F; outline-offset: 4px; }
  .lh__share-channel-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #5C6A60;
  }

  /* Native share fallback button */
  .lh__share-native {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
    padding: 12px 16px;
    border-radius: 999px;
    border: 1px solid rgba(86, 115, 79, 0.3);
    background: transparent;
    color: #56734F;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 220ms ease, transform 320ms var(--lh-spring);
    opacity: 0;
    transform: translate3d(0, 8px, 0);
  }
  .lh__share-native[hidden] { display: none !important; }
  .lh__share-native:not([hidden]) { display: inline-flex; }
  .lh__share.is-open .lh__share-native:not([hidden]) {
    animation: lh-rise 520ms var(--lh-ease) 920ms forwards;
  }
  .lh__share-native:hover { background: rgba(86, 115, 79, 0.08); transform: translate3d(0, -1px, 0); }
  .lh__share-native:active { transform: translate3d(0, 0, 0) scale(0.98); transition-duration: 140ms; }
  .lh__share-native:focus-visible { outline: 2px solid #56734F; outline-offset: 2px; }

  /* ===== Keyframes ===== */
  @keyframes lh-fade { to { opacity: 1; } }
  @keyframes lh-rise {
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  @keyframes lh-shell-rise {
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }
  @keyframes lh-pop {
    from { opacity: 0; transform: scale(0.94) translateY(8px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes lh-avatar-pop {
    0%   { opacity: 0; transform: scale(0.6); }
    60%  { opacity: 1; transform: scale(1.05); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes lh-avatar-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50%      { transform: translate3d(0, -4px, 0); }
  }
  @keyframes lh-bg-drift {
    0%   { transform: scale(1.08) translate3d(0, 0, 0); }
    100% { transform: scale(1.14) translate3d(-1.2%, -1.2%, 0); }
  }
  @keyframes lh-shine-loop {
    0%, 100% { transform: translateX(-130%); }
    50%      { transform: translateX(130%); }
  }
  @keyframes lh-menu-pop {
    to { opacity: 1; transform: scale(1) translate3d(0, 0, 0); }
  }
  @keyframes lh-pulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(86, 115, 79, 0.5); }
    50%      { transform: scale(1.35); box-shadow: 0 0 0 5px rgba(86, 115, 79, 0); }
  }

  /* ===== Reduced motion ===== */
  @media (prefers-reduced-motion: reduce) {
    .lh__shell, .lh__avatar, .lh__title, .lh__tagline, .lh__corner,
    .lh__credit, .lh__link, .lh__socials li, .lh__bg-img, .lh__note,
    .lh__menu-backdrop, .lh__menu-card, .lh__link--featured .lh__link-shine,
    .lh__menu-kicker, .lh__menu-headline, .lh__menu-body,
    .lh__menu-product, .lh__menu-secondary, .lh__menu-product-shine,
    .lh__menu-product-badge-dot,
    .lh__share-backdrop, .lh__share-card, .lh__share-kicker,
    .lh__share-headline, .lh__share-sub, .lh__share-copy,
    .lh__share-divider, .lh__share-channel, .lh__share-native {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .lh__link, .lh__icon-btn, .lh__social, .lh__avatar, .lh__link-tail,
    .lh__link-shine, .lh__link-icon, .lh__menu-close,
    .lh__menu-product, .lh__menu-product-thumb, .lh__menu-product-cta,
    .lh__menu-secondary, .lh__menu-secondary svg,
    .lh__share-copy, .lh__share-channel-bubble, .lh__share-native,
    .lh__share-copy-icon-default, .lh__share-copy-icon-success,
    .lh__share-copy-state {
      transition: none !important;
    }
    .lh__link:hover, .lh__social:hover, .lh__icon-btn:hover,
    .lh__menu-product:hover, .lh__menu-close:hover,
    .lh__share-copy:hover, .lh__share-native:hover { transform: none; }
    .lh__link:hover .lh__link-icon,
    .lh__menu-product:hover .lh__menu-product-thumb,
    .lh__menu-product:hover .lh__menu-product-cta,
    .lh__menu-secondary:hover svg,
    .lh__share-channel:hover .lh__share-channel-bubble { transform: none; }
  }

  /* ===== Tiny screens ===== */
  @media (max-width: 360px) {
    .lh__shell { padding: 22px 14px 20px; gap: 16px; }
    .lh__head { padding-top: 16px; }
    .lh__link { grid-template-columns: 48px 1fr 20px; min-height: 60px; }
    .lh__link-icon { width: 44px; height: 44px; border-radius: 10px; }
  }

  /* ===== Wider screens ===== */
  @media (min-width: 768px) {
    .lh { padding-top: 48px; padding-bottom: 48px; }
  }
{% endstyle %}

<script>
(function () {
  var prefersReduce = window.matchMedia
    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* === Cursor-tracked spotlight on link buttons (rAF-throttled) === */
  if (!prefersReduce && window.matchMedia('(hover: hover)').matches) {
    document.querySelectorAll('[data-lh-link]').forEach(function (el) {
      var raf = null;
      el.addEventListener('mousemove', function (e) {
        if (raf) cancelAnimationFrame(raf);
        var rect = el.getBoundingClientRect();
        var x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
        var y = ((e.clientY - rect.top) / rect.height * 100).toFixed(1);
        raf = requestAnimationFrame(function () {
          el.style.setProperty('--mx', x + '%');
          el.style.setProperty('--my', y + '%');
        });
      }, { passive: true });
      el.addEventListener('mouseleave', function () {
        el.style.setProperty('--mx', '50%');
        el.style.setProperty('--my', '50%');
      });
    });
  }

  /* === Branded share modal === */
  var shareModal = document.querySelector('[data-lh-share-menu]');
  if (shareModal) {
    var shareTriggers = document.querySelectorAll('[data-lh-share]');
    var shareClosers = shareModal.querySelectorAll('[data-lh-share-close]');
    var shareUrlEl = shareModal.querySelector('[data-lh-share-url]');
    var copyBtn = shareModal.querySelector('[data-lh-share-copy]');
    var nativeBtn = shareModal.querySelector('[data-lh-share-native]');
    var channels = shareModal.querySelectorAll('[data-lh-share-channel]');
    var lastShareFocused = null;
    var shareTitle = '';
    var shareText = '';

    function buildChannelUrls() {
      var url = window.location.href;
      var encodedUrl = encodeURIComponent(url);
      var encodedText = encodeURIComponent(shareTitle);
      var encodedBody = encodeURIComponent(shareText ? shareText + ' — ' + url : url);

      channels.forEach(function (a) {
        var brand = a.getAttribute('data-lh-share-channel');
        if (brand === 'whatsapp') {
          a.href = 'https://wa.me/?text=' + encodedText + '%20' + encodedUrl;
        } else if (brand === 'telegram') {
          a.href = 'https://t.me/share/url?url=' + encodedUrl + '&text=' + encodedText;
        } else if (brand === 'x') {
          a.href = 'https://twitter.com/intent/tweet?url=' + encodedUrl + '&text=' + encodedText;
        } else if (brand === 'email') {
          a.href = 'mailto:?subject=' + encodedText + '&body=' + encodedBody;
        }
      });

      if (shareUrlEl) {
        var pretty = url
          .replace(/^https?:\/\//, '')
          .replace(/\/$/, '');
        shareUrlEl.textContent = pretty.length > 42 ? pretty.slice(0, 40) + '…' : pretty;
      }

      if (nativeBtn) {
        if (navigator.share) nativeBtn.removeAttribute('hidden');
        else nativeBtn.setAttribute('hidden', '');
      }
    }

    function openShare(triggerBtn) {
      lastShareFocused = document.activeElement;
      shareTitle = (triggerBtn && triggerBtn.getAttribute('data-lh-share-title'))
        || document.title;
      shareText = (triggerBtn && triggerBtn.getAttribute('data-lh-share-text')) || '';
      buildChannelUrls();
      shareModal.hidden = false;
      void shareModal.offsetWidth;
      shareModal.classList.add('is-open');
      if (copyBtn) copyBtn.classList.remove('is-copied');
      var firstFocusable = shareModal.querySelector('.lh__menu-close');
      if (firstFocusable) firstFocusable.focus();
      document.addEventListener('keydown', onShareKey);
      document.body.style.overflow = 'hidden';
    }
    function closeShare() {
      shareModal.classList.remove('is-open');
      shareModal.hidden = true;
      document.removeEventListener('keydown', onShareKey);
      document.body.style.overflow = '';
      if (lastShareFocused && lastShareFocused.focus) lastShareFocused.focus();
    }
    function onShareKey(e) { if (e.key === 'Escape') closeShare(); }

    shareTriggers.forEach(function (b) {
      b.addEventListener('click', function () { openShare(b); });
    });
    shareClosers.forEach(function (b) { b.addEventListener('click', closeShare); });

    /* Copy link with success state */
    if (copyBtn) {
      var copyResetTimer = null;
      copyBtn.addEventListener('click', function () {
        var url = window.location.href;
        var done = function () {
          copyBtn.classList.add('is-copied');
          if (copyResetTimer) clearTimeout(copyResetTimer);
          copyResetTimer = setTimeout(function () {
            copyBtn.classList.remove('is-copied');
          }, 2200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done).catch(function () {
            // fall back to legacy
            try {
              var ta = document.createElement('textarea');
              ta.value = url;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              done();
            } catch (_) {}
          });
        }
      });
    }

    /* Native OS share — opens device share sheet */
    if (nativeBtn) {
      nativeBtn.addEventListener('click', function () {
        if (!navigator.share) return;
        navigator.share({
          title: shareTitle || document.title,
          text: shareText,
          url: window.location.href
        }).catch(function () {});
      });
    }

    /* Track channel clicks for analytics */
    channels.forEach(function (a) {
      a.addEventListener('click', function () {
        try {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'links_hub_share', {
              channel: a.getAttribute('data-lh-share-channel')
            });
          }
        } catch (_) {}
        // dismiss after a tick
        setTimeout(closeShare, 200);
      });
    });
  }

  /* === Menu modal — choreographed open/close === */
  var menu = document.querySelector('[data-lh-menu]');
  if (menu) {
    var openers = document.querySelectorAll('[data-lh-menu-trigger]');
    var closers = document.querySelectorAll('[data-lh-menu-close]');
    var lastFocused = null;

    function open() {
      lastFocused = document.activeElement;
      menu.hidden = false;
      // Force a reflow so the staggered child animations restart from frame 0.
      void menu.offsetWidth;
      menu.classList.add('is-open');
      var closeBtn = menu.querySelector('.lh__menu-close');
      if (closeBtn) closeBtn.focus();
      document.addEventListener('keydown', onKey);
      document.body.style.overflow = 'hidden';
    }
    function close() {
      menu.classList.remove('is-open');
      menu.hidden = true;
      document.removeEventListener('keydown', onKey);
      document.body.style.overflow = '';
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }
    function onKey(e) { if (e.key === 'Escape') close(); }
    openers.forEach(function (b) { b.addEventListener('click', open); });
    closers.forEach(function (b) { b.addEventListener('click', close); });
  }

  /* === Product CTA tracking (separate event for upsell card) === */
  document.querySelectorAll('[data-lh-product]').forEach(function (a) {
    a.addEventListener('click', function () {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'links_hub_upsell_click', {
            link_url: a.href,
            link_label: (a.querySelector('.lh__menu-product-title') || {}).textContent || ''
          });
        }
      } catch (_) {}
    });
  });

  /* === Lightweight click-tracking hook (fires gtag if present) === */
  document.querySelectorAll('[data-lh-link]').forEach(function (a) {
    a.addEventListener('click', function () {
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'links_hub_click', {
            link_url: a.href,
            link_label: (a.querySelector('.lh__link-label') || {}).textContent || ''
          });
        }
      } catch (_) {}
    });
  });
})();
</script>

