{%- liquid
  if section.settings.product
    assign cta_url = section.settings.product.url
  else
    assign cta_url = routes.all_products_collection_url
  endif
-%}
<section class="og-proof og-section">
  <div class="og-container og-proof__wrap">
    <h2 class="og-visually-hidden">{{ 'oil_guide.proof.heading' | t }}</h2>

    <div
      class="og-proof__rating"
      role="img"
      aria-label="{{ 'oil_guide.proof.rating_aria' | t }}"
    >
      <img
        src="{{ 'oil-guide-stars.svg' | asset_url }}"
        alt=""
        width="272"
        height="58"
        loading="lazy"
        decoding="async"
        class="og-proof__stars"
      >
      <span class="og-proof__score" aria-hidden="true">{{ 'oil_guide.proof.rating' | t }}</span>
    </div>

    <p class="og-proof__count">{{ 'oil_guide.proof.customers_html' | t }}</p>

    <blockquote class="og-proof__quote">
      <p class="og-proof__text">
        <img
          src="{{ 'oil-guide-quote-open.png' | asset_url }}"
          alt=""
          width="500"
          height="395"
          loading="lazy"
          decoding="async"
          class="og-proof__mark og-proof__mark--open"
        >
        {{ 'oil_guide.proof.quote' | t }}
        <img
          src="{{ 'oil-guide-quote-close.png' | asset_url }}"
          alt=""
          width="499"
          height="395"
          loading="lazy"
          decoding="async"
          class="og-proof__mark og-proof__mark--close"
        >
        <span class="og-proof__attr">{{ 'oil_guide.proof.attribution' | t }}</span>
      </p>
    </blockquote>

    <a class="og-proof__cta" href="{{ cta_url }}">{{ 'oil_guide.proof.cta' | t }}</a>

    <p class="og-proof__guarantee">{{ 'oil_guide.proof.guarantee' | t }}</p>
  </div>
</section>

{% style %}
  .og-proof {
    padding-top: var(--og-gap-block);
  }

  .og-proof__wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .og-proof__rating {
    display: flex;
    align-items: center;
    gap: calc(22 * var(--og-u));
  }

  .og-proof__stars {
    width: calc(272 * var(--og-u));
    height: auto;
  }

  .og-proof__score {
    font-size: calc(45 * var(--og-u));
    font-weight: 700;
    line-height: 1.21;
    color: var(--og-ink);
  }

  .og-proof__count {
    margin: calc(14 * var(--og-u)) 0 0;
    font-size: calc(75 * var(--og-u));
    font-weight: 700;
    line-height: 1.21;
    color: var(--og-ink);
  }

  .og-proof__quote {
    max-width: calc(981 * var(--og-u));
    margin: calc(47 * var(--og-u)) 0 0;
    padding: 0;
  }

  .og-proof__text {
    margin: 0;
    font-size: calc(45 * var(--og-u));
    line-height: 1.25;
    color: var(--og-ink);
  }

  .og-proof__attr {
    display: inline-block;
    margin-left: 0.6em;
    font-size: calc(35 * var(--og-u));
    white-space: nowrap;
  }

  .og-proof__mark {
    display: inline-block;
    width: auto;
  }

  .og-proof__mark--open {
    height: calc(44 * var(--og-u));
    margin-right: calc(16 * var(--og-u));
    vertical-align: -0.06em;
  }

  .og-proof__mark--close {
    height: calc(44 * var(--og-u));
    margin: 0 calc(14 * var(--og-u)) 0 calc(14 * var(--og-u));
    vertical-align: -0.55em;
  }

  .og-proof__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: calc(38 * var(--og-u));
    height: calc(100 * var(--og-u));
    padding: 0 calc(72 * var(--og-u));
    border-radius: calc(150 * var(--og-u));
    background: var(--og-ink);
    font-size: calc(45 * var(--og-u));
    line-height: 1;
    color: var(--og-cream);
    text-decoration: none;
  }

  .og-proof__cta:hover {
    opacity: 0.92;
  }

  .og-proof__guarantee {
    margin: calc(73 * var(--og-u)) 0 0;
    font-size: calc(45 * var(--og-u));
    line-height: 1.3;
    color: var(--og-ink);
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Social Proof",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produk tujuan CTA"
    }
  ],
  "presets": [
    {
      "name": "OG Social Proof"
    }
  ]
}
{% endschema %}
