<div class="lp-steps lp-steps--{{ section.settings.background }} lp-pad lp-reveal">
  <div class="lp-container">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-steps__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-steps__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="lp-steps__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="lp-steps__grid" style="--lp-steps-columns: {{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div class="lp-step" {{ block.shopify_attributes }}>
          {% if block.settings.emoji != blank %}
            <div class="lp-step__icon" aria-hidden="true">{{ block.settings.emoji }}</div>
          {% endif %}

          {% if block.settings.label != blank %}
            <div class="lp-step__label">{{ block.settings.label }}</div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="lp-h3 lp-step__title">{{ block.settings.title }}</h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <p class="lp-step__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-steps--cream {
    background: var(--lp-cream);
  }

  .lp-steps--bloom {
    background: var(--lp-bloom);
  }

  .lp-steps--surface {
    background: var(--lp-surface);
  }

  .lp-steps__eyebrow,
  .lp-steps__heading,
  .lp-steps__sub {
    text-align: center;
  }

  .lp-steps__eyebrow {
    margin-bottom: 0.75rem;
  }

  .lp-steps__heading {
    margin-bottom: 0.5rem;
  }

  .lp-steps__sub {
    max-width: 560px;
    margin: 0 auto 3rem;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
  }

  .lp-steps__grid {
    display: grid;
    grid-template-columns: repeat(var(--lp-steps-columns, 3), minmax(0, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin-inline: auto;
  }

  .lp-step {
    text-align: center;
  }

  .lp-step__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: var(--lp-bloom);
    font-size: 2rem;
  }

  .lp-steps--bloom .lp-step__icon {
    background: var(--lp-surface);
  }

  .lp-step__label {
    margin-bottom: 0.5rem;
    color: var(--lp-gold);
    font-family: var(--lp-font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .lp-step__title {
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
  }

  .lp-step__text {
    margin: 0;
    color: var(--lp-text-mid);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
  }

  @media screen and (max-width: 640px) {
    .lp-steps__grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Steps",
  "tag": "section",
  "class": "lp-steps-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kebiasaan Harian Tanpa Ribet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Ritual Inside Out"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Deskripsi",
      "default": "Dua menit sehari. Itu saja rutinitasnya."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Jumlah kolom (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "background",
      "label": "Latar",
      "options": [
        { "value": "cream", "label": "Krem terang" },
        { "value": "bloom", "label": "Krem alternatif" },
        { "value": "surface", "label": "Putih" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Langkah",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label kecil",
          "default": "PAGI"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Judul",
          "default": "Minum 3 Kapsul"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Deskripsi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
