<script type="application/json" data-variant-prices>
{
  "variants": [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "price": {{ v.price | default: 0 }},
        "original_price": {% if v.metafields.custom.original_price.value and v.metafields.custom.original_price.value != 0 %}{{ v.metafields.custom.original_price.value }}{% else %}{{ v.compare_at_price | default: 0 | divided_by: 100.0 | round }}{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
<div data-rating-badge>{{ product.metafields.judgeme.badge | replace: 'schema.org/AggregateRating', 'schema.org/None' }}</div>

{% schema %}
{
  "name": "Variant Compare Data",
  "settings": []
}
{% endschema %}
