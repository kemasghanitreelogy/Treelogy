{% assign selected_bundle = product.metafields.custom.bundle_set.value %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 2 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 2 }}px;
    }
  }
  .featured-bundle-section .description {
    padding-right: 0;
  }
  .inside-set-wrapper p {
    font-weight: 600;
  }
  .inside-set-content.rte ul {
    list-style: none;
    padding-left: 0;
  }
  .inside-set-content.rte li {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }
  .inside-set-content.rte li::before {
    content: "•";
    font-size: 1.2em;
    line-height: 1;
  }

  .featured-bundle-section .gallery-wrapper {
    transform: translateX(24px);
  }
  .featured-bundle-section .product-detail-wrapper {
    display: flex;
    flex-direction: column;
  }
  .bundle-gallery-grid {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .featured-bundle-section .section-heading {
    padding: 0 24px;
    color: #6c7256;
  }

  @media screen and (min-width: 749px) {
    .featured-bundle-section .section-heading {
      text-align: center;
      margin-bottom: 40px;
    }
  }

  .main-image-display {
    width: 100%;
    position: relative;
    border-radius: 8px;
    overflow: hidden;
  }

  .main-image-display img {
    width: 100%;
    height: auto;
    display: none;
    object-fit: cover;
    aspect-ratio: 1 / 1;
  }

  .main-image-display img.activeBundle {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  .slider-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .slider-row::-webkit-scrollbar {
    display: none;
  }

  .slider-item {
    flex-shrink: 0;
    cursor: pointer;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    border: 1px solid transparent;
    transition: border-color 0.2s;
    scroll-snap-align: start;
  }

  .slider-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slider-item.activeBundle {
    border-color: #000;
  }

  @media screen and (max-width: 749px) {
    .main-image-display {
      display: none;
    }

    .slider-row {
      gap: 3px;
      padding-right: 20px;
    }

    .slider-item {
      height: auto;
      aspect-ratio: 4 / 5;
    }
    .slider-item.activeBundle {
      border-color: transparent;
    }

    .slider-item {
      width: 55%;
      height: 190px;
    }
  }

  @media screen and (min-width: 750px) {
    .featured-bundle-section .product-detail-wrapper {
      flex-direction: row;
      column-gap: 40px;
    }
    .slider-item {
      width: 80px;
      height: 80px;
    }
    .slider-item:first-child {
      width: 80px;
    }
    .slider-row {
      display: none;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 1;
    }
  }

  .featured-bundle-section .protocol-variant-card.checkbox-button {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    min-height: 68px !important;
    padding: 14px 16px !important;
    gap: 12px !important;
    row-gap: 0 !important;
    cursor: default;
  }
  .featured-bundle-section .protocol-variant-card.checkbox-button.static-active {
    background-color: rgba(165, 187, 135, 0.25) !important;
  }
  .featured-bundle-section .protocol-variant-card .pv-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    gap: 10px;
  }
  .featured-bundle-section .protocol-variant-card .pv-info {
    flex: 1;
    min-width: 0;
  }
  .featured-bundle-section .protocol-variant-card .pv-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .featured-bundle-section .protocol-variant-card .pv-time {
    font-size: 16px;
    font-weight: 700;
    color: #2B3C35;
    line-height: 1.3;
  }
  .featured-bundle-section .protocol-variant-card .pv-daily {
    font-size: 12px;
    font-weight: 400;
    color: #515E56;
    line-height: 1.3;
  }
  .featured-bundle-section .protocol-variant-card .pv-desc {
    font-size: 14px;
    font-weight: 400;
    color: #515E56;
    margin-top: 2px;
    line-height: 1.4;
  }
  .featured-bundle-section .protocol-variant-card .pv-meta-desc {
    font-size: 13px;
    font-weight: 300;
    color: #515E56;
    margin-top: 4px;
    line-height: 1.4;
  }
  .featured-bundle-section .protocol-variant-card .pv-prices {
    text-align: right;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .featured-bundle-section .protocol-variant-card .pv-original {
    font-size: 12px;
    font-weight: 300;
    color: #6C7256;
    text-decoration: line-through;
    line-height: 1.4;
  }
  .featured-bundle-section .protocol-variant-card .pv-sale {
    font-size: 16px;
    font-weight: 700;
    color: #2B3C35;
    line-height: 1.3;
  }
  .featured-bundle-section .protocol-variant-card .pv-badge {
    top: -10px;
    right: -10px;
    display: flex;
    font-size: 14px;
    color: #F8F8F2;
    font-weight: 500;
    line-height: 125%;
    padding: 4px 12px;
    position: absolute;
    border-radius: 50px;
    align-items: center;
    justify-content: center;
    background-color: #526547;
    white-space: nowrap;
  }
  .featured-bundle-section .protocol-variant-card.checkbox-button.bundle-variant-hidden {
    display: none !important;
  }
{%- endstyle -%}

{% if selected_bundle != blank %}

  {% comment %} --- LOGIC TRANSLATION SETUP --- {% endcomment %}
  {% liquid
    if localization.language.iso_code == 'id'
      assign add_cart_text = 'Tambahkan ke Keranjang'
      assign sold_out_text = 'Habis'
      assign adding_text = 'Menambahkan...'
      assign added_text = 'Berhasil Ditambahkan!'
    else
      assign add_cart_text = 'Add to Cart'
      assign sold_out_text = 'Sold Out'
      assign adding_text = 'Adding...'
      assign added_text = 'Item Added!'
    endif
  %}

  {% assign current_variant = selected_bundle.selected_or_first_available_variant %}

  {% for variant in selected_bundle.variants %}
    {% if variant.metafields.custom.set_default == true %}
      {% assign current_variant = variant %}
      {% break %}
    {% endif %}
  {% endfor %}

  <div class="featured-bundle-section section-{{ section.id }} page-width section-{{ section.id }}-padding">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading text-center">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="bundle-grid product-detail-wrapper">

      <div class="gallery-wrapper">
        <div id="bundle-gallery-wrapper-{{ section.id }}" class="bundle-gallery-grid">
          <div class="main-image-display">
            {% for image in selected_bundle.images limit: 5 %}
              {% liquid
                assign bundle_class = ''
                if forloop.first
                  assign bundle_class = 'activeBundle'
                endif
              %}
              {{ image
                | image_url: width: 1000
                | image_tag:
                  widths: '375, 550, 750, 1000',
                  sizes: '(max-width: 749px) 100vw, 50vw',
                  loading: 'lazy',
                  alt: image.alt,
                  class: bundle_class,
                  data-index: forloop.index0
              }}
            {% endfor %}
          </div>
          <div class="slider-row">
            {% for image in selected_bundle.images limit: 5 %}
              <div class="slider-item {% if forloop.first %}activeBundle{% endif %}" data-index="{{ forloop.index0 }}">
                {{ image
                  | image_url: width: 600
                  | image_tag: widths: '300, 450, 600', sizes: '(max-width: 749px) 90vw, 600px', loading: 'lazy', alt: image.alt
                }}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {% comment %} DETAILS {% endcomment %}
      <div class="detail bundle-details">
        <div class="rating">
          {% render 'Rating' %}
        </div>

        <h1>{{ selected_bundle.title }}</h1>
        <div class="description body-desk">
          {{ selected_bundle.description }}
          {% assign inside_set = selected_bundle.metafields.custom.inside_set %}
          {% if inside_set != blank %}
            <div class="inside-set-wrapper">
              <p>
                {% if localization.language.iso_code == 'id' %}
                  Isi Set
                {% else %}
                  Inside the Set
                {% endif %}
              </p>

              <div class="inside-set-content rte">
                {{ inside_set | metafield_tag }}
              </div>
            </div>
          {% endif %}
        </div>

        <div class="bundle-purchase-area mt-8">
          <form
            action="/cart/add"
            method="post"
            enctype="multipart/form-data"
            id="AddToCartForm-{{ section.id }}">

            <div class="variant-button" id="VariantContainer-{{ section.id }}">
              {% if selected_bundle.has_only_default_variant == false %}
                {% for variant in selected_bundle.variants %}
                  {% assign v_compare_price = variant.compare_at_price %}
                  {% assign v_saving = 0 %}
                  {% if v_compare_price and v_compare_price > variant.price %}
                    {% assign v_saving = v_compare_price | minus: variant.price %}
                  {% endif %}

                  <div
                    data-value="{{ variant.id }}"
                    class="checkbox-button protocol-variant-card static-active {% unless variant.id == current_variant.id %}bundle-variant-hidden{% endunless %}"
                    data-available="{{ variant.available }}">

                    {% assign v_custom_badge = variant.metafields.custom.custom_badge_text %}
                    {% if v_custom_badge != blank %}
                      <div class="pv-badge">{{ v_custom_badge }}</div>
                    {% elsif v_saving > 0 %}
                      {% if request.locale.iso_code == 'id' %}
                        <div class="pv-badge">hemat {{ v_saving | money_without_trailing_zeros }}</div>
                      {% else %}
                        <div class="pv-badge">save {{ v_saving | money_without_trailing_zeros }}</div>
                      {% endif %}
                    {% endif %}

                    {% assign has_header = false %}
                    {% if variant.metafields.custom.time_protocol != blank or variant.metafields.custom.value_per_day != blank %}
                      {% assign has_header = true %}
                    {% endif %}

                    <div class="pv-content">
                      <div class="pv-info">
                        {% if has_header %}
                          <div class="pv-header">
                            {% if variant.metafields.custom.time_protocol != blank %}
                              <span class="pv-time">{{ variant.metafields.custom.time_protocol }}</span>
                            {% endif %}
                            {% if variant.metafields.custom.value_per_day != blank %}
                              <span class="pv-daily">{{ variant.metafields.custom.value_per_day }}</span>
                            {% endif %}
                          </div>
                        {% endif %}
                        <div class="pv-desc" {% unless has_header %}style="font-weight:700;"{% endunless %}>
                          {{ variant.title | replace: ' + ', '<br>+ ' }}
                          {% unless variant.available %} - sold out{% endunless %}
                        </div>
                        {% if variant.metafields.custom.description %}
                          <div class="pv-meta-desc">{{ variant.metafields.custom.description | metafield_tag }}</div>
                        {% endif %}
                      </div>

                      <div class="pv-prices">
                        {% if v_compare_price and v_compare_price > variant.price %}
                          <div class="pv-original">{{ v_compare_price | money_without_trailing_zeros }}</div>
                        {% endif %}
                        <div class="pv-sale">{{ variant.price | money_without_trailing_zeros }}</div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>

            <select
              name="id"
              id="RealProductSelect-{{ section.id }}"
              style="display: none;">
              {% for variant in selected_bundle.variants %}
                <option
                  value="{{ variant.id }}"
                  data-available="{{ variant.available }}"
                  {% if variant.id == current_variant.id %}selected="selected"{% endif %}>
                  {{ variant.title }}
                </option>
              {% endfor %}
            </select>

            <input
              type="hidden"
              name="quantity"
              value="1">

            <button
              type="submit"
              name="add"
              id="AddToCartBtn-{{ section.id }}"
              class="button AddToCartBtn button--full-width button--primary mt-4"
              {% unless current_variant.available %}
              disabled
              {% endunless %}>
              {% if current_variant.available %}
                {{ add_cart_text }}
              {% else %}
                {{ sold_out_text }}{% endif %}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const sectionId = "{{ section.id }}";
      const variantContainer = document.getElementById(`VariantContainer-${sectionId}`);
      const cartBtn = document.getElementById(`AddToCartBtn-${sectionId}`);
      const realSelect = document.getElementById(`RealProductSelect-${sectionId}`);

      const TEXT_ADD_TO_CART = "{{ add_cart_text }}";
      const TEXT_SOLD_OUT = "{{ sold_out_text }}";
      const TEXT_ADDING = "{{ adding_text }}";
      const TEXT_ADDED = "{{ added_text }}";
      const TEXT_ERROR = "{{ 'products.product.error' | t | default: 'Error' }}";

      // ============================================
      // VARIANT SYNC — listen for main product change
      // ============================================
      function switchBundleVariant(targetId) {
        if (!variantContainer || !targetId) return;
        const cards = variantContainer.querySelectorAll('.checkbox-button');

        cards.forEach(card => {
          const cardId = card.getAttribute('data-value');

          if (cardId === targetId) {
            card.classList.remove('bundle-variant-hidden');

            // Sync hidden select
            if (realSelect) realSelect.value = cardId;

            // Sync cart button
            const isAvailable = card.getAttribute('data-available') === 'true';
            if (cartBtn) {
              cartBtn.textContent = isAvailable ? TEXT_ADD_TO_CART : TEXT_SOLD_OUT;
              cartBtn.disabled = !isAvailable;
            }
          } else {
            card.classList.add('bundle-variant-hidden');
          }
        });
      }

      // Listen for variant change from main product
      window.addEventListener('custom-variant-change', function(e) {
        if (e.detail && e.detail.targetId) {
          switchBundleVariant(e.detail.targetId);
        }
      });

      // Check sessionStorage on load (for page refresh)
      const storedId = sessionStorage.getItem('target_bundle_id');
      if (storedId) {
        switchBundleVariant(storedId);
      }

      // ============================================
      // GALLERY LOGIC
      // ============================================
      if (window.innerWidth > 749) {
        const wrapper = document.getElementById(`bundle-gallery-wrapper-${sectionId}`);
        if (wrapper) {
          const thumbs = wrapper.querySelectorAll('.slider-item');
          const mains = wrapper.querySelectorAll('.main-image-display img');

          thumbs.forEach(t => {
            t.addEventListener('click', function(e) {
              e.preventDefault();
              thumbs.forEach(i => i.classList.remove('activeBundle'));
              mains.forEach(i => i.classList.remove('activeBundle'));
              this.classList.add('activeBundle');
              const idx = this.getAttribute('data-index');
              const target = wrapper.querySelector(`.main-image-display img[data-index="${idx}"]`);
              if (target) target.classList.add('activeBundle');
            });
          });
        }
      }

      // ============================================
      // AJAX ADD TO CART
      // ============================================
      if (cartBtn) {
        cartBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const variantId = realSelect ? realSelect.value : null;
          if (!variantId) return;

          this.innerHTML = TEXT_ADDING;
          this.style.opacity = '0.7';

          fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
          })
          .then(response => {
            if (!response.ok) throw new Error('Network response was not ok');
            return response.json();
          })
          .then(data => {
            this.innerHTML = TEXT_ADDED;
            this.style.opacity = '1';
            setTimeout(() => { this.innerHTML = TEXT_ADD_TO_CART; }, 2000);

            const cartIcon = document.querySelector('a[href="/cart"]') || document.querySelector('.header__icon--cart');
            if (cartIcon) {
              cartIcon.click();
            } else {
              document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
              document.documentElement.dispatchEvent(new CustomEvent('cart:open', { bubbles: true }));
            }

            const cartBubble = document.querySelectorAll('.cart-count-bubble span, .header__cart-count');
            cartBubble.forEach(el => {
              let currentCount = parseInt(el.innerText || 0);
              el.innerText = currentCount + 1;
            });
          })
          .catch(() => {
            this.innerHTML = TEXT_ERROR;
            this.style.opacity = '1';
            setTimeout(() => { this.innerHTML = TEXT_ADD_TO_CART; }, 2000);
          });
        });
      }
    });
  </script>
{% endif %}

{% schema %}
  {
    "name": "Featured Bundle",
    "tag": "section",
    "class": "section",
    "settings": [
      {
        "type": "product",
        "id": "feature_product",
        "label": "Featured Product (The Bundle)"
      }, {
        "type": "textarea",
        "id": "heading",
        "label": "Heading textarea",
        "default": "Complete Your Set"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Featured Bundle"
      }
    ]
  }
{% endschema %}