  "name": "PDP3 Reviews",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Review source",
      "info": "Klaviyo Reviews is not populated yet — Judge.me holds the review history.",
      "default": "judgeme",
      "options": [
        {
          "value": "judgeme",
          "label": "Judge.me"
        },
        {
          "value": "klaviyo",
          "label": "Klaviyo Reviews"
        }
      ]
    },
    {
      "type": "text",
      "id": "ratings_word",
      "label": "Word after the rating count"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified buyer label"
    },
    {
      "type": "header",
      "content": "Summary card"
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Write a review button"
    },
    {
      "type": "text",
      "id": "ask_label",
      "label": "Ask a question button"
    },
    {
