{% if section.settings.show_whatsapp and section.settings.whatsapp_number != blank %}
  {%- assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
  <a
    class="lp-wa"
    style="--lp-fab-gutter: {{ section.settings.fab_gutter }}px"
    href="https://wa.me/{{ wa_number }}?text={{ section.settings.whatsapp_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.whatsapp_label }}"
  >
    <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
      <path d="M16.004 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.59 4.46 1.71 6.4L3.2 28.8l6.58-1.67a12.74 12.74 0 0 0 6.22 1.62h.01c7.06 0 12.79-5.74 12.79-12.8 0-3.42-1.33-6.63-3.75-9.05a12.72 12.72 0 0 0-9.05-3.7zm0 23.39h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.02 1.02 1.07-3.92-.25-.4a10.56 10.56 0 0 1-1.62-5.66c0-5.87 4.78-10.64 10.66-10.64 2.84 0 5.51 1.11 7.52 3.12a10.57 10.57 0 0 1 3.11 7.53c0 5.87-4.78 10.66-10.67 10.66zm5.84-7.97c-.32-.16-1.89-.93-2.19-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.18.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66 0 1.57 1.14 3.08 1.3 3.29.16.21 2.25 3.44 5.45 4.82.76.33 1.36.53 1.82.67.77.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.75.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37z"/>
    </svg>
  </a>
{% endif %}

{% if section.settings.show_sticky_bar %}
  <div class="lp-sticky" data-lp-sticky-cta hidden>
    <div class="lp-sticky__text">
      <span>{{ section.settings.sticky_highlight }}</span>
      {{ section.settings.sticky_text }}
    </div>
    {% if section.settings.cta_label != blank %}
      <a class="lp-btn" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
{% endif %}

{% stylesheet %}
  .lp-wa {
    position: fixed;
    right: var(--lp-fab-gutter, 16px);
    bottom: var(--lp-fab-gutter, 16px);
    z-index: 95;
    transform: translateY(calc(-1 * var(--lp-sticky-height, 0px))) scale(var(--lp-fab-scale, 1));
    transition: transform 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 4px 16px rgb(0 0 0 / 22%);
  }

  .lp-wa:hover {
    --lp-fab-scale: 1.08;
  }

  .lp-wa svg {
    width: 30px;
    height: 30px;
    fill: #fff;
  }

  .lp-sticky {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 0.75rem 1.5rem;
    border-top: 1px solid var(--lp-border);
    background: var(--lp-surface);
    box-shadow: 0 -4px 20px rgb(0 0 0 / 8%);
    transform: translateY(100%);
    transition: transform 0.35s ease;
  }

  .lp-sticky.is-visible {
    transform: none;
  }

  .lp-sticky__text {
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .lp-sticky__text span {
    color: var(--lp-gold);
  }

  .lp-sticky .lp-btn {
    padding: 0.65rem 1.5rem;
    font-size: 0.875rem;
  }

  @media screen and (max-width: 520px) {
    .lp-wa {
      width: 50px;
      height: 50px;
    }

    .lp-sticky {
      flex-direction: column;
      gap: 0.4rem;
      padding: 0.6rem 1rem;
    }

    .lp-sticky__text {
      font-size: 0.75rem;
    }

    .lp-sticky .lp-btn {
      width: 100%;
      padding: 0.6rem 1rem;
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function start() {
      var bar = document.querySelector('[data-lp-sticky-cta]');
      if (!bar) return;

      bar.removeAttribute('hidden');

      var trigger =
        document.querySelector('.lp-hero-section') ||
        document.querySelector('.lp-hero') ||
        document.querySelector('.lp-urgency-section');

      if (!trigger) {
        bar.classList.add('is-visible');
        return;
      }

      function syncHeight() {
        var visible = bar.classList.contains('is-visible');
        var height = visible ? bar.getBoundingClientRect().height : 0;
        document.documentElement.style.setProperty('--lp-sticky-height', height + 'px');
      }

      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            bar.classList.toggle('is-visible', !entry.isIntersecting);
            syncHeight();
          });
        },
        { threshold: 0 }
      ).observe(trigger);

      if (window.ResizeObserver) {
        new ResizeObserver(syncHeight).observe(bar);
      }
      window.addEventListener('resize', syncHeight);
      syncHeight();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Floating CTA",
  "tag": "div",
  "class": "lp-floating-section",
  "settings": [
    {
      "type": "header",
      "content": "Bilah CTA melayang"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "Tampilkan bilah CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_highlight",
      "label": "Teks disorot",
      "default": "Inside Out Protocol"
    },
    {
      "type": "text",
      "id": "sticky_text",
      "label": "Teks pendamping",
      "default": "· Offer Terbatas"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol",
      "default": "Belanja Sekarang"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "header",
      "content": "Tombol WhatsApp"
    },
    {
      "type": "range",
      "id": "fab_gutter",
      "label": "Jarak dari tepi",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "Dipakai untuk sisi kanan dan bawah sekaligus. Jarak ke bilah CTA dihitung otomatis."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Tampilkan tombol WhatsApp",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Nomor WhatsApp",
      "default": "6281139603993",
      "info": "Format internasional tanpa tanda plus."
    },
    {
      "type": "textarea",
      "id": "whatsapp_message",
      "label": "Pesan awal",
      "default": "Halo Treelogy, saya ingin bertanya tentang Inside Out Protocol"
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "Label aksesibilitas",
      "default": "Chat dengan Treelogy di WhatsApp"
    }
  ],
  "presets": [
    {
      "name": "LP · Floating CTA"
    }
  ]
}
{% endschema %}
