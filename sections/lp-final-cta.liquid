<div class="lp-final">
  <div class="lp-container lp-container--narrow">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-final__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-final__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <p class="lp-final__text">{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <a class="lp-btn lp-btn--gold" href="{{ section.settings.cta_url | default: '#' }}">
        {{- section.settings.cta_label -}}
      </a>
    {% endif %}

    {% if section.settings.proof != blank %}
      <div class="lp-final__proof">{{ section.settings.proof }}</div>
    {% endif %}

    {% if section.settings.disclaimer != blank %}
      <div class="lp-final__disclaimer">{{ section.settings.disclaimer }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .lp-final {
    padding: 5rem 0;
    background: var(--lp-forest-deep);
    color: var(--lp-on-dark);
    text-align: center;
  }

  .lp-final__eyebrow {
    margin-bottom: 1rem;
    color: var(--lp-gold-light);
  }

  .lp-final__heading {
    margin-bottom: 1rem;
    color: var(--lp-on-dark);
  }

  .lp-final__text {
    max-width: 520px;
    margin: 0 auto 2rem;
    color: rgb(255 255 255 / 60%);
    font-family: var(--lp-font-body);
  }

  .lp-final__proof {
    margin-top: 1.5rem;
    color: rgb(255 255 255 / 40%);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-final__disclaimer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 10%);
    color: rgb(255 255 255 / 30%);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .lp-final__disclaimer p {
    margin: 0 0 0.5rem;
  }

  .lp-final__disclaimer p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Final CTA",
  "tag": "section",
  "class": "lp-final-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Menopause Itu Alami. Menderita Karenanya Tidak."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Nutrisi dari Dalam. Lindungi dari Luar."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Deskripsi"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol",
      "default": "Mulai Inside Out Protocol"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "text",
      "id": "proof",
      "label": "Baris bukti",
      "default": "Garansi Uang Kembali 30 Hari · Gratis Ongkir · Sertifikasi BPOM & Halal"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer"
    }
  ],
  "presets": [
    {
      "name": "LP · Final CTA"
    }
  ]
}
{% endschema %}
