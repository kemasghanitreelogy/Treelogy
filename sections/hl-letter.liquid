{%- liquid
  assign cta_label = 'harga_lama.cta_label' | t
  assign code = section.settings.discount_code | strip
  assign code_aria = 'harga_lama.letter.code_copy_aria' | t: code: code
  assign code_label = 'harga_lama.letter.code_label' | t
  assign code_hint = 'harga_lama.letter.code_hint' | t
  assign code_copied = 'harga_lama.letter.code_copied' | t
  assign code_manual = 'harga_lama.letter.code_manual' | t
  assign code_note = 'harga_lama.letter.code_note' | t
  assign cta_target = section.settings.cta_url
  if cta_target == blank
    assign cta_target = routes.all_products_collection_url
  endif
-%}
{%- comment -%}
  Tombol halaman ini selalu mendarat di storefront /id — lihat snippets/og-id-url.
{%- endcomment -%}
{%- capture cta_url -%}{%- render 'og-id-url', url: cta_target -%}{%- endcapture -%}
{%- assign cta_url = cta_url | strip -%}
<section class="hl-letter og-section">
  <h1 class="hl-letter__heading">{{ 'harga_lama.letter.heading_html' | t }}</h1>

  {%- render 'og-arrow' -%}

  <div class="hl-letter__body">
    <p>{{ 'harga_lama.letter.greeting' | t }}</p>
    <p>{{ 'harga_lama.letter.body_html' | t }}</p>
    <p>{{ 'harga_lama.letter.body2_html' | t }}</p>
  </div>

  <div class="hl-letter__code">
    {%- if code != blank -%}
      {%- render 'og-copy-code',
        code: code,
        label: code_label,
        aria: code_aria,
        hint: code_hint,
        copied: code_copied,
        manual: code_manual,
        note: code_note
      -%}
    {%- endif -%}
  </div>

  <div class="hl-letter__cta">
    {%- render 'og-cta', label: cta_label, url: cta_url, width: 726 -%}
  </div>

  {%- render 'og-arrow' -%}
</section>

{% style %}
  .hl-letter {
    padding-top: calc(122 * var(--og-u));
    text-align: center;
    color: var(--og-ink);
  }

  .hl-letter__heading {
    width: calc(886 * var(--og-u));
    margin: 0 auto;
    font-size: calc(64 * var(--og-u));
    font-weight: 400;
    line-height: normal;
  }

  .hl-letter__heading b,
  .hl-letter__heading strong {
    font-weight: 700;
  }

  .hl-letter__body {
    width: calc(990 * var(--og-u));
    margin: var(--og-gap-block) auto 0;
    font-size: var(--og-fs-lead);
    line-height: normal;
  }

  .hl-letter__body p {
    margin: 0 0 var(--og-gap-block);
  }

  .hl-letter__body p:last-child {
    margin-bottom: 0;
  }

  .hl-letter__code {
    width: calc(920 * var(--og-u));
    margin: var(--og-gap-block) auto 0;
  }

  .hl-letter__cta {
    margin-top: var(--og-gap-block);
  }

  .hl-letter .og-arrow {
    margin-top: var(--og-gap-block);
  }
{% endstyle %}

{% schema %}
{
  "name": "HL Letter",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "discount_code",
      "label": "Kode diskon yang ditampilkan & disalin",
      "default": "HARGATETAP"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tujuan tombol (kosong = katalog semua produk)"
    }
  ],
  "presets": [
    {
      "name": "HL Letter"
    }
  ]
}
{% endschema %}
