<div class="lp-stats lp-pad">
  <div class="lp-container lp-reveal">
    {% if section.settings.eyebrow != blank %}
      <div class="lp-eyebrow lp-stats__eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lp-h2 lp-stats__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="lp-stats__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.show_before_after %}
      <div class="lp-stats__ba">
        <div class="lp-stats__ba-grid">
          <div>
            {% if section.settings.before_image %}
              {{
                section.settings.before_image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(max-width: 640px) 45vw, 275px',
                  loading: 'lazy',
                  alt: section.settings.before_label
              }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'lp-placeholder' }}
            {% endif %}
            <div class="lp-stats__ba-label">{{ section.settings.before_label }}</div>
          </div>
          <div>
            {% if section.settings.after_image %}
              {{
                section.settings.after_image
                | image_url: width: 600
                | image_tag:
                  widths: '300, 450, 600',
                  sizes: '(max-width: 640px) 45vw, 275px',
                  loading: 'lazy',
                  alt: section.settings.after_label
              }}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'lp-placeholder' }}
            {% endif %}
            <div class="lp-stats__ba-label lp-stats__ba-label--after">{{ section.settings.after_label }}</div>
          </div>
        </div>

        {% if section.settings.before_after_caption != blank %}
          <p class="lp-stats__ba-caption">{{ section.settings.before_after_caption }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="lp-stats__grid" style="--lp-stats-columns: {{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div class="lp-stats__card" {{ block.shopify_attributes }}>
          {% if block.settings.value != blank %}
            <div class="lp-stats__value">{{ block.settings.value }}</div>
          {% endif %}

          {% if block.settings.label != blank %}
            <div class="lp-stats__label">{{ block.settings.label }}</div>
          {% endif %}

          {% if block.settings.comparison != blank %}
            <div class="lp-stats__vs">{{ block.settings.comparison }}</div>
          {% endif %}

          {% if block.settings.note != blank %}
            <div class="lp-stats__note">{{ block.settings.note }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <div class="lp-stats__cta">
        <a class="lp-btn lp-btn--gold" href="{{ section.settings.cta_url | default: '#' }}">
          {{- section.settings.cta_label -}}
        </a>
      </div>
    {% endif %}

    {% if section.settings.footnote != blank %}
      <p class="lp-stats__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .lp-stats {
    position: relative;
    overflow: hidden;
    background: var(--lp-forest-deep);
    color: var(--lp-on-dark);
  }

  .lp-stats::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -15%;
    width: 50%;
    height: 160%;
    background: radial-gradient(ellipse, rgb(184 148 74 / 6%) 0%, transparent 70%);
    pointer-events: none;
  }

  .lp-stats .lp-stats__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--lp-gold-light);
  }

  .lp-stats .lp-stats__heading {
    margin-bottom: 0.5rem;
    color: var(--lp-on-dark);
  }

  .lp-stats__sub {
    max-width: 620px;
    margin: 0 0 3rem;
    color: rgb(255 255 255 / 60%);
    font-family: var(--lp-font-body);
    font-size: 1.0625rem;
  }

  .lp-stats__ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .lp-stats__ba-grid img,
  .lp-stats__ba-grid svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: var(--lp-radius-lg);
    object-fit: cover;
  }

  .lp-stats__ba-label {
    margin-top: 0.5rem;
    color: rgb(255 255 255 / 55%);
    font-family: var(--lp-font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-align: center;
  }

  .lp-stats__ba-label--after {
    color: var(--lp-gold-light);
  }

  .lp-stats__ba-caption {
    margin: 0.75rem 0 2.5rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    text-align: center;
  }

  .lp-stats__grid {
    display: grid;
    grid-template-columns: repeat(var(--lp-stats-columns, 3), minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .lp-stats__card {
    padding: 2rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: var(--lp-radius-lg);
    background: rgb(255 255 255 / 4%);
    text-align: center;
    transition: background 0.3s ease;
  }

  .lp-stats__card:hover {
    background: rgb(255 255 255 / 7%);
  }

  .lp-stats__value {
    margin-bottom: 0.25rem;
    color: var(--lp-gold-light);
    font-family: var(--lp-font-display);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
  }

  .lp-stats__label {
    margin-bottom: 0.35rem;
    color: var(--lp-on-dark);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .lp-stats__vs {
    color: rgb(255 255 255 / 45%);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
  }

  .lp-stats__note {
    margin-top: 0.5rem;
    color: var(--lp-gold-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
    font-style: italic;
    opacity: 0.8;
  }

  .lp-stats__cta {
    text-align: center;
  }

  .lp-stats__footnote {
    margin: 2rem 0 0;
    color: rgb(255 255 255 / 35%);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
  }

  @media screen and (max-width: 640px) {
    .lp-stats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 400px) {
    .lp-stats__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LP · Stat grid",
  "tag": "section",
  "class": "lp-stats-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kenapa Daun Ini untuk Menopause"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Judul",
      "default": "Nutrisi yang Hilang dari Tubuh. Dipenuhi dari Dalam."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Deskripsi"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Jumlah kolom (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Sebelum & sesudah"
    },
    {
      "type": "checkbox",
      "id": "show_before_after",
      "label": "Tampilkan pasangan gambar",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Gambar sebelum"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Label sebelum",
      "default": "Sebelum"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Gambar sesudah"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "Label sesudah",
      "default": "Sesudah"
    },
    {
      "type": "text",
      "id": "before_after_caption",
      "label": "Keterangan"
    },
    {
      "type": "header",
      "content": "Tombol dan catatan"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Label tombol"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Tautan tombol"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Catatan kaki"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistik",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Angka",
          "default": "17×"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Kalsium Lebih Banyak"
        },
        {
          "type": "text",
          "id": "comparison",
          "label": "Pembanding",
          "default": "daripada susu"
        },
        {
          "type": "textarea",
          "id": "note",
          "label": "Catatan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Stat grid",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
