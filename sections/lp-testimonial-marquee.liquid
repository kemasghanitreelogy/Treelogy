<div class="lp-tmarquee" style="--lp-tmarquee-duration: {{ section.settings.duration }}s">
  <div class="lp-tmarquee__track" data-lp-marquee-track>
    <div class="lp-tmarquee__set" data-lp-marquee-set>
      {% for block in section.blocks %}
        <figure class="lp-tcard" {{ block.shopify_attributes }}>
          <div class="lp-tcard__stars" aria-label="{{ block.settings.rating }} dari 5">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
          <figcaption>
            <div class="lp-tcard__author">{{ block.settings.author }}</div>
            <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>

    <div class="lp-tmarquee__set" aria-hidden="true">
      {% for block in section.blocks %}
        <figure class="lp-tcard">
          <div class="lp-tcard__stars">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
          <figcaption>
            <div class="lp-tcard__author">{{ block.settings.author }}</div>
            <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-tmarquee {
    overflow: hidden;
    padding-block: 2.5rem;
    background: var(--lp-bloom);
  }

  .lp-tmarquee.is-interactive .lp-tmarquee__track {
    animation: none;
  }

  .lp-tmarquee.is-interactive {
    cursor: grab;
    touch-action: pan-y;
  }

  .lp-tmarquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .lp-tmarquee.is-dragging .lp-tcard {
    pointer-events: none;
  }

  .lp-tmarquee__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    animation: lp-tmarquee-scroll var(--lp-tmarquee-duration, 45s) linear infinite;
  }

  .lp-tmarquee__set {
    display: flex;
    flex: 0 0 auto;
    gap: 1.25rem;
  }

  .lp-tmarquee.is-interactive .lp-tmarquee__track {
    will-change: transform;
  }

  .lp-tcard {
    flex: 0 0 330px;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
  }

  .lp-tcard__stars {
    margin-bottom: 0.75rem;
    color: var(--lp-gold);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  .lp-tcard__text {
    margin: 0 0 1rem;
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.6;
    white-space: normal;
  }

  .lp-tcard__author {
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lp-tcard__detail {
    margin-top: 0.15rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
  }

  @keyframes lp-tmarquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-1 * var(--lp-loop-distance, 50%)));
    }
  }

  @media screen and (max-width: 520px) {
    .lp-tcard {
      flex-basis: 270px;
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-tmarquee__track {
      overflow-x: auto;
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function settled() {
      var fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
      return fonts.then(function () {
        return new Promise(function (resolve) {
          requestAnimationFrame(function () {
            requestAnimationFrame(resolve);
          });
        });
      });
    }

    function init(root) {
      var track = root.querySelector('[data-lp-marquee-track]');
      if (!track || root.dataset.lpMarqueeBound === 'true') return;
      if (reducedMotion()) return;

      var sets = Array.prototype.slice.call(track.querySelectorAll('[data-lp-marquee-set], .lp-tmarquee__set'));
      var cards = [];
      sets.forEach(function (set) {
        Array.prototype.slice.call(set.children).forEach(function (card) {
          cards.push(card);
        });
      });
      if (cards.length < 2) return;

      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;

      var seconds = parseFloat(getComputedStyle(root).getPropertyValue('--lp-tmarquee-duration'));
      seconds = seconds > 0 ? seconds : 45;

      var perSet = 0;
      var setCount = sets.length || 1;
      cards.forEach(function (card) {
        perSet += card.offsetWidth + gap;
      });
      perSet = perSet / setCount;
      if (perSet < 40) return;

      var pxPerMs = perSet / (seconds * 1000);

      root.dataset.lpMarqueeBound = 'true';
      root.classList.add('is-interactive');

      sets.forEach(function (set) {
        set.remove();
      });
      cards.forEach(function (card) {
        card.removeAttribute('aria-hidden');
        track.appendChild(card);
      });

      var offset = 0;
      var last = 0;
      var running = false;
      var frameId = 0;
      var dragging = false;
      var lastX = 0;

      function recycle() {
        var guard = 0;
        var head = track.firstElementChild;
        while (head && guard < 60) {
          var width = head.offsetWidth + gap;
          if (-offset < width) break;
          offset += width;
          track.appendChild(head);
          head = track.firstElementChild;
          guard += 1;
        }

        guard = 0;
        var tail = track.lastElementChild;
        while (tail && offset > 0 && guard < 60) {
          var tailWidth = tail.offsetWidth + gap;
          track.insertBefore(tail, track.firstElementChild);
          offset -= tailWidth;
          tail = track.lastElementChild;
          guard += 1;
        }
      }

      function draw() {
        recycle();
        track.style.transform = 'translate3d(' + offset + 'px, 0, 0)';
      }

      function frame(now) {
        if (!running) return;
        if (!last) last = now;
        var delta = now - last;
        last = now;
        if (delta > 0 && delta < 200 && !dragging) {
          offset -= pxPerMs * delta;
        }
        draw();
        frameId = requestAnimationFrame(frame);
      }

      function play() {
        if (running || dragging) return;
        running = true;
        last = 0;
        frameId = requestAnimationFrame(frame);
      }

      function pause() {
        running = false;
        if (frameId) cancelAnimationFrame(frameId);
        frameId = 0;
      }

      draw();
      play();

      track.addEventListener('pointerdown', function (event) {
        if (event.button && event.button !== 0) return;
        dragging = true;
        lastX = event.clientX;
        root.classList.add('is-dragging');
        try { track.setPointerCapture(event.pointerId); } catch (e) {}
      });

      track.addEventListener('pointermove', function (event) {
        if (!dragging) return;
        event.preventDefault();
        offset += event.clientX - lastX;
        lastX = event.clientX;
        draw();
      });

      function release(event) {
        if (!dragging) return;
        dragging = false;
        root.classList.remove('is-dragging');
        try { track.releasePointerCapture(event.pointerId); } catch (e) {}
        last = 0;
      }

      track.addEventListener('pointerup', release);
      track.addEventListener('pointercancel', release);
      track.addEventListener('lostpointercapture', release);

      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              play();
            } else {
              pause();
            }
          });
        },
        { rootMargin: '300px 0px' }
      ).observe(root);

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) pause();
        else play();
      });

      window.addEventListener('pageshow', play);

      var remeasure;
      window.addEventListener('resize', function () {
        window.clearTimeout(remeasure);
        remeasure = window.setTimeout(function () {
          gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          var total = 0;
          Array.prototype.slice.call(track.children).forEach(function (card) {
            total += card.offsetWidth + gap;
          });
          var next = total / setCount;
          if (next > 40) pxPerMs = next / (seconds * 1000);
          draw();
        }, 200);
      });
    }

    function start() {
      settled().then(function () {
        document.querySelectorAll('.lp-tmarquee').forEach(init);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Testimonial marquee",
  "tag": "section",
  "class": "lp-tmarquee-section",
  "settings": [
    {
      "type": "range",
      "id": "duration",
      "label": "Durasi satu putaran",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "d",
      "default": 45,
      "info": "Waktu untuk melewati satu set testimoni. Makin besar makin lambat."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimoni",
      "limit": 12,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Bintang",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Kutipan",
          "default": "Tulis testimoni pelanggan di sini."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nama",
          "default": "Ibu Ratna"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Keterangan",
          "default": "55 Tahun · Surabaya · Pembeli Terverifikasi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Testimonial marquee",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
