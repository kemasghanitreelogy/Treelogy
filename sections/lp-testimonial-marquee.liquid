<div class="lp-tmarquee" style="--lp-tmarquee-duration: {{ section.settings.duration }}s">
  <div class="lp-tmarquee__track" data-lp-marquee-track>
    <div class="lp-tmarquee__set" data-lp-marquee-set>
      {% for block in section.blocks %}
        <figure class="lp-tcard" {{ block.shopify_attributes }}>
          <div class="lp-tcard__stars" aria-label="{{ block.settings.rating }} dari 5">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
          <figcaption>
            <div class="lp-tcard__author">{{ block.settings.author }}</div>
            <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>

    <div class="lp-tmarquee__set" aria-hidden="true">
      {% for block in section.blocks %}
        <figure class="lp-tcard">
          <div class="lp-tcard__stars">
            {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
          </div>
          <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
          <figcaption>
            <div class="lp-tcard__author">{{ block.settings.author }}</div>
            <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
          </figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lp-tmarquee {
    overflow: hidden;
    padding-block: 2.5rem;
    background: var(--lp-bloom);
  }

  .lp-tmarquee.is-interactive {
    cursor: grab;
    touch-action: pan-y;
  }

  .lp-tmarquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .lp-tmarquee.is-dragging .lp-tcard {
    pointer-events: none;
  }

  .lp-tmarquee__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    animation: lp-tmarquee-scroll var(--lp-tmarquee-duration, 45s) linear infinite;
  }

  .lp-tmarquee__set {
    display: flex;
    flex: 0 0 auto;
    gap: 1.25rem;
  }

  .lp-tcard {
    flex: 0 0 330px;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
  }

  .lp-tcard__stars {
    margin-bottom: 0.75rem;
    color: var(--lp-gold);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  .lp-tcard__text {
    margin: 0 0 1rem;
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.6;
    white-space: normal;
  }

  .lp-tcard__author {
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lp-tcard__detail {
    margin-top: 0.15rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
  }

  @keyframes lp-tmarquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-1 * var(--lp-loop-distance, 50%)));
    }
  }

  @media screen and (max-width: 520px) {
    .lp-tcard {
      flex-basis: 270px;
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-tmarquee__track {
      overflow-x: auto;
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function init(root) {
      var track = root.querySelector('[data-lp-marquee-track]');
      if (!track || root.dataset.lpMarqueeBound === 'true') return;

      var original = track.querySelector('[data-lp-marquee-set]');
      if (!original) return;

      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      var loopDistance = original.getBoundingClientRect().width + gap;
      if (loopDistance <= gap) return;

      root.dataset.lpMarqueeBound = 'true';
      track.style.setProperty('--lp-loop-distance', loopDistance + 'px');

      function ensureCoverage() {
        var needed = loopDistance + root.getBoundingClientRect().width * 2;
        var guard = 0;
        while (track.getBoundingClientRect().width < needed && guard < 10) {
          var clone = original.cloneNode(true);
          clone.removeAttribute('data-lp-marquee-set');
          clone.setAttribute('aria-hidden', 'true');
          track.appendChild(clone);
          guard += 1;
        }
      }
      ensureCoverage();

      var anim = track.getAnimations()[0];
      if (!anim) return;

      var duration = anim.effect.getComputedTiming().duration;
      if (!duration || !isFinite(duration)) return;

      root.classList.add('is-interactive');
      if (reducedMotion()) anim.pause();

      var dragging = false;
      var startX = 0;
      var startTime = 0;

      track.addEventListener('pointerdown', function (event) {
        if (event.button && event.button !== 0) return;
        dragging = true;
        startX = event.clientX;
        startTime = Number(anim.currentTime) || 0;
        anim.pause();
        root.classList.add('is-dragging');
        try { track.setPointerCapture(event.pointerId); } catch (e) {}
      });

      track.addEventListener('pointermove', function (event) {
        if (!dragging) return;
        event.preventDefault();
        var pxPerMs = loopDistance / duration;
        var next = startTime - (event.clientX - startX) / pxPerMs;
        anim.currentTime = ((next % duration) + duration) % duration;
      });

      function release(event) {
        if (!dragging) return;
        dragging = false;
        root.classList.remove('is-dragging');
        try { track.releasePointerCapture(event.pointerId); } catch (e) {}
        if (!reducedMotion()) anim.play();
      }

      track.addEventListener('pointerup', release);
      track.addEventListener('pointercancel', release);
      track.addEventListener('lostpointercapture', release);

      function repaint() {
        track.style.opacity = '0.999';
        requestAnimationFrame(function () {
          track.style.opacity = '';
        });
      }

      function resume() {
        if (dragging || reducedMotion()) return;
        anim.play();
      }

      new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              track.style.willChange = 'transform';
              resume();
              repaint();
            } else {
              anim.pause();
              track.style.willChange = 'auto';
            }
          });
        },
        { rootMargin: '300px 0px' }
      ).observe(root);

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) return;
        resume();
        repaint();
      });

      window.addEventListener('pageshow', function () {
        resume();
        repaint();
      });

      var remeasure;
      window.addEventListener('resize', function () {
        window.clearTimeout(remeasure);
        remeasure = window.setTimeout(function () {
          var width = original.getBoundingClientRect().width;
          if (!width) return;
          var nextGap = parseFloat(getComputedStyle(track).columnGap) || 0;
          loopDistance = width + nextGap;
          track.style.setProperty('--lp-loop-distance', loopDistance + 'px');
          ensureCoverage();
        }, 200);
      });
    }

    function start() {
      document.querySelectorAll('.lp-tmarquee').forEach(function (root) {
        var tries = 0;
        (function attempt() {
          var track = root.querySelector('[data-lp-marquee-track]');
          if (track && track.getAnimations().length) {
            init(root);
            return;
          }
          if (tries++ < 30) requestAnimationFrame(attempt);
        })();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Testimonial marquee",
  "tag": "section",
  "class": "lp-tmarquee-section",
  "settings": [
    {
      "type": "range",
      "id": "duration",
      "label": "Durasi satu putaran",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "d",
      "default": 45,
      "info": "Waktu untuk melewati satu set testimoni. Makin besar makin lambat."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimoni",
      "limit": 12,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Bintang",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Kutipan",
          "default": "Tulis testimoni pelanggan di sini."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nama",
          "default": "Ibu Ratna"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Keterangan",
          "default": "55 Tahun · Surabaya · Pembeli Terverifikasi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Testimonial marquee",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
