<div class="lp-tmarquee" style="--lp-tmarquee-duration: {{ section.settings.duration }}s">
  <div class="lp-tmarquee__track">
    {% for block in section.blocks %}
      <figure class="lp-tcard" {{ block.shopify_attributes }}>
        <div class="lp-tcard__stars" aria-label="{{ block.settings.rating }} dari 5">
          {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
        </div>
        <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
        <figcaption>
          <div class="lp-tcard__author">{{ block.settings.author }}</div>
          <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
        </figcaption>
      </figure>
    {% endfor %}

    {% for block in section.blocks %}
      <figure class="lp-tcard" aria-hidden="true">
        <div class="lp-tcard__stars">
          {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
        </div>
        <blockquote class="lp-tcard__text">{{ block.settings.quote }}</blockquote>
        <figcaption>
          <div class="lp-tcard__author">{{ block.settings.author }}</div>
          <div class="lp-tcard__detail">{{ block.settings.detail }}</div>
        </figcaption>
      </figure>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .lp-tmarquee {
    overflow: hidden;
    padding-block: 2.5rem;
    background: var(--lp-bloom);
  }

  .lp-tmarquee__track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    animation: lp-tmarquee-scroll var(--lp-tmarquee-duration, 45s) linear infinite;
  }

  .lp-tmarquee.is-interactive .lp-tmarquee__track {
    animation: none;
  }

  .lp-tmarquee.is-interactive {
    cursor: grab;
    touch-action: pan-y;
  }

  .lp-tmarquee.is-dragging {
    cursor: grabbing;
    user-select: none;
  }

  .lp-tmarquee.is-dragging .lp-tcard {
    pointer-events: none;
  }

  .lp-tcard {
    flex: 0 0 330px;
    margin: 0;
    padding: 1.5rem;
    border: 1px solid var(--lp-border);
    border-radius: var(--lp-radius-lg);
    background: var(--lp-surface);
  }

  .lp-tcard__stars {
    margin-bottom: 0.75rem;
    color: var(--lp-gold);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
  }

  .lp-tcard__text {
    margin: 0 0 1rem;
    color: var(--lp-text);
    font-family: var(--lp-font-body);
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.6;
    white-space: normal;
  }

  .lp-tcard__author {
    color: var(--lp-forest);
    font-family: var(--lp-font-body);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .lp-tcard__detail {
    margin-top: 0.15rem;
    color: var(--lp-text-light);
    font-family: var(--lp-font-body);
    font-size: 0.75rem;
  }

  @keyframes lp-tmarquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lp-tmarquee__track {
      overflow-x: auto;
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function init(root) {
      var track = root.querySelector('.lp-tmarquee__track');
      if (!track || root.dataset.lpMarqueeBound === 'true') return;
      root.dataset.lpMarqueeBound = 'true';

      var seconds = parseFloat(getComputedStyle(root).getPropertyValue('--lp-tmarquee-duration'));
      var duration = (seconds > 0 ? seconds : 45) * 1000;

      root.classList.add('is-interactive');

      var anim = track.animate(
        [{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }],
        { duration: duration, iterations: Infinity, easing: 'linear' }
      );

      if (reducedMotion()) anim.pause();

      var dragging = false;
      var startX = 0;
      var startTime = 0;

      function pxPerMs() {
        var span = track.scrollWidth / 2;
        return span > 0 ? span / duration : 1;
      }

      track.addEventListener('pointerdown', function (event) {
        if (event.button && event.button !== 0) return;
        dragging = true;
        startX = event.clientX;
        startTime = Number(anim.currentTime) || 0;
        anim.pause();
        root.classList.add('is-dragging');
        try { track.setPointerCapture(event.pointerId); } catch (e) {}
      });

      track.addEventListener('pointermove', function (event) {
        if (!dragging) return;
        event.preventDefault();
        var next = startTime - (event.clientX - startX) / pxPerMs();
        anim.currentTime = ((next % duration) + duration) % duration;
      });

      function release(event) {
        if (!dragging) return;
        dragging = false;
        root.classList.remove('is-dragging');
        try { track.releasePointerCapture(event.pointerId); } catch (e) {}
        if (!reducedMotion()) anim.play();
      }

      track.addEventListener('pointerup', release);
      track.addEventListener('pointercancel', release);
      track.addEventListener('lostpointercapture', release);
    }

    function start() {
      document.querySelectorAll('.lp-tmarquee').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start);
    } else {
      start();
    }

    document.addEventListener('shopify:section:load', start);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "LP · Testimonial marquee",
  "tag": "section",
  "class": "lp-tmarquee-section",
  "settings": [
    {
      "type": "range",
      "id": "duration",
      "label": "Durasi satu putaran",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "d",
      "default": 45,
      "info": "Makin besar makin lambat."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimoni",
      "limit": 12,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Bintang",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Kutipan",
          "default": "Tulis testimoni pelanggan di sini."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nama",
          "default": "Ibu Ratna"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Keterangan",
          "default": "55 Tahun · Surabaya · Pembeli Terverifikasi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP · Testimonial marquee",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
