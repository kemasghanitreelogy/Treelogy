{%- liquid
  comment
    Gerbang yang sama dengan sections/MainProductDetail.liquid: di template
    yang memuat section PDP v3 dan section lama berdampingan, section lama
    harus mundur untuk produk yang sudah dipegang desain baru. Setting-nya
    kosong secara bawaan, jadi di tema mana pun yang tidak mengisinya section
    ini berperilaku persis seperti sebelumnya — termasuk di luar halaman
    produk, tempat product.handle kosong dan gerbangnya tidak pernah menutup.
  endcomment
  assign pdp3_skip = false
  if section.settings.excluded_handles != blank
    assign pdp3_needle = product.handle | prepend: ',' | append: ','
    assign pdp3_hay = section.settings.excluded_handles | remove: ' ' | prepend: ',' | append: ','
    if pdp3_hay contains pdp3_needle
      assign pdp3_skip = true
    endif
  endif
-%}
{%- unless pdp3_skip -%}
{% assign card_detail = product.metafields.custom.how_to_use %}
{% if card_detail != blank %}
  <div class="inner">
    <div class="header">
      <h3 class="h1 title">
        {{ section.settings.title }}
      </h3>
    </div>

    <div class="content">
      <div class="items">
        {% for card in card_detail.value %}
          <div class="card">
            {% render 'Image', image: card.thumb %}

            <div class="detail">
              <div class="title">
                {{ card.title }}
              </div>
              <div class="desc">
                {{ card.description }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

<style>
  #shopify-section-{{ section.id }}{
    background: {{ section.settings.bakground_color | default: '#FFFFFF' }}
  }
</style>
{%- endunless -%}

{% schema %}
{
  "name": "How To",
  "tag": "section",
  "class": "section how-to-use main-grid",
  "settings": [
      {
        "type": "text",
        "id": "excluded_handles",
        "label": "Hide this section for these product handles (comma separated)"
      },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },

    {
      "type": "color",
      "id": "bakground_color",
      "label": "Background"
    }
  ],

  "presets": [
    {
      "name": "How to Use"
    }
  ]
}
{% endschema %}
