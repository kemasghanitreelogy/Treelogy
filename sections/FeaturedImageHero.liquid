{% liquid
  assign v2 = section.settings.enable_v2
  assign wrapper_class = 'hero-slider swiper-wrapper'
  if v2
    assign wrapper_class = 'hero-slider hero-v2 swiper-wrapper'
  endif
%}
<div class="{{ wrapper_class }}" data-cs-capture>
  {% for block in section.blocks %}
    {% assign product = block.settings.product %}

    {% comment %} --- LOGIC: Handle Image and Alt Text based on Language --- {% endcomment %}
    {% if block.type == 'image_type_3' %}
      {% comment %} Logic for Image-Only block with Mobile Support {% endcomment %}
      {% if request.locale.iso_code == 'id' %}
        {% assign current_banner = block.settings.image_id | default: block.settings.image_en %}
        {% assign mobile_banner = block.settings.image_mobile_id | default: current_banner %}
        {% assign current_alt_text = block.settings.alt_text_id | default: block.settings.alt_text_en %}
      {% else %}
        {% assign current_banner = block.settings.image_en %}
        {% assign mobile_banner = block.settings.image_mobile_en | default: block.settings.image_en %}
        {% assign current_alt_text = block.settings.alt_text_en %}
      {% endif %}
    {% else %}
      {% comment %} Logic for original blocks {% endcomment %}
      {% assign current_banner = block.settings.banner %}
      {% assign current_alt_text = block.settings.alt_text_en %}
      {% if request.locale.iso_code == 'id' and block.settings.alt_text_id != blank %}
        {% assign current_alt_text = block.settings.alt_text_id %}
      {% endif %}
      {% assign mobile_banner = block.settings.banner_mobile | default: block.settings.banner %}
    {% endif %}
    {% comment %} ------------------------------------------------ {% endcomment %}

    <div
      class="banner swiper-slide slider-type-{{ block.type }}"
      data-href="{{ product.url }}"
      data-swiper-autoplay="{{ section.settings.interval }}"
    >
      {% liquid
        if forloop.first
          assign hero_loading = 'eager'
          assign hero_priority = 'high'
        else
          assign hero_loading = 'lazy'
          assign hero_priority = 'auto'
        endif
        assign hero_desktop_class = 'background background-' | append: block.id | append: ' desktop'
      %}
      {% if v2 and current_banner %}
        <picture>
          {% if mobile_banner %}
            <source
              media="(max-width: 900px)"
              sizes="100vw"
              srcset="
                {{ mobile_banner | image_url: width: 375 }} 375w,
                {{ mobile_banner | image_url: width: 550 }} 550w,
                {{ mobile_banner | image_url: width: 750 }} 750w,
                {{ mobile_banner | image_url: width: 1100 }} 1100w
              "
            >
          {% endif %}
          {{ current_banner
            | image_url: width: 1920
            | image_tag:
              widths: '750, 1100, 1500, 1920',
              sizes: '100vw',
              loading: hero_loading,
              fetchpriority: hero_priority,
              decoding: 'async',
              alt: current_alt_text,
              class: 'background hero-v2__bg'
          }}
        </picture>
      {% else %}
        {% if current_banner %}
          {{ current_banner
            | image_url: width: 1920
            | image_tag:
              widths: '750, 1100, 1500, 1920',
              sizes: '100vw',
              loading: hero_loading,
              fetchpriority: hero_priority,
              decoding: 'async',
              alt: current_alt_text,
              class: hero_desktop_class
          }}
        {% endif %}
        {% if mobile_banner %}
          {{ mobile_banner
            | image_url: width: 1100
            | image_tag:
              widths: '375, 550, 750, 1100',
              sizes: '100vw',
              loading: hero_loading,
              fetchpriority: hero_priority,
              decoding: 'async',
              alt: current_alt_text,
              class: 'background mobile'
          }}
        {% endif %}
      {% endif %}
      <div class="main-grid">
        <div class="content {{ block.type }}">
          {% if block.type == 'image_picker' %}
            {% render 'HeroBannerSliderType1', block: block, product: product, v2: v2 %}
          {% elsif block.type == 'image_type_2' %}
            {% render 'HeroBannerSliderType2', block: block, v2: v2 %}
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<div class="swiper-pagination"></div>

{% if section.settings.enable_v2 %}
  {% style %}
    /* <picture> adalah flex-item yang di-center oleh .banner; tanpa anchor,
       img absolute di dalamnya mengambil posisi statis (tengah) dan menjorok
       kanan-bawah. Kunci keduanya ke inset 0. */
    #shopify-section-{{ section.id }} .hero-v2 .banner picture {
      position: absolute;
      inset: 0;
    }
    #shopify-section-{{ section.id }} .hero-v2 .banner img.hero-v2__bg {
      position: absolute;
      inset: 0;
    }
    #shopify-section-{{ section.id }} .hero-v2 .main-grid .content .product.hero-card-v2 {
      background-color: rgba(42, 59, 52, {{ section.settings.glass_opacity | divided_by: 100.0 }});
      -webkit-backdrop-filter: blur(14px) saturate(1.15);
      backdrop-filter: blur(14px) saturate(1.15);
      border: 1px solid rgba(248, 248, 242, 0.14);
      border-radius: 14px;
      cursor: pointer;
    }
    @supports not (backdrop-filter: blur(14px)) {
      #shopify-section-{{ section.id }} .hero-v2 .main-grid .content .product.hero-card-v2 {
        background-color: rgba(42, 59, 52, 0.88);
      }
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2:focus-visible {
      outline: 2px solid #A5BB86;
      outline-offset: 3px;
    }
    {% if section.settings.enable_kenburns %}
      #shopify-section-{{ section.id }} .hero-v2 .swiper-slide-active img.background {
        animation: hero-v2-drift {{ section.settings.interval }}ms linear 400ms forwards;
      }
    {% endif %}
    @keyframes hero-v2-drift {
      from { transform: scale(1); }
      to { transform: scale(1.06); }
    }
    #shopify-section-{{ section.id }} .hero-v2 .swiper-slide-active .hero-card-v2 .rating {
      animation: hero-v2-star-wipe 600ms cubic-bezier(0.22, 1, 0.36, 1) 650ms backwards;
    }
    @keyframes hero-v2-star-wipe {
      from { clip-path: inset(0 100% 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
    #shopify-section-{{ section.id }} .hero-v2 .main-grid .content .product.hero-card-v2 {
      display: block;
      padding: 0;
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .hero-card-v2__inner {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 10px;
      padding: 12px;
      transition: transform 160ms ease-out;
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2:active .hero-card-v2__inner {
      transform: scale(0.985);
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .product-excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    @media only screen and (max-width: 900px) {
      #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .product-excerpt.desktop { display: none; }
    }
    @media only screen and (min-width: 901px) {
      #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .product-excerpt.mobile { display: none; }
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .price {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-weight: 600;
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2__arrow {
      flex: 0 0 auto;
      color: #A5BB86;
      transition: transform 200ms ease-out;
    }
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2:hover .hero-card-v2__arrow,
    #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2:focus-visible .hero-card-v2__arrow {
      transform: translateX(4px);
    }
    #shopify-section-{{ section.id }} .hero-v2 .swiper-slide-active img.background {
      transform-origin: center;
    }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ section.id }} .hero-v2 .swiper-slide-active img.background,
      #shopify-section-{{ section.id }} .hero-v2 .swiper-slide-active .hero-card-v2 .rating {
        animation: none;
      }
      #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2 .hero-card-v2__inner,
      #shopify-section-{{ section.id }} .hero-v2 .hero-card-v2__arrow {
        transition: none;
      }
    }
  {% endstyle %}
{% endif %}

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section jumbo-slider swiper",
  "settings": [
    {
      "type": "number",
      "id": "interval",
      "label": "Slider interval",
      "info": "Interval is in millisecond",
      "default": 6000
    },
    {
      "type": "header",
      "content": "Hero v2 (glass card)"
    },
    {
      "type": "checkbox",
      "id": "enable_v2",
      "label": "Enable hero v2 design",
      "info": "Glass product card, picture-based LCP image, refreshed motion. Uncheck to restore the legacy hero instantly.",
      "default": true
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass card tint opacity",
      "min": 40,
      "max": 90,
      "step": 2,
      "unit": "%",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "enable_kenburns",
      "label": "Enable slow image drift",
      "default": true
    }
  ],
  "blocks": [
    {
      "limit": 5,
      "type": "image_picker",
      "name": "Banner",
      "settings": [
        { "type": "text", "id": "title_one", "default": "Premium Organic", "label": "Title one" },
        { "type": "text", "id": "title_two", "default": "Moringa Oleifera", "label": "Title two" },
        { "id": "content", "type": "textarea", "label": "Content" },
        { "id": "product", "type": "product", "label": "Link to product" },
        {
          "type": "textarea",
          "id": "card_excerpt",
          "label": "Product card blurb",
          "info": "Shown on the hero product card. Leave empty to fall back to the product description.",
          "default": "Grown regeneratively and crafted by hand, our stem-free organic moringa"
        },
        { "type": "header", "content": "Banner" },
        { "type": "image_picker", "id": "banner", "label": "Background" },
        { "type": "image_picker", "id": "banner_mobile", "label": "Background mobile" },
        { "type": "text", "id": "alt_text_en", "label": "Alt Text (English)" },
        { "type": "text", "id": "alt_text_id", "label": "Alt Text (Bahasa Indonesia)" }
      ]
    },
    {
      "limit": 5,
      "type": "image_type_2",
      "name": "Banner Type 2",
      "settings": [
        { "type": "product", "id": "link_product", "label": "Link to product" },
        { "type": "textarea", "id": "title_one", "default": "Premium Organic", "label": "Title" },
        { "type": "image_picker", "id": "bagde", "label": "Badge icon" },
        { "type": "textarea", "id": "bagde_desc", "default": "No extracts. No fillers.", "label": "Badge description" },
        { "id": "content", "type": "textarea", "label": "Footer content" },
        { "id": "content_mobile", "type": "textarea", "label": "Footer content mobile" },
        { "type": "header", "content": "Banner" },
        { "type": "image_picker", "id": "banner", "label": "Background" },
        { "type": "image_picker", "id": "banner_mobile", "label": "Background mobile" },
        { "type": "text", "id": "alt_text_en", "label": "Alt Text (English)" },
        { "type": "text", "id": "alt_text_id", "label": "Alt Text (Bahasa Indonesia)" }
      ]
    },
    {
      "limit": 5,
      "type": "image_type_3",
      "name": "Image Only (Bilingual)",
      "settings": [
        { "type": "header", "content": "English Version" },
        { "type": "image_picker", "id": "image_en", "label": "Desktop Image (EN)" },
        { "type": "image_picker", "id": "image_mobile_en", "label": "Mobile Image (EN)" },
        { "type": "text", "id": "alt_text_en", "label": "Alt Text (EN)" },
        { "type": "header", "content": "Indonesian Version" },
        { "type": "image_picker", "id": "image_id", "label": "Desktop Image (ID)" },
        { "type": "image_picker", "id": "image_mobile_id", "label": "Mobile Image (ID)" },
        { "type": "text", "id": "alt_text_id", "label": "Alt Text (ID)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Heroo Slider"
    }
  ]
}
{% endschema %}
