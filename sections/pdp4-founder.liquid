{%- comment -%}
  pdp4 — surat pendiri. Salinan DOM `<section id="founder">` dari berkas
  rujukan: potret dan surat berdampingan (`pdp-split`), sapaan di atas,
  tanda tangan di bawah.
{%- endcomment -%}

{%- liquid
  comment
    Template produk hanya ada satu per tema, sedangkan desain ini ditulis untuk
    satu produk saja. Section JSON tidak bisa dipasang bersyarat, jadi
    gerbangnya ada di sini. Kosongkan setting `handles` untuk semua produk.
  endcomment
  assign pdp4_on = false
  if section.settings.handles == blank
    assign pdp4_on = true
  else
    assign pdp4_needle = product.handle | prepend: ',' | append: ','
    assign pdp4_hay = section.settings.handles | remove: ' ' | prepend: ',' | append: ','
    if pdp4_hay contains pdp4_needle
      assign pdp4_on = true
    endif
  endif
-%}
{%- if pdp4_on -%}
{%- capture t_eyebrow %}{% render 'pdp4-copy', value: section.settings.eyebrow, key: 'pdp3.founder.eyebrow' %}{% endcapture -%}
{%- capture t_body %}{% render 'pdp4-copy', value: section.settings.body, key: 'pdp3.founder.body' %}{% endcapture -%}
{%- capture t_sig %}{% render 'pdp4-copy', value: section.settings.signature, key: 'pdp3.founder.signature' %}{% endcapture -%}
<div class="pdp4-page sk-root">
<section class="sk-container sk-pb-64" id="pdp4-founder"><div class="pdp-wrap sk-stack" style="gap:var(--sk-space-16)">
  <div class="pdp-split">
    {%- if section.settings.image != blank -%}
      <div class="pdp-media">
        {{ section.settings.image | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(max-width: 959px) 100vw, 320px', loading: 'lazy', alt: section.settings.image_alt }}
      </div>
    {%- endif -%}
    <div class="sk-stack" style="gap:var(--sk-space-16)">
      {%- if t_eyebrow != blank -%}<p class="sk-eyebrow sk-text-secondary">{{ t_eyebrow }}</p>{%- endif -%}
      {%- if t_body != blank -%}<p class="sk-body">{{ t_body }}</p>{%- endif -%}
      {%- if t_sig != blank -%}<p class="sk-small sk-text-secondary">{{ t_sig }}</p>{%- endif -%}
    </div>
  </div>
</div></section>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PDP4 Founder",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Portrait alt text",
      "default": "Sacha, founder of Treelogy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Letter"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature"
    },
    {
      "type": "text",
      "id": "handles",
      "label": "Only show for these product handles (comma separated)",
      "default": "organic-moringa-capsules"
    }
  ]
}
{% endschema %}
