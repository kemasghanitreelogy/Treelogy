{%- comment -%}
  pdp4 — footer. Salinan DOM `<footer class="pdp-foot">` dari berkas rujukan:
  ajakan berlangganan di kiri, formulir di kanan, lalu baris logo + ikon sosial.

  Footer tema (sections/Footer.liquid) DISEMBUNYIKAN di halaman ini lewat
  assets/pdp4.css — berkas itu dipakai seluruh toko dan tidak disentuh. Yang
  hilang bersamanya adalah empat kolom tautan (Shop, Blog, FAQ, dan seterusnya);
  rujukan memang tidak punya kolom itu. Kalau tautan-tautan itu mau
  dipertahankan demi tautan internal, section ini tempatnya menambahkannya
  kembali, bukan dengan menghidupkan lagi footer tema.

  Formulirnya BUKAN salinan mati seperti di rujukan (`onsubmit="return false"`).
  Ia `{% form 'customer' %}` milik Shopify, endpoint yang sama dengan formulir
  di footer tema, jadi pendaftar sungguhan tetap masuk. Kotak centang
  persetujuan ikut dibawa apa adanya seperti di footer tema: ia penanda visual,
  bukan gerbang — mengubahnya menjadi syarat wajib di satu halaman saja akan
  membuat halaman ini berjanji hal yang tidak dijanjikan halaman lain.
{%- endcomment -%}

{%- liquid
  comment
    Template produk hanya ada satu per tema, sedangkan desain ini ditulis untuk
    satu produk saja. Section JSON tidak bisa dipasang bersyarat, jadi
    gerbangnya ada di sini. Kosongkan setting `handles` untuk semua produk.
  endcomment
  assign pdp4_on = false
  if section.settings.handles == blank
    assign pdp4_on = true
  else
    assign pdp4_needle = product.handle | prepend: ',' | append: ','
    assign pdp4_hay = section.settings.handles | remove: ' ' | prepend: ',' | append: ','
    if pdp4_hay contains pdp4_needle
      assign pdp4_on = true
    endif
  endif
-%}
{%- if pdp4_on -%}
{%- capture t_heading %}{% render 'pdp4-copy', value: section.settings.heading, key: 'pdp3.footer.heading' %}{% endcapture -%}
{%- capture t_body %}{% render 'pdp4-copy', value: section.settings.body, key: 'pdp3.footer.body' %}{% endcapture -%}
{%- capture t_label %}{% render 'pdp4-copy', value: section.settings.email_label, key: 'pdp3.footer.email_label' %}{% endcapture -%}
{%- capture t_cta %}{% render 'pdp4-copy', value: section.settings.cta_label, key: 'pdp3.footer.cta_label' %}{% endcapture -%}
{%- capture t_consent %}{% render 'pdp4-copy', value: section.settings.consent_label, key: 'pdp3.footer.consent_label' %}{% endcapture -%}
{%- capture t_thanks %}{% render 'pdp4-copy', value: section.settings.thanks, key: 'pdp3.footer.thanks' %}{% endcapture -%}
<div class="pdp4-page sk-root">
<footer class="sk-inverse sk-py-64 pdp-foot" id="pdp4-footer"><div class="sk-container">
  <div class="pdp-wrap pdp-foot__grid">
    <div class="sk-stack" style="gap:var(--sk-space-12)">
      {%- if t_heading != blank -%}<h2 class="sk-h2">{% render 'pdp4-sentence-lines', text: t_heading %}</h2>{%- endif -%}
      {%- if t_body != blank -%}<p class="sk-body sk-text-secondary">{{ t_body }}</p>{%- endif -%}
    </div>

    {%- form 'customer', id: 'pdp4-newsletter', class: 'sk-stack' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="sk-body">{{ t_thanks }}</p>
      {%- else -%}
        <div class="sk-field">
          <label class="sk-label" for="pdp4-footer-email">{{ t_label }}</label>
          <input class="sk-input sk-input--strong" id="pdp4-footer-email" type="email" name="contact[email]"
                 autocomplete="email" inputmode="email" required
                 value="{{ form.email | default: '' | escape }}">
        </div>
        {%- if form.errors -%}
          <p class="sk-small sk-text-error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <button class="sk-btn sk-btn--full" type="submit">{{ t_cta }}</button>
        {%- if t_consent != blank -%}
          {%- comment -%}
            Tautan kebijakan privasi diambil dari `shop.privacy_policy`, bukan
            dituliskan keras: toko bisa mengubah handle-nya, dan tautan mati di
            kalimat persetujuan lebih buruk daripada tidak ada tautan.
          {%- endcomment -%}
          <label class="sk-check sk-small">
            <input type="checkbox">
            <span class="sk-check__box"></span>
            <span class="sk-check__text">
              {%- if shop.privacy_policy.url != blank -%}
                <a class="sk-link" href="{{ shop.privacy_policy.url }}">{{ t_consent }}</a>
              {%- else -%}
                {{ t_consent }}
              {%- endif -%}
            </span>
          </label>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}

    <div class="pdp-foot__legal">
      {%- if section.settings.logo_url != blank -%}
        <img src="{{ section.settings.logo_url }}" alt="{{ shop.name | escape }}" width="120" height="20" loading="lazy">
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="sk-cluster pdp-foot__social">
          {%- for block in section.blocks -%}
            {%- if block.settings.url != blank -%}
              <a class="sk-btn sk-btn--ghost sk-btn--icon sk-btn--sm" href="{{ block.settings.url }}"
                 aria-label="{{ block.settings.label | escape }}" rel="noopener" {{ block.shopify_attributes }}>
                <svg class="sk-btn__icon pdp-ico" aria-hidden="true"><use href="#{{ block.settings.icon }}"/></svg>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div></footer>
</div>
{%- endif -%}

{% schema %}
{
  "name": "PDP4 Footer",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email field label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Submit button"
    },
    {
      "type": "text",
      "id": "consent_label",
      "label": "Consent line"
    },
    {
      "type": "text",
      "id": "thanks",
      "label": "Thank-you line"
    },
    {
      "type": "text",
      "id": "logo_url",
      "label": "Logo (image URL, light on dark)"
    },
    {
      "type": "text",
      "id": "handles",
      "label": "Only show for these product handles (comma separated)",
      "default": "organic-moringa-capsules"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (screen readers)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "i-ig",
          "options": [
            { "value": "i-ig", "label": "Instagram" },
            { "value": "i-fb", "label": "Facebook" },
            { "value": "i-tt", "label": "TikTok" },
            { "value": "i-yt", "label": "YouTube" },
            { "value": "i-pin", "label": "Pinterest" },
            { "value": "i-in", "label": "LinkedIn" },
            { "value": "i-wa", "label": "WhatsApp" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
