{%- liquid
  assign alt_1 = 'oil_guide.know.image_alt_1' | t
  assign alt_2 = 'oil_guide.know.image_alt_2' | t
-%}
<section class="og-know og-section">
  <div class="og-container">
    <img
      class="og-arrow"
      src="{{ 'oil-guide-arrow.svg' | asset_url }}"
      alt=""
      width="70"
      height="70"
      loading="lazy"
      decoding="async"
    >

    <h2 class="og-h2 og-know__heading">{{ 'oil_guide.know.heading_html' | t }}</h2>

    <div class="og-know__card">
      <div class="og-know__row">
        <div class="og-know__icon" aria-hidden="true">
          {%- if section.settings.image_1 -%}
            {{
              section.settings.image_1
              | image_url: width: 426
              | image_tag:
                widths: '213, 426',
                sizes: 'auto',
                loading: 'lazy',
                decoding: 'async',
                class: 'og-know__glyph',
                alt: alt_1
            }}
          {%- endif -%}
        </div>
        <div class="og-know__text">
          <h3 class="og-know__q">{{ 'oil_guide.know.q1_title' | t }}</h3>
          <p class="og-know__a">{{ 'oil_guide.know.q1_body' | t }}</p>
        </div>
      </div>

      <div class="og-know__row">
        <div class="og-know__icon" aria-hidden="true">
          {%- if section.settings.image_2 -%}
            {{
              section.settings.image_2
              | image_url: width: 426
              | image_tag:
                widths: '213, 426',
                sizes: 'auto',
                loading: 'lazy',
                decoding: 'async',
                class: 'og-know__glyph',
                alt: alt_2
            }}
          {%- endif -%}
        </div>
        <div class="og-know__text">
          <h3 class="og-know__q">{{ 'oil_guide.know.q2_title' | t }}</h3>
          <p class="og-know__a">{{ 'oil_guide.know.q2_body' | t }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  .og-know {
    padding-top: var(--og-gap-block);
  }

  .og-know .og-arrow {
    margin-bottom: var(--og-gap-block);
  }

  .og-know__heading {
    margin-bottom: var(--og-gap-section);
    font-weight: 400;
  }

  .og-know__card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(60 * var(--og-u));
    min-height: calc(631 * var(--og-u));
    padding: calc(60 * var(--og-u)) calc(70 * var(--og-u)) calc(60 * var(--og-u)) 0;
    border-radius: var(--og-radius-card);
    background: var(--og-card);
    color: #2b3c35;
  }

  .og-know__row {
    display: grid;
    grid-template-columns: calc(452 * var(--og-u)) 1fr;
    align-items: center;
  }

  .og-know__icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .og-know__glyph {
    height: calc(190 * var(--og-u));
    width: auto;
    opacity: 0.7;
  }

  .og-know__q {
    margin: 0;
    font-size: calc(39 * var(--og-u));
    font-weight: 700;
    line-height: 1.35;
  }

  .og-know__a {
    margin: 0;
    font-size: calc(39 * var(--og-u));
    font-weight: 300;
    line-height: 1.35;
  }
{% endstyle %}

{% schema %}
{
  "name": "OG Good to Know",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Ikon penyimpanan"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Ikon awan"
    }
  ],
  "presets": [
    {
      "name": "OG Good to Know"
    }
  ]
}
{% endschema %}
