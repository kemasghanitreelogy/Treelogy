  .acp-od__actions{display:grid;gap:10px}

  @media (prefers-reduced-motion:reduce){.acp-root *,.acp-root *::before,.acp-root *::after{animation-duration:1ms!important;animation-delay:0s!important;transition-duration:1ms!important}}
