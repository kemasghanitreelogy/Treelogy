  .acp-btn[aria-disabled="true"]{cursor:default;opacity:.55}
  .acp-btn[aria-busy="true"]{pointer-events:none}
  .acp-btn[aria-busy="true"] .acp-btn__label{opacity:0}
  .acp-btn[aria-busy="true"]::after{content:"";position:absolute;width:16px;height:16px;border-radius:50%;border:2px solid currentColor;border-right-color:transparent;animation:acp-spin .7s linear infinite}
  .acp-btn{position:relative}
  .acp-btn[data-done]{background:#3d6b39}
  @keyframes acp-spin{to{transform:rotate(1turn)}}

  .acp-details{display:grid;gap:10px}
