  .acp-btn{all:unset;box-sizing:border-box;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:12px;background:var(--ink);color:#f8f8f2;font-weight:600;font-size:14px;text-align:center;white-space:nowrap;transition:background .2s,transform .2s var(--ease),opacity .2s}
