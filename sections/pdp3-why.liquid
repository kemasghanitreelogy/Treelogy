{%- comment -%}
  pdp3 — kategori BPOM + tabel banding + dialog registrasi.

  Salinan DOM `<section class="why">` dari mockup, termasuk letak dialognya:
  di mockup `.modal` adalah SAUDARA section, bukan anaknya. Itu bukan detail
  kosmetik — ia `position:fixed`, dan setiap `.p3-rv` yang belum tergulir masuk
  masih membawa `transform`, yang akan menjadikan dirinya containing block dan
  menjatuhkan dialog dari tengah layar.

  Tabelnya tetap `<table>` asli: ini data dua kolom yang dibandingkan baris per
  baris, dan pembaca layar butuh hubungan sel-ke-judulnya.
{%- endcomment -%}

{%- liquid
  comment
    Template produk hanya ada satu per tema, sedangkan desain ini ditulis untuk
    satu produk saja. Section JSON tidak bisa dipasang bersyarat, jadi
    gerbangnya ada di sini. Kosongkan setting `handles` untuk semua produk.
  endcomment
  assign pdp3_on = false
  if section.settings.handles == blank
    assign pdp3_on = true
  else
    assign pdp3_needle = product.handle | prepend: ',' | append: ','
    assign pdp3_hay = section.settings.handles | remove: ' ' | prepend: ',' | append: ','
    if pdp3_hay contains pdp3_needle
      assign pdp3_on = true
    endif
  endif
-%}
{%- if pdp3_on -%}
{%- capture t_badge1 %}{% render 'pdp3-copy', value: section.settings.badge_line_1, key: 'pdp3.why.badge_line_1' %}{% endcapture -%}
{%- capture t_badge2 %}{% render 'pdp3-copy', value: section.settings.badge_line_2, key: 'pdp3.why.badge_line_2' %}{% endcapture -%}
{%- capture t_heading %}{% render 'pdp3-copy', value: section.settings.heading, key: 'pdp3.why.heading' %}{% endcapture -%}
{%- capture t_body %}{% render 'pdp3-copy', value: section.settings.body, key: 'pdp3.why.body' %}{% endcapture -%}
{%- capture t_crit %}{% render 'pdp3-copy', value: section.settings.col_criteria, key: 'pdp3.why.col_criteria' %}{% endcapture -%}
{%- capture t_us %}{% render 'pdp3-copy', value: section.settings.col_us, key: 'pdp3.why.col_us' %}{% endcapture -%}
{%- capture t_them %}{% render 'pdp3-copy', value: section.settings.col_them, key: 'pdp3.why.col_them' %}{% endcapture -%}
{%- capture t_mhead %}{% render 'pdp3-copy', value: section.settings.modal_heading, key: 'pdp3.why.modal_heading' %}{% endcapture -%}
{%- comment -%}
  Isi dialog dibangun dari LIMA baris `Label|Nilai`, bukan dari satu bongkah
  HTML.

  BUG yang pernah terjadi: dialognya menampilkan `<p><strong>Product:</strong>`
  sebagai teks biasa. Sebabnya filter `t` — ia meng-escape HTML, jadi markup
  apa pun yang disimpan di berkas locale sampai ke halaman sebagai tulisan,
  bukan sebagai tag. Tidak ada filter kebalikannya di Liquid.

  Jadi yang disimpan di locale cuma teks, dan `<p><b>` dirakit di sini. Setting
  richtext `modal_body` tetap ada sebagai penimpa untuk editor: nilai richtext
  memang HTML dan aman dicetak apa adanya.
{%- endcomment -%}
{%- capture t_mrows -%}
  {%- for i in (1..5) -%}
    {%- capture k %}pdp3.why.modal_row_{{ i }}{% endcapture -%}
    {%- assign row = k | t -%}
    {%- if row contains 'Translation missing' or row == blank -%}{%- continue -%}{%- endif -%}
    {%- assign parts = row | split: '|' -%}
    <p>{% if parts.size > 1 %}<b>{{ parts[0] | strip }}:</b> {{ parts[1] | strip }}{% else %}{{ row }}{% endif %}</p>
  {%- endfor -%}
{%- endcapture -%}
{%- assign t_mbody = section.settings.modal_body -%}
{%- if t_mbody == blank -%}{%- assign t_mbody = t_mrows -%}{%- endif -%}
{%- capture t_mclose %}{% render 'pdp3-copy', value: section.settings.modal_close, key: 'pdp3.why.modal_close' %}{% endcapture -%}
<div class="pdp3-page">
<section class="p3-why" id="p3-why">
  {%- if section.settings.badge_image != blank -%}
    <button class="p3-bpom p3-rv" id="p3-bpom-btn" type="button" aria-haspopup="dialog">
      {{ section.settings.badge_image | image_url: width: 264 | image_tag: widths: '88, 176, 264', sizes: '88px', loading: 'lazy', alt: 'BPOM' }}
      <span><span class="p3-l1">{{ t_badge1 }}</span><br><span class="p3-l2">{{ t_badge2 }}</span></span>
    </button>
  {%- endif -%}
  <h2 class="p3-rv">{% render 'pdp3-sentence-lines', text: t_heading %}</h2>
  {%- if t_body != blank -%}<p class="p3-rv">{{ t_body }}</p>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="p3-cmp p3-rv"><table>
      <colgroup><col class="p3-c0"><col><col></colgroup>
      <thead><tr><th><span class="p3-sr">{{ t_crit }}</span></th><th class="p3-us" scope="col">{{ t_us }}</th><th class="p3-ot" scope="col">{{ t_them }}</th></tr></thead>
      <tbody>
        {%- for block in section.blocks -%}
          {%- capture k %}pdp3.why.{{ block.id }}{% endcapture -%}
          {%- assign k_crit = k | append: '.criteria' -%}
          {%- assign k_ours = k | append: '.ours' -%}
          {%- assign k_theirs = k | append: '.theirs' -%}
          {%- capture t_row_crit %}{% render 'pdp3-copy', value: block.settings.criteria, key: k_crit %}{% endcapture -%}
          {%- capture t_row_ours %}{% render 'pdp3-copy', value: block.settings.ours, key: k_ours %}{% endcapture -%}
          {%- capture t_row_theirs %}{% render 'pdp3-copy', value: block.settings.theirs, key: k_theirs %}{% endcapture -%}
          <tr{% if block.settings.tint_alt %} class="p3-alt"{% endif %} {{ block.shopify_attributes }}><td class="p3-k">{{ t_row_crit }}</td><td class="p3-us">✓&nbsp; {{ t_row_ours }}</td><td class="p3-no">✕&nbsp; {{ t_row_theirs }}</td></tr>
        {%- endfor -%}
      </tbody>
    </table></div>
  {%- endif -%}
</section>
{%- if t_mbody != blank -%}
  <div class="p3-modal" id="p3-bpom-modal" role="dialog" aria-modal="true" aria-label="{{ t_mhead | escape }}"><div class="p3-box"><h3 style="font-size:20px">{{ t_mhead }}</h3>{{ t_mbody }}<button class="p3-btn" id="p3-bpom-close" type="button" style="background:transparent;border:1px solid var(--p3-forest);color:var(--p3-forest)">{{ t_mclose }}</button></div></div>
{%- endif -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "PDP3 Why this one",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Certificate badge"
    },
    {
      "type": "text",
      "id": "badge_line_1",
      "label": "Badge line 1"
    },
    {
      "type": "text",
      "id": "badge_line_2",
      "label": "Badge line 2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "header",
      "content": "Comparison table"
    },
    {
      "type": "text",
      "id": "col_criteria",
      "label": "Criteria column label"
    },
    {
      "type": "text",
      "id": "col_us",
      "label": "Our column"
    },
    {
      "type": "text",
      "id": "col_them",
      "label": "Their column"
    },
    {
      "type": "header",
      "content": "Registration dialog"
    },
    {
      "type": "text",
      "id": "modal_heading",
      "label": "Dialog heading"
    },
    {
      "type": "richtext",
      "id": "modal_body",
      "label": "Dialog body",
      "info": "Optional override. Leave blank to use the five registration rows from the locale files."
    },
    {
      "type": "text",
      "id": "modal_close",
      "label": "Dialog close label"
    },
    {
      "type": "text",
      "id": "handles",
      "label": "Only show for these product handles (comma separated)",
      "default": "organic-moringa-capsules"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "criteria",
          "label": "Criteria"
        },
        {
          "type": "text",
          "id": "ours",
          "label": "Treelogy"
        },
        {
          "type": "text",
          "id": "theirs",
          "label": "Others"
        },
        {
          "type": "checkbox",
          "id": "tint_alt",
          "label": "Use alternate tint",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
