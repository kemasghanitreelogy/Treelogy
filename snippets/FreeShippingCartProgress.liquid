<div
  class="free-shipping-progress"
  data-free-shipping="{{ settings.min_shipping}}"
>
  <div class="free-shipping-progress-container">
    <div class="free-shipping-progress-container-text" id="shipping-progress-text">
      <span id="first-text" style="display:none;">{{ 'cart.progress.only_text' | t }}</span>
      <span id="amount-to-get" style="display:none;"></span>
      <span id="progress-note" style="display:none;">
        {{ 'cart.progress.left_text' | t }}
        <span class="label-note">{{ 'cart.progress.free_delivery_text' | t }}</span>
      </span>
      <span id="shipping-progress-label"></span>
    </div>

    <div class="free-shipping-progress-container-bar">
      <div class="progress-track">
        <div class="progress-fill"></div>
      </div>
      <div class="progress-indicator">
        <div class="progress-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 3.83072C18 3.60237 17.8542 3.39661 17.6311 3.30981L9.22613 0.0422358C9.08123 -0.0140786 8.91877 -0.0140786 8.77387 0.0422358L0.368944 3.30981C0.145755 3.39657 0 3.60237 0 3.83072V14.1693C0 14.3976 0.145718 14.6034 0.368944 14.6902L8.77387 17.9578C8.91721 18.0135 9.07833 18.0147 9.22538 17.9577C9.23256 17.9555 8.91435 18.079 17.6311 14.6902C17.8543 14.6034 18 14.3976 18 14.1693V3.83072ZM9 6.53684L5.9031 5.33287L12.5958 2.56991L15.8998 3.85441L9 6.53684ZM1.19014 4.71824L3.86205 5.75699V8.6876C3.86205 8.99859 4.12849 9.25074 4.45712 9.25074C4.78575 9.25074 5.05219 8.99859 5.05219 8.6876V6.21969L8.40493 7.52312V16.5967L1.19014 13.7918V4.71824ZM9 1.17194L11.0629 1.97393L4.37016 4.73689L2.10015 3.85437L9 1.17194ZM9.59507 7.52312L16.8099 4.71824V13.7918L9.59507 16.5967V7.52312Z" fill="#567350"/>
          </svg>
        </div>
        <div class="free-shipping-badge" id="free-shipping-badge">
          <span id="badge-text"></span>
        </div>
      </div>
    </div>

    <!-- Hidden: bundle writes bonus product icons here -->
    <div class="indicator" style="display:none !important;">
      <div class="bar"></div>
    </div>
    <div id="progress-content" class="item-list" style="display:none !important;"></div>
  </div>
</div>
