{% doc %}
  Sprite ikon untuk halaman produk pdp3.

  Dirender sekali oleh section paling atas (`pdp3-buybox`). Kartu router
  memilih ikonnya lewat `<use href="#i-...">` di sisi klien, jadi seluruh
  simbol harus sudah ada di DOM sebelum kartu pertama digambar — bukan
  ditambahkan per section.

  @example
  {% render 'pdp3-icons' %}
{% enddoc %}

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
  <symbol id="i-truck" viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/></symbol>
  <symbol id="i-tag" viewBox="0 0 24 24"><path d="M3 12V4h8l9 9-8 8-9-9Z"/><circle cx="7.5" cy="8.5" r="1.2"/></symbol>
  <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><path d="M4 17h16M6 17a6 6 0 0 1 12 0M12 5v2M5 9l1.5 1.5M19 9l-1.5 1.5"/></symbol>
  <symbol id="i-battery" viewBox="0 0 24 24"><rect x="3" y="7" width="16" height="10" rx="2"/><path d="M21 10v4M6 10v4M10 10v4"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></symbol>
  <symbol id="i-thermo" viewBox="0 0 24 24"><path d="M10 4a2 2 0 0 1 4 0v9.5a4 4 0 1 1-4 0V4Z"/><path d="M12 9v6"/></symbol>
  <symbol id="i-cal" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></symbol>
  <symbol id="i-mother" viewBox="0 0 24 24"><circle cx="12" cy="6" r="3"/><path d="M6 21v-5a6 6 0 0 1 12 0v5"/><circle cx="17.5" cy="15.5" r="2"/></symbol>
  <symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></symbol>
  <symbol id="i-man" viewBox="0 0 24 24"><circle cx="12" cy="6" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/></symbol>
  <symbol id="i-parents" viewBox="0 0 24 24"><circle cx="8" cy="7" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2 21v-3a6 6 0 0 1 12 0v3M14 21v-2a4 4 0 0 1 8 0v2"/></symbol>
  <symbol id="i-plate" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/></symbol>
  <!-- i-capsules: tiga kapsul dua-warna dikipas ±18°. Separuh bawah diisi currentColor lewat ATRIBUT — atribut pada path menang atas fill:none yang diwariskan dari elemen svg induk, jadi ikon garis lain tidak ikut terisi. (Komentar HTML, bukan Liquid: theme-check menganggap isi elemen svg sebagai raw node dan tersedak tag Liquid di dalamnya.) -->
  <!-- i-sunrise: matahari terbit dua-warna (separuh cakram terisi currentColor, sinar garis) di atas dua garis cakrawala — pasangan gaya i-capsules. -->
  <symbol id="i-sunrise" viewBox="0 0 24 24">
    <path d="M7.2 15.5a4.8 4.8 0 0 1 9.6 0" fill="currentColor" stroke="none"/>
    <path d="M7.2 15.5a4.8 4.8 0 0 1 9.6 0"/>
    <path d="M12 5.2v2.1M5.9 8.4l1.5 1.5M18.1 8.4l-1.5 1.5M3.4 15.5h2M18.6 15.5h2"/>
    <path d="M2.8 18.2h18.4"/>
    <path d="M6.4 21h11.2" stroke-opacity="0.45"/>
  </symbol>
  <symbol id="i-capsules" viewBox="0 0 24 24">
    <g transform="rotate(-10 5.2 12.6)"><rect x="3" y="6.6" width="4.4" height="12" rx="2.2"/><path d="M3 12.6h4.4v3.8a2.2 2.2 0 0 1-4.4 0z" fill="currentColor" stroke="none"/></g>
    <g><rect x="9.8" y="5" width="4.4" height="12" rx="2.2"/><path d="M9.8 11h4.4v3.8a2.2 2.2 0 0 1-4.4 0z" fill="currentColor" stroke="none"/></g>
    <g transform="rotate(10 18.8 12.6)"><rect x="16.6" y="6.6" width="4.4" height="12" rx="2.2"/><path d="M16.6 12.6h4.4v3.8a2.2 2.2 0 0 1-4.4 0z" fill="currentColor" stroke="none"/></g>
  </symbol>
  <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
  <symbol id="i-steth" viewBox="0 0 24 24"><path d="M6 3v6a5 5 0 0 0 10 0V3"/><path d="M11 14v2a4 4 0 0 0 8 0v-3"/><circle cx="19" cy="10" r="2"/></symbol>
  <symbol id="i-wa" viewBox="0 0 24 24"><path d="M4 20l1.3-3.8A8 8 0 1 1 8.3 19L4 20Z"/><path d="M9.5 9.5c.3 2.2 2.6 4.5 4.8 4.8l1.2-1.2 1.8.9-.6 1.6c-3.5.6-8.6-4.5-8-8l1.6-.6.9 1.8-1.7.7Z"/></symbol>
</svg>
