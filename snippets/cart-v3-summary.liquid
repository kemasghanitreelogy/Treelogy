{% doc %}
  Cart v3 order summary. Every figure is derived from the server cart so
  the rows always add up to what checkout charges:

    Subtotal  = Σ paid lines at compare-at (or original) price
    Saving    = Subtotal − Σ final line prices (pack + line discounts)
    Discount  = each cart-level discount application
    Total     = cart.total_price

  The saving row is named after the only line that saves ("3-month
  saving"), otherwise "Savings". Gifts are listed one by one for a single
  product, otherwise counted ("3 free gifts").

  @example
  {% render 'cart-v3-summary' %}
{% enddoc -%}
{%- liquid
  assign subtotal = 0
  assign saving = 0
  assign saving_lines = 0
  assign saving_item = nil
  assign paid_lines = 0
  assign single = nil
  assign gift_units = 0

  for item in cart.items
    assign is_gift = false
    if item.final_line_price == 0
      if item.properties['_Gifted'] != blank or item.line_level_discount_allocations.size > 0
        assign is_gift = true
      endif
    endif
    if is_gift
      assign gift_units = gift_units | plus: item.quantity
      continue
    endif
    assign paid_lines = paid_lines | plus: 1
    assign single = item
    assign base_unit = item.variant.compare_at_price | default: 0
    if item.original_price > base_unit
      assign base_unit = item.original_price
    endif
    assign base_line = base_unit | times: item.quantity
    assign subtotal = subtotal | plus: base_line
    if base_line > item.final_line_price
      assign saving = saving | plus: base_line | minus: item.final_line_price
      assign saving_lines = saving_lines | plus: 1
      assign saving_item = item
    endif
  endfor

  assign saving_label = 'cart_v3.savings' | t
  if saving_lines == 1
    for p in metaobjects.cart_pack.values
      if p.variant.value.id == saving_item.variant_id
        assign saving_label = p.saving_label.value | default: saving_label
        break
      endif
    endfor
  endif

  assign ship_free = false
  if localization.market.handle == 'id'
    assign fs_min = settings.min_shipping | default: 700000 | times: 100
    if cart.items_subtotal_price >= fs_min
      assign ship_free = true
    endif
  endif

  assign single_pack = nil
  if paid_lines == 1
    for p in metaobjects.cart_pack.values
      if p.variant.value.id == single.variant_id
        assign single_pack = p
        break
      endif
    endfor
  endif
-%}
<div class="cv3-summary">
  <div class="cv3-row">
    <span>{{ 'cart_v3.subtotal' | t }}</span>
    <span>{% render 'cart-v3-money', amount: subtotal %}</span>
  </div>
  {%- if saving > 0 -%}
    <div class="cv3-row">
      <span>{{ saving_label }}</span>
      <span>−{% render 'cart-v3-money', amount: saving %}</span>
    </div>
  {%- endif -%}
  {%- for discount in cart.cart_level_discount_applications -%}
    <div class="cv3-row">
      <span>{{ discount.title }}</span>
      <span>−{% render 'cart-v3-money', amount: discount.total_allocated_amount %}</span>
    </div>
  {%- endfor -%}
  {%- if gift_units > 0 -%}
    {%- liquid
      assign list_gifts = false
      if paid_lines == 1
        assign list_gifts = true
        for item in cart.items
          if item.final_line_price == 0 and item.properties['_Gifted'] != blank and item.quantity > 1
            assign list_gifts = false
          endif
        endfor
      endif
    -%}
    {%- if list_gifts -%}
      {%- for item in cart.items -%}
        {%- if item.final_line_price == 0 and item.properties['_Gifted'] != blank -%}
          {%- liquid
            assign g_name = item.product.title
            for p in metaobjects.cart_pack.values
              if p.variant.value.id == item.variant_id
                assign g_name = p.label.value | default: g_name
                break
              endif
            endfor
          -%}
          <div class="cv3-row">
            <span>{{ g_name }}</span>
            <span>{{ 'cart_v3.free' | t }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="cv3-row">
        <span>{{ 'cart_v3.gifts_count' | t: count: gift_units }}</span>
        <span>{{ 'cart_v3.free' | t }}</span>
      </div>
    {%- endif -%}
  {%- endif -%}
  <div class="cv3-row">
    <span>{{ 'cart_v3.shipping' | t }}</span>
    <span>
      {%- if ship_free -%}{{ 'cart_v3.free' | t }}{%- else -%}{{ 'cart_v3.calculated' | t }}{%- endif -%}
    </span>
  </div>
  <hr class="cv3-summary__divider">
  <div class="cv3-row cv3-row--total">
    <span>{{ 'cart_v3.total' | t }}</span>
    <span class="cv3-row__strong" data-cv3-roll="total">{% render 'cart-v3-money', amount: cart.total_price %}</span>
  </div>
  {%- if single_pack and single_pack.unit.value == 'day' -%}
    {%- liquid
      assign days = single_pack.units.value | default: 0 | times: single.quantity
    -%}
    {%- if days > 0 -%}
      {%- capture per_amount -%}{% render 'cart-v3-rate', amount: cart.total_price, units: days %}{%- endcapture -%}
      <span class="cv3-summary__note">{{ 'cart_v3.per_day_for' | t: amount: per_amount, days: days }}</span>
    {%- endif -%}
  {%- endif -%}
</div>
