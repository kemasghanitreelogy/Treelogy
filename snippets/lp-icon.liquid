{% doc %}
  Ikon garis untuk baris rincian kartu paket di landing page.

  Digambar sebagai SVG inline, bukan emoji: emoji dirender berbeda di tiap
  sistem operasi (Android menampilkan kapsul biru, Windows menggambar kado
  dengan gaya lain), sehingga kartu harga tidak pernah terlihat sama untuk
  dua pembeli. SVG juga mewarisi warna teks barisnya lewat `currentColor`,
  jadi ia otomatis ikut saat kartu unggulan berganti latar.

  Semua ikon memakai kanvas 24×24, garis 1.6, ujung membulat — satu bahasa
  visual, bukan kumpulan ikon dari sumber berbeda.

  @param {string} name - kapsul | dropper | pouch | gift | truck | leaf
  @param {number} [size] - lebar & tinggi dalam px (default 17)

  @example
  {% render 'lp-icon', name: 'dropper' %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 17
  assign icon_name = name | strip
-%}

{%- if icon_name != blank and icon_name != 'none' -%}
  <svg
    class="lp-icon"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {%- case icon_name -%}
      {%- when 'kapsul' -%}
        {%- comment -%} Kapsul miring 45° dengan garis sambungan dua paruhnya. {%- endcomment -%}
        <path d="M7.4 16.6a4.1 4.1 0 0 1 0-5.8l3.4-3.4a4.1 4.1 0 1 1 5.8 5.8l-3.4 3.4a4.1 4.1 0 0 1-5.8 0Z" />
        <path d="M10.1 13.9l3.8-3.8" />

      {%- when 'dropper' -%}
        {%- comment -%}
          Botol serum bertutup pipet: bulb di puncak, leher, kerah tebal,
          lalu badan silinder berlabel — siluet Organic Moringa Oil 30ml.
        {%- endcomment -%}
        <path d="M10.4 2.6h3.2v3.1h-3.2z" />
        <path d="M12 5.7v1.4" />
        <rect x="8.6" y="7.1" width="6.8" height="2.3" rx="0.7" />
        <path d="M9.4 9.4h5.2a1.6 1.6 0 0 1 1.6 1.6v9a1.8 1.8 0 0 1-1.8 1.8H9.6a1.8 1.8 0 0 1-1.8-1.8v-9a1.6 1.6 0 0 1 1.6-1.6Z" />
        <path d="M10 14.4h4" />

      {%- when 'pouch' -%}
        {%- comment -%}
          Kantong serut: tali yang terjulur ke atas, mulut kantong yang
          terkerut, lalu badan kain yang melebar ke bawah.
        {%- endcomment -%}
        <path d="M9.4 6.6c-.6-1.6-.3-2.9.8-3.8" />
        <path d="M14.6 6.6c.6-1.6.3-2.9-.8-3.8" />
        <rect x="7.7" y="6.6" width="8.6" height="2.6" rx="1.1" />
        <path d="M8.6 9.2c-1.5 2-2.4 4.3-2.4 6.6A5.5 5.5 0 0 0 12 21.3a5.5 5.5 0 0 0 5.8-5.5c0-2.3-.9-4.6-2.4-6.6" />

      {%- when 'gift' -%}
        <path d="M4.2 11.4h15.6v8.1a1.6 1.6 0 0 1-1.6 1.6H5.8a1.6 1.6 0 0 1-1.6-1.6Z" />
        <rect x="3.2" y="7.6" width="17.6" height="3.8" rx="0.9" />
        <path d="M12 7.6v13.5" />
        <path d="M12 7.6C11 5.4 9.9 4.2 8.6 4.2a2 2 0 0 0 0 3.4" />
        <path d="M12 7.6c1-2.2 2.1-3.4 3.4-3.4a2 2 0 0 1 0 3.4" />

      {%- when 'truck' -%}
        <path d="M2.6 6.4h10.2v9.4H2.6z" />
        <path d="M12.8 9.6h3.6l3 3v3.2h-6.6z" />
        <circle cx="7" cy="18.2" r="1.9" />
        <circle cx="16.6" cy="18.2" r="1.9" />
        <path d="M8.9 18.2h5.8" />

      {%- when 'leaf' -%}
        <path d="M20 4.4c0 8-4.9 12.4-11.2 12.4A4.8 4.8 0 0 1 4 12c0-4.6 5.4-7.6 16-7.6Z" />
        <path d="M4.6 20c1.6-4.4 4.6-7.6 8.6-9.4" />
    {%- endcase -%}
  </svg>
{%- endif -%}
