{% doc %}
  Ikon produk untuk baris rincian kartu paket di landing page.

  Digambar sebagai SVG inline, bukan emoji dan bukan foto produk. Emoji
  dirender berbeda di tiap sistem operasi sehingga kartu harga tak pernah
  terlihat sama untuk dua pembeli. Foto produk sempat dicoba dan ditolak
  kenyataannya: satu-satunya packshot bersih yang dimiliki toko hanyalah
  pouch dan mystery gift — foto kapsul dan minyaknya semuanya foto gaya
  hidup bertumpuk teks, yang pada 20px berubah jadi noda tak terbaca.

  ── Kenapa berwarna penuh, bukan garis ──
  Versi garis tunggal gagal dua kali: pada 20px, outline 1.6px kehilangan
  isi bendanya sehingga botol minyak dan kantong serut terbaca sebagai dua
  benda yang sama. Yang membuat sebuah benda terbaca sekecil ini adalah
  MASSA dan KONTRAS DUA NADA, bukan detail garis. Karena itu tiap ikon kini
  punya bidang terisi, satu sisi lebih gelap sebagai bayangan bentuk, satu
  sorotan tipis, lalu garis tepi gelap tipis.

  Garis tepi itu penting: kartu unggulan berlatar EMAS, dan tanpa tepi gelap
  bidang krem (pouch, kotak kado, badan botol) lenyap ke latarnya.

  Warna diambil dari benda aslinya — kapsul hijau-krem, botol serum putih
  berkerah gelap, kantong kanvas krem, kado krem berpita hijau tua.

  @param {string} name - kapsul | dropper | pouch | gift | truck | leaf
  @param {number} [size] - lebar & tinggi dalam px (default 20)

  @example
  {% render 'lp-icon', name: 'dropper' %}
{% enddoc %}

{%- liquid
  assign icon_size = size | default: 20
  assign icon_name = name | strip
-%}

{%- if icon_name != blank and icon_name != 'none' -%}
  <svg
    class="lp-icon lp-icon--{{ icon_name }}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    {%- case icon_name -%}
      {%- when 'kapsul' -%}
        {%- comment -%} Kapsul dua nada: paruh krem dan paruh hijau, persis kapsul aslinya. {%- endcomment -%}
        <g>
        <path d="M6.7 17.3a4.6 4.6 0 0 1 0-6.5l4-4a4.6 4.6 0 1 1 6.5 6.5l-4 4a4.6 4.6 0 0 1-6.5 0Z" fill="#F2E6C8"/>
        <path d="M6.7 17.3a4.6 4.6 0 0 1 0-6.5l3.25-3.25 6.5 6.5-3.25 3.25a4.6 4.6 0 0 1-6.5 0Z" fill="#5C7A4A"/>
        <path d="M8.6 9.6a3 3 0 0 1 1.9-1.4" stroke="#fff" stroke-opacity=".55" stroke-width="1.3" stroke-linecap="round" fill="none"/>
        <path d="M6.7 17.3a4.6 4.6 0 0 1 0-6.5l4-4a4.6 4.6 0 1 1 6.5 6.5l-4 4a4.6 4.6 0 0 1-6.5 0Z" fill="none" stroke="#2B3A22" stroke-opacity=".48" stroke-width="1"/>
        </g>

      {%- when 'dropper' -%}
        {%- comment -%} Botol serum: bulb karet bulat, leher ramping, kerah gelap, badan berlabel. {%- endcomment -%}
        <g>
        <ellipse cx="12" cy="3.5" rx="2.1" ry="2.3" fill="#F4F4F1"/>
        <ellipse cx="12" cy="3.5" rx="2.1" ry="2.3" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1"/>
        <rect x="11.3" y="5.4" width="1.4" height="1.9" fill="#C9CCC4"/>
        <rect x="8.1" y="7.1" width="7.8" height="3" rx=".9" fill="#3A4033"/>
        <path d="M9 10.1h6a1.9 1.9 0 0 1 1.9 1.9v7.9a2.1 2.1 0 0 1-2.1 2.1H9.2a2.1 2.1 0 0 1-2.1-2.1V12A1.9 1.9 0 0 1 9 10.1Z" fill="#F7F5F0"/>
        <path d="M7.1 13.1h9.8v4.6H7.1z" fill="#E4E8DA"/>
        <path d="M8.6 14.6h6.2M8.6 16.2h4.4" stroke="#8FA37D" stroke-width=".95" stroke-linecap="round"/>
        <path d="M9 10.1h6a1.9 1.9 0 0 1 1.9 1.9v7.9a2.1 2.1 0 0 1-2.1 2.1H9.2a2.1 2.1 0 0 1-2.1-2.1V12A1.9 1.9 0 0 1 9 10.1Z" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1.05"/>
        </g>

      {%- when 'pouch' -%}
        {%- comment -%} Kantong serut: mulut terkerut bergaris lipatan, badan menggembung, tali terjulur. {%- endcomment -%}
        <g>
        <path d="M9.7 7.1C8.7 5 9.4 3.2 11.1 2.5" stroke="#B9A47B" stroke-width="1.15" fill="none" stroke-linecap="round"/>
        <path d="M14.3 7.1c1-2.1.3-3.9-1.4-4.6" stroke="#B9A47B" stroke-width="1.15" fill="none" stroke-linecap="round"/>
        <path d="M8.9 9.6c-2.4 2.2-3.9 4.9-3.9 7.3 0 2.9 3.1 4.8 7 4.8s7-1.9 7-4.8c0-2.4-1.5-5.1-3.9-7.3Z" fill="#E8DABA"/>
        <path d="M14.2 9.6c1.8 2.1 2.8 4.5 2.8 6.8 0 2.4-2.1 4.1-5 4.6 3.3-.2 5.9-2.1 5.9-4.7 0-2.4-1.5-4.9-3.7-6.7Z" fill="#D2BE93"/>
        <circle cx="12" cy="16.1" r="3" fill="#D8C69E" fill-opacity=".75"/>
        <path d="M11 15a2.5 2.5 0 0 1 1.8-1.2" stroke="#F7F1E3" stroke-width=".9" fill="none" stroke-linecap="round"/>
        <rect x="7.9" y="6.8" width="8.2" height="2.8" rx="1.4" fill="#DCC9A2"/>
        <path d="M9.5 7.1v2.2M11.1 6.9v2.6M12.9 6.9v2.6M14.5 7.1v2.2" stroke="#B39F76" stroke-width=".75" stroke-linecap="round"/>
        <rect x="7.9" y="6.8" width="8.2" height="2.8" rx="1.4" fill="none" stroke="#2B3A22" stroke-opacity=".4" stroke-width=".95"/>
        <path d="M8.9 9.6c-2.4 2.2-3.9 4.9-3.9 7.3 0 2.9 3.1 4.8 7 4.8s7-1.9 7-4.8c0-2.4-1.5-5.1-3.9-7.3" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1.05"/>
        </g>

      {%- when 'gift' -%}
        {%- comment -%} Kotak kado krem berpita hijau tua — mengikuti foto Mystery Gift yang asli. {%- endcomment -%}
        <g>
        <path d="M4.4 11.6h15.2v7.9a1.7 1.7 0 0 1-1.7 1.7H6.1a1.7 1.7 0 0 1-1.7-1.7Z" fill="#F2EDE0"/>
        <path d="M12 11.6h7.6v7.9a1.7 1.7 0 0 1-1.7 1.7H12Z" fill="#E6DECB"/>
        <rect x="3.3" y="7.7" width="17.4" height="3.9" rx="1" fill="#F7F3E9"/>
        <path d="M12 7.7h8.7v3.9H12z" fill="#EDE7D8"/>
        <path d="M10.2 7.7h3.6v13.5h-3.6z" fill="#2E5138"/>
        <path d="M12 7.7C10.9 5.4 9.8 4.1 8.5 4.1a2.05 2.05 0 0 0 0 3.6" fill="none" stroke="#2E5138" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M12 7.7c1.1-2.3 2.2-3.6 3.5-3.6a2.05 2.05 0 0 1 0 3.6" fill="none" stroke="#2E5138" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M4.4 11.6h15.2v7.9a1.7 1.7 0 0 1-1.7 1.7H6.1a1.7 1.7 0 0 1-1.7-1.7Z" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1"/>
        <rect x="3.3" y="7.7" width="17.4" height="3.9" rx="1" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1"/>
        </g>

      {%- when 'truck' -%}
        {%- comment -%} Kendaraan kirim: kabin, bak, dua roda bermata terang. {%- endcomment -%}
        <g>
        <path d="M2.4 7.1h9.9a1 1 0 0 1 1 1v8.3H2.4a1 1 0 0 1-1-1V8.1a1 1 0 0 1 1-1Z" fill="#DCE7CE"/>
        <path d="M13.3 10.2h3.1a1 1 0 0 1 .75.34l2.4 2.7a1 1 0 0 1 .25.66v2.5h-6.5Z" fill="#C3D6AF"/>
        <rect x="14.3" y="11.2" width="3.4" height="2.3" rx=".5" fill="#EFF5E8"/>
        <circle cx="7" cy="17.9" r="2.2" fill="#3A4033"/>
        <circle cx="7" cy="17.9" r=".85" fill="#DCE7CE"/>
        <circle cx="16.6" cy="17.9" r="2.2" fill="#3A4033"/>
        <circle cx="16.6" cy="17.9" r=".85" fill="#DCE7CE"/>
        <path d="M2.4 7.1h9.9a1 1 0 0 1 1 1v8.3H2.4a1 1 0 0 1-1-1V8.1a1 1 0 0 1 1-1Z" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1"/>
        <path d="M13.3 10.2h3.1a1 1 0 0 1 .75.34l2.4 2.7a1 1 0 0 1 .25.66v2.5h-6.5Z" fill="none" stroke="#2B3A22" stroke-opacity=".45" stroke-width="1"/>
        </g>

      {%- when 'leaf' -%}
        {%- comment -%} Daun kelor dua nada dengan tulang daun. {%- endcomment -%}
        <g>
        <path d="M20.4 3.9c.6 8.4-4.4 13.4-11 13.4A5.2 5.2 0 0 1 4 12c0-4.9 5.6-8.1 16.4-8.1Z" fill="#8FB56E"/>
        <path d="M20.4 3.9c-6 1.3-10.6 4.4-13.4 9.4a5.2 5.2 0 0 0 6.4 4c4.5-1.4 7.3-6.1 7-13.4Z" fill="#6E9A52"/>
        <path d="M4.2 20.6c1.8-4.7 4.9-8.1 9.2-10.2" stroke="#4E7238" stroke-width="1.5" fill="none" stroke-linecap="round"/>
        </g>

    {%- endcase -%}
  </svg>
{%- endif -%}

{% stylesheet %}
  /* Ikon membawa warnanya sendiri, jadi tidak ada yang perlu diwarisi dari
     teks. Yang diatur di sini hanya perilaku tata letaknya. */
  .lp-icon {
    display: inline-block;
    flex: 0 0 auto;
    vertical-align: -0.28em;
  }
{% endstylesheet %}
