{% doc %}
  Kartu pemilih varian versi 2 — tata letak paket berdaftar-manfaat.

  Menggantikan `VariantsButton` ketika setting tema `variant_card_v2` menyala.
  Tema live membiarkannya mati, tema preview menyalakannya, jadi desain ini
  tidak pernah terlihat pembeli sampai sengaja dirilis.

  Kontrak DOM-nya sengaja dibuat sama persis dengan kartu lama: setiap kartu
  memakai `.checkbox-button` + `data-value` + `data-variant-price` dan berada
  dalam satu induk yang sama. assets/section-product-single.js dan
  assets/gtm-events.js mengikat ke selektor itu, jadi pemilihan varian, sinkron
  #productSelect, harga langganan, dan event select_variant tetap jalan tanpa
  JavaScript tambahan.

  Sumber datanya metafield varian, bukan field bawaan, karena field bawaan ikut
  terbaca kartu lama di tema live:
  - custom.staged_plan_label      → judul kartu ("3 months", "180 grams")
  - custom.staged_compare_at_price → harga coret; compare_at_price bawaan tidak
    dipakai sebab mengubahnya langsung memunculkan badge hemat di tema live
  - custom.description            → daftar manfaat, satu <li> per baris dengan
    format `label|nilai|ikon`. Dua ruas terakhir opsional:
      "60-day money-back guarantee"            → titik biasa, tanpa nilai
      "Free Bamboo Spoon|Rp 120.000"           → ikon kado (bawaan)
      "Free Shipping included|~ Rp 25.000|ship" → ikon truk
    Nilainya dirender rata kanan dan dicoret. Ruas ikon ada supaya baris yang
    bernilai tapi bukan barang fisik — ongkos kirim — tidak ikut memakai ikon
    kado, karena itu akan salah arti.

  @param {product} product - Produk yang varian-variannya dirender
  @param {variant} [current_variant] - Varian terpilih dari ?variant= bila ada

  @example
  {% render 'VariantsButtonV2', product: product %}
{% enddoc %}

{% liquid
  assign show_staged = settings.show_staged_variants
  assign is_id_locale = false
  if request.locale.iso_code == 'id'
    assign is_id_locale = true
  endif

  comment
    Mockup menyusun paket terbesar di atas, kebalikan dari urutan varian di
    admin, jadi urutkan menurun berdasarkan harga.
  endcomment
  assign v2_variants = product.variants | sort: 'price' | reverse
%}

<div
  class="v2-plans"
  role="radiogroup"
  aria-label="{% if is_id_locale %}Pilih paket{% else %}Choose your plan{% endif %}"
>
  {%- assign v2_rendered = 0 -%}
  {%- for variant in v2_variants -%}
    {%- if variant.metafields.custom.staged_hidden == true and show_staged != true -%}
      {%- continue -%}
    {%- endif -%}

    {%- liquid
      assign v2_rendered = v2_rendered | plus: 1

      assign v2_label = variant.metafields.custom.staged_plan_label
      if v2_label == blank
        assign v2_label = variant.metafields.custom.time_protocol
      endif
      if v2_label == blank
        assign v2_label = variant.title
      endif

      comment
        staged_compare_at_price disimpan dalam rupiah penuh (mengikuti
        custom.original_price), sedangkan variant.price dalam satuan terkecil.
        Tanpa dikalikan 100 perbandingannya selalu kalah dan harga coretnya
        tidak pernah muncul.
      endcomment
      assign v2_compare = 0
      assign v2_compare_meta = variant.metafields.custom.staged_compare_at_price.value | plus: 0
      if v2_compare_meta > 0
        assign v2_compare = v2_compare_meta | times: 100
      elsif variant.compare_at_price > variant.price
        assign v2_compare = variant.compare_at_price
      endif

      assign v2_saving = 0
      if v2_compare > variant.price
        assign v2_saving = v2_compare | minus: variant.price
      endif

      comment
        Badge di mockup berbunyi "save 180.000" tanpa simbol mata uang, jadi
        buang penanda Rp dari hasil filter money.
      endcomment
      assign v2_saving_text = v2_saving | money_without_trailing_zeros | remove: 'Rp' | strip

      assign v2_compare_text = ''
      if v2_saving > 0
        assign v2_compare_text = v2_compare | money_without_trailing_zeros
      endif
      assign v2_price_text = variant.price | money_without_trailing_zeros

      assign v2_is_active = false
      if current_variant
        if current_variant.id == variant.id
          assign v2_is_active = true
        endif
      elsif v2_rendered == 1
        assign v2_is_active = true
      endif
    -%}

    <div
      class="checkbox-button protocol-variant-card v2-plan{% if v2_is_active %} active{% endif %}"
      data-value="{{ variant.id }}"
      data-variant-price="{{ variant.price | divided_by: 100 }}"
      data-available="{{ variant.available }}"
      data-v2-compare="{{ v2_compare_text | escape }}"
      data-v2-price="{{ v2_price_text | escape }}"
      role="radio"
      aria-checked="{% if v2_is_active %}true{% else %}false{% endif %}"
      tabindex="0"
    >
      <div class="v2-plan__head">
        {%- comment -%}
          Radio, judul, dan badge dikelompokkan supaya merekalah yang boleh
          turun baris saat kartu menyempit. Tanpa pengelompokan ini blok harga
          yang ikut membungkus, dan ia mendarat sendirian di baris bawah.
        {%- endcomment -%}
        <span class="v2-plan__main">
          <span class="v2-plan__radio" aria-hidden="true"></span>
          <span class="v2-plan__title">{{ v2_label }}</span>

          {%- assign v2_badge = variant.metafields.custom.custom_badge_text -%}
          {%- if v2_saving > 0 -%}
            <span class="v2-plan__badge">
              {%- if is_id_locale -%}hemat {{ v2_saving_text }}{%- else -%}save {{ v2_saving_text }}{%- endif -%}
            </span>
          {%- elsif v2_badge != blank -%}
            <span class="v2-plan__badge">{{ v2_badge }}</span>
          {%- endif -%}
        </span>

        <span class="v2-plan__prices">
          {%- if v2_compare_text != blank -%}
            <s class="v2-plan__compare">{{ v2_compare_text }}</s>
          {%- endif -%}
          <span class="v2-plan__price">{{ v2_price_text }}</span>
          {%- unless variant.available -%}
            <span class="v2-plan__soldout">
              {%- if is_id_locale -%}stok habis{%- else -%}sold out{%- endif -%}
            </span>
          {%- endunless -%}
        </span>
      </div>

      {%- comment -%}
        Nilai hadiah dicoret, sama seperti harga lama di kanan atas. Dua coretan
        dengan arti berbeda dalam satu kartu sebenarnya rawan tertukar, dan yang
        membedakannya di sini adalah ikon kado pada barisnya: coretan di baris
        berikon = barang yang kamu terima, coretan di baris judul = harga yang
        batal kamu bayar. Jangan hilangkan ikonnya tanpa mengganti pembeda lain.
      {%- endcomment -%}
      {%- capture v2_perks_html -%}{{ variant.metafields.custom.description | metafield_tag }}{%- endcapture -%}
      {%- assign v2_perk_items = v2_perks_html | split: '<li>' -%}
      {%- if v2_perk_items.size > 1 -%}
        <ul class="v2-plan__perks">
          {%- for v2_perk_raw in v2_perk_items offset: 1 -%}
            {%- assign v2_perk_text = v2_perk_raw | split: '</li>' | first | strip_html | strip -%}
            {%- if v2_perk_text == blank -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign v2_perk_parts = v2_perk_text | split: '|' -%}
            <li class="v2-plan__perk{% if v2_perk_parts.size > 1 %} v2-plan__perk--gift{% endif %}">
              {%- comment -%}
                Baris berhadiah ditandai ikon kado, bukan titik. Penandanya
                memisahkan barang fisik yang punya nilai rupiah dari benefit
                layanan seperti gratis ongkir, sehingga angka di kanan langsung
                terbaca sebagai nilai hadiah. Kata "worth" tetap ada di markup
                tapi hanya untuk pembaca layar — ikon menyampaikan kategori,
                bukan makna, jadi teksnya tidak boleh hilang sama sekali.
              {%- endcomment -%}
              {%- assign v2_perk_icon = v2_perk_parts[2] | default: 'gift' | strip | downcase -%}
              <span class="v2-plan__marker" aria-hidden="true">
                {%- if v2_perk_parts.size > 1 and v2_perk_icon == 'ship' -%}
                  <svg class="v2-plan__gift" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
                    <path d="M15 18H9" />
                    <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
                    <circle cx="17" cy="18" r="2" />
                    <circle cx="7" cy="18" r="2" />
                  </svg>
                {%- elsif v2_perk_parts.size > 1 -%}
                  <svg class="v2-plan__gift" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <rect x="3" y="8" width="18" height="4" rx="1" />
                    <path d="M12 8v13" />
                    <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
                    <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" />
                  </svg>
                {%- else -%}
                  <span class="v2-plan__dot"></span>
                {%- endif -%}
              </span>
              <span class="v2-plan__perk-text">{{ v2_perk_parts[0] | strip }}</span>
              {%- if v2_perk_parts.size > 1 -%}
                {%- assign v2_perk_value = v2_perk_parts[1] | strip -%}
                <span class="v2-plan__perk-value">
                  {%- comment -%}
                    Label baris hadiah hanya menyebut barangnya ("Bamboo
                    Spoon"); yang menyatakan gratis adalah ikon kado, coretan,
                    dan chip — semuanya visual. Karena itu teks tersembunyi ini
                    harus memuat kata "gratis" sendiri, kalau tidak pembaca
                    layar cuma mendengar nama barang dan sebuah harga.

                    Spasi pengapitnya &nbsp; supaya tidak terpangkas trim Liquid
                    maupun penciutan spasi HTML; tanpa itu terdengar menyatu
                    seperti "Bamboo Spoonfree".
                  {%- endcomment -%}
                  <span class="v2-plan__sr">
                    {%- if is_id_locale -%}&nbsp;gratis, senilai&nbsp;{%- else -%}&nbsp;free, worth&nbsp;{%- endif -%}
                  </span>
                  <s class="v2-plan__perk-price">{{ v2_perk_value }}</s>
                </span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{%- comment -%}
  Bilah add-to-cart yang menempel di bawah layar. Ia hanya muncul saat tombol
  add-to-cart aslinya keluar dari viewport, jadi tidak pernah ada dua ajakan
  yang bersaing di layar yang sama.

  Tombolnya sengaja meneruskan klik ke #AddToCart yang asli, bukan mengirim
  form sendiri. Seluruh logika keranjang tema — validasi varian, langganan,
  event GTM — sudah menempel di tombol itu; menduplikasinya berarti dua jalur
  yang bisa menyimpang diam-diam.
{%- endcomment -%}
<div class="v2-sticky" data-v2-sticky>
  <button type="button" class="v2-sticky__btn" data-v2-sticky-btn>
    <span class="v2-atc__label">{{ 'products.general.add_to_cart' | t }}</span>
    <span class="v2-atc__sep" aria-hidden="true"></span>
    <s class="v2-atc__compare" data-v2-atc-compare></s>
    <span class="v2-atc__price" data-v2-atc-price></span>
  </button>
</div>

<style>
  /* Ukuran dasar dipilih agar radio + judul + badge + harga tetap muat pada
     SATU baris di layar 360-390px. Kalau salah satunya kebesaran, badge turun
     ke baris kedua dan kartu langsung terlihat berantakan. Media query di bawah
     menaikkannya untuk desktop, tapi tetap di bawah ukuran teks isi halaman
     (16px) supaya kartu tidak mendominasi. */
  .v2-plans {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0 0 16px;
  }

  .v2-plan.protocol-variant-card.checkbox-button {
    display: block !important;
    position: relative;
    padding: 13px 14px !important;
    min-height: 44px;
    border: 2px solid #6c7257;
    border-radius: 6px;
    background-color: #fff !important;
    cursor: pointer;
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  .v2-plan.protocol-variant-card.checkbox-button.active,
  .v2-plan.protocol-variant-card.checkbox-button.static-active {
    border-color: #3f4c39;
    background-color: #e1e7da !important;
  }

  .v2-plan:hover {
    border-color: #3f4c39;
  }

  .v2-plan:focus-visible {
    outline: 3px solid #2b3c35;
    outline-offset: 2px;
  }

  /* Baris judul tidak boleh membungkus: kalau ia membungkus, blok harga yang
     turun dan mendarat sendirian di baris bawah. Yang boleh turun hanyalah
     badge di dalam .v2-plan__main, dan itu pun hanya sebagai jaring pengaman
     untuk label yang luar biasa panjang. */
  .v2-plan__head {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 8px;
  }

  .v2-plan__main {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 8px;
    flex: 1 1 auto;
    min-width: 0;
  }

  .v2-plan__radio {
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
    display: block;
    border: 2px solid #3f4c39;
    border-radius: 50%;
    box-sizing: border-box;
    position: relative;
  }

  .v2-plan.active .v2-plan__radio::before {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background-color: #5c6b4a;
  }

  .v2-plan__title {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    color: #2b3c35;
    white-space: nowrap;
  }

  .v2-plan__badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: #2b3c35;
    color: #f8f8f2;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.07;
    white-space: nowrap;
  }

  .v2-plan__prices {
    flex: 0 0 auto;
    margin-left: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    white-space: nowrap;
    line-height: 1.2;
  }

  /* #515e56, bukan #6c7256: di atas kartu terpilih yang bernada sage, warna
     lama hanya mencapai 3.89:1 dan tidak lolos ambang 4.5:1 untuk teks kecil.
     Teks yang dicoret tetap menyampaikan informasi, jadi tidak dikecualikan. */
  .v2-plan__compare {
    font-size: 0.625rem;
    font-weight: 500;
    color: #2b3c35;
  }

  .v2-plan__price {
    font-size: 0.75rem;
    font-weight: 900;
    color: #2b3c35;
  }

  .v2-plan__soldout {
    font-size: 0.6875rem;
    font-weight: 500;
    color: #8a5b4a;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Bullet dimasukkan ke dalam sejauh (lebar radio + jarak) dikurangi (lebar
     titik + jarak), supaya teks manfaat lurus dengan teks judul dan daftar
     tidak terlihat menggantung di tepi kartu. */
  .v2-plan__perks {
    list-style: none;
    margin: 9px 0 0;
    padding: 0 0 0 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .v2-plan__perk {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1.75;
    color: #2b3c35;
  }

  /* Titik dan ikon kado berbagi kotak penanda selebar sama, supaya teks semua
     bullet tetap lurus meski penandanya berbeda ukuran. */
  .v2-plan__marker {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .v2-plan__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: #2b3c35;
  }

  .v2-plan__gift {
    width: 14px;
    height: 14px;
    color: #5c6b4a;
  }

  .v2-plan__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Arti "gratis" dibawa dua penanda saja: ikon kado menandai barisnya sebagai
     hadiah, coretan menandai angkanya batal ditagih. Sebelumnya ada chip GRATIS
     sebagai penanda ketiga, tapi sisi kanan jadi berisi dua elemen yang saling
     berebut perhatian dan barisnya melelahkan dibaca. Angkanya sengaja dibuat
     satu tingkat lebih kecil dari labelnya supaya terbaca sebagai keterangan,
     bukan sebagai harga yang harus dibayar. */
  .v2-plan__perk-value {
    margin-left: auto;
    padding-left: 10px;
    white-space: nowrap;
  }

  .v2-plan__perk-price {
    color: #2b3c35;
    font-size: 0.625rem;
    font-weight: 500;
  }


  /* Tombol add-to-cart versi 2: label, pemisah, harga coret, harga akhir. */
  .button-quick-add-cart.v2-atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    flex-wrap: wrap;
    width: 100%;
    min-height: 48px;
    padding: 13px 14px;
    border: 0;
    border-radius: 10px;
    background-color: #2b3c35;
    color: #f8f8f2;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .button-quick-add-cart.v2-atc:hover {
    background-color: #1f2a22;
  }

  .button-quick-add-cart.v2-atc:focus-visible {
    outline: 3px solid #2b3c35;
    outline-offset: 3px;
  }

  .v2-atc__label {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .v2-atc__sep {
    width: 2px;
    height: 16px;
    background-color: rgb(248 248 242 / 65%);
  }

  .v2-atc__compare {
    font-size: 0.75rem;
    color: rgb(248 248 242 / 80%);
  }

  .v2-atc__compare:empty {
    display: none;
  }

  .v2-atc__price {
    font-size: 0.875rem;
    font-weight: 700;
  }

  /* Layar 360-375px adalah kasus tersempit yang nyata. Label terpanjang
     ("180 grams" + "save 290.000") butuh sekitar 14px tambahan agar badge tidak
     terlempar ke baris kedua, jadi padding, jarak, dan badge dirampingkan di
     sini saja — bukan diturunkan untuk semua ukuran layar. */
  @media screen and (max-width: 419px) {
    .v2-plan.protocol-variant-card.checkbox-button {
      padding: 12px !important;
    }

    .v2-plan__head {
      gap: 6px;
    }

    .v2-plan__main {
      gap: 5px 6px;
    }

    .v2-plan__badge {
      font-size: 0.6875rem;
      padding: 3px 7px;
    }

    .v2-plan__perks {
      padding-left: 2px;
    }
  }

  /* Di bawah 375px ("180 grams" + "save 290.000" pada layar Android lama)
     ruangnya masih kurang belasan piksel, jadi tipografinya diturunkan satu
     tingkat lagi hanya di sini. */
  @media screen and (max-width: 374px) {
    .v2-plan__title {
      font-size: 0.9375rem;
    }

    .v2-plan__badge {
      padding: 3px 6px;
    }

    .v2-plan__price {
      font-size: 0.875rem;
    }
  }

  @media screen and (min-width: 768px) {
    .v2-plans {
      gap: 12px;
    }

    .v2-plan.protocol-variant-card.checkbox-button {
      padding: 14px 16px !important;
    }

    .v2-plan__head {
      gap: 10px;
    }

    .v2-plan__main {
      gap: 6px 10px;
    }

    .v2-plan__radio {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
    }

    .v2-plan__title {
      font-size: 1.0625rem;
    }

    .v2-plan__badge {
      font-size: 1.0625rem;
      padding: 3px 10px;
    }

    .v2-plan__compare {
      font-size: 0.75rem;
    }

    .v2-plan__price {
      font-size: 0.875rem;
    }

    .v2-plan__perks {
      margin-top: 8px;
      gap: 5px;
      padding-left: 6px;
    }

    .v2-plan__perk {
      font-size: 0.75rem;
      gap: 9px;
    }

    .v2-plan__marker {
      width: 15px;
      height: 15px;
      flex: 0 0 15px;
    }

    .v2-plan__dot {
      width: 7px;
      height: 7px;
    }

    .v2-plan__gift {
      width: 15px;
      height: 15px;
    }

    .v2-plan__perk-price {
      font-size: 0.75rem;
    }

    .button-quick-add-cart.v2-atc {
      min-height: 52px;
      gap: 11px;
    }

    .v2-atc__label,
    .v2-atc__price {
      font-size: 1rem;
    }

    .v2-atc__compare {
      font-size: 0.8125rem;
    }

    .v2-atc__sep {
      height: 18px;
    }
  }

  /* ---- Bilah add-to-cart menempel ----
     Gerakannya transform + opacity saja; properti layout tidak pernah
     ditransisikan. Masuk dan keluar sengaja tidak simetris: kedatangan
     memakai kurva melambat (power4.out) dengan jarak tempuh lebih panjang
     supaya terasa mendarat, sedangkan kepergian lebih singkat dan memakai
     kurva mempercepat sehingga tidak menahan perhatian. Opasitas selesai
     lebih dulu daripada geraknya, jadi bilahnya "hadir lalu menetap" — bukan
     sekadar memudar masuk. */
  .v2-sticky {
    position: fixed;
    z-index: 9998;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background-color: rgb(247 247 238 / 92%);
    border-top: 1px solid rgb(63 76 57 / 14%);
    box-shadow: 0 -6px 24px rgb(31 42 34 / 10%);
    transform: translateY(115%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 320ms cubic-bezier(0.7, 0, 0.84, 0),
      opacity 180ms ease-in,
      visibility 0s linear 320ms;
  }

  @supports (backdrop-filter: blur(10px)) {
    .v2-sticky {
      background-color: rgb(247 247 238 / 78%);
      backdrop-filter: blur(12px);
    }
  }

  .v2-sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    transition:
      transform 460ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 240ms ease-out,
      visibility 0s linear 0s;
  }

  .v2-sticky__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    flex-wrap: wrap;
    width: 100%;
    min-height: 48px;
    padding: 13px 14px;
    border: 0;
    border-radius: 10px;
    background-color: #2b3c35;
    color: #f8f8f2;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .v2-sticky__btn:hover {
    background-color: #1f2a22;
  }

  .v2-sticky__btn:focus-visible {
    outline: 3px solid #2b3c35;
    outline-offset: 3px;
  }

  /* Isi bilah menyusul badannya dengan jeda bertingkat — kedatangan bertahap
     terbaca lebih mahal daripada satu lempeng yang muncul utuh. */
  .v2-sticky__btn > * {
    transform: translateY(9px);
    opacity: 0;
    transition:
      transform 200ms cubic-bezier(0.7, 0, 0.84, 0),
      opacity 140ms ease-in;
  }

  .v2-sticky.is-visible .v2-sticky__btn > * {
    transform: translateY(0);
    opacity: 1;
    transition:
      transform 380ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 240ms ease-out;
  }

  .v2-sticky.is-visible .v2-sticky__btn > :nth-child(1) {
    transition-delay: 90ms;
  }

  .v2-sticky.is-visible .v2-sticky__btn > :nth-child(2) {
    transition-delay: 125ms;
  }

  .v2-sticky.is-visible .v2-sticky__btn > :nth-child(3) {
    transition-delay: 155ms;
  }

  .v2-sticky.is-visible .v2-sticky__btn > :nth-child(4) {
    transition-delay: 180ms;
  }

  @media screen and (min-width: 768px) {
    .v2-sticky {
      padding: 12px 24px calc(12px + env(safe-area-inset-bottom, 0px));
    }

    .v2-sticky__btn {
      min-height: 52px;
      gap: 11px;
      max-width: 640px;
      margin: 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v2-plan.protocol-variant-card.checkbox-button,
    .button-quick-add-cart.v2-atc,
    .v2-sticky,
    .v2-sticky__btn,
    .v2-sticky__btn > * {
      transition-duration: 1ms;
      transition-delay: 0ms;
    }

    .v2-sticky,
    .v2-sticky.is-visible {
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var group = document.currentScript.previousElementSibling;
    while (group && !group.classList.contains('v2-plans')) {
      group = group.previousElementSibling;
    }
    if (!group) return;

    var cards = group.querySelectorAll('.v2-plan');
    if (!cards.length) return;

    /* Kartu lama dipilih lewat klik saja. Kartu ini berperan sebagai radio,
       jadi keyboard harus bisa melakukan hal yang sama. */
    cards.forEach(function (card) {
      card.addEventListener('keydown', function (event) {
        if (event.key !== 'Enter' && event.key !== ' ' && event.key !== 'Spacebar') return;
        event.preventDefault();
        card.click();
      });
    });

    function syncAtc() {
      var active = group.querySelector('.v2-plan.active') || cards[0];
      if (!active) return;

      cards.forEach(function (card) {
        card.setAttribute('aria-checked', card === active ? 'true' : 'false');
      });

      /* querySelectorAll, bukan querySelector: harga muncul di dua tempat —
         tombol di dalam form dan bilah menempel di bawah layar. */
      var compare = active.getAttribute('data-v2-compare') || '';
      var price = active.getAttribute('data-v2-price') || '';
      document.querySelectorAll('[data-v2-atc-compare]').forEach(function (el) {
        el.textContent = compare;
      });
      document.querySelectorAll('[data-v2-atc-price]').forEach(function (el) {
        el.textContent = price;
      });
    }

    /* Kelas .active dipindahkan oleh beberapa pihak — handler klik di
       section-product-single.js, auto-klik "kickstart"-nya, dan popup varian.
       Mengamati atribut kelas menangkap semuanya sekaligus, tanpa perlu ikut
       menebak urutan eksekusi masing-masing. */
    new MutationObserver(syncAtc).observe(group, {
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });

    /* Tombol add-to-cart dirender setelah snippet ini, jadi pada saat script
       berjalan ia belum ada di DOM. Isi pertama kali harus menunggu dokumen
       selesai diurai, kalau tidak harganya tetap kosong sampai ada klik. */
    function initStickyBar() {
      var bar = document.querySelector('[data-v2-sticky]');
      var realButton = document.getElementById('AddToCart');
      if (!bar || !realButton) return;

      bar.querySelector('[data-v2-sticky-btn]').addEventListener('click', function () {
        realButton.click();
      });

      if (typeof IntersectionObserver !== 'function') {
        /* Tanpa IntersectionObserver bilahnya tidak pernah ditampilkan.
           Tombol aslinya tetap ada di halaman, jadi tidak ada yang hilang. */
        return;
      }

      /* rootMargin bawah disetel setinggi bilah supaya tombol asli dianggap
         "terlihat" hanya kalau ia benar-benar tampak, bukan saat tertutup
         bilahnya sendiri — tanpa ini keduanya saling memicu dan berkedip. */
      new IntersectionObserver(
        function (entries) {
          bar.classList.toggle('is-visible', !entries[0].isIntersecting);
        },
        { rootMargin: '0px 0px -84px 0px', threshold: 0 }
      ).observe(realButton);
    }

    /* Tombol add-to-cart dirender setelah snippet ini, jadi pada saat script
       berjalan ia belum ada di DOM. Isi pertama kali harus menunggu dokumen
       selesai diurai, kalau tidak harganya tetap kosong sampai ada klik. */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        syncAtc();
        initStickyBar();
      });
    } else {
      syncAtc();
      initStickyBar();
    }
  })();
</script>
