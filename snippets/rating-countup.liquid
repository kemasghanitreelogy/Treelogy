{% doc %}
  Menghidupkan angka bukti sosial: "Trusted by more than 17.233 customers"
  menghitung naik dari nol saat baris itu benar-benar terlihat pembeli.

  Hitungan angkanya berlaku di SEMUA permukaan; letupan bintangnya HANYA di
  section featured-product (blok hero produk).

  Teksnya datang dari metafield `custom.rating` yang dirender snippets/Rating.liquid,
  jadi kalimatnya bebas — skrip ini mencari token angka di dalamnya, bukan
  mengandalkan susunan kata tertentu. Pemisah ribuannya pun ditiru dari teks
  aslinya (titik untuk konvensi Indonesia, koma untuk Inggris).

  Dipasang sekali dari layout/theme.liquid dan berlaku untuk SEMUA permukaan
  yang memakai .rating-text — kartu koleksi, PDP, section featured, dan popup
  "Choose your size" (app.bundle.js menyalin .star-review ke dalam popup,
  jadi elemen baru itu ditangkap MutationObserver di bawah).

  ── Doktrin gerak (rule counting-dynamic-scale) ──
  1. Angka dan skalanya membaca SATU progres ter-ease dari satu penggerak —
     keduanya mendarat sebagai satu ketukan, bukan dua animasi berbarengan.
     Bintang sengaja punya ketukannya sendiri dan selesai lebih dulu (±1,5 dtk):
     ia menyatakan MUTU, angkanya menyatakan JUMLAH — dua fakta berbeda, jadi
     dibaca berurutan justru lebih jelas daripada dipaksa serentak.
  2. `power3.out`, BUKAN `expo.out`. Versi pertama memakai expo dan itulah yang
     membuatnya terasa murah: 87% hitungan selesai di 30% waktu pertama, lalu
     angkanya merangkak hampir sedetik — terbaca seperti tersendat, bukan
     melambat.
  3. Angka TIDAK PERNAH overshoot. Ia data, bukan dekorasi; pantulan membuatnya
     terlihat tidak stabil. Yang tumbuh hanya skalanya, dan hanya sampai 1.
  4. Per frame hanya menulis teks + transform. Tidak pernah font-size, tidak
     pernah properti layout.

  @example
  {% render 'rating-countup' %}
{% enddoc %}

<script>
  (function () {
    'use strict';
    if (window.__ratingCountUp) return;
    window.__ratingCountUp = true;

    /* Dua kali lebih lambat atas permintaan (14 Agu): 1600ms → 3200ms.
       Doktrin menyebut 1.2–2.5s sebagai rentang lazim, tapi batas bawahnya yang
       keras ("di bawah ~0.8s jadi kedipan") — memperlambat aman, dan pada angka
       lima digit justru memberi mata waktu membaca digit yang berlari.
       Pasangannya (skala + penyingkapan bintang) ikut otomatis karena ketiganya
       membaca progres yang SAMA. */
    var DURATION = 3200;
    var START_SCALE = 0.86;
    var REDUCED = window.matchMedia
      && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function group(n, sep) {
      var s = String(n);
      if (!sep) return s;
      var out = '';
      for (var i = 0; i < s.length; i++) {
        if (i > 0 && (s.length - i) % 3 === 0) out += sep;
        out += s.charAt(i);
      }
      return out;
    }

    function run(el) {
      if (el.dataset.countDone) return;
      var text = el.textContent;
      var m = text.match(/\d[\d.,]*\d|\d+/);
      if (!m) { el.dataset.countDone = '1'; return; }

      var raw = m[0];
      var sep = raw.indexOf('.') >= 0 ? '.' : (raw.indexOf(',') >= 0 ? ',' : '');
      var target = parseInt(raw.replace(/[.,]/g, ''), 10);
      if (!target || target < 2) { el.dataset.countDone = '1'; return; }
      el.dataset.countDone = '1';

      /* Kalimat utuh dikunci ke aria-label lebih dulu: pembaca layar harus
         mendapat angka final, bukan angka yang sedang berlari. */
      el.setAttribute('aria-label', text);

      var before = text.slice(0, m.index);
      var after = text.slice(m.index + raw.length);
      var num = document.createElement('span');
      num.className = 'rt-num';
      num.setAttribute('aria-hidden', 'true');

      el.textContent = '';
      el.appendChild(document.createTextNode(before));
      el.appendChild(num);
      el.appendChild(document.createTextNode(after));

      /* Lebar dikunci pada angka FINAL sebelum hitungan mulai. Tanpa ini kata
         sesudahnya bergeser tiap kali jumlah digit bertambah — gerakan yang
         terbaca sebagai kutu, bukan sebagai animasi. */
      num.textContent = group(target, sep);
      var w = num.offsetWidth;
      if (w) num.style.minWidth = w + 'px';

      /* Grafik pendamping: bintang di baris yang sama, muncul SATU PER SATU
         dengan kilau singkat di puncaknya — bukan tersingkap sebagai satu
         sapuan. Lima bintang itu path SVG terpisah, jadi tiap bintang punya
         ketukannya sendiri (lihat keyframes rtStarPop di bawah).

         Dijalankan lewat kelas CSS, bukan per-frame JS: keyframes-nya deklaratif
         dan dijalankan compositor, dan yang terpenting — tanpa kelas ini
         bintangnya tampil normal. Jadi kalau JS gagal atau tidak pernah jalan,
         pembeli tetap melihat lima bintang utuh, bukan baris kosong. */
      /* Bintang HANYA dianimasikan di section featured-product (blok hero
         produk). Di kartu koleksi dan popup ia tetap tampil diam: di sana
         bintangnya kecil dan berjajar banyak, dan lima letupan per kartu
         berubah dari aksen jadi kebisingan. Pembatasannya ditegakkan di CSS
         (selektor discope) DAN di sini, supaya niatnya terbaca dari kode. */
      var host = el.closest ? el.closest('.star-review') : null;
      var inHero = host && host.closest && host.closest('.featured-product');

      if (REDUCED) return;

      if (inHero) host.classList.add('rt-stars-in');

      num.textContent = group(0, sep);
      num.style.transform = 'scale(' + START_SCALE + ')';

      var start = 0;
      function frame(now) {
        if (!start) start = now;
        var t = Math.min(1, (now - start) / DURATION);
        /* power3.out — melambat tegas tapi tidak asimtotik: angkanya tetap
           bergerak terbaca sampai dekat akhir, lalu berhenti mantap. */
        var e = 1 - Math.pow(1 - t, 3);

        num.textContent = group(Math.round(target * e), sep);
        num.style.transform = 'scale(' + (START_SCALE + (1 - START_SCALE) * e) + ')';

        if (t < 1) {
          requestAnimationFrame(frame);
        } else {
          num.textContent = group(target, sep);
          num.style.transform = '';
        }
      }
      requestAnimationFrame(frame);
    }

    /* Hitungan dimulai saat barisnya benar-benar masuk layar — kalau dijalankan
       saat muat halaman, animasi paling berharga di halaman ini habis sebelum
       ada yang melihatnya. */
    var io = window.IntersectionObserver
      ? new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            run(e.target);
          });
        }, { threshold: 0.6 })
      : null;

    function scan(root) {
      (root || document).querySelectorAll('.rating-text').forEach(function (el) {
        if (el.dataset.countSeen) return;
        el.dataset.countSeen = '1';
        if (io) io.observe(el); else run(el);
      });
    }

    function arm() {
      scan();
      /* Popup "Choose your size" menyalin .star-review ke dalam dirinya saat
         dibuka, jadi elemen ratingnya baru lahir sesudah halaman siap. */
      new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
          if (muts[i].addedNodes && muts[i].addedNodes.length) { scan(); return; }
        }
      }).observe(document.body, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', arm);
    } else {
      arm();
    }
  })();
</script>

{% stylesheet %}
  /* Angka berjalan: lebar digit seragam supaya tidak bergetar antar frame, dan
     rata kanan supaya titik pemisah ribuan tetap di tempatnya. transform-origin
     kanan-tengah — angka tumbuh dari sisi yang menempel pada kata sesudahnya,
     jadi jarak antar kata tidak pernah terlihat memuai. */
  .rating-text .rt-num {
    display: inline-block;
    text-align: right;
    font-variant-numeric: tabular-nums;
    transform-origin: 100% 50%;
    will-change: transform;
  }

  /* ===== Bintang menyala satu per satu =====
     Tanpa kelas .rt-stars-in bintangnya tampil normal — keadaan tersembunyi
     HANYA hidup di dalam keyframes (animation-fill-mode: both menerapkan frame
     0% selama delay). Jadi kalau JS gagal, pembeli tetap melihat lima bintang
     utuh; tidak pernah ada baris kosong. */
  /* viewBox-nya persis sebesar bintangnya (0 0 76 12) dan SVG MEMOTONG apa pun
     yang melewati batas itu — tanpa baris ini, setiap pembesaran di atas 1.0
     ujung bintangnya terpangkas dan pop-nya terlihat kepentok dinding. Inilah
     penyebab utama versi sebelumnya terasa kasar. */
  .featured-product .star-review svg {
    overflow: visible;
  }

  .featured-product .star-review svg > path {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  .featured-product .star-review.rt-stars-in svg > path {
    animation: rtStarPop 640ms both;
  }

  .featured-product .star-review.rt-stars-in svg > path:nth-of-type(1) { animation-delay: 0ms; }
  .featured-product .star-review.rt-stars-in svg > path:nth-of-type(2) { animation-delay: 150ms; }
  .featured-product .star-review.rt-stars-in svg > path:nth-of-type(3) { animation-delay: 300ms; }
  .featured-product .star-review.rt-stars-in svg > path:nth-of-type(4) { animation-delay: 450ms; }
  .featured-product .star-review.rt-stars-in svg > path:nth-of-type(5) { animation-delay: 600ms; }

  /* Pantulan teredam sungguhan: melesat melewati ukuran akhir, jatuh sedikit,
     memantul lebih kecil, lalu diam. Dua ayunan yang mengecil — itu yang
     membuat gerakan terbaca sebagai pegas, bukan sebagai kedutan.

     Rotasi DIBUANG: pada bintang setinggi 12px, putaran tidak terbaca sebagai
     gerakan melainkan sebagai getaran. Yang membawa rasa "melompat keluar"
     adalah translateY kecil yang berpasangan dengan skalanya.

     Kilau tinggal brightness murni — drop-shadow 4px di bintang sekecil ini
     menghasilkan halo buram, bukan kilau. */
  @keyframes rtStarPop {
    0% {
      opacity: 0;
      transform: translateY(3px) scale(0.2);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    32% {
      opacity: 1;
      transform: translateY(-2px) scale(1.34);
      filter: brightness(1.28);
      animation-timing-function: cubic-bezier(0.4, 0, 0.25, 1);
    }
    54% {
      transform: translateY(1px) scale(0.93);
      filter: brightness(1);
      animation-timing-function: cubic-bezier(0.4, 0, 0.25, 1);
    }
    74% {
      transform: translateY(-0.5px) scale(1.09);
      animation-timing-function: cubic-bezier(0.4, 0, 0.25, 1);
    }
    90% {
      transform: scale(0.985);
      animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rating-text .rt-num {
      will-change: auto;
    }

    .featured-product .star-review.rt-stars-in svg > path {
      animation: none;
    }
  }
{% endstylesheet %}
