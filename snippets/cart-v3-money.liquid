{% doc %}
  Formats an amount in the cart currency. IDR drops the space after "Rp"
  ("Rp455.000") to match the cart v3 design; other currencies keep the
  store format untouched.

  @param {number} amount - Amount in the currency subunit

  @example
  {% render 'cart-v3-money', amount: item.final_line_price %}
{% enddoc -%}
{%- liquid
  assign cv3_formatted = amount | money
  if cart.currency.iso_code == 'IDR'
    echo cv3_formatted | replace_first: 'Rp ', 'Rp'
  else
    echo cv3_formatted
  endif
-%}
