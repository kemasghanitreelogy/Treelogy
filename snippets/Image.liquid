{% doc %}
  Renders a responsive image with srcset and valid intrinsic width/height
  attributes so the browser can pick the right size and reserve space
  before the file loads (prevents layout shift and oversized downloads).

  @param {image} image - The image to render (falls back to a placeholder)
  @param {number} [width] - Max width to request (defaults to intrinsic, capped at 1920)
  @param {number} [height] - Optional height attribute override for the placeholder
  @param {string} [sizes] - The sizes attribute (defaults to '100vw')
  @param {string} [loading] - 'eager' or 'lazy' (defaults to 'eager')

  @example
  {% render 'Image', image: section.settings.logo, sizes: '302px' %}
  {% render 'Image', image: section.settings.banner, loading: 'lazy' %}
{% enddoc %}

{% liquid
  assign attr_sizes = sizes | default: '100vw'
  assign attr_loading = loading | default: 'lazy'
%}

{% if image %}
  {% liquid
    assign max_width = width | default: image.width | at_most: 1920
    assign srcset_widths = '180, 360, 540, 750, 960, 1200, 1600, 1920' | append: ', ' | append: max_width
  %}
  {{ image
    | image_url: width: max_width
    | image_tag:
      widths: srcset_widths,
      sizes: attr_sizes,
      loading: attr_loading,
      alt: image.alt
  }}
{% else %}
  <img
    src="{{ 'placeholder.png' | asset_url }}"
    width="{{ width | default: 1104 }}"
    height="{{ height | default: 1156 }}"
    loading="{{ attr_loading }}"
    alt="">
{% endif %}
