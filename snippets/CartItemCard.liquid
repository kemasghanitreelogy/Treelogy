{%- liquid
  comment
    Price hierarchy:
      item.final_price    → per-unit after all discounts (incl. selling plan)
      item.original_price → per-unit before any discount
      item.variant.price  → variant base price (fallback)
  endcomment
  assign item_price = item.final_price
  if item_price == blank or item_price == nil or item_price == 0
    assign item_price = item.variant.price
  endif

  assign has_selling_plan = false
  if item.selling_plan_allocation
    assign has_selling_plan = true
  endif

  assign original_price = item.variant.metafields.custom.original_price.value | default: 0 | plus: 0
  assign original_price_sub = original_price | times: 100
-%}
<div
  class="cart-item"
  id="item-{{ item.variant.id }}"
  data-variant="{{ item.variant.id }}"
  data-key="{{ item.key }}"
  data-price="{{ item_price }}"
  data-compare-at="{{ original_price_sub }}"
  data-qty="{{ item.quantity }}">
  <a href="{{ item.url | within: collections.all }}" class="thumb">
    {% assign image_to_show = item.image | default: item.product.featured_image %}
    <img src="{{ image_to_show | img_url: 'medium' }}" alt="{{ item.title | escape }}">
  </a>

  {% assign is_free_roduct = false %}
  {% assign free_product_variant = settings.free_product.variants | first %}
  {%- liquid
    if item.variant.id == free_product_variant.id
      assign is_free_roduct = true
    endif
  -%}
  <div class="detail">
    <div class="detail-top">
      <div class="detail-info">
        <a href="{{ item.url }}" class="sub-head title">{{ item.product.title }}</a>
        <div class="variant body-desk-s">
          {% unless is_free_roduct %}
            {{ item.variant.title }}
          {% endunless %}
        </div>
        {% if has_selling_plan %}
          <div class="cart-item__sub-tag" aria-label="Subscription item">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.74 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z" fill="currentColor"/>
            </svg>
            <span>{{ item.selling_plan_allocation.selling_plan.name }}</span>
          </div>
        {% endif %}
      </div>
      {% unless is_free_roduct %}
        <div
          role="button"
          class="button-remove-force"
          data-key="{{ item.key }}"
          style="cursor: pointer;"
          onclick="window.cartRemoveItem(this)">
          <svg
            width="10"
            height="13"
            viewBox="0 0 10 13"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path d="M8.25641 1.48376H6.70085V1.07692C6.70085 0.483108 6.21775 0 5.62393 0H3.7094C3.11559 0 2.63248 0.483108 2.63248 1.07692V1.48376H1.07692C0.48215 1.48376 0 1.96591 0 2.56068V2.91966C0 3.11791 0.160725 3.27863 0.358974 3.27863H8.97436C9.17261 3.27863 9.33333 3.11791 9.33333 2.91966V2.56068C9.33333 1.96591 8.85118 1.48376 8.25641 1.48376ZM3.35043 1.07692C3.35043 0.878985 3.51146 0.717949 3.7094 0.717949H5.62393C5.82187 0.717949 5.98291 0.878985 5.98291 1.07692V1.48376H3.35043V1.07692Z" fill="#2A3B35" />
            <path d="M1.12456 11.046C1.15206 11.376 1.30137 11.6812 1.54501 11.9053C1.78866 12.1295 2.10518 12.253 2.43625 12.253H6.89684C7.22794 12.253 7.54446 12.1295 7.78808 11.9054C8.0317 11.6812 8.18106 11.376 8.20853 11.0461L8.79601 3.99658H0.537109L1.12456 11.046ZM6.22312 10.3116L6.58209 5.52529C6.59693 5.32759 6.76922 5.17933 6.96691 5.19417C7.16461 5.20901 7.31287 5.38129 7.29803 5.57899L6.93906 10.3653C6.92422 10.563 6.75194 10.7113 6.55424 10.6964C6.35654 10.6816 6.20828 10.5093 6.22312 10.3116ZM4.30758 5.55214C4.30758 5.35389 4.46831 5.19316 4.66656 5.19316C4.86481 5.19316 5.02553 5.35389 5.02553 5.55214V10.3385C5.02553 10.5367 4.86481 10.6974 4.66656 10.6974C4.46831 10.6974 4.30758 10.5367 4.30758 10.3385V5.55214ZM2.3662 5.19417C2.5639 5.17933 2.73619 5.32759 2.75102 5.52529L3.11 10.3116C3.12484 10.5093 2.97658 10.6816 2.77888 10.6964C2.58118 10.7113 2.4089 10.563 2.39406 10.3653L2.03509 5.57899C2.02027 5.38129 2.1685 5.20901 2.3662 5.19417Z" fill="#2A3B35" />
          </svg>
        </div>
      {% endunless %}
    </div>

    {% unless is_free_roduct %}
      <div class="detail-bottom">
        <div class="price-row">
          {%- if has_selling_plan and item.original_price > item.final_price -%}
            <span class="price-wrapper compare-at-price">
              {{ item.original_price | money }}
            </span>
          {%- elsif original_price_sub > 0 and original_price_sub > item_price -%}
            <span class="price-wrapper compare-at-price">
              {{ original_price_sub | money }}
            </span>
          {%- endif -%}
          <div class="sub-head price-wrapper">
            {{ item_price | money }}
          </div>
        </div>
        <div class="qty-select-wrapper">
          <select
            class="qty-select"
            data-key="{{ item.key }}"
            data-id="{{ item.variant.id }}"
            onchange="window.cartChangeQty(this)">
            {% for i in (1..10) %}
              <option
                value="{{ i }}"
                {% if item.quantity == i %}
                selected{% endif %}>{{ i }}</option>
            {% endfor %}
          </select>
          <svg
            class="qty-arrow"
            width="10"
            height="6"
            viewBox="0 0 10 6"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="M1 1L5 5L9 1"
              stroke="#2B3C35"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    {% endunless %}
  </div>
</div>