{% doc %}
  Merender bintang + ringkasan rating produk.

  Angkanya dibaca SERVER-SIDE dari metafield standar Shopify `reviews.rating`
  dan `reviews.rating_count`, yang ditulis sinkronisasi metafield Klaviyo
  Reviews. Sumbernya sama dengan section ulasan, kartu produk, mini cart, dan
  badge lain, jadi semua angka di situs sama. Tidak ada JS pihak ketiga.

  Kelas `klr-widget`, `klr-prev-badge`, `klr-prev-badge__text`,
  `average-rating`, dan `total-review` ditata assets/theme.css (termasuk aturan
  yang menyembunyikan jumlah ulasan di PDP). Bintangnya memakai snippet
  StarReview milik tema.
  @param {product} [product] - Produk yang ratingnya ditampilkan. Bila tidak
    diisi, memakai objek `product` global pada template produk.

  @example
  {% render 'Rating', product: item %}
{% enddoc %}

{%- liquid
  assign rating_manual = product.metafields.custom.rating
  assign rating_avg = ''
  assign rating_cnt = product.metafields.reviews.rating_count.value | append: ''
  if product.metafields.reviews.rating != blank
    assign rating_avg = product.metafields.reviews.rating.value.rating | times: 100 | round | divided_by: 100.0 | append: ''
  endif

  assign rating_separator = 'products.rating.decimal_separator' | t
  assign rating_avg_local = rating_avg
  if rating_separator.size == 1
    assign rating_avg_local = rating_avg | replace: '.', rating_separator
  endif
-%}

<div class="star-review">
  {%- if rating_manual != blank -%}
    <div>
      {% render 'StarReview' %}
      <span class="rating-text">{% render 'unique-buyers', text: rating_manual %}</span>
    </div>
  {%- elsif rating_avg != blank and rating_cnt != blank and rating_cnt != '0' -%}
    <div class="klr-widget">
      <div class="klr-prev-badge">
        {% render 'StarReview', color: 'currentColor' %}
        <span class="klr-prev-badge__text">
          <span class="average-rating">
            {{- 'products.rating.average' | t: rating: rating_avg_local -}}
          </span>
          <span class="total-review">
            {{- 'products.rating.count' | t: count: rating_cnt -}}
          </span>
        </span>
      </div>
    </div>
  {%- endif -%}
</div>
