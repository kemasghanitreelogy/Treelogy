{% doc %}
  Melengkapi popup "Choose your size" dengan dua hal yang tidak bisa
  diketahuinya sendiri: NAMA varian yang seragam dengan seluruh toko, dan
  HADIAH yang menyertai tiap varian.

  Popup itu dibangun app.bundle.js dari `/products/<handle>.json`, dan JSON
  Shopify tidak membawa metafield sama sekali — jadi ia hanya tahu
  `variant.title` mentah dan tidak tahu apa-apa soal hadiah. Alih-alih
  membongkar bundel yang ter-minify, kedua data itu dititipkan pada tombol
  pemicunya (`data-plan-labels` dan `data-plan-gifts` di
  snippets/ProductCard.liquid, keduanya urut sama dengan `item.variants`),
  lalu disuntikkan ke baris popup setelah ia dirender.

  Penyuntikan memakai URUTAN, bukan pencocokan teks: dua produk berbeda bisa
  punya nama varian yang sama persis (mis. "30 ml" di oil katalog utama dan
  di listing LP), dan pencocokan teks akan menukarnya diam-diam.

  @example
  {% render 'popup-variant-enrich' %}
{% enddoc %}

<script>
  (function () {
    'use strict';

    /* Kata "Free/Gratis" diambil dari kunci terjemahan yang sudah dipakai
       badge hadiah di keranjang — nol kunci locale baru, dan bahasanya ikut
       pengaturan toko. */
    var FREE_LABEL = {{ 'cart.gift_free_label' | t | json }};

    var GIFT_SVG =
      '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">' +
      '<path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 7h20v4H2V7Zm10-1v15M12 6H8.5a2.25 2.25 0 1 1 0-4.5C11 1.5 12 6 12 6Zm0 0h3.5a2.25 2.25 0 1 0 0-4.5C13 1.5 12 6 12 6Z" ' +
      'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    /* Data milik produk yang tombolnya barusan ditekan. Diambil di fase
       capture supaya sudah tersimpan sebelum app.bundle.js mulai mengisi
       popup-nya. */
    var labels = null;
    var gifts = null;

    function readJSON(el, attr) {
      try {
        return JSON.parse(el.getAttribute(attr) || 'null');
      } catch (err) {
        return null;
      }
    }

    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('.open-popup-variants');
      if (!btn) return;
      labels = readJSON(btn, 'data-plan-labels');
      gifts = readJSON(btn, 'data-plan-gifts');
    }, true);

    function enrich() {
      var wrap = document.getElementById('variants-wrapper');
      if (!wrap) return;
      var rows = wrap.querySelectorAll('.checkbox-button');
      if (!rows.length) return;

      /* Baris dengan hadiah TERBANYAK mendapat satu ketukan perhatian —
         itu paket yang paling menguntungkan pembeli, dan satu-satunya
         perbedaan antar baris yang tidak terbaca dari harga. */
      var richest = 0;
      if (gifts) {
        gifts.forEach(function (g) {
          if (g && g.length > richest) richest = g.length;
        });
      }

      Array.prototype.forEach.call(rows, function (row, i) {
        var host = row.querySelector('.variant-detail');
        if (!host) return;

        if (labels && labels[i]) {
          var nameEl = host.querySelector('div');
          /* Menulis hanya bila berbeda: penulisan memicu observer lagi, dan
             penjaga ini yang membuatnya berhenti setelah satu putaran. */
          if (nameEl && nameEl.textContent.trim() !== labels[i]) {
            nameEl.textContent = labels[i];
          }
        }

        var list = gifts && gifts[i];
        var existing = host.querySelector('.pv-gift');
        if (!list || !list.length) {
          if (existing) existing.remove();
          return;
        }
        if (existing) return;

        /* Foto hadiah 18px di baris sepadat ini terbaca sebagai noda, bukan
           informasi — jadi di sini hadiahnya dinyatakan dengan KATA, dibungkus
           pil bernada sage supaya terlihat tanpa berteriak. Foto tetap dipakai
           di deret hadiah bawah tombol paket, tempat ukurannya memadai. */
        var names = list
          .map(function (g) { return g.n; })
          .join(' \u00b7 ');

        var el = document.createElement('span');
        el.className = 'pv-gift' + (list.length === richest && richest > 1 ? ' pv-gift--top' : '');
        el.style.setProperty('--r', i);

        var nameEsc = document.createElement('span');
        nameEsc.className = 'pv-gift__names';
        nameEsc.textContent = names;

        el.innerHTML =
          '<span class="pv-gift__icon" aria-hidden="true">' + GIFT_SVG + '</span>' +
          '<span class="pv-gift__free">' + FREE_LABEL + '</span>';
        el.appendChild(nameEsc);
        host.appendChild(el);
      });
    }

    function arm() {
      var wrap = document.getElementById('variants-wrapper');
      if (!wrap) return;
      new MutationObserver(enrich).observe(wrap, { childList: true, subtree: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', arm);
    } else {
      arm();
    }
  })();
</script>

{% stylesheet %}
  /* ===== Pil hadiah di baris popup varian =====
     Baris ini sudah memikul nama paket dan harga, jadi hadiahnya harus
     terbaca dalam satu tarikan mata: ikon + kata "FREE" + nama hadiah,
     dibungkus pil bernada sage tipis. Versi ikon-saja sebelumnya terlalu
     samar di ukuran baris ini. Gerak: transform + opacity, semuanya
     berhingga. */
  /* Teks rating di kepala popup: `.rating-text` tidak punya font-size di
     desktop (theme.css hanya menyetelnya di breakpoint mobile), jadi ia
     mewarisi ukuran induk dan tampil sebesar teks isi — terlalu berat untuk
     baris pendukung. Dikunci 12px, DISCOPE ke .popup-variant saja sehingga
     rating di kartu produk, PDP, dan section lain tidak ikut berubah. */
  .popup-variant .header .star-review .rating-text,
  .popup-variant .header .jdgm-widget .jdgm-prev-badge__text {
    font-size: 12px;
    line-height: 1.35;
  }

  .pv-gift {
    display: flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
    max-width: 100%;
    margin-top: 5px;
    padding: 3px 10px 3px 8px;
    border-radius: 999px;
    background: rgba(43, 60, 53, 0.07);
    border: 1px solid rgba(43, 60, 53, 0.1);
    color: #2b3c35;
    line-height: 1.35;
    position: relative;
    overflow: hidden;
    transition: background-color 200ms ease-out, border-color 200ms ease-out;
    animation: pvGiftIn 0.42s cubic-bezier(0.16, 1, 0.3, 1)
      calc(0.08s + var(--r, 0) * 0.08s) backwards;
  }

  .pv-gift__icon {
    display: inline-flex;
    flex: 0 0 auto;
    opacity: 0.85;
  }

  .pv-gift__icon svg {
    width: 11px;
    height: 11px;
  }

  .pv-gift__free {
    flex: 0 0 auto;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pv-gift__names {
    font-size: 10.5px;
    opacity: 0.8;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Memilih paketnya mempertegas hadiahnya. */
  .checkbox-button:hover .pv-gift,
  .checkbox-button.active .pv-gift {
    background: rgba(43, 60, 53, 0.11);
    border-color: rgba(43, 60, 53, 0.16);
  }

  /* Satu sapuan cahaya melintasi pil paket berhadiah TERBANYAK, sesudah semua
     baris mendarat. Itu perbedaan antar baris yang tidak terbaca dari kolom
     harga — sekali sapu, lalu diam. */
  .pv-gift--top::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.65) 50%,
      transparent 70%
    );
    transform: translateX(-130%);
    animation: pvGiftSweep 1.15s cubic-bezier(0.4, 0, 0.2, 1) 0.85s 1;
  }

  @keyframes pvGiftIn {
    from {
      opacity: 0;
      transform: translateY(-3px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes pvGiftSweep {
    to {
      transform: translateX(130%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-gift {
      animation: none;
      transition: none;
    }

    .pv-gift--top::after {
      display: none;
      animation: none;
    }
  }
{% endstylesheet %}
