<script type="application/json" data-gift-map>{{ gift_map }}</script>

<style>
  /* Gerak kedatangan hadiah. Doktrinnya: transform + opacity saja (tidak
     pernah properti layout), kurva melambat power4.out untuk kedatangan, dan
     opasitas selesai lebih dulu daripada geraknya sehingga barisnya "mendarat"
     alih-alih sekadar memudar masuk. Durasi ditahan di bawah 500ms sesuai
     pedoman micro-interaction.

     Skeleton-nya sendiri memakai .cart-item--optimistic milik tema, jadi
     animasi masuknya sudah seragam dengan kartu optimistis mini cart. */
  @keyframes v2GiftLand {
    from { opacity: 0; transform: translateY(0.5rem) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  .cart-item--gift-in {
    animation: v2GiftLand 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Isi barisnya menyusul badannya dengan tumpang-tindih kecil — kedatangan
     bertahap terbaca lebih mahal daripada satu lempeng yang muncul utuh. */
  .cart-item--gift-in .detail-info > * {
    animation: v2GiftLand 300ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .cart-item--gift-in .detail-info > :nth-child(1) { animation-delay: 70ms; }
  .cart-item--gift-in .detail-info > :nth-child(2) { animation-delay: 110ms; }
  .cart-item--gift-in .detail-info > :nth-child(3) { animation-delay: 140ms; }

  /* Skeleton pergi lebih cepat dan dengan kurva mempercepat — kepergian tidak
     boleh menahan perhatian selama kedatangan. */
  .cart-item--gift-out {
    animation: v2GiftLand 160ms cubic-bezier(0.7, 0, 0.84, 0) reverse both;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cart-item--gift-in,
    .cart-item--gift-in .detail-info > *,
    .cart-item--gift-out {
      animation-duration: 1ms;
      animation-delay: 0ms;
    }
  }
</style>

<script>
  (function () {
    var el = document.querySelector('[data-gift-map]');
    if (!el) return;

    var MAP;
    try { MAP = JSON.parse(el.textContent); } catch (e) { return; }

    var GIFTS = {};
    Object.keys(MAP).forEach(function (k) {
      MAP[k].forEach(function (g) { GIFTS[g] = true; });
    });

    /* Putaran sinkronisasi diserialkan lewat satu rantai promise supaya dua
       putaran tidak pernah berjalan bersamaan dan tidak ada yang terbuang. */
    var chain = Promise.resolve();
    /* Menandai permintaan keranjang milik snippet ini sendiri. */
    var internal = 0;
    /* Berapa baris hadiah yang sedang ditunggu. Selama > 0, drawer diberi
       kartu skeleton supaya pembeli langsung melihat hadiahnya sedang datang. */
    var awaiting = 0;

    function ownFetch(url, opts) {
      internal++;
      var req = fetch(url, opts);
      internal--;
      return req;
    }

    function post(url, payload) {
      return ownFetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      }).then(function (res) {
        if (!res.ok) throw new Error('cart ' + res.status);
        return res.json();
      });
    }

    function readCart() {
      return ownFetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) {
          /* Status WAJIB diperiksa. Saat Shopify membatasi laju endpoint
             keranjang ia membalas 429 dengan halaman HTML, dan .json() atasnya
             melempar SyntaxError yang tertelan .catch di ujung rantai —
             sinkronisasi mati diam-diam dan hadiahnya tampak menyangkut. */
          if (!r.ok) throw new Error('cart ' + r.status);
          return r.json();
        });
    }

    /* Ulangi dengan jeda menaik. 429 di endpoint keranjang bersifat sesaat,
       jadi menyerah pada percobaan pertama membuat keranjang tertinggal di
       keadaan setengah jadi yang tidak pernah pulih sendiri. */
    function withRetry(fn, tries, delay) {
      return fn().catch(function (err) {
        if (tries <= 1) throw err;
        return new Promise(function (resolve) { setTimeout(resolve, delay); })
          .then(function () { return withRetry(fn, tries - 1, delay * 2); });
      });
    }

    function itemsParent(root) {
      var first = root.querySelector('.cart-item');
      return first ? first.parentNode : root;
    }

    /* Skeleton memakai kelas loading milik tema (.cart-item--optimistic dan
       .opt-shimmer) supaya animasi, warna, dan iramanya identik dengan kartu
       optimistis yang sudah dipakai mini cart — bukan gaya baru yang bersaing. */
    function skeletonCard() {
      var el = document.createElement('div');
      el.className = 'cart-item cart-item--gift cart-item--optimistic';
      el.setAttribute('data-gift-skeleton', '');
      el.setAttribute('aria-hidden', 'true');
      el.innerHTML =
        '<div class="thumb"><span class="opt-shimmer" style="display:block;width:100%;height:100%"></span></div>' +
        '<div class="detail"><div class="detail-top"><div class="detail-info">' +
        '<span class="opt-shimmer" style="display:block;width:7.5rem;height:0.875rem;margin-bottom:0.5rem"></span>' +
        '<span class="opt-shimmer" style="display:block;width:4rem;height:1.25rem;border-radius:999px"></span>' +
        '</div></div></div>';
      return el;
    }

    function clearSkeletons(root) {
      (root || document).querySelectorAll('[data-gift-skeleton]').forEach(function (n) {
        /* Beri kepergian singkat lalu buang. Kalau animasi dimatikan pengguna,
           timeout tetap membersihkannya sehingga tidak ada sisa yang menempel. */
        n.classList.add('cart-item--gift-out');
        setTimeout(function () { if (n.parentNode) n.remove(); }, 180);
      });
    }

    function ensureSkeletons() {
      var c = document.getElementById('cart');
      if (!c || awaiting < 1) return;
      var have = c.querySelectorAll('[data-gift-skeleton]').length;
      var parent = itemsParent(c);
      for (var i = have; i < awaiting; i++) parent.insertBefore(skeletonCard(), parent.firstChild);
    }

    /* Tema mengisi #cart dengan HTML dari /cart?view=mini setiap kali drawer
       dibuka, jadi skeleton yang disisipkan lebih awal akan tersapu. Mengamati
       perubahan isinya membuat skeleton dipasang ulang tepat setelah render. */
    var cartRoot = document.getElementById('cart');
    if (cartRoot) {
      new MutationObserver(function () { ensureSkeletons(); })
        .observe(cartRoot, { childList: true, subtree: true });
    }

    /* Ganti skeleton dengan baris hadiah sungguhan, diambil dari render server
       supaya markup dan gayanya persis sama dengan baris keranjang lain. Hanya
       node hadiah yang disisipkan — sisa drawer tidak disentuh agar event
       binding milik tema tetap utuh. */
    function paintGifts() {
      var c = document.getElementById('cart');
      if (!c) { awaiting = 0; return Promise.resolve(); }
      var prefix = (window.Shopify && window.Shopify.locale === 'id') ? '/id' : '';
      return ownFetch(prefix + '/cart?view=mini', { headers: { Accept: 'text/html' } })
        .then(function (r) {
          /* Halaman 429 tetap HTML yang sah, jadi tanpa penjagaan ini ia
             ter-parse jadi dokumen tanpa baris hadiah — dan rekonsiliasi dua
             arah di bawah akan MENGHAPUS hadiah yang sebenarnya sah. */
          if (!r.ok) throw new Error('mini ' + r.status);
          return r.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var parent = itemsParent(c);
          awaiting = 0;
          clearSkeletons(c);

          /* Rekonsiliasi DUA ARAH. Versi sebelumnya hanya menyisipkan baris
             hadiah yang kurang, tidak pernah membuang yang berlebih — sehingga
             saat produk utamanya dihapus, hadiahnya lenyap di server tapi
             node-nya tertinggal di drawer dan tampak menyangkut. */
          var fresh = {};
          doc.querySelectorAll('.cart-item--gift').forEach(function (node) {
            var k = node.getAttribute('data-key');
            if (k) fresh[k] = true;
          });
          c.querySelectorAll('.cart-item--gift').forEach(function (node) {
            if (node.hasAttribute('data-gift-skeleton')) return;
            var k = node.getAttribute('data-key');
            if (!k || !fresh[k]) {
              node.classList.add('cart-item--gift-out');
              setTimeout(function () { if (node.parentNode) node.remove(); }, 180);
            }
          });

          doc.querySelectorAll('.cart-item--gift').forEach(function (node) {
            var key = node.getAttribute('data-key');
            if (key && c.querySelector('.cart-item[data-key="' + key + '"]')) return;
            var real = document.importNode(node, true);
            real.classList.add('cart-item--gift-in');
            /* Kelas animasinya dilepas setelah selesai supaya render ulang
               berikutnya tidak memutarnya lagi. */
            real.addEventListener('animationend', function handler(ev) {
              if (ev.target !== real) return;
              real.classList.remove('cart-item--gift-in');
              real.removeEventListener('animationend', handler);
            });
            parent.insertBefore(real, parent.firstChild);
          });
        })
        .catch(function (err) {
          /* Diteruskan, bukan ditelan: 429 di sini harus memicu percobaan
             ulang. Skeleton sengaja DIBIARKAN — prosesnya memang belum
             selesai, jadi membersihkannya sekarang membuat hadiah berkedip
             hilang lalu muncul lagi. */
          throw err;
        });
    }

    function runSync() {
      return readCart()
        .then(function (cart) {
          var wanted = {};
          cart.items.forEach(function (item) {
            var gifts = MAP[String(item.variant_id)];
            if (gifts) gifts.forEach(function (g) { wanted[g] = true; });
          });

          /* Buang hadiah yang tidak lagi berhak. Selain baris bertanda _Gifted,
             baris apa pun yang variannya ada di daftar hadiah juga dibuang:
             produk hadiah tidak bisa dibeli terpisah, jadi kalau ia ada tanpa
             pemicunya, ia pasti sisa yang tersangkut. */
          var drop = [];
          cart.items.forEach(function (item) {
            var ours = item.properties && item.properties._Gifted;
            if ((ours || GIFTS[item.variant_id]) && !wanted[item.variant_id]) drop.push(item.key);
          });

          var present = {};
          cart.items.forEach(function (item) { present[item.variant_id] = true; });
          var missing = Object.keys(wanted).filter(function (g) { return !present[g]; });

          if (!drop.length && !missing.length) {
            if (awaiting) { awaiting = 0; clearSkeletons(); }
            return null;
          }

          /* Semua penghapusan digabung ke satu /cart/update.js. Endpoint ini
             menerima line key sebagai kunci (diuji langsung ke toko) dan
             mengembalikan keranjang penuh, jadi satu permintaan sudah cukup —
             makin sedikit permintaan, makin jarang kena batas laju. */
          var work = Promise.resolve(null);
          if (drop.length) {
            work = work.then(function () {
              var updates = {};
              drop.forEach(function (key) { updates[key] = 0; });
              return post('/cart/update.js', { updates: updates });
            });
          }
          if (missing.length) {
            work = work.then(function () {
              return post('/cart/add.js', {
                items: missing.map(function (g) {
                  return { id: Number(g), quantity: 1, properties: { _Gifted: 'true' } };
                })
              });
            });
            /* /cart/add.js hanya mengembalikan baris yang ditambahkan, bukan
               keranjang penuh, jadi di jalur ini pembacaan ulang wajib. */
            return work.then(readCart);
          }
          /* Jalur hapus-saja: /cart/update.js sudah mengembalikan keranjang
             penuh, jadi tidak perlu dibaca ulang. */
          return work;
        })
        .then(function (cart) {
          if (!cart) return null;
          /* Cat ulang baris hadiah DULU, baru totalnya. Kalau urutannya
             dibalik, total sempat dihitung saat baris basi masih terpasang. */
          return paintGifts().then(function () {
            if (typeof window.refreshCartUI === 'function') {
              try { window.refreshCartUI(cart); } catch (e) { /* abaikan */ }
            }
          });
        })
        /* Skeleton dibiarkan selama percobaan ulang; hanya syncOnce yang
           membersihkannya, dan itu pun setelah semua percobaan habis. */
        .catch(function (err) { throw err; });
    }

    /* Sinkronisasi penuh dengan percobaan ulang. Kalau tetap gagal, keranjang
       dibaca sekali lagi supaya total di tombol checkout tidak tertinggal di
       angka lama — angka basi lebih berbahaya daripada baris yang telat hilang,
       karena pembeli memutuskan berdasarkan angka itu. */
    function syncOnce() {
      return withRetry(runSync, 3, 1200).catch(function () {
        awaiting = 0;
        clearSkeletons();
        return readCart()
          .then(function (cart) {
            if (typeof window.refreshCartUI === 'function') window.refreshCartUI(cart);
          })
          .catch(function () { /* keranjang benar-benar tak terjangkau */ });
      });
    }

    function sync() {
      chain = chain.then(syncOnce, syncOnce);
      return chain;
    }

    var origFetch = window.fetch;
    window.fetch = function () {
      var url = arguments[0];
      var href = typeof url === 'string' ? url : (url && url.url) || '';
      var mine = internal > 0;
      /* Harus dipanggil dengan window sebagai this — fetch yang dilepas dari
         konteksnya melempar "Illegal invocation" di sebagian browser. */
      var result = origFetch.apply(window, arguments);

      if (mine || !/\/cart\/(add|change|update)(\.js)?/.test(href)) return result;

      /* Responsnya TIDAK ditahan: drawer harus terbuka secepat biasanya.
         Sebagai gantinya jumlah hadiah yang akan datang dihitung dari payload
         permintaan ini, lalu skeleton dipasang begitu drawer selesai dirender. */
      try {
        var body = arguments[1] && arguments[1].body;
        if (body && /\/cart\/add/.test(href)) {
          var parsed = JSON.parse(body);
          var incoming = parsed.items || [parsed];
          var expect = {};
          incoming.forEach(function (it) {
            var gifts = MAP[String(it.id)];
            if (gifts) gifts.forEach(function (g) { expect[g] = true; });
          });
          var n = Object.keys(expect).length;
          if (n) { awaiting = n; ensureSkeletons(); }
        }
      } catch (e) { /* payload tak terbaca: lewati skeleton, sinkronisasi tetap jalan */ }

      result.then(function () { sync(); }).catch(function () { awaiting = 0; clearSkeletons(); });
      return result;
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { sync(); });
    } else {
      sync();
    }

    /* Halaman yang dipulihkan dari bfcache tidak menjalankan DOMContentLoaded,
       jadi keranjang basi bisa tampil apa adanya. */
    window.addEventListener('pageshow', function (e) { if (e.persisted) sync(); });

    /* Jaring terakhir: sebelum pembeli menuju checkout. */
    document.addEventListener('click', function (e) {
      var t = e.target;
      if (t && t.closest && t.closest('[name="checkout"], a[href*="/checkout"]')) sync();
    }, true);
  })();
</script>
