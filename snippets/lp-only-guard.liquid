{% doc %}
  Menjaga agar produk eksklusif landing page tidak terbawa ke luar funnel-nya.

  Produk bertag `lp-only` hanya boleh berada di keranjang selama pembeli masih
  berada di dalam alur landing page. Begitu ia kembali menjelajah toko biasa,
  item itu dikeluarkan dari keranjang — bukan hanya disembunyikan di tampilan,
  tetapi benar-benar dihapus lewat /cart/update.js sehingga keranjang di server
  ikut bersih.

  Halaman yang dianggap masih di dalam funnel:
  - halaman landing page itu sendiri (daftar handle di `lp_guard_pages`)
  - halaman keranjang (/cart, termasuk berawalan lokal seperti /id/cart)

  Halaman keranjang WAJIB dikecualikan. Tombol paket di landing page menuju
  permalink keranjang, jadi pembeli selalu melewati /cart sebelum membayar.
  Tanpa pengecualian ini, keranjang akan dikosongkan tepat saat pembeli hendak
  checkout dan tidak akan pernah ada pesanan yang masuk.

  Atribut keranjang `lp_source` tetap dipasang saat pembeli datang dari landing
  page. Atribut itu tidak lagi menentukan penghapusan, tetapi ikut sampai ke
  pesanan sehingga bisa dipakai untuk pelaporan atau otomasi Flow.

  @example
  {% render 'lp-only-guard' %}
{% enddoc %}

{% liquid
  assign lp_guard_tag = 'lp-only'
  assign lp_guard_pages = 'dukungan-menopause-offer-terbatas,menopause-lp,inside-out-protocol'
  assign lp_guard_keys = ''
  assign lp_in_funnel = false

  assign lp_last_segment = request.path | split: '/' | last
  if lp_last_segment == 'cart'
    assign lp_in_funnel = true
  endif

  unless lp_in_funnel
    assign lp_guard_handles = lp_guard_pages | split: ','
    for lp_handle in lp_guard_handles
      assign lp_needle = lp_handle | strip
      if lp_needle != blank and request.path contains lp_needle
        assign lp_in_funnel = true
        break
      endif
    endfor
  endunless

  for lp_item in cart.items
    if lp_item.product.tags contains lp_guard_tag
      assign lp_guard_keys = lp_guard_keys | append: lp_item.key | append: '~~'
    endif
  endfor
%}

{%- if lp_guard_keys != blank and request.design_mode != true -%}
  <div
    class="lp-guard"
    data-lp-guard
    data-keys="{{ lp_guard_keys | split: '~~' | join: '||' | escape }}"
    data-in-funnel="{{ lp_in_funnel }}"
    data-source="{{ cart.attributes.lp_source | escape }}"
    data-landing-handle="{{ lp_guard_pages | split: ',' | first | strip | escape }}"
    hidden
  ></div>
{%- endif -%}

{% stylesheet %}
  /* Elemen ini hanya pembawa data untuk skrip di bawah, tidak pernah terlihat.
     Toast pemberitahuan sengaja dihapus: penghapusan item tetap berjalan diam-diam
     supaya pembeli tidak dihadapkan pesan yang membingungkan di luar konteks LP. */
  .lp-guard {
    display: none;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var STORAGE_KEY = 'lp_source';

    function post(url, payload) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      }).then(function (res) {
        if (!res.ok) throw new Error('cart request failed: ' + res.status);
        return res.json();
      });
    }

    function repaint(cart) {
      // Tema menyediakan pembaruan mini-cart-nya sendiri; pakai itu supaya
      // jumlah item dan total ikut berubah tanpa memuat ulang halaman.
      if (typeof window.refreshCartUI === 'function') {
        try {
          window.refreshCartUI(cart);
          return true;
        } catch (e) {
          /* jatuh ke muat ulang di bawah */
        }
      }
      return false;
    }

    function run(root) {
      if (root.dataset.lpGuardDone === '1') return;
      root.dataset.lpGuardDone = '1';

      var keys = (root.getAttribute('data-keys') || '').split('||').filter(Boolean);
      if (!keys.length) return;

      var inFunnel = root.getAttribute('data-in-funnel') === 'true';

      if (inFunnel) {
        // Masih di dalam alur landing page. Pastikan asal-usulnya tercatat pada
        // keranjang supaya ikut terbawa ke pesanan.
        if ((root.getAttribute('data-source') || '').trim()) return;

        var marker = '';
        try {
          marker = sessionStorage.getItem(STORAGE_KEY) || '';
        } catch (e) {
          marker = '';
        }

        post('/cart/update.js', {
          attributes: { lp_source: marker || root.getAttribute('data-landing-handle') }
        }).catch(function () {});
        return;
      }

      // Di luar alur: keluarkan dari keranjang, termasuk di sisi server.
      var updates = {};
      keys.forEach(function (key) {
        updates[key] = 0;
      });

      post('/cart/update.js', { updates: updates })
        .then(function (cart) {
          if (!repaint(cart)) window.location.reload();
        })
        .catch(function () {});
    }

    function init(scope) {
      (scope || document).querySelectorAll('[data-lp-guard]').forEach(run);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        init();
      });
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
    });
  })();
{% endjavascript %}
