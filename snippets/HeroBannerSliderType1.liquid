<div class="title">
  {%- if block.settings.t -%}
    <div class="line-one {% unless request.design_mode %} stagger {% endunless %}">
      {{ block.settings.title_one | newline_to_br }}
    </div>
  {%- endif -%}
  {%- if block.settings.title_two -%}
    <div class="line-two {% unless request.design_mode %} stagger {% endunless %}">
      <h1>{{ block.settings.title_two | newline_to_br }}</h1>
    </div>
  {%- endif -%}
</div>

<div class="description {% unless request.design_mode %} stagger {% endunless %}">
  {{ block.settings.content | newline_to_br }}
</div>

{% if v2 %}
  {% render 'HeroCardV2', product: product, excerpt: block.settings.card_excerpt %}
{% elsif product != empty %}
  <a href="{{ product.url }}" class="product {% unless request.design_mode %} stagger {% endunless %}">
    <div class="thumb">
      <img
        src="{{product.featured_image | image_url: width: '96x' }}"
        width="96"
        height="96"
        alt="{{ product.featured_image.alt | default: product.title | default: 'Treelogy moringa product' | escape }}"
        loading="lazy">
    </div>
    <div class="product-card-detail">
      <div class="rating">
        {% render 'Rating'
          , product: product %}
      </div>
      <div class="product-title">{{ product.title }}</div>
      {% assign description = product.excerpt | default: product.content | strip_html %}
      <div class="product-excerpt desktop">
        {{ description | truncate: '80' }}
      </div>

      <div class="product-excerpt mobile">
        {{ description | truncate: '68' }}
      </div>
      {%- comment -%}
        Cabang legacy (kill-switch v2 dimatikan). `.product:` di sini salah tulis
        — pemisah argumen render harus koma; dibiarkan begitu, fallback-nya rusak
        justru saat dibutuhkan.
      {%- endcomment -%}
      <div class="price">{{ 'products.general.from' | t }}&nbsp;{% render 'PriceFormat', product: block.settings.product %}</div>
    </div>
  </a>
{% endif %}