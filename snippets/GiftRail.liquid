{% doc %}
  Merender deretan hadiah gratis yang menyertai satu varian, untuk dipasang
  tepat di bawah tombol paketnya.

  Sumbernya metafield varian `custom.eligible_gifts` — peta yang SAMA yang
  dipakai snippets/gift-auto-add.liquid saat memasukkan hadiah ke keranjang.
  Jadi apa yang dijanjikan tombol ini tidak akan pernah bisa berbeda dari apa
  yang benar-benar diterima pembeli, dan mengubah aturan hadiah dari admin
  otomatis mengubah tampilan di sini. Varian tanpa hadiah merender nol markup.

  Fotonya foto produk hadiah yang asli: pembeli melihat barangnya, bukan
  membaca janji. Itu yang membuat baris ini layak diklik.

  @param {variant} variant - Varian yang hadiahnya ditampilkan

  @example
  {% render 'GiftRail', variant: fp_v1 %}
{% enddoc %}

{%- liquid
  assign gr_gifts = variant.metafields.custom.eligible_gifts.value
  assign gr_count = gr_gifts | size
-%}

{%- if gr_count > 0 -%}
  {%- capture gr_names -%}
    {%- for gr_gift in gr_gifts -%}
      {{- gr_gift.product.title -}}
      {%- unless forloop.last -%}&#32;&middot;&#32;{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  <span class="fp-gift" data-fp-gift>
    {%- comment -%}
      Chip ikon memimpin tumpukan, bukan berdiri terpisah: satu deret token
      yang dibaca sebagai "ini hadiah" lalu "ini barangnya". Ikon kadonya
      sengaja sama dengan badge GRATIS di keranjang dan penanda hadiah di
      kartu paket PDP — satu bahasa visual di seluruh perjalanan pembeli.
    {%- endcomment -%}
    <span class="fp-gift__stack" aria-hidden="true">
      <span class="fp-gift__chip">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M20 12v8a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-8M2 7h20v4H2V7Zm10-1v15M12 6H8.5a2.25 2.25 0 1 1 0-4.5C11 1.5 12 6 12 6Zm0 0h3.5a2.25 2.25 0 1 0 0-4.5C13 1.5 12 6 12 6Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      {%- for gr_gift in gr_gifts -%}
        <span class="fp-gift__thumb" style="--i: {{ forloop.index }}">
          <img
            src="{{ gr_gift.product.featured_image | image_url: width: 88, height: 88, crop: 'center' }}"
            alt=""
            width="88"
            height="88"
            loading="lazy">
        </span>
      {%- endfor -%}
    </span>
    <span class="fp-gift__text">
      <b class="fp-gift__free">{{ 'cart.gift_free_label' | t }}</b>
      <span class="fp-gift__names">{{ gr_names | strip }}</span>
    </span>
  </span>
{%- endif -%}

{% stylesheet %}
  /* ===== Deret hadiah di bawah tombol paket =====
     Doktrin gerak: transform + opacity saja, tidak pernah properti layout;
     kurva melambat (power4-out) untuk kedatangan; setiap animasi berhingga —
     tidak ada yang berulang selamanya menuntut perhatian. */
  .fp-gift {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    max-width: 100%;
    min-width: 0;
    animation: fpGiftRise 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.48s backwards;
  }

  .fp-gift__stack {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  /* Cincin seterang latar memisahkan token yang saling tumpang-tindih —
     tanpa itu dua foto gelap berdempet terbaca sebagai satu gumpalan. */
  .fp-gift__chip,
  .fp-gift__thumb {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1.5px solid rgba(247, 248, 241, 0.92);
    background: #f7f8f1;
    overflow: hidden;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .fp-gift__chip {
    background: #2b3c35;
    color: #f2f2e8;
    animation:
      fpGiftPop 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.54s backwards,
      fpGiftBeat 0.9s cubic-bezier(0.34, 1.4, 0.5, 1) 1.7s 1;
  }

  .fp-gift__chip svg {
    width: 12px;
    height: 12px;
  }

  .fp-gift__thumb {
    margin-left: -8px;
    animation: fpGiftPop 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(0.54s + var(--i, 1) * 0.08s) backwards;
  }

  .fp-gift__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fp-gift__text {
    font-size: 11px;
    line-height: 1.45;
    color: #2b3c35;
    min-width: 0;
    flex: 1 1 auto;
    overflow-wrap: anywhere;
  }

  .fp-gift__free {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-right: 5px;
  }

  .fp-gift__names {
    opacity: 0.76;
    transition: opacity 200ms ease-out;
  }

  /* Menyentuh tombolnya MEMBUKA hadiahnya: tumpukan merenggang, chip
     terangkat sedikit, nama menajam. Gerakan itulah yang menautkan "klik ini"
     dengan "dapat ini" — bukan sekadar dekorasi hover. */
  .fp-cta:hover .fp-gift__thumb,
  .fp-cta:focus-within .fp-gift__thumb {
    transform: translateX(calc(var(--i, 1) * 3px));
  }

  .fp-cta:hover .fp-gift__chip,
  .fp-cta:focus-within .fp-gift__chip {
    transform: translateY(-1px) scale(1.07);
  }

  .fp-cta:hover .fp-gift__names,
  .fp-cta:focus-within .fp-gift__names {
    opacity: 1;
  }

  @keyframes fpGiftRise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fpGiftPop {
    from {
      opacity: 0;
      transform: translateX(-7px) scale(0.78);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Satu ketukan perhatian, sekali saja: cukup untuk menarik mata ke hadiah
     saat halaman sudah tenang, lalu berhenti dan tidak pernah mengganggu lagi. */
  @keyframes fpGiftBeat {
    0%,
    100% {
      transform: none;
    }
    35% {
      transform: scale(1.16) rotate(-6deg);
    }
    62% {
      transform: scale(0.98) rotate(2deg);
    }
  }

  /* Mobile: kolomnya hanya ~165px — nama dua hadiah mustahil muat sebaris
     dengan foto dan label FREE. Alih-alih membiarkannya membungkus asal
     (yang membuat kolom 1-hadiah dan 2-hadiah beda tinggi), deret ini dipecah
     dua baris YANG DISENGAJA: foto + FREE di atas, nama di bawahnya. Karena
     tiap paket selalu punya persis dua baris, kedua kolom terkunci sama
     tinggi apa pun jumlah hadiahnya.

     display:contents membubarkan pembungkus teks sehingga FREE dan nama
     menjadi anak langsung flex — nama lalu dipaksa ke barisnya sendiri lewat
     flex-basis 100%, bukan lewat pembungkusan yang tak bisa dikendalikan. */
  @media only screen and (max-width: 900px) {
    .fp-gift {
      flex-wrap: wrap;
      column-gap: 6px;
      row-gap: 3px;
    }

    .fp-gift__text {
      display: contents;
    }

    .fp-gift__free {
      margin-right: 0;
    }

    .fp-gift__names {
      flex: 0 0 100%;
      font-size: 10px;
      line-height: 1.35;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .fp-gift__chip,
    .fp-gift__thumb {
      width: 20px;
      height: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-gift,
    .fp-gift__chip,
    .fp-gift__thumb {
      animation: none;
      transition: none;
    }

    .fp-cta:hover .fp-gift__thumb,
    .fp-cta:focus-within .fp-gift__thumb,
    .fp-cta:hover .fp-gift__chip,
    .fp-cta:focus-within .fp-gift__chip {
      transform: none;
    }
  }
{% endstylesheet %}
