{%- capture pc_plan_gifts -%}
[
{%- for pc_v in item.variants -%}
  {%- assign pc_g = pc_v.metafields.custom.eligible_gifts.value -%}
  {%- assign pc_gc = pc_g | size -%}
  {%- if pc_gc > 0 -%}
    [
    {%- for pc_gift in pc_g -%}
      {"i":{{ pc_gift.product.featured_image | image_url: width: 72, height: 72, crop: 'center' | json }},"n":{{ pc_gift.product.title | json }}}
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- else -%}null{%- endif -%}
  {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture pc_plan_labels -%}
[
{%- for pc_v in item.variants -%}
  {%- liquid
    assign pc_vl = pc_v.metafields.custom.staged_plan_label
    if pc_vl == blank
      assign pc_vl = pc_v.metafields.custom.time_protocol
    endif
    if pc_vl == blank
      assign pc_vl = pc_v.title
    endif
  -%}
  {{- pc_vl | json -}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}
{% if item %}
  {% assign first_variant = item.variants.first %}
  {% assign card_image = item.media.first %}
  {% for image in item.media %}
    {% if image.alt contains 'LANG:' %}
      {% assign language_code = image.alt | split: "|" | first | remove: "LANG:" | downcase %}
      {% if language_code == request.locale.iso_code %}
        {% assign card_image = image %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if card_image.alt contains 'LANG:' %}
    {% assign card_alt = card_image.alt | split: "|" | last %}
  {% else %}
    {% assign card_alt = card_image.alt | default: item.title %}
  {% endif %}
  <div class="card swiper-slide" data-cs-capture>
    <figure>
      <a href="{{ item.url }}">
        {{- card_image
          | image_url: width: 350
          | image_tag: widths: '175, 350', loading: 'lazy', alt: card_alt
        -}}
      </a>

      {% comment %} {% unless button_cart %} {% endcomment %}
      {% if first_variant.available %}
        <div class="button-wrapper">
        {% comment %}
          Hidden rating copy: app.bundle.js opens the variant popup by reading
          btn.parentNode.parentNode.querySelector('.star-review'), which for this
          overlay button resolves to <figure>. The visible rating lives in
          .card-detail (outside figure), so without this copy the lookup returns
          null and the click throws before the popup opens.
        {% endcomment %}
        <span hidden aria-hidden="true">{% render 'Rating', product: item %}</span>
        <a
          href="#"
          class="button-cart button-quick-add-cart overlay-button open-popup-variants"
          data-title="{{ item.title }}"
          data-slug="{{ item.url }}"
          data-plan-labels="{{ pc_plan_labels | strip | escape }}"
          data-plan-gifts="{{ pc_plan_gifts | strip | escape }}"
        >
          {{ 'products.general.add_to_cart' | t }}
        </a>
        </div>
      {% endif %}
      {% comment %} {% endunless %} {% endcomment %}
    </figure>
    <div class="card-detail">
      <div>
        <div class="top">{% render 'Rating', product: item %}</div>
        <a href="{{ item.url }}" class="card-detail__description">
          <h2 class="sub-head-alt">{{ item.title }}</h2>
          <div class="sort-desc">
            {{
              item.metafields.custom.excerpt
              | default: 'Superfood, packed with vitamins, minerals, and antioxidants.'
            }}
          </div>
          <div class="price-wrapper">
            {% if item.price_varies %}
              {{ 'products.general.from' | t }}
            {% endif %}
            {% render 'PriceFormat'
              , product: item %}
          </div>
        </a>
      </div>

      {% if button_cart and first_variant.available %}
        <a
          href="#"
          class="button-cart button-quick-add-cart open-popup-variants"
          data-title="{{ item.title }}"
          data-slug="{{ item.url }}"
          data-plan-labels="{{ pc_plan_labels | strip | escape }}"
          data-plan-gifts="{{ pc_plan_gifts | strip | escape }}"
        >
          {{ 'products.general.add_to_cart' | t }}
        </a>
      {% endif %}
    </div>
  </div>
{% endif %}
