    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    /* Kontras ~7:1 di atas latar drawer — sengaja lebih redup dari harga dan
       tombol, tetap terbaca nyaman. */
