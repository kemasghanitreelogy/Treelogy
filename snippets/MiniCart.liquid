<script>
  /* ===== Premium Add-to-Cart choreography — all quick-add surfaces ======== */
  /* Optimistic UI (Shopify Hydrogen guidance): drawer opens with the item    */
  /* already inside; the server response reconciles silently. No spinner for  */
  /* sub-second ops (NN/g); pressed -> adding -> success morph with a 350ms   */
  /* minimum state hold. Covers: PDP #AddToCart, the variant-popup button,    */
  /* and .button-direct-add cards. FBT keeps its own surgical flow;           */
  /* FeaturedBundle keeps its own stateful flow.                              */
  (function () {
    var SELECTOR = '#AddToCart, #popup-variants-button-bag, .button-direct-add';
    var MIN_STATE = 350;
    var L = window.cartDecodeMap({
      adding: {{ 'cart.atc_adding' | t | json }},
      added: '\u2713 ' + {{ 'cart.atc_added' | t | json }},
      failed: {{ 'cart.atc_failed_generic' | t | json }}
    });

    function utmFlowOwnsButton() {
      try {
        return (
          typeof window.isUtmFreeShipping === 'function' && window.isUtmFreeShipping()
          && sessionStorage.getItem('utm_source_matched') === 'kesehatanwanita_blog'
          && sessionStorage.getItem('utm_discount_code')
        );
      } catch (err) {
        return false;
      }
    }

    /* Image + title for the optimistic card, resolved per surface */
    function cardContext(btn) {
      if (btn.id === 'AddToCart') {
        var h1 = document.querySelector('.product-detail-wrapper h1');
        var sel = document.getElementById('productSelect');
        var variantText = '';
        /* Kartu paket v2 adalah yang benar-benar ditekan pembeli, dan judulnya
           berasal dari metafield staged_plan_label — label yang sama yang kini
           dirender snippets/CartItemCard.liquid. Membacanya dari sini membuat
           kartu optimistis dan baris hasil server berbunyi sama, jadi tidak ada
           teks yang berganti saat keduanya bertukar. Select bawaan tetap jadi
           cadangan untuk halaman produk yang belum memakai kartu v2. */
        var plans = document.querySelectorAll('.v2-plan');
        var activePlan = document.querySelector('.v2-plan.active .v2-plan__title, .v2-plan[aria-checked="true"] .v2-plan__title');
        if (plans.length > 1 && activePlan) {
          variantText = (activePlan.textContent || '').trim();
        } else if (sel && sel.options.length > 1 && sel.selectedIndex >= 0) {
          variantText = (sel.options[sel.selectedIndex].text || '').split(' - ')[0].trim();
        }
        return {
          img: document.querySelector('.native-gallery__slide img'),
          title: h1 ? h1.textContent : '',
          variant: variantText
        };
      }
      if (btn.id === 'popup-variants-button-bag') {
        var pt = document.getElementById('popup-variant-title');
        return { img: null, title: pt ? pt.textContent : '' };
      }
      var scope = btn, img = null, hops = 0;
      while (scope && hops++ < 5 && !img) {
        scope = scope.parentElement;
        if (scope) img = scope.querySelector('img');
      }
      var titleEl = scope && scope.querySelector('.product-info, .title, h3, h2, h1');
      return { img: img, title: titleEl ? titleEl.textContent : '' };
    }

    /* Real price for the optimistic card when the data already exists
       client-side (price matrix / variant cards); shimmer otherwise. */
    function optimisticPrice(variantId, planId) {
      try {
        var m = window.subscriptionPriceMatrix && window.subscriptionPriceMatrix[String(variantId)];
        if (m) {
          if (planId && m.plans && m.plans[String(planId)]) return m.plans[String(planId)].final;
          return m.onetime;
        }
        /* data-variant-price is denominated in rupiah (same contract the UTM
           discount renderer uses) — NOT cents */
        var card = document.querySelector('.protocol-variant-card[data-value="' + variantId + '"]');
        if (card && card.dataset.variantPrice && window.formatRp) {
          return window.formatRp(parseInt(card.dataset.variantPrice, 10));
        }
      } catch (err) {}
      return null;
    }

    /* Markup mirrors snippets/CartItemCard.liquid exactly (same classes,
       same structure) so fonts, sizes and spacing are identical before and
       after reconciliation — the swap reads as a data refresh, not a
       re-layout. Qty ghost is a real disabled <select> for pixel parity. */
    function buildOptimisticCard(ctx, priceText) {
      var el = document.createElement('div');
      el.className = 'cart-item cart-item--optimistic';
      el.innerHTML =
        '<a class="thumb"></a>'
        + '<div class="detail">'
        +   '<div class="detail-top">'
        +     '<div class="detail-info">'
        +       '<a class="sub-head title"></a>'
        +       '<div class="variant body-desk-s"></div>'
        +     '</div>'
        +   '</div>'
        +   '<div class="detail-bottom">'
        +     '<div class="price-row">'
        +       '<div class="sub-head price-wrapper"></div>'
        +     '</div>'
        +     '<div class="qty-select-wrapper">'
        +       '<select class="qty-select" disabled aria-hidden="true"><option>1</option></select>'
        +       '<svg class="qty-arrow" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="#2B3C35" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        +     '</div>'
        +   '</div>'
        + '</div>';
      if (ctx.img) {
        var im = document.createElement('img');
        im.src = ctx.img.currentSrc || ctx.img.src;
        im.alt = '';
        el.querySelector('.thumb').appendChild(im);
      }
      el.querySelector('.title').textContent = (ctx.title || '').trim();
      if (ctx.variant) el.querySelector('.variant').textContent = ctx.variant;
      var priceEl = el.querySelector('.price-row .price-wrapper');
      if (priceText) priceEl.textContent = priceText;
      else priceEl.innerHTML = '<span class="opt-shimmer"></span>';
      return el;
    }

    /* Scoped crossfade for the reconciliation swap. Deliberately NOT
       document.startViewTransition: a full-page snapshot freezes every
       running animation (shimmer, marquee) for ~180ms and reads as a
       glitch. Fading only the drawer regions keeps the rest alive. */
    function smoothApply(fn) {
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var sel = ['#cart .cart-items', '#cart .sub-total.cart-footer'];
      var targets = sel.map(function (q) { return document.querySelector(q); }).filter(Boolean);
      if (reduce || !targets.length) { fn(); return; }
      targets.forEach(function (el) {
        el.style.transition = 'opacity 120ms ease-out';
        el.style.opacity = '0';
      });
      setTimeout(function () {
        fn();
        /* re-query: the full-render fallback may have replaced the nodes */
        var fresh = sel.map(function (q) { return document.querySelector(q); }).filter(Boolean);
        fresh.forEach(function (el) {
          el.style.transition = 'none';
          el.style.opacity = '0';
        });
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            fresh.forEach(function (el) {
              el.style.transition = 'opacity 200ms cubic-bezier(0.16, 1, 0.3, 1)';
              el.style.opacity = '1';
            });
            setTimeout(function () {
              fresh.forEach(function (el) { el.style.transition = ''; el.style.opacity = ''; });
            }, 280);
          });
        });
      }, 125);
    }

    /* Central FBT choreography: wraps syncFBTVisibility so EVERY flow
       (premium ATC, FBT add, app.bundle re-render) resolves the skeleton
       into real cards with the stagger reveal. */
    if (window.syncFBTVisibility && !window.syncFBTVisibility.__fbtWrapped) {
      var __origSyncFBT = window.syncFBTVisibility;
      window.syncFBTVisibility = function (cart) {
        var sec = document.querySelector('.fbt-section');
        var visBefore = !!(sec && sec.querySelector('.fbt-card[style*="flex"]'));
        __origSyncFBT(cart);
        if (!sec) return;
        var visAfter = !!sec.querySelector('.fbt-card[style*="flex"]');
        var wasLoading = sec.classList.contains('fbt-loading');
        sec.classList.remove('fbt-loading');
        /* syncFBTVisibility already ran its per-card restore choreography on
           this pass; stacking the fbt-reveal stagger on top would re-animate
           the same cards from a second from-state mid-transition. */
        if (sec.dataset.fbtReturning) return;
        if (visAfter && (wasLoading || !visBefore)) {
          sec.classList.add('fbt-reveal');
          setTimeout(function () { sec.classList.remove('fbt-reveal'); }, 700);
        }
      };
      window.syncFBTVisibility.__fbtWrapped = true;
    }

    function showErrorToast(msg) {
      window.cartToast(msg);
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest(SELECTOR);
      if (!btn) return;
      var isMain = btn.id === 'AddToCart';
      if (isMain && utmFlowOwnsButton()) return;

      e.stopImmediatePropagation();
      e.preventDefault();
      if (btn.classList.contains('is-adding') || btn.classList.contains('is-added')) return;

      var select = isMain ? document.getElementById('productSelect') : null;
      var variantId = parseInt(btn.dataset.variant || btn.dataset.variantId || (select && select.value), 10);
      if (!variantId) return; /* popup button before a variant is picked */

      var item = { id: variantId, quantity: 1 };
      if (isMain) {
        var qtyInput = document.getElementById('Quantity');
        if (qtyInput) item.quantity = parseInt(qtyInput.value, 10) || 1;
        var plan = document.querySelector('input[name="selling_plan"]:checked');
        if (plan && plan.value) item.selling_plan = parseInt(plan.value, 10);
      }

      var ctx = cardContext(btn);
      var priceText = optimisticPrice(variantId, item.selling_plan);

      var t0 = Date.now();
      /* Simpan MARKUP-nya, bukan sekadar teksnya. Tombol kartu varian v2 berisi
         beberapa elemen anak: <span class="v2-atc__label"> yang memberi gaya
         huruf besar, <s class="v2-atc__compare"> yang mencoret harga lama, dan
         <span data-v2-atc-price> yang jadi SASARAN syncAtc() ketika pembeli
         berpindah paket. Memulihkan lewat textContent meratakan semuanya jadi
         satu simpul teks — coretan dan huruf besar hilang, dan yang lebih parah
         harga di tombol berhenti mengikuti paket yang dipilih karena simpul
         sasarannya sudah tidak ada lagi.

         Disimpan ulang pada SETIAP penambahan, bukan sekali saja, supaya
         markup yang dipulihkan selalu mencerminkan paket yang sedang aktif. */
      btn._idleHTML = btn.innerHTML;
      if (!btn.dataset.idleLabel) btn.dataset.idleLabel = btn.textContent.trim();
      btn.classList.add('atc-btn', 'is-adding');
      btn.setAttribute('aria-busy', 'true');
      btn.textContent = L.adding;

      /* The popup hands off to the drawer */
      if (btn.id === 'popup-variants-button-bag') {
        var popup = document.getElementById('popup-variant');
        if (popup) popup.classList.remove('active');
        window.popupVariantActive = false;
      }

      /* Optimistic: drawer opens with the item already inside */
      var mini = document.querySelector('.mini-cart');
      if (mini) mini.classList.add('active');
      var itemsWrap = document.querySelector('#cart .cart-items');
      var optCard = null;
      var emptyState = itemsWrap && itemsWrap.querySelector('.cart-empty-state');
      if (itemsWrap) {
        if (emptyState) emptyState.style.display = 'none';
        optCard = buildOptimisticCard(ctx, priceText);
        itemsWrap.insertBefore(optCard, itemsWrap.firstChild);
      }
      /* FBT skeleton immediately — the section is never an empty hole */
      if (window.moveFBT) window.moveFBT();
      var fbtSec = document.querySelector('.fbt-section');
      if (fbtSec && !fbtSec.querySelector('.fbt-card[style*="flex"]')) {
        fbtSec.classList.add('fbt-loading');
        fbtSec.style.display = '';
      }
      /* Footer: swap the empty-cart CTA for a checkout-bar skeleton */
      var footerEl = document.querySelector('#cart .sub-total.cart-footer');
      if (footerEl && footerEl.querySelector('.cart-empty-shop-btn')) {
        footerEl.classList.add('opt-pending');
        var fskel = document.createElement('div');
        fskel.className = 'opt-footer-skelwrap';
        fskel.setAttribute('aria-hidden', 'true');
        fskel.innerHTML =
          '<div class="cart-footer-summary">'
          + '<div class="cart-footer-row visible"><span class="opt-shimmer fbt-skel-line" style="width:96px"></span><span class="opt-shimmer fbt-skel-line" style="width:74px"></span></div>'
          + '<div class="cart-footer-row visible"><span class="opt-shimmer fbt-skel-line" style="width:64px"></span><span class="opt-shimmer fbt-skel-line" style="width:42px"></span></div>'
          + '</div>'
          + '<div class="opt-skel-checkout"><span class="opt-shimmer opt-shimmer--light fbt-skel-line" style="width:172px;height:13px"></span></div>'
          + '<div class="opt-skel-secure"><span class="opt-shimmer fbt-skel-line" style="width:210px;height:10px"></span></div>';
        footerEl.appendChild(fskel);
      }

      function settle(stateClass, label, hold) {
        var wait = Math.max(0, MIN_STATE - (Date.now() - t0));
        setTimeout(function () {
          btn.classList.remove('is-adding');
          btn.removeAttribute('aria-busy');
          btn.classList.add(stateClass);
          btn.textContent = label;
          setTimeout(function () {
            btn.classList.remove(stateClass);
            /* innerHTML, bukan textContent — lihat catatan di titik penyimpanan. */
            if (btn._idleHTML != null) {
              btn.innerHTML = btn._idleHTML;
              /* Bila paket diganti selagi tombol sibuk, markup yang dipulihkan
                 membawa harga paket lama. Selaraskan lagi dari kartu aktif;
                 syncAtc() milik VariantsButtonV2 tidak diekspos global. */
              var act = document.querySelector('.v2-plan.active');
              if (act) {
                var cmp = act.getAttribute('data-v2-compare') || '';
                var prc = act.getAttribute('data-v2-price') || '';
                btn.querySelectorAll('[data-v2-atc-compare]').forEach(function (el) { el.textContent = cmp; });
                btn.querySelectorAll('[data-v2-atc-price]').forEach(function (el) { el.textContent = prc; });
              }
            } else if (btn.dataset.idleLabel) {
              btn.textContent = btn.dataset.idleLabel;
            }
          }, hold);
        }, wait);
      }

      window.cartMutSeq++;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [item] })
      })
        .then(function (r) {
          return r.json().then(function (j) {
            if (!r.ok) throw j;
            return j;
          });
        })
        .then(function () {
          var prefix = (typeof Shopify !== 'undefined' && Shopify.locale === 'id') ? '/id/' : '/';
          return Promise.all([
            fetch(prefix + 'cart?view=mini').then(function (r) { return r.text(); }),
            fetch('/cart.js').then(function (r) { return r.json(); })
          ]);
        })
        .then(function (results) {
          var doc = new DOMParser().parseFromString(results[0], 'text/html');
          var cart = results[1];
          /* One scoped crossfade: optimistic card -> real card, footer
             totals and FBT resolve together instead of popping. */
          smoothApply(function () {
            var cartEl = document.getElementById('cart');
            var newItems = doc.querySelector('.cart-items');
            var newFooter = doc.querySelector('.sub-total.cart-footer');
            var oldItems = cartEl && cartEl.querySelector('.cart-items');
            var oldFooter = cartEl && cartEl.querySelector('.sub-total.cart-footer');
            if (oldItems && newItems) {
              window.cartReconcileRows(oldItems, newItems);
              if (oldFooter && newFooter) {
                oldFooter.innerHTML = newFooter.innerHTML;
                if (window.initCartTrustSlider) window.initCartTrustSlider();
              }
            } else if (cartEl) {
              /* Container was never populated — full render like app.bundle */
              var content = doc.getElementById('mini-cart-content');
              if (content) {
                cartEl.innerHTML = content.innerHTML;
                if (window.initCartTrustSlider) window.initCartTrustSlider();
              }
            }
            if (window.moveFBT) window.moveFBT();
            if (window.refreshCartUI) window.refreshCartUI(cart);
            if (window.syncFBTVisibility) window.syncFBTVisibility(cart);
          });

          /* opt-pending cleanup (footer innerHTML was replaced; the class
             lives on the container and must be lifted here) */
          var f2 = document.querySelector('#cart .sub-total.cart-footer');
          if (f2) f2.classList.remove('opt-pending');

          if (cart.item_count > 0 && window.loadCompareAtPrices) window.loadCompareAtPrices();
          var indicator = document.getElementById('cart-indicator');
          if (indicator) indicator.classList.toggle('show', cart.item_count > 0);
          settle('is-added', L.added, 1400);
        })
        .catch(function (err) {
          /* Rollback the optimistic state, tell the user WHY it failed */
          if (optCard && optCard.parentNode) optCard.parentNode.removeChild(optCard);
          if (emptyState) emptyState.style.display = '';
          var secRb = document.querySelector('.fbt-section');
          if (secRb && secRb.classList.contains('fbt-loading')) {
            secRb.classList.remove('fbt-loading');
            if (!secRb.querySelector('.fbt-card[style*="flex"]')) secRb.style.display = 'none';
          }
          var fRb = document.querySelector('#cart .sub-total.cart-footer');
          if (fRb) {
            fRb.classList.remove('opt-pending');
            var skl = fRb.querySelector('.opt-footer-skelwrap');
            if (skl) skl.remove();
          }
          showErrorToast((err && err.description) || L.failed);
          settle('is-error', L.failed, 1600);
        });
    }, true); /* capture: runs before (and blocks) the app.bundle.js handler */

    /* ===== Drawer dialog behavior: Esc, focus-in/restore, tab loop ======= */
    var lastFocus = null;
    document.addEventListener('keydown', function (e) {
      var m = document.querySelector('.mini-cart.active');
      if (!m) return;
      if (e.key === 'Escape') {
        m.classList.remove('active');
        return;
      }
      if (e.key === 'Tab') {
        var w = m.querySelector('.mini-cart-wrapper');
        if (!w) return;
        var nodes = w.querySelectorAll('a[href], button, select, input, [tabindex]:not([tabindex="-1"])');
        var focusables = Array.prototype.filter.call(nodes, function (el) { return el.offsetParent !== null; });
        if (!focusables.length) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (document.activeElement === last || !w.contains(document.activeElement))) {
          e.preventDefault();
          first.focus();
        }
      }
    });
    var miniEl = document.querySelector('.mini-cart');
    if (miniEl) {
      new MutationObserver(function () {
        var active = miniEl.classList.contains('active');
        if (active && !miniEl.dataset.dialogFocused) {
          miniEl.dataset.dialogFocused = '1';
          lastFocus = document.activeElement;
          var target = miniEl.querySelector('#cart .close-button') || miniEl.querySelector('.mini-cart-wrapper');
          if (target) {
            target.setAttribute('tabindex', '-1');
            setTimeout(function () { target.focus({ preventScroll: true }); }, 80);
          }
        } else if (!active && miniEl.dataset.dialogFocused) {
          delete miniEl.dataset.dialogFocused;
          if (lastFocus && document.contains(lastFocus)) lastFocus.focus({ preventScroll: true });
          lastFocus = null;
        }
      }).observe(miniEl, { attributes: true, attributeFilter: ['class'] });
    }

    /* Fallback close for the server-rendered drawer (idempotent alongside
       whatever app.bundle binds after its own re-render). */
    document.addEventListener('click', function (e) {
      var mini = e.target.closest && e.target.closest('.mini-cart');
      if (!mini || !mini.classList.contains('active')) return;
      if (e.target.closest('.close-button') || e.target.classList.contains('overlay')) {
        mini.classList.remove('active');
      }
    });
  })();
</script>

<script>
  /* ===== Move FBT into cart form flow (insertBefore, NOT clone) ===== */
  /* Uses backup reference so FBT survives bundle re-renders of #cart. */
  /* No Swiper — FBT track uses native CSS scroll-snap.               */
  var _fbtRef = null;

  window.moveFBT = function() {
    var form = document.querySelector('#cart .min-cart-template .cart form');
    if (!form) return;

    /* Tujuannya blok bawah yang sudah dideklarasikan di CartDrawerContent.
       Fungsi ini tidak membentuk struktur, hanya memindahkan simpul FBT ke
       tempat yang memang disediakan untuknya. Bila wadah itu tidak ada —
       misalnya HTML lama yang masih tersaji dari cache — perilaku lama tetap
       berlaku: sisipkan langsung sebelum footer. */
    var dock = form.querySelector('.cart-bottom-dock');
    var induk = dock || form;

    var footer = induk.querySelector('.cart-footer');
    if (!footer) return;

    /* Already in place? Skip. */
    if (form.querySelector('.fbt-section')) return;

    /* Get from original position OR backup (after bundle re-render) */
    var fbt = document.querySelector('.mini-cart-wrapper > .fbt-section') || _fbtRef;
    if (!fbt) return;

    _fbtRef = fbt;
    induk.insertBefore(fbt, footer);
  };

  /* ===== Recalculate savings from DOM data attributes ===== */
  window.recalcSavings = function() {
    var cartEl = document.getElementById('cart');
    if (!cartEl) return;
    var sr = cartEl.querySelector('#cart-saving-row');
    var sa = cartEl.querySelector('#cart-saving-amount');
    if (!sr || !sa) return;
    var saved = 0;
    /* Hanya diskon PRODUK yang dihitung. Baris hadiah dikecualikan: nilai
       hadiah sudah dinyatakan lewat badge FREE di barisnya sendiri, dan
       menjumlahkannya di sini membuat angka hemat melompat melebihi selisih
       harga yang benar-benar dilihat pembeli di baris produk. */
    cartEl.querySelectorAll('.cart-item[data-compare-at]:not(.cart-item--gift)').forEach(function(el) {
      var cap = parseInt(el.getAttribute('data-compare-at') || '0', 10);
      var price = parseInt(el.getAttribute('data-price') || '0', 10);
      var qtyEl = el.querySelector('.qty-select');
      var qty = qtyEl ? parseInt(qtyEl.value, 10) : parseInt(el.getAttribute('data-qty') || '1', 10);
      if (cap > 0 && cap > price) saved += (cap - price) * qty;
    });
    sa.dataset.saving = saved;
    if (saved > 0) {
      sr.style.display = '';
      sr.classList.add('visible');
      sa.textContent = window.formatRp(saved / 100);
    } else {
      sr.classList.remove('visible');
    }
    window.updateCheckoutCompare();
  };

  /* ===== Isolate scroll containers — kini murni CSS, TANPA kunci JS ===== */
  /* Versi lama mengunci overflow lawan pada touchstart (fbt-track ⇄        */
  /* cart-items). Sejak dock pindah KE DALAM .cart-items (fix 18 Agu),      */
  /* touchstart di kartu FBT ikut membekukan scroller daftar di tengah      */
  /* gesture — iOS menghentikan gesture itu, dan bila touchend/touchcancel  */
  /* tidak sempat menyala (lazim saat native scroll mengambil alih), kunci  */
  /* `overflowY: hidden` TERTINGGAL PERMANEN: daftar macet sampai reload.   */
  /* Pemisahan sumbu sudah ditangani CSS .fbt-track (touch-action: pan-x    */
  /* pan-y + overscroll-behavior-x: contain) — axis-locking bawaan browser  */
  /* mengarahkan geseran mendatar ke track dan geseran tegak ke induknya.   */
  /* Fungsi dipertahankan sebagai no-op pembersih agar call site tetap      */
  /* valid dan sisa kunci dari sesi HTML lama ikut dilepas.                 */
  window.isolateScrollContainers = function() {
    var cartEl = document.getElementById('cart');
    if (!cartEl) return;
    var fbtTrack = cartEl.querySelector('.fbt-track');
    var cartItems = cartEl.querySelector('.cart-items');
    if (cartItems) cartItems.style.overflowY = '';
    if (fbtTrack) fbtTrack.style.overflowX = '';
  };

  /* ===== Cart Trust Badge Slider ===== */
  /* Scoped to [data-cart-trust-slider] — no conflict with product USP slider */
  window.initCartTrustSlider = function() {
    var container = document.querySelector('[data-cart-trust-slider]');
    if (!container) return;

    /* Prevent double-init on same DOM node */
    if (container._trustInit) return;

    var wrapper = container.querySelector('.cart-trust-wrapper');
    var slides = container.querySelectorAll('.cart-trust-slide');
    var dotsWrap = container.querySelector('.cart-trust-dots');

    if (!wrapper || slides.length < 2) {
      /* Single slide or none — hide dots, no slider needed */
      if (dotsWrap) dotsWrap.style.display = 'none';
      if (container) container.style.paddingBottom = '4px';
      return;
    }

    container._trustInit = true;

    var current = 0;
    var total = slides.length;
    var interval;

    /* Build dots */
    dotsWrap.innerHTML = '';
    for (var i = 0; i < total; i++) {
      var dot = document.createElement('button');
      dot.className = 'cart-trust-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Slide ' + (i + 1));
      (function(idx) {
        dot.addEventListener('click', function() {
          goTo(idx);
          reset();
        });
      })(i);
      dotsWrap.appendChild(dot);
    }

    function goTo(idx) {
      if (idx < 0) idx = total - 1;
      if (idx >= total) idx = 0;
      current = idx;
      wrapper.style.transform = 'translateX(-' + (current * 100) + '%)';
      var dots = dotsWrap.querySelectorAll('.cart-trust-dot');
      dots.forEach(function(d) { d.classList.remove('active'); });
      if (dots[current]) dots[current].classList.add('active');
    }

    function start() { stop(); interval = setInterval(function() { goTo(current + 1); }, 3000); }
    function stop() { if (interval) clearInterval(interval); }
    function reset() { stop(); start(); }

    /* Touch swipe */
    var sx = 0;
    wrapper.addEventListener('touchstart', function(e) { sx = e.changedTouches[0].screenX; stop(); }, { passive: true });
    wrapper.addEventListener('touchend', function(e) {
      var diff = e.changedTouches[0].screenX - sx;
      if (Math.abs(diff) > 40) { diff < 0 ? goTo(current + 1) : goTo(current - 1); }
      start();
    }, { passive: true });

    start();
  };
</script>

<script>
  /* ===== Cart voucher (discount code) ====================================
     Applies a code with POST /cart/update.js { discount: "CODE" }.

     Two behaviours of that endpoint drive the whole design and are verified
     against this store, not assumed:
       1. It ALWAYS answers 200 — an unusable code comes back as
          discount_codes: [{ code, applicable: false }], never as an HTTP error.
          So success is decided by reading `applicable`, not by r.ok.
       2. discount_codes[] carries no amount. The money value lives in
          cart_level_discount_applications, which nests the application under
          `.discount_application` in the Ajax JSON but NOT in Liquid — hence
          the shape-tolerant read below.

     All listeners are delegated off document because #cart gets its innerHTML
     replaced by app.bundle.js and by the drawer's own re-render paths. */
  (function () {
    var I18N = window.cartDecodeMap({
      invalid:   {{ 'cart.voucher.invalid' | t | json }},
      failed:    {{ 'cart.voucher.error_generic' | t | json }},
      empty:     {{ 'cart.voucher.empty' | t | json }},
      success:   {{ 'cart.voucher.success' | t | json }},
      expired:   {{ 'cart.voucher.no_longer_valid' | t | json }},
      atCheckout:{{ 'cart.voucher.applied_at_checkout' | t | json }},
      addMore:   {{ 'cart.voucher.add_more' | t | json }},
      remove:    {{ 'cart.voucher.remove' | t | json }},
      duplicate: {{ 'cart.voucher.duplicate' | t | json }},
      conflict:  {{ 'cart.voucher.conflict' | t | json }}
    });
    var MIN_BUSY = 350; /* same state-hold the ATC choreography uses */
    var lastApplied = [];

    function root() { return document.querySelector('#cart [data-cart-voucher]'); }
    function input() { var el = root(); return el && el.querySelector('[data-voucher-input]'); }

    function setState(el, state) {
      el.setAttribute('data-state', state);
      var trigger = el.querySelector('[data-voucher-open]');
      if (trigger) trigger.setAttribute('aria-expanded', state === 'open' ? 'true' : 'false');
    }

    function say(el, text, isError) {
      var m = el.querySelector('[data-voucher-msg]');
      if (!m) return;
      if (!text) {
        m.classList.remove('is-visible', 'is-error');
        m.textContent = '';
        return;
      }
      m.textContent = text;
      m.classList.toggle('is-error', !!isError);
      m.classList.add('is-visible');
    }

    function flashSummary() {
      var s = document.querySelector('#cart .cart-footer-summary');
      if (!s) return;
      s.classList.remove('cart-voucher-flash');
      void s.offsetWidth;
      s.classList.add('cart-voucher-flash');
      setTimeout(function () { s.classList.remove('cart-voucher-flash'); }, 950);
    }

    /* Reads every applicable code plus the money they account for. Tolerates
       both the Ajax shape ({ amount, discount_application }) and the flat
       Liquid shape so the same helper can serve either source. */
    function appliedFromCart(cart) {
      var codes = (cart && cart.discount_codes) || [];
      var applied = [];
      var rejected = [];
      for (var i = 0; i < codes.length; i++) {
        (codes[i].applicable ? applied : rejected).push(codes[i].code);
      }

      var amount = 0;
      var apps = (cart && cart.cart_level_discount_applications) || [];
      for (var j = 0; j < apps.length; j++) {
        var wrap = apps[j];
        var app = wrap.discount_application || wrap;
        if (app.type !== 'discount_code') continue;
        amount += wrap.amount != null ? wrap.amount : (app.total_allocated_amount || 0);
      }
      return { applied: applied, rejected: rejected, amount: amount };
    }

    function sameSet(a, b) {
      if (a.length !== b.length) return false;
      var x = a.slice().sort().join('|').toUpperCase();
      var y = b.slice().sort().join('|').toUpperCase();
      return x === y;
    }

    function chipHtml(code) {
      var safe = String(code).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
      return '<span class="cart-voucher-chip" data-voucher-chip="' + safe + '">'
        + '<svg width="11" height="9" viewBox="0 0 14 11" fill="none" aria-hidden="true">'
        + '<path d="M1 5.5 5 9.5 13 1.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
        + '<span class="cart-voucher-code">' + safe + '</span>'
        + '<button type="button" class="cart-voucher-remove" data-voucher-remove="' + safe + '"'
        + ' aria-label="' + I18N.remove + ' ' + safe + '">'
        + '<svg width="9" height="9" viewBox="0 0 12 12" fill="none" aria-hidden="true">'
        + '<path d="M1 1 11 11M11 1 1 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
        + '</button></span>';
    }

    /* Single source of truth for the row — called after every cart mutation
       (qty change, remove, FBT add) via refreshCartUI, not just after apply.
       A code can silently stop qualifying when the cart shrinks below its
       minimum, and the customer must be told rather than quietly overcharged. */
    window.syncVoucherUI = function (cart) {
      var el = root();
      if (!el) return;
      /* Without this an error payload reads as "no applicable codes" and the
         row wrongly announces that a perfectly good voucher expired. */
      if (!window.isCartPayload(cart)) return;

      var state = appliedFromCart(cart);
      if (state.applied.length) {
        var chips = el.querySelector('[data-voucher-chips]');
        if (chips) {
          var addMore = '<button type="button" class="cart-voucher-addmore" data-voucher-open>+ '
            + I18N.addMore + '</button>';
          chips.innerHTML = state.applied.map(chipHtml).join('') + addMore;
        }
        var amtEl = el.querySelector('[data-voucher-amount]');
        if (amtEl) {
          amtEl.textContent = state.amount > 0
            ? '−' + window.formatRp(state.amount / 100)
            : I18N.atCheckout;
        }
        setState(el, 'applied');
        lastApplied = state.applied.slice();
        return;
      }

      var wasApplied = lastApplied.length || el.getAttribute('data-state') === 'applied';
      lastApplied = [];
      if (!wasApplied) {
        if (el.getAttribute('data-state') === 'applied') setState(el, 'idle');
        return;
      }

      /* Had codes, none qualify now — reopen with the first one prefilled */
      setState(el, 'open');
      var inp = el.querySelector('[data-voucher-input]');
      if (inp && state.rejected.length) inp.value = state.rejected[0];
      say(el, I18N.expired, true);
    };

    function hold(t0) {
      return new Promise(function (res) {
        setTimeout(res, Math.max(0, MIN_BUSY - (Date.now() - t0)));
      });
    }

    function post(code) {
      window.cartMutSeq++;
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ discount: code })
      }).then(function (r) { return r.json(); });
    }

    /* Shared by the cancel button and Escape so the two can't drift apart. */
    function closePanel(el, refocusTrigger) {
      if (!el) return;
      var inp = el.querySelector('[data-voucher-input]');
      if (inp) inp.value = '';
      el.classList.remove('is-invalid');
      say(el, '');
      setState(el, lastApplied.length ? 'applied' : 'idle');
      if (refocusTrigger) {
        var trigger = el.querySelector('[data-voucher-open]');
        if (trigger) trigger.focus();
      }
    }

    function reject(el, message) {
      el.classList.add('is-invalid');
      say(el, message, true);
      var inp = el.querySelector('[data-voucher-input]');
      if (inp) { inp.focus(); inp.select(); }
      setTimeout(function () { el.classList.remove('is-invalid'); }, 520);
    }

    function apply(code) {
      var el = root();
      if (!el || el.hasAttribute('data-busy')) return;
      if (!code) { reject(el, I18N.empty); return; }

      /* Posting `discount` REPLACES the whole set, so the existing codes have
         to be resent alongside the new one or they are dropped. */
      var prev = lastApplied.slice();
      var already = prev.some(function (c) {
        return c.toUpperCase() === code.toUpperCase();
      });
      if (already) { reject(el, I18N.duplicate); return; }
      var next = prev.concat([code]);

      var t0 = Date.now();
      el.setAttribute('data-busy', '');
      el.classList.remove('is-invalid');
      say(el, '');

      post(next.join(','))
        .then(function (cart) { return hold(t0).then(function () { return cart; }); })
        .then(function (cart) {
          el.removeAttribute('data-busy');
          var state = appliedFromCart(cart);
          var accepted = state.applied.some(function (c) {
            return c.toUpperCase() === code.toUpperCase();
          });

          /* Verified on this store: sending MOR10,HABIT10 returns MOR10 with
             applicable:false — a non-combinable code silently evicts the one
             already on the cart. Detect that by comparing sets, and say which
             pairing failed instead of letting a discount vanish. */
          var evicted = prev.filter(function (c) {
            return !state.applied.some(function (a) {
              return a.toUpperCase() === c.toUpperCase();
            });
          });

          if (accepted && !evicted.length) {
            window.refreshCartUI(cart);
            flashSummary();
            say(el, I18N.success, false);
            setTimeout(function () {
              var later = root();
              if (later && later.getAttribute('data-state') === 'applied') say(later, '');
            }, 2800);
            return;
          }

          reject(el, evicted.length ? I18N.conflict.replace('__CODE__', evicted.join(', ')) : I18N.invalid);
          /* Undo the attempt: the failed code is still on the cart and would
             otherwise resurface as a phantom on the next quantity change. */
          lastApplied = [];
          post(prev.join(','))
            .then(function (restored) { window.refreshCartUI(restored); })
            .catch(function () {});
        })
        .catch(function () {
          el.removeAttribute('data-busy');
          reject(el, I18N.failed);
        });
    }

    function remove(code) {
      var el = root();
      if (!el || el.hasAttribute('data-busy')) return;
      el.setAttribute('data-busy', '');

      /* Drop just this one and resend the rest — `discount` replaces the whole
         set, so an empty string here would clear every code the cart holds. */
      var keep = lastApplied.filter(function (c) {
        return c.toUpperCase() !== String(code).toUpperCase();
      });
      lastApplied = [];

      post(keep.join(','))
        .then(function (cart) {
          el.removeAttribute('data-busy');
          var inp = el.querySelector('[data-voucher-input]');
          if (inp) inp.value = '';
          say(el, '');
          setState(el, 'idle');
          window.refreshCartUI(cart);
          flashSummary();
        })
        .catch(function () {
          el.removeAttribute('data-busy');
        });
    }

    /* The drawer footer is pinned to the bottom of a fixed-height panel, so an
       on-screen keyboard covers it outright — scrollIntoView cannot help. Match
       the wrapper to the visual viewport instead; the flex layout compresses
       .cart-items and the field stays above the keyboard. Height (not
       transform) because the wrapper's transform drives the slide-in. */
    function bindKeyboardFit() {
      var vv = window.visualViewport;
      if (!vv) return;
      function fit() {
        var wrap = document.querySelector('.mini-cart-wrapper');
        var el = root();
        if (!wrap) return;
        var inp = el && el.querySelector('[data-voucher-input]');
        var focused = inp && document.activeElement === inp;
        var overlap = window.innerHeight - vv.height;
        if (focused && overlap > 80) wrap.style.height = vv.height + 'px';
        else wrap.style.height = '';
      }
      vv.addEventListener('resize', fit);
      document.addEventListener('focusin', function () { setTimeout(fit, 120); });
      document.addEventListener('focusout', function () { setTimeout(fit, 120); });
    }
    bindKeyboardFit();

    document.addEventListener('click', function (e) {
      var t = e.target;
      if (!t || !t.closest) return;

      if (t.closest('[data-voucher-open]')) {
        e.preventDefault();
        var el = root();
        if (!el) return;
        setState(el, 'open');
        var trigger = el.querySelector('[data-voucher-open]');
        if (trigger) trigger.setAttribute('aria-expanded', 'true');
        var inp = el.querySelector('[data-voucher-input]');
        if (inp) setTimeout(function () { inp.focus(); }, 220);
        return;
      }

      if (t.closest('[data-voucher-submit]')) {
        e.preventDefault();
        var i = input();
        apply(i ? i.value.trim() : '');
        return;
      }

      if (t.closest('[data-voucher-cancel]')) {
        e.preventDefault();
        closePanel(root(), false);
        return;
      }

      var rm = t.closest('[data-voucher-remove]');
      if (rm) {
        e.preventDefault();
        remove(rm.getAttribute('data-voucher-remove'));
      }
    });

    /* ===== Hand the voucher over to checkout ===============================
       A code applied with /cart/update.js sits on the cart object and shows a
       discounted total in the drawer, but it does NOT survive into checkout —
       verified by reading the checkout document for a cart carrying MOR10:

         "merchandiseDiscount":{"__typename":"FilledDiscountTerms","lines":[]}
         "deliveryDiscount":  {"__typename":"FilledDiscountTerms","lines":[]}

       Empty. Without this handoff the customer sees Rp 621.000 on the button
       and Rp 690.000 on the next screen, and has to retype the code.

       /discount/CODE?redirect=... is Shopify's own mechanism for exactly this
       and is already the path the UTM flow uses in layout/theme.liquid.

       Deliberately bound in the BUBBLE phase with no stopImmediatePropagation:
       anything else listening on this button still runs first. begin_checkout
       is emitted by the Shopify custom pixel inside checkout, not from here,
       so the redirect leaves analytics untouched. */
    function appliedVoucherCode() {
      var els = document.querySelectorAll(
        '#cart [data-cart-voucher][data-state="applied"] [data-voucher-chip]'
      );
      var codes = [];
      for (var i = 0; i < els.length; i++) {
        var c = (els[i].getAttribute('data-voucher-chip') || '').trim();
        if (c) codes.push(c);
      }
      /* Shopify's discount URL takes a comma-separated list, the same shape
         /cart/update.js accepts. */
      return codes.join(',');
    }

    /* Satu serah-terima pada satu waktu. Statusnya hidup di closure, BUKAN di
       `btn.dataset`: render ulang drawer mengganti simpul tombolnya, dan
       penanda yang ikut lenyap bersamanya membuat penjaga ini bocor tanpa
       suara. Penjaga dilepas ketika overlay menyerah (cart:loading-timeout)
       atau ketika pembeli kembali dari checkout lewat bfcache — dua-duanya
       berarti navigasinya tidak jadi, jadi percobaan berikutnya harus boleh
       berangkat lagi. */
    var handoffInFlight = false;
    var HANDOFF_WATCHDOG_MS = 8000;

    function releaseHandoff() { handoffInFlight = false; }
    document.addEventListener('cart:loading-timeout', releaseHandoff);
    window.addEventListener('pageshow', function (e) {
      if (e.persisted) releaseHandoff();
    });

    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('#cart-checkout-btn');
      if (!btn) return;

      var code = appliedVoucherCode();
      if (!code) return; /* no voucher — leave the native submit alone */

      /* Sejak titik ini submit natif TIDAK BOLEH lolos. Dulu ketukan kedua —
         yang pasti terjadi, karena redirect terasa lama — jatuh ke `return`
         tanpa preventDefault: form ikut submit ke /cart dan pembeli mendarat
         di checkout TANPA kodenya. Diskonnya hilang diam-diam, dan tidak ada
         yang tahu. */
      e.preventDefault();
      if (handoffInFlight) return;
      handoffInFlight = true;

      if (window.cartShowLoading) window.cartShowLoading(HANDOFF_WATCHDOG_MS);

      /* Satu lompatan, bukan dua. `/discount/CODE?redirect=/checkout` harus
         singgah dulu di /discount (terukur 1,0–4,2 dtk, sangat bervariasi)
         sebelum melanjut ke /checkout; `/checkout?discount=CODE` mendarat
         langsung di /checkouts/cn/... (terukur 0,8–1,0 dtk) dengan kodenya
         tetap terbawa — daftar berkoma sekalipun, ter-encode maupun tidak,
         dan tetap benar di bawah awalan market `/id/`. Makin sedikit lompatan,
         makin kecil peluang WebView in-app tersendat di tengah rantai. */
      var shopRoot = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      window.location.href = shopRoot + 'checkout?discount=' + encodeURIComponent(code);
    });

    /* The field lives inside <form action="/cart" method="post">, so a bare
       Enter would submit the cart form and navigate away from the drawer. */
    document.addEventListener('keydown', function (e) {
      var t = e.target;
      if (!t || !t.matches || !t.matches('[data-voucher-input]')) return;
      if (e.key === 'Enter') {
        e.preventDefault();
        e.stopPropagation();
        apply(t.value.trim());
      } else if (e.key === 'Escape') {
        e.preventDefault();
        e.stopPropagation();
        closePanel(root(), true);
      }
    });
  })();
</script>

<script>
  /* ===== After bundle renders: move FBT, sync UI, load prices ===== */
  (function() {
    function onCartRender() {
      var c = document.getElementById('cart');
      if (!c) return;

      /* 1. Always show progress bar (even when cart is empty) */
      var pw = c.querySelector('.free-shipping-progress');
      if (pw) pw.classList.add('active');
      var ch = c.querySelector('.min-cart-template .cart-header');
      if (ch) ch.classList.add('with-progress');

      /* 2. Move FBT into form flow (between cart-items and footer) */
      window.moveFBT();

      /* 3. Isolate scroll containers to prevent scroll-chaining conflicts */
      window.isolateScrollContainers();

      /* 4. Fetch cart data and update UI */
      fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
        window.refreshCartUI(cart);
        window.syncFBTVisibility(cart);

        /* 5. Fetch original_price from product pages, then recalc savings */
        if (cart.item_count > 0) {
          window.loadCompareAtPrices();
        }
      });

      /* 6. Fetch Judge.me ratings for FBT products */
      window.loadFBTRatings();

      /* 7. Init cart trust badge slider */
      window.initCartTrustSlider();
    }

    var cartContainer = document.getElementById('cart');
    if (!cartContainer) return;

    var observer = new MutationObserver(function(mutations) {
      var dominated = mutations.some(function(m) {
        return m.type === 'childList' && m.target === cartContainer;
      });
      if (!dominated) return;
      setTimeout(onCartRender, 500);
      setTimeout(onCartRender, 1200);
    });
    observer.observe(cartContainer, { childList: true });
  })();
</script>

<script>
  /* ===== UTM free shipping override ===== */
  (function() {
    if (typeof window.isUtmFreeShipping !== 'function' || !window.isUtmFreeShipping()) return;

    function forceAllSet() {
      if (!window.isUtmFreeShipping()) return;
      var c = document.getElementById('cart');
      if (!c) return;

      var pw = c.querySelector('.free-shipping-progress');
      var sv = c.querySelector('#cart-shipping-value');
      var ch = c.querySelector('.min-cart-template .cart-header');

      var i18n = window._cartI18n || {};
      if (pw) pw.classList.add('active');
      if (sv) sv.textContent = i18n.shippingFree || 'FREE';
      if (ch) ch.classList.add('with-progress');

      /* Same writer as refreshCartUI — this used to keep its own copy of the
         fill/label/badge logic and pinned the marker to a hardcoded 88%. */
      window.setShippingProgress(100, 0, true);
    }

    var cartContainer = document.getElementById('cart');
    if (!cartContainer) return;

    var observer = new MutationObserver(function(mutations) {
      var dominated = mutations.some(function(m) {
        return m.type === 'childList' && m.target === cartContainer;
      });
      if (!dominated) return;
      setTimeout(forceAllSet, 500);
      setTimeout(forceAllSet, 1000);
    });
    observer.observe(cartContainer, { childList: true });
  })();
</script>

<script>
  // This automatically locks the background scroll when the cart opens
  document.addEventListener('DOMContentLoaded', () => {
    const miniCart = document.querySelector('.mini-cart');
    if (miniCart) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.attributeName === 'class') {
            if (miniCart.classList.contains('active')) {
              // Lock the body
              document.body.style.position = 'fixed';
              document.body.style.top = `-${window.scrollY}px`;
              document.body.style.width = '100%';
            } else {
              // Unlock the body and restore scroll position
              const scrollY = document.body.style.top;
              document.body.style.position = '';
              document.body.style.top = '';
              document.body.style.width = '';
              window.scrollTo(0, parseInt(scrollY || '0') * -1);
            }
          }
        });
      });
      observer.observe(miniCart, { attributes: true });
    }
  });
</script>


<style>
  /* ===== Roll harga — micro-motion ala HyperFrames =====
     Angka lama terbang naik (percepat-keluar) sementara angka baru mendarat
     dari bawah (perlambat + overshoot kecil) — pasangan ease cermin, murni
     transform+opacity, tanpa menggeser layout. tabular-nums menjaga digit
     tidak bergetar lebarnya saat berganti. */
  #sub-total-mini,
  #cart-saving-amount {
    display: inline-block;
    position: relative;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Tombol checkout mengikuti tombol Add to Cart di halaman produk: satu baris
     mendatar berisi label, pemisah, harga coret, harga bayar. Ukuran dan bobot
     hurufnya sengaja disamakan dengan .v2-atc__* supaya kedua tombol terbaca
     sebagai satu bahasa, bukan dua komponen berbeda yang kebetulan mirip. */
  /* ---- Baris kepercayaan di atas tombol checkout ---- */
  .cart-assure {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 14px;
    margin: 0 0 10px;
    padding: 10px 4px 0;
    border-top: 1px solid rgba(43, 60, 53, 0.1);
  }

  .cart-assure__item {
