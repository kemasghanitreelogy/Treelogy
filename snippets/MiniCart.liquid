<div class="mini-cart">
  <div class="overlay"></div>

  <!-- Remove item confirmation modal -->
  <div class="cart-remove-modal" id="cart-remove-modal">
    <div class="cart-remove-backdrop"></div>
    <div class="cart-remove-dialog">
      <div class="cart-remove-title">{{ 'cart.remove_title' | t }}</div>
      <div class="cart-remove-msg">{{ 'cart.remove_prefix' | t }} <span class="cart-remove-name" id="cart-remove-name"></span> {{ 'cart.remove_suffix' | t }}</div>
      <div class="cart-remove-actions">
        <button type="button" class="cart-remove-btn cart-remove-cancel" id="cart-remove-cancel">{{ 'cart.remove_cancel' | t }}</button>
        <button type="button" class="cart-remove-btn cart-remove-confirm" id="cart-remove-confirm">{{ 'cart.remove_confirm' | t }}</button>
      </div>
    </div>
  </div>

  <div class="mini-cart-wrapper" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="up-selling fbt-section">
      <div class="fbt-header">
        {{ 'cart.fbt_title' | t }} <strong>{{ 'cart.fbt_title_bold' | t }}</strong>
      </div>
      {% if up_selling != null %}
        <div class="fbt-track">
          {% for i in (1..2) %}
            <div class="fbt-card fbt-card--skel" aria-hidden="true">
              <div class="fbt-card-image"><span class="opt-shimmer opt-shimmer--light fbt-skel-imgfill"></span></div>
              <div class="fbt-card-info">
                <div class="fbt-card-title">
                  <span class="opt-shimmer opt-shimmer--light fbt-skel-line" style="width: 82%"></span>
                  <span class="opt-shimmer opt-shimmer--light fbt-skel-line" style="width: 48%; margin-top: 7px"></span>
                </div>
                <div class="fbt-card-bottom">
                  <span class="opt-shimmer opt-shimmer--light fbt-skel-line" style="width: 74px; height: 13px"></span>
                  <span class="opt-shimmer opt-shimmer--light fbt-skel-action"></span>
                </div>
              </div>
            </div>
          {% endfor %}
          {% for product in up_selling %}
            {%- comment -%}
              Produk hadiah (harga 0, dibagikan otomatis oleh gift-auto-add)
              tidak boleh ditawarkan di FBT: ia tidak bisa dibeli terpisah dan
              tampil sebagai "Rp 0" yang membingungkan. Disaring di kode, bukan
              di setting, supaya tidak bergantung pada isi "Up Selling
              Products" di Header.
            {%- endcomment -%}
            {%- if product.price == 0 -%}
              {%- continue -%}
            {%- endif -%}
            <div
              class="fbt-card upsel-product-cart"
              id="upsel-product-{{ product.id }}"
              data-product="{{ product.id }}"
              data-handle="{{ product.handle }}"
              style="display: none;"
            >
              <div class="fbt-card-image">
                <img
                  src="{{ product.media.first | img_url: '160x' }}"
                  alt="{{ product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </div>
              <div class="fbt-card-info">
                <div class="fbt-rating" style="display:none;">
                  <span class="fbt-star"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 0C5.80302 0 5.63472 0.0961647 5.5078 0.213572C5.38088 0.33098 5.27903 0.47454 5.18487 0.635508C4.99654 0.957443 4.83682 1.3563 4.68095 1.76327C4.52508 2.17024 4.37566 2.58362 4.23302 2.91318C4.09037 3.24274 3.92546 3.48566 3.88535 3.51613C3.84523 3.54659 3.57302 3.63634 3.22908 3.67631C2.88513 3.71627 2.4613 3.73567 2.04284 3.76486C1.62438 3.79405 1.21293 3.8321 0.861812 3.91983C0.686252 3.9637 0.523469 4.01877 0.377421 4.10866C0.231373 4.19855 0.091925 4.33478 0.0310553 4.5306C-0.0298147 4.72641 0.00641869 4.92552 0.0740254 5.08797C0.141632 5.25042 0.241827 5.3939 0.359191 5.53725C0.593919 5.82395 0.905579 6.10823 1.22771 6.38893C1.54984 6.66964 1.88211 6.94619 2.1379 7.18983C2.39368 7.43347 2.56269 7.67186 2.57801 7.72116C2.59334 7.77045 2.59064 8.06882 2.52072 8.42308C2.4508 8.77734 2.33831 9.20397 2.23555 9.62898C2.1328 10.054 2.03896 10.4744 2.01029 10.8505C1.99595 11.0386 1.99576 11.2167 2.03242 11.3897C2.06908 11.5626 2.15172 11.7453 2.31108 11.8663C2.47044 11.9873 2.66192 12.0122 2.83063 11.9952C2.99933 11.9782 3.16004 11.9243 3.32674 11.852C3.66013 11.7072 4.01478 11.4825 4.36974 11.249C4.7247 11.0155 5.07816 10.7729 5.37889 10.594C5.67962 10.415 5.95042 10.3205 6 10.3205C6.04958 10.3205 6.32039 10.415 6.62112 10.594C6.92184 10.7729 7.27531 11.0155 7.63026 11.249C7.98522 11.4825 8.33987 11.7072 8.67327 11.852C8.83997 11.9243 9.00067 11.9782 9.16938 11.9952C9.33808 12.0122 9.52957 11.9873 9.68892 11.8663C9.84828 11.7453 9.93092 11.5626 9.96758 11.3897C10.0042 11.2167 10.0041 11.0386 9.98971 10.8505C9.96103 10.4744 9.8672 10.054 9.76445 9.62898C9.66169 9.20397 9.5492 8.77734 9.47928 8.42308C9.40936 8.06882 9.40666 7.77045 9.42199 7.72116C9.43731 7.67186 9.60632 7.43347 9.86211 7.18983C10.1179 6.94619 10.4502 6.66964 10.7723 6.38893C11.0944 6.10823 11.4061 5.82395 11.6408 5.53725C11.7582 5.3939 11.8584 5.25042 11.926 5.08797C11.9936 4.92552 12.0298 4.72641 11.9689 4.5306C11.9081 4.33478 11.7686 4.19855 11.6226 4.10866C11.4765 4.01877 11.3138 3.9637 11.1382 3.91983C10.7871 3.8321 10.3756 3.79405 9.95716 3.76486C9.5387 3.73567 9.11487 3.71627 8.77093 3.67631C8.42698 3.63634 8.15477 3.54659 8.11465 3.51613C8.07454 3.48566 7.90963 3.24274 7.76699 2.91318C7.62434 2.58362 7.47492 2.17024 7.31906 1.76327C7.16319 1.3563 7.00346 0.957443 6.81513 0.635508C6.72097 0.47454 6.61913 0.33098 6.4922 0.213572C6.36528 0.0961647 6.19698 0 6 0Z" fill="#F8F8F2"/></svg></span>
                  <span class="fbt-rating-text"></span>
                </div>
                <div class="fbt-card-title">{{ product.title }}</div>
                {%- comment -%}
                  Rendered only when there is one. An empty div still adds a
                  gap, which is part of why a title-and-price-only product
                  looked stretched next to a fully-populated card.
                {%- endcomment -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="fbt-card-variant">{{ product.variants.first.title }}</div>
                {%- endunless -%}
                <div class="fbt-card-bottom">
                  <div class="fbt-card-price">{{ product.price | money }}</div>
                  <div
                    class="fbt-card-action button-quick-add-cart button-cart-icon"
                    data-variant="{{ product.variants.first.id }}"
                  >
                <span class="fbt-btn-state fbt-btn-idle">{{ 'cart.fbt_add' | t }}</span>
                <span class="fbt-btn-state fbt-btn-loading">
                  <svg class="fbt-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity=".25"/>
                    <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
                </span>
                    <span class="fbt-btn-state fbt-btn-success">
                      <svg width="14" height="11" viewBox="0 0 14 11" fill="none">
                        <path d="M1 5.5L5 9.5L13 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div id="cart">{% render 'CartDrawerContent' %}</div>
  </div>
</div>


<style>
  /* ===== Penjaga zoom mobile =====
     Zoom halaman yang "kadang muncul saat remove" punya dua mekanisme:

     1) Double-tap zoom — dua ketukan cepat berdekatan (ikon sampah lalu
        tombol Remove di modal, atau ketukan ganda karena tak sabar) sesekali
        ditafsirkan browser sebagai double tap dan men-zoom seluruh halaman.
        touch-action: manipulation mematikannya di area drawer dan modal;
        pan dan pinch zoom tetap hidup untuk aksesibilitas.

     2) Zoom fokus iOS — WebKit men-zoom viewport saat kontrol form ber-font
        di bawah 16px menerima fokus. Satu-satunya yang tersisa di drawer
        adalah .qty-select (13px); di layar sentuh dinaikkan ke 16px dengan
        padding vertikal dirapatkan supaya tinggi kontrolnya tidak berubah. */
  .mini-cart,
  .mini-cart *,
  .cart-remove-modal,
  .cart-remove-modal * {
    touch-action: manipulation;
  }

  @media (hover: none) and (pointer: coarse) {
    .cart-item .qty-select {
      font-size: 16px;
      padding-top: 2px;
      padding-bottom: 2px;
    }
  }
</style>

<script>
  /* Shopify's `t` filter HTML-escapes its output, so a translation containing
     an apostrophe reaches JS as the literal characters "Couldn&#39;t" and
     renders exactly that way through textContent. Decode once, at the boundary
     where Liquid strings become JS strings. */
  window.cartDecode = function (s) {
    if (typeof s !== 'string' || s.indexOf('&') === -1) return s;
    var el = document.createElement('textarea');
    el.innerHTML = s;
    return el.value;
  };
  window.cartDecodeMap = function (o) {
    for (var k in o) {
      if (typeof o[k] === 'string') o[k] = window.cartDecode(o[k]);
    }
    return o;
  };

  /* ===== Cart i18n strings (Liquid → JS) ===== */
  window._cartI18n = window.cartDecodeMap({
    allSet:            {{ 'cart.progress.all_set' | t | json }},
    unlocked:          {{ 'cart.progress.unlocked' | t | json }},
    progressAdd:       {{ 'cart.progress_add' | t | json }},
    progressMore:      {{ 'cart.progress_more' | t | json }},
    freeShippingBadge: {{ 'cart.free_shipping_badge' | t | json }},
    progressAway:      {{ 'cart.progress_away' | t | json }},
    shippingFree:      {{ 'cart.shipping_free' | t | json }},
    shippingCalc:      {{ 'cart.shipping_calculated' | t | json }}
  });

  const minShipping = {{ settings.min_shipping | default: 1000000 }};

  /* ===== Rp formatter (dots, no decimals) ===== */
  window.formatRp = function(amount) {
    var n = Math.round(Math.abs(Number(amount)));
    /* Last line of defence: a customer must never be shown "Rp NaN". Callers
       are guarded too, but this is the single place every price passes through. */
    if (!isFinite(n)) return '';
    return 'Rp ' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  };

  /* ===== Harga coret di tombol checkout =====
     Nilainya = total + hemat, dua angka yang SUDAH ada di DOM sebagai sen
     mentah (#sub-total-mini[data-total] dan #cart-saving-amount[data-saving]).
     Menghitung ulang dari sini, bukan menitipkan angka ke tiap pemanggil,
     membuat fungsi ini benar dipanggil dari jalur mana pun — dan jalur yang
     lupa memanggilnya hanya menghasilkan angka basi, bukan angka salah.
     Hemat nol berarti tidak ada yang dicoret: menampilkan coretan yang sama
     dengan harga bayar terbaca seperti bug. */
  window.updateCheckoutCompare = function () {
    var cartEl = document.getElementById('cart');
    if (!cartEl) return;
    var cmp = cartEl.querySelector('#cart-checkout-compare');
    var te = cartEl.querySelector('#sub-total-mini');
    if (!cmp || !te) return;

    var totalCents = parseInt(te.dataset.total || '0', 10);
    var sa = cartEl.querySelector('#cart-saving-amount');
    var savingCents = sa ? parseInt(sa.dataset.saving || '0', 10) : 0;

    if (!isFinite(totalCents) || !isFinite(savingCents) || savingCents <= 0) {
      cmp.hidden = true;
      return;
    }
    var compareCents = totalCents + savingCents;
    cmp.dataset.compare = compareCents;
    cmp.textContent = window.formatRp(compareCents / 100);
    cmp.hidden = false;
  };

  /* ===== Is this actually a cart? =====
     The Ajax cart endpoints answer 200 with a cart on success but return
     { status, message, description } on failure — no total_price, no items.
     Verified live: POST /cart/change.js with a line key that no longer exists
     (item removed in another tab, cart expired) answers exactly that shape.
     Feeding it to refreshCartUI printed "Rp NaN" on the checkout button and the
     progress line, and because item_count was undefined the
     `if (cart.item_count === 0) reload()` safety never fired either. */
  window.isCartPayload = function (c) {
    return !!c && typeof c.total_price === 'number' && Array.isArray(c.items);
  };

  /* ===== Telemetri keranjang =====
     Bentuknya sama dengan giftTrack di gift-auto-add.js: dorong event, lalu
     dorong reset null supaya parameter ephemeral tidak bocor ke event
     berikutnya. Telemetri tidak boleh pernah mengganggu keranjang. */
  window.cartTrack = function (name, data) {
    try {
      if (document.prerendering) return;
      window.dataLayer = window.dataLayer || [];
      var payload = { event: name };
      var reset = {};
      Object.keys(data || {}).forEach(function (k) {
        payload[k] = data[k];
        reset[k] = null;
      });
      window.dataLayer.push(payload);
      window.dataLayer.push(reset);
    } catch (e) { /* diam */ }
  };

  /* ===== Loading overlay for cart =====
     Overlay ini `position:absolute` menutup seluruh #cart dengan `z-index:100`
     dan TANPA `pointer-events:none` — selama ia tampil, SETIAP sentuhan di
     dalam drawer ditelan: tombol checkout, tombol tutup, ubah jumlah, hapus
     baris. Itu benar untuk permintaan yang kita tunggu lalu tutup sendiri.
     Tapi pemanggil yang menyalakannya lalu pergi — navigasi yang tak pernah
     mendarat, promise yang tak pernah selesai — meninggalkan pembeli menatap
     keranjang pudar berspinner tanpa satu pun jalan keluar. Laporan "checkout
     freeze" dari in-app browser Instagram berpangkal persis di sini.

     Karena itu masa hidup overlay dijamin di PRIMITIF, bukan dititipkan ke
     setiap pemanggil: tiap `show` memasang penjaga yang menutupnya kembali,
     dan `hide` melucuti penjaga itu — sehingga pasangan show/hide yang normal
     tidak pernah memicunya. Satu perbaikan di sini menutup semua jalur yang
     ada sekarang maupun yang ditambahkan nanti.

     Bawaan 12 detik dipilih DI ATAS anggaran ~10 detik `cartChangeWithRetry`,
     supaya penjaga tidak pernah memotong percobaan ulang yang masih sah.
     Pemanggil dengan anggaran lebih pendek mengirim batasnya sendiri. */
  var loadingWatchdog = null;
  var LOADING_WATCHDOG_MS = 12000;

  window.cartShowLoading = function (maxMs) {
    var c = document.getElementById('cart');
    if (!c) return;
    var ov = c.querySelector('.cart-loading-overlay');
    if (ov) {
      ov.style.display = 'flex';
    } else {
      ov = document.createElement('div');
      ov.className = 'cart-loading-overlay';
      ov.innerHTML = '<div class="cart-loading-spinner"></div>';
      c.appendChild(ov);
    }
    if (loadingWatchdog) clearTimeout(loadingWatchdog);
    loadingWatchdog = setTimeout(function () {
      loadingWatchdog = null;
      window.cartHideLoading();
      /* Pemulihan yang tak terlihat sama saja dengan bug yang tak terhitung.
         Penjaga yang menyala SELALU berarti ada yang gagal, jadi beri tahu
         siapa pun yang sedang menunggu (mis. serah-terima voucher) lalu
         catat kejadiannya. */
      try {
        document.dispatchEvent(new CustomEvent('cart:loading-timeout'));
      } catch (err) { /* diam */ }
      window.cartTrack('cart_loading_timeout');
    }, typeof maxMs === 'number' && maxMs > 0 ? maxMs : LOADING_WATCHDOG_MS);
  };

  window.cartHideLoading = function () {
    if (loadingWatchdog) { clearTimeout(loadingWatchdog); loadingWatchdog = null; }
    var ov = document.querySelector('#cart .cart-loading-overlay');
    if (ov) ov.style.display = 'none';
  };

  /* ===== Shared error toast =====
     One implementation for every cart surface. The premium-ATC block used to
     carry its own private copy, which is how two toasts with different
     lifetimes end up on the same page. */
  window.cartToast = function(msg) {
    if (!msg) return;
    var t = document.getElementById('atc-error-toast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'atc-error-toast';
      t.setAttribute('role', 'alert');
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._hideTimer);
    t._hideTimer = setTimeout(function() { t.classList.remove('show'); }, 4200);
  };

  /* ===== Sync FBT card visibility with current cart =======================
     Matching is by PRODUCT, not variant, for two reasons.

     One: correctness. An FBT card advertises a product but its ADD button
     carries product.variants.first.id. A customer who bought "Powder — 60
     servings" from the PDP holds a different variant than the card's first
     one, so a variant match would keep upselling something already in the bag.

     Two: app.bundle.js getCartItems() independently shows/hides these same
     cards and matches on item.product_id. Matching on variant here meant the
     two writers disagreed — the bundle hid the card, this function showed it,
     and because the bundle sets style.display directly it never left the
     restore marker behind, so removing the item brought the card back with no
     animation at all. That was the "back to FBT doesn't work" symptom. */
  function fbtReduced() {
    return !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
  }

  /* Plays the restore choreography on one card. Mirrors .fbt-card-exit — the
     card left leftwards and shrinking, so it comes back from the same place,
     which is what makes it read as "restored" rather than "some new card". */
  function fbtPlayReturn(card, delay) {
    card.classList.remove('fbt-card-enter', 'fbt-card-enter-active', 'fbt-card-returned');
    card.style.removeProperty('--fbt-d');
    if (fbtReduced()) return;

    card.style.setProperty('--fbt-d', delay + 'ms');
    card.classList.add('fbt-card-enter');
    void card.offsetWidth; /* commit the from-state before transitioning */
    card.classList.add('fbt-card-enter-active', 'fbt-card-returned');

    /* Timed cleanup rather than transitionend. The previous version listened
       for an opacity transition that could never fire — .fbt-card-enter had no
       CSS at all — so every restored card leaked a listener that never ran. */
    setTimeout(function () {
      card.classList.remove('fbt-card-enter', 'fbt-card-enter-active', 'fbt-card-returned');
      card.style.removeProperty('--fbt-d');
    }, delay + 1000);
  }

  window.syncFBTVisibility = function(cart) {
    if (!window.isCartPayload(cart)) return;
    var inCartProducts = {};
    var inCartVariants = {};
    (cart.items || []).forEach(function(item) {
      inCartProducts[String(item.product_id)] = true;
      inCartVariants[String(item.variant_id)] = true;
    });

    /* Check each FBT card */
    var fbtCards = document.querySelectorAll('.fbt-card.upsel-product-cart');
    var anyVisible = false;
    var returned = [];

    fbtCards.forEach(function(card) {
      var btn = card.querySelector('.fbt-card-action');
      if (!btn) return;
      var variantId = btn.getAttribute('data-variant');
      /* id="upsel-product-<productId>" is the fallback for any card rendered
         before data-product existed (e.g. a cached drawer still in the DOM). */
      var productId = card.dataset.product || String(card.id || '').replace('upsel-product-', '');

      var isInCart =
        (productId && inCartProducts[productId]) ||
        (variantId && inCartVariants[variantId]);

      if (isInCart) {
        /* In the cart — keep hidden, and record WHY it is hidden */
        card.dataset.fbtInCart = '1';
        /* A card already animating itself out owns its own hide; snapping
           display:none here would cut the exit short mid-fade. */
        if (!card.classList.contains('fbt-card-exit')) card.style.display = 'none';
        card.classList.remove('fbt-card-enter', 'fbt-card-enter-active', 'fbt-card-returned');
        return;
      }

      /* "Returned" means precisely: this card was hidden because its product
         sat in the cart, and now it doesn't. The old check read
         card.style.display === 'none', which is true for EVERY card on first
         render (Liquid ships them hidden) — so the restore animation fired for
         cards that had never been in the cart at all.
         The reason lives on the element rather than in a module-level snapshot
         of the last cart, because the FBT add flow hides its own card without
         routing through this function; a snapshot would miss it and the card
         would come back with no animation. */
      var didReturn = card.dataset.fbtInCart === '1';
      delete card.dataset.fbtInCart;

      /* Not in the cart — restore to FBT */
      card.style.display = 'flex';
      card.classList.remove('fbt-card-exit');
      btn.classList.remove('is-success', 'is-loading');
      anyVisible = true;

      if (didReturn) returned.push(card);
    });

    /* Show/hide the entire FBT section based on whether any cards are visible */
    var fbtSection = document.querySelector('.fbt-section');
    if (fbtSection) {
      var wasShown = fbtSection.style.display !== 'none';
      fbtSection.style.display = anyVisible ? '' : 'none';
      /* Section coming back from empty is a bigger jump than any single card,
         so it gets its own settle. Flagged for the fbt-reveal wrapper below so
         the two entrance animations can't both claim the same cards. */
      if (anyVisible && !wasShown && returned.length && !fbtReduced()) {
        fbtSection.dataset.fbtReturning = '1';
        fbtSection.classList.remove('fbt-section-in');
        void fbtSection.offsetWidth;
        fbtSection.classList.add('fbt-section-in');
        setTimeout(function () {
          fbtSection.classList.remove('fbt-section-in');
          delete fbtSection.dataset.fbtReturning;
        }, 700);
      }
    }

    if (!returned.length) return;

    /* Measure before animating: the enter transform would otherwise skew the
       rect, and .fbt-track isn't positioned so offsetLeft can't be trusted. */
    var track = returned[0].closest('.fbt-track');
    var scrollTo = null;
    if (track) {
      scrollTo = track.scrollLeft
        + (returned[0].getBoundingClientRect().left - track.getBoundingClientRect().left);
      scrollTo = Math.max(0, scrollTo);
    }

    returned.forEach(function (card, i) {
      fbtPlayReturn(card, i * 70);
    });

    /* Scroll to the card that came back, not to zero — with one card visible at
       a time, scrolling to zero can land on a completely different product. */
    if (track && scrollTo !== null) {
      track.style.scrollSnapType = 'none';
      track.scrollTo({ left: scrollTo, behavior: fbtReduced() ? 'auto' : 'smooth' });
      var onDone = function() {
        track.removeEventListener('scrollend', onDone);
        clearTimeout(fallback);
        track.style.scrollSnapType = '';
      };
      track.addEventListener('scrollend', onDone, { once: true });
      var fallback = setTimeout(onDone, 600);
    }
  };

  /* ===== Free-shipping progress: the ONLY writer for the bar ==============
     refreshCartUI and the UTM override both route through here so they can't
     drift apart (they previously kept their own copies of the fill/label/badge
     logic, and the badge said the same thing as the label). */
  function fspSetAmount(el, text) {
    if (!el || el.textContent === text) return;
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { el.textContent = text; return; }
    /* NB: opacity-only, so this is not "motion animation" under WCAG 2.3.3 and
       stays on for reduced-motion users — they still get the state change. */
    /* 100ms crossfade rather than a rolling count. Counting delays reading the
       one number the customer needs, re-fires on every quantity tick, and has
       no evidence behind it; a pure opacity change is also excluded from WCAG
       2.3.3's definition of motion animation. */
    el.classList.add('fsp-swap');
    setTimeout(function () {
      el.textContent = text;
      el.classList.remove('fsp-swap');
    }, 100);
  }

  /* The celebration is once per session. A customer who nudges quantity across
     the line repeatedly is fiddling, not achieving something new, and a reward
     that replays is not a reward. */
  function fspAlreadyCelebrated() {
    try { return sessionStorage.getItem('fsp_celebrated') === '1'; }
    catch (e) { return false; }
  }
  function fspMarkCelebrated() {
    try { sessionStorage.setItem('fsp_celebrated', '1'); } catch (e) {}
  }

  window.setShippingProgress = function (pct, remaining, isFree) {
    var c = document.getElementById('cart');
    if (!c) return;
    var i18n = window._cartI18n || {};

    /* scaleX, not width — compositor-only. Floored at 3% so an untouched cart
       reads as started; the sentence still states the true remainder. */
    var fill = c.querySelector('.progress-fill');
    if (fill) fill.style.transform = 'scaleX(' + (Math.max(pct, 3) / 100) + ')';

    var prefix = c.querySelector('[data-fsp-prefix]');
    var amountEl = c.querySelector('[data-fsp-amount]');
    var suffix = c.querySelector('[data-fsp-suffix]');
    if (prefix && amountEl && suffix) {
      if (isFree) {
        /* Possession, not a system state. "Active"/"unlocked" describes a
           feature toggle; "your shipping is free" describes something the
           customer now has. And the value is stated as SCOPE, never as rupiah:
           real shipping here runs Rp 15.000-85.000, so naming the floor would
           understate the gift to everyone outside Java. */
        prefix.textContent = i18n.unlocked || 'Your shipping is free.';
        fspSetAmount(amountEl, '');
        suffix.textContent = '';
      } else {
        prefix.textContent = (i18n.progressAdd || 'Spend') + ' ';
        suffix.textContent = ' ' + (i18n.progressMore || 'more for free shipping');
        fspSetAmount(amountEl, window.formatRp(remaining));
      }
    }

    /* Single writer for the Shipping row too — it is where the earned state
       actually lives once the header retracts. */
    /* The row states the arithmetic; the header chip states the benefit. Only
       the value changes here — giving the row its own emphasis too was the same
       fact twice. */
    var sv = c.querySelector('#cart-shipping-value');
    if (sv) {
      fspSetAmount(sv, isFree ? (i18n.shippingFree || 'FREE') : (i18n.shippingCalc || 'Calculated at checkout'));
      sv.classList.toggle('is-free', !!isFree);
    }

    var wrap = c.querySelector('.free-shipping-progress');
    if (!wrap) return;
    var was = wrap.getAttribute('data-fsp-state') === 'earned';
    /* Both states live in one fixed-height slot, so this swap moves nothing */
    wrap.setAttribute('data-fsp-state', isFree ? 'earned' : 'progress');

    /* Only on the crossing itself. A server-rendered qualifying cart never
       gets .just-unlocked, so it opens already collapsed and plays nothing. */
    if (isFree && !was) {
      var announce = wrap.querySelector('[data-fsp-announce]');
      if (announce) announce.textContent = i18n.unlocked || 'Your shipping is free.';

      if (!fspAlreadyCelebrated()) {
        fspMarkCelebrated();
        wrap.classList.remove('just-unlocked');
        void wrap.offsetWidth;
        wrap.classList.add('just-unlocked');
        setTimeout(function () { wrap.classList.remove('just-unlocked'); }, 1800);
        /* One light tap. No sound: Indonesian mobile shoppers are frequently
           browsing somewhere a chime would be unwelcome. */
        try {
          if (navigator.vibrate && !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) {
            navigator.vibrate(10);
          }
        } catch (e) {}
      }
    } else if (!isFree && was) {
      wrap.classList.remove('just-unlocked');
      var undo = wrap.querySelector('[data-fsp-announce]');
      if (undo) undo.textContent = '';
    }
  };

  /* ===== Rekonsiliasi baris keranjang =====
     Dulu drawer memasang ulang seluruh daftar: `oldItems.innerHTML =
     newItems.innerHTML`. Benar hasilnya, tapi ia MENCABUT setiap simpul lalu
     membuat penggantinya — termasuk baris yang isinya tidak berubah sama
     sekali, dan termasuk baris yang digambar lebih awal oleh mesin hadiah.
     Itulah sebabnya baris hadiah tidak pernah bisa tampil sebelum server
     menjawab: berapa pun cepat ia digambar, penyapuan ini menghapusnya.

     Sekarang: baris dengan identitas sama DIPERTAHANKAN simpulnya, hanya
     isinya yang disegarkan. Identitasnya `data-variant` (+ penanda hadiah),
     BUKAN `data-key` — Shopify mengganti kunci baris tiap kali keranjang
     dimutasi, jadi memakainya membuat semua baris terlihat baru. Pelajaran
     yang sama dengan bug baris hadiah 18 Agu.

     Hasil akhirnya identik dengan HTML server: yang berubah ikut berubah,
     yang hilang ikut hilang, yang baru ikut masuk. Yang berbeda hanya
     caranya — memperbarui, bukan membangun ulang. */
  window.cartReconcileRows = function (oldWrap, newWrap) {
    if (!oldWrap || !newWrap) return false;
    function idOf(el) {
      if (!el || !el.getAttribute) return null;
      var v = el.getAttribute('data-variant');
      if (!v) return null;
      return v + (el.classList && el.classList.contains('cart-item--gift') ? ':gift' : '');
    }
    var lama = {};
    Array.prototype.forEach.call(oldWrap.querySelectorAll('.cart-item'), function (n) {
      var id = idOf(n);
      if (id && !lama[id]) lama[id] = n;
    });
    var frag = document.createDocumentFragment();
    Array.prototype.forEach.call(newWrap.children, function (baru) {
      var id = idOf(baru);
      var simpul = id ? lama[id] : null;
      if (simpul) {
        /* Simpul sedang dianimasikan keluar oleh mesin hadiah, tapi HTML
           server yang baru MENYAHKANNYA lagi — batalkan kematiannya, atau
           timer 180ms-nya menghapus baris yang baru saja dibenarkan. */
        if (simpul.hasAttribute('data-dying') && typeof window.giftRevive === 'function') {
          window.giftRevive(simpul);
        }
        if (simpul.innerHTML !== baru.innerHTML) simpul.innerHTML = baru.innerHTML;
        for (var i = 0; i < baru.attributes.length; i++) {
          var a = baru.attributes[i];
          if (simpul.getAttribute(a.name) !== a.value) simpul.setAttribute(a.name, a.value);
        }
        delete lama[id];
        frag.appendChild(simpul);
      } else {
        frag.appendChild(baru.cloneNode(true));
      }
    });
    /* Sisa `lama` = baris yang tidak ada lagi di keranjang; dibuang bersama
       isi lama saat wadahnya dikosongkan. */
    oldWrap.innerHTML = '';
    oldWrap.appendChild(frag);
    return true;
  };

  /* ===== Nomor urut mutasi =====
     Naik satu setiap kali mutasi keranjang BERANGKAT dari drawer ini.
     Gunanya satu: cartSyncRows harus tahu apakah payload yang baru mendarat
     masih yang termuda. Respons yang potretnya diambil SEBELUM mutasi lain
     berangkat tidak tahu apa-apa tentang baris yang lahir sesudahnya —
     memakainya untuk membuang baris akan menghapus barang yang baru saja
     ditambahkan pembeli. Kalau ragu, baris DIPERTAHANKAN: baris basi yang
     tertinggal sebentar akan dibereskan mutasi berikutnya, sedangkan baris
     yang salah dibuang membuat pembeli mengira barangnya hilang. */
  window.cartMutSeq = 0;

  /* ===== Daftar baris keranjang: satu penulis, bersumber dari server ======
     Setiap permukaan keranjang di file ini digambar ulang dari payload yang
     baru saja dijawab server — total, progress bar, hemat, voucher, FBT.
     Daftar barangnya satu-satunya yang TIDAK: ia ditambal dengan tangan di
     tiap pemanggil lewat `row.remove()`, memakai simpul yang direkam SEBELUM
     permintaan berangkat. Simpul itu bisa meleset dua arah, dan pembeli
     melihat keduanya sebagai keluhan yang sama — "sudah klik hapus, barangnya
     tetap di sana; setelah reload baru benar":

     1. Simpulnya TERCABUT. Jalur add (FBT, upsell, ATC saat drawer terbuka)
        memasang ulang seluruh daftar. Bila itu mendarat antara pembeli
        menekan ikon tong sampah dan menekan Konfirmasi — atau selagi
        permintaan hapus masih di jalan — `row` menunjuk simpul yatim.
        `row.remove()` mencabut simpul yang sudah tidak ada di dokumen:
        server menghapus barangnya, layar tetap menampilkannya.

     2. Server DIAM-DIAM menolak. Mesin hadiah menulis ulang change.js jadi
        update.js untuk baris pemicu, dan update.js mengabaikan line key yang
        tak dikenalnya TANPA error. Barisnya bertahan di keranjang, sementara
        `row.remove()` telanjur menghapusnya dari layar — arah sebaliknya,
        sama-sama menyesatkan, dan totalnya ikut salah karena recalcSavings
        membaca baris dari DOM.

     Akarnya satu: daftar barang tidak pernah direkonsiliasi dengan kebenaran
     server. Rekonsiliasinya dipasang di sini dan `row.remove()` di pemanggil
     dihapus, jadi pola berlakunya sama dengan setShippingProgress: satu
     penulis, dipanggil dari satu tempat.

     Yang sengaja TIDAK disentuh karena sudah ada pemiliknya:
     - `.cart-item--optimistic` — placeholder yang memang mendahului server.
     - `.cart-item--gift` — milik mesin hadiah, yang mengecatnya dari
       kebenaran server juga dan sengaja tampil lebih dulu.

     Fungsi ini hanya MEMBUANG baris yang sudah tidak ada di keranjang dan
     MENYEGARKAN data-key; ia tidak pernah membuat baris. Membuat baris butuh
     HTML server, dan jalur add memang sudah mengambilnya. */
  window.cartSyncRows = function (cart, seq) {
    var c = document.getElementById('cart');
    if (!c || !cart || !Array.isArray(cart.items)) return;
    var wrap = c.querySelector('.cart-items');
    if (!wrap) return;

    /* Payload yang sudah didahului mutasi lain hanya boleh MENYEGARKAN kunci,
       tidak boleh membuang baris — lihat catatan cartMutSeq di atas. */
    var bolehBuang = (seq === undefined || seq === null || seq === window.cartMutSeq);

    var rows = Array.prototype.filter.call(
      wrap.querySelectorAll('.cart-item'),
      function (n) {
        return !n.classList.contains('cart-item--optimistic')
            && !n.classList.contains('cart-item--gift');
      }
    );
    if (!rows.length) return;

    /* Baris hadiah dikeluarkan dari pencocokan: pemiliknya mesin hadiah, dan
       membiarkannya ikut bisa membuat baris produk berbayar "diselamatkan"
       oleh baris hadiah bervarian sama. */
    var lines = [];
    for (var li = 0; li < cart.items.length; li++) {
      var it = cart.items[li];
      if (it.properties && it.properties._Gifted) continue;
      lines.push(it);
    }

    var used = [];
    var matched = [];

    /* Babak 1 — cocokkan lewat data-key. Ini identitas paling tepat, dan
       satu-satunya yang bisa membedakan dua baris bervarian sama dengan
       properties berbeda. */
    rows.forEach(function (row, ri) {
      matched[ri] = -1;
      var k = row.getAttribute('data-key');
      if (!k) return;
      for (var i = 0; i < lines.length; i++) {
        if (used[i] || lines[i].key !== k) continue;
        used[i] = true; matched[ri] = i; return;
      }
    });

    /* Babak 2 — sisanya masih boleh diselamatkan lewat varian. data-key di
       DOM bisa tertinggal bila barisnya dirender sebelum mutasi terakhir,
       dan membuang baris yang sebenarnya masih ada jauh lebih berbahaya
       daripada menahannya. Kuncinya sekalian disegarkan, supaya klik
       BERIKUTNYA pada baris itu memakai kunci yang hidup. */
    rows.forEach(function (row, ri) {
      if (matched[ri] >= 0) return;
      var v = row.getAttribute('data-variant');
      if (!v) return;
      for (var i = 0; i < lines.length; i++) {
        if (used[i] || String(lines[i].variant_id) !== String(v)) continue;
        used[i] = true; matched[ri] = i; return;
      }
    });

    rows.forEach(function (row, ri) {
      if (matched[ri] < 0) { if (bolehBuang) row.remove(); return; }
      var line = lines[matched[ri]];
      if (!line.key || row.getAttribute('data-key') === line.key) return;
      row.setAttribute('data-key', line.key);
      Array.prototype.forEach.call(row.querySelectorAll('[data-key]'), function (el) {
        el.setAttribute('data-key', line.key);
      });
    });
  };

  /* ===== Central UI refresh ===== */
  window.refreshCartUI = function(cart, seq) {
    var c = document.getElementById('cart');
    if (!c) return;

    /* One choke point for every caller. An error payload must never reach the
       renderers — it produces NaN prices and makes syncVoucherUI think a live
       voucher expired. Re-read the real cart instead of guessing. */
    if (!window.isCartPayload(cart)) {
      console.error('[cart] non-cart payload rejected', cart);
      if (window.refreshCartUI._healing) return;
      window.refreshCartUI._healing = true;
      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (fresh) {
          window.refreshCartUI._healing = false;
          if (window.isCartPayload(fresh)) window.refreshCartUI(fresh);
        })
        .catch(function () { window.refreshCartUI._healing = false; });
      return;
    }

    /* Daftar baris didamaikan DULU: recalcSavings di bawah membaca baris dari
       DOM, jadi baris basi yang belum dibuang akan menggelembungkan "hemat". */
    window.cartSyncRows(cart, seq);

    /* Baris hadiah ikut disegarkan dari payload yang sama — lewat pemiliknya
       (mesin hadiah), bukan salinan logika. Hanya payload termuda yang boleh:
       potret basi yang mengecat hadiah justru penyakit yang sedang diobati. */
    if ((seq === undefined || seq === null || seq === window.cartMutSeq)
        && typeof window.giftRepaint === 'function') {
      window.giftRepaint(cart);
    }

    var i18n = window._cartI18n || {};
    var totalCents = cart.total_price;
    var total = totalCents / 100;
    /* Progress is measured on MERCHANDISE value (items_subtotal_price), not on
       the post-voucher total. Two reasons.

       The goal is "how much more product do I need to add" — a figure the
       customer controls. Measuring it on the post-voucher total makes the goal
       move backwards the moment they use a voucher, which reads as a bug: a
       cart holding Rp 470.000 of product with a 100% code shows Rp 0 and asks
       for the full Rp 700.000 again.

       And it now matches the store rule: the automatic "Free Shipping"
       discount (Indonesia) was moved to a Rp 700.000 minimum and set to
       combine with order and product discounts, so a voucher should no longer
       cost an earned free-shipping. Note that /cart/shipping_rates.json cannot
       confirm this — that endpoint returns raw profile rates and is blind to
       shipping discounts — so the checkout line item is the outstanding check. */
    var progressCents = cart.items_subtotal_price;
    if (progressCents === null || progressCents === undefined) progressCents = totalCents;
    var progressBase = progressCents / 100;
    var threshold = minShipping;
    var remaining = threshold - progressBase;
    var isFree = remaining <= 0;

    // UTM override
    var utmFree = (typeof window.isUtmFreeShipping === 'function' && window.isUtmFreeShipping());
    if (utmFree) { isFree = true; remaining = 0; }

    /* -- Progress bar: single writer, see setShippingProgress -- */
    var pct = Math.min((progressBase / threshold) * 100, 100);
    window.setShippingProgress(pct, remaining, isFree);

    /* -- Keranjang kosong: tutup drawer dengan hormat (hanya bila BARU
          menjadi kosong — lihat cartMaybeCloseOnEmpty) -- */
    window.cartMaybeCloseOnEmpty(cart.item_count);

    /* -- Checkout total -- */
    var te = c.querySelector('#sub-total-mini');
    if (te) {
      te.dataset.total = totalCents;
      te.textContent = window.formatRp(total);
    }
    window.updateCheckoutCompare();

    /* -- Shipping row stays visible; its value is written by
          setShippingProgress, which owns every free-shipping surface -- */
    var shippingRow = c.querySelector('#cart-shipping-row');
    if (shippingRow) shippingRow.classList.add('visible');

    /* -- Savings row: recalculate from DOM data attributes -- */
    window.recalcSavings();

    /* -- Voucher row: reconcile with whatever the cart actually holds -- */
    if (window.syncVoucherUI) window.syncVoucherUI(cart);

    /* -- FBT: every cart mutation reconciles the carousel ------------------
       Previously only two call sites did this by hand, so any path that
       forgot (or that threw earlier in its own .then) left a removed product
       missing from the carousel until the drawer was closed and reopened.
       Routing it through here makes the restore a property of "the cart
       changed" rather than of one particular handler remembering.
       Idempotent: the restore marker is cleared on the first pass, so a
       second call in the same tick finds nothing to animate. */
    if (window.syncFBTVisibility) window.syncFBTVisibility(cart);
  };

  /* ===== Tutup premium saat keranjang kosong =====
     Doktrin gerak yang sama dengan kedatangan hadiah, dibalik: kepergian
     lebih cepat dari kedatangan, kurva MEMPERCEPAT (cubic-bezier(0.7,0,0.84,0)),
     hanya transform + opacity, dan berlapis — isi panel pamit duluan
     (memudar turun 150ms), baru panelnya meluncur keluar lewat transisi
     tutup milik tema. Drawer kosong yang menganga membebani pembeli dengan
     keputusan "sekarang apa?"; menutupnya mengembalikan mereka ke halaman. */
  window.cartPremiumClose = function () {
    var mini = document.querySelector('.mini-cart.active');
    if (!mini) return;
    var panel = document.getElementById('cart');
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var slideOut = function () {
      mini.classList.remove('active');
      /* Bersihkan jejak inline setelah panel selesai keluar (transisi tema
         0.38 detik) supaya pembukaan berikutnya mulai dari keadaan murni. */
      setTimeout(function () {
        if (panel) {
          panel.style.removeProperty('transform');
          panel.style.removeProperty('transition');
        }
      }, 450);
    };
    if (reduced || !panel) { slideOut(); return; }
    /* Parallax dua lapis, TANPA fade: konten mendahului ke arah keluar
       (24px, kurva mempercepat), panel menyusul lewat transisi tema 70ms
       kemudian. Dua lapisan yang bergerak dengan kecepatan berbeda terbaca
       sebagai kedalaman; opacity tidak disentuh sama sekali. */
    panel.style.transition = 'transform 220ms cubic-bezier(0.7, 0, 0.84, 0)';
    panel.style.transform = 'translateX(1.5rem)';
    setTimeout(slideOut, 70);
  };

  /* Dipanggil refreshCartUI setiap kali keranjang menjadi kosong. Jedanya
     satu tarikan napas (650ms): baris terakhir sempat menuntaskan animasi
     keluarnya dan pembeli sempat MELIHAT keranjangnya kosong — menutup
     seketika terasa seperti diusir. Batal otomatis bila sempat ada isi lagi
     (mis. pembeli menekan ADD di Frequently Bought Together). */
  var _emptyCloseTimer = null;
  var _lastItemCount = null;
  window.cartCancelEmptyClose = function () {
    if (_emptyCloseTimer) { clearTimeout(_emptyCloseTimer); _emptyCloseTimer = null; }
  };
  /* Hanya TRANSISI berisi → kosong yang menutup. Drawer yang memang dibuka
     dalam keadaan kosong (klik ikon keranjang tanpa isi) harus tetap terbuka —
     pembeli sengaja membukanya dan empty state punya pekerjaan: menunjukkan
     jalan mulai belanja. */
  window.cartMaybeCloseOnEmpty = function (count) {
    if (count === 0) {
      if (_lastItemCount !== null && _lastItemCount > 0) window.cartScheduleEmptyClose();
    } else {
      window.cartCancelEmptyClose();
    }
    _lastItemCount = count;
  };
  window.cartScheduleEmptyClose = function () {
    if (_emptyCloseTimer) return;
    _emptyCloseTimer = setTimeout(function () {
      _emptyCloseTimer = null;
      var c = document.getElementById('cart');
      if (c && c.querySelector('.cart-item')) return; /* sudah terisi lagi */
      window.cartPremiumClose();
    }, 650);
  };

  /* ===== Mutasi keranjang dengan percobaan ulang =====
     Endpoint keranjang membalas 429 sebagai halaman HTML, jadi pola lama
     fetch().then(r => r.json()) melempar SyntaxError yang jatuh ke .catch —
     handler remove lalu MEMULIHKAN barisnya seolah pembeli membatalkan,
     padahal servernya cuma minta napas. Pembeli melihat barangnya "balik
     lagi" dan harus menghapus dua kali. 429 bersifat sesaat; tiga percobaan
     berjeda menaik hampir selalu cukup. */
  window.cartChangeWithRetry = function (payload, tries, delay) {
    /* Anggaran total dijaga di bawah ~10 detik. Lima percobaan dengan
       Retry-After 30 detik pernah membuat spinner menggiling hampir semenit —
       lebih jujur menyerah cepat dan memulihkan barisnya daripada menyandera
       pembeli di depan overlay. */
    /* Hanya percobaan PERTAMA yang menaikkan nomor urut: percobaan ulang
       adalah mutasi logis yang sama, dan menaikkannya lagi akan membuat
       pemanggilnya sendiri terlihat basi. */
    if (tries === undefined) window.cartMutSeq++;
    tries = tries || 3;
    delay = delay || 1000;
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload)
    }).then(function (r) {
      if (!r.ok) {
        var err = new Error('cart ' + r.status);
        /* Kalau server memberi tahu kapan boleh kembali, patuhi itu. */
        var ra = parseInt(r.headers.get('Retry-After'), 10);
        if (ra > 0 && ra <= 6) err.retryAfter = ra * 1000;
        throw err;
      }
      return r.json();
    }).catch(function (err) {
      if (tries <= 1) {
        /* Jejak untuk debug: tanpa ini, baris yang "balik lagi" tampak
           seperti bug UI padahal servernya yang menolak terus. */
        try { console.warn('[cart] change gagal setelah semua percobaan:', err && err.message); } catch (e) {}
        throw err;
      }
      var pause = (err && err.retryAfter) ? err.retryAfter : delay;
      return new Promise(function (res) { setTimeout(res, pause); })
        .then(function () { return window.cartChangeWithRetry(payload, tries - 1, delay * 2); });
    });
  };

  /* ===== Qty change handler ===== */
  window.cartChangeQty = function(sel) {
    var key = sel.getAttribute('data-key') || sel.getAttribute('data-id');
    var qty = parseInt(sel.value);

    window.cartShowLoading();

    var req = window.cartChangeWithRetry({ id: key, quantity: qty });
    var seq = window.cartMutSeq;
    req.then(function(cart) {
      window.refreshCartUI(cart, seq);
      window.syncFBTVisibility(cart);
      /* qty 0 (dan baris yang hilang karena sebab lain) dibuang cartSyncRows
         dari refreshCartUI di atas — satu penulis, bukan salinan lokal. */
      window.cartHideLoading();
    })
    .catch(function() { window.cartHideLoading(); });
  };

  /* ===== Remove item confirmation modal ===== */
  (function() {
    var _pendingBtn = null;
    var _closeTimer = null;
    var modal = document.getElementById('cart-remove-modal');
    var nameEl = document.getElementById('cart-remove-name');
    var cancelBtn = document.getElementById('cart-remove-cancel');
    var confirmBtn = document.getElementById('cart-remove-confirm');

    /* Move modal to <body> so it isn't affected by .mini-cart pointer-events
       or any stacking-context quirks of the cart drawer. */
    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }

    function openModal() {
      if (!modal) return;
      /* Cancel any pending close — prevents a stale timeout from hiding
         a freshly-opened modal when the user rapidly re-triggers remove. */
      if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
      modal.classList.add('active');
      /* Trigger reflow so the transition plays */
      void modal.offsetWidth;
      modal.classList.add('visible');
    }

    function closeModal() {
      if (!modal) return;
      if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
      modal.classList.remove('visible');
      /* Wait for the exit animation to finish, then hide */
      _closeTimer = setTimeout(function() {
        modal.classList.remove('active');
        _closeTimer = null;
      }, 250);
    }

    /* Show confirmation — called from trash button onclick */
    window.cartRemoveItem = function(btn) {
      _pendingBtn = btn;
      var row = btn.closest('.cart-item');
      var title = row ? (row.querySelector('.title') || {}).textContent : '';
      if (nameEl) nameEl.textContent = '"' + (title || 'this item').trim() + '"';
      openModal();
    };

    /* Cancel — close modal, do nothing */
    if (cancelBtn) {
      cancelBtn.addEventListener('click', function() {
        _pendingBtn = null;
        closeModal();
      });
    }

    /* Also close on backdrop click */
    if (modal) {
      modal.querySelector('.cart-remove-backdrop').addEventListener('click', function() {
        _pendingBtn = null;
        closeModal();
      });
    }

    /* Confirm — actually remove the item */
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        if (!_pendingBtn) return;
        var btn = _pendingBtn;
        _pendingBtn = null;
        closeModal();

        var key = btn.getAttribute('data-key');
        var row = btn.closest('.cart-item');

        /* Fade + shrink the row out */
        if (row) {
          row.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          row.style.opacity = '0';
          row.style.transform = 'scale(0.96)';
        }

        window.cartShowLoading();

        var req = window.cartChangeWithRetry({ id: key, quantity: 0 });
        var seq = window.cartMutSeq;
        req.then(function(cart) {
          /* Barisnya TIDAK dicabut di sini. `row` direkam sebelum permintaan
             berangkat dan bisa sudah tercabut oleh re-render jalur add — dan
             server bisa saja tidak benar-benar menghapusnya. cartSyncRows di
             dalam refreshCartUI membuang baris berdasarkan jawaban server,
             pada DOM yang sedang hidup. */
          window.refreshCartUI(cart, seq);
          window.syncFBTVisibility(cart);
          window.cartHideLoading();
        })
        .catch(function() {
          if (row) {
            row.style.opacity = '1';
            row.style.transform = '';
            row.style.transition = '';
          }
          window.cartHideLoading();
        });
      });
    }
  })();
</script>

<script>
  /* ===== Harga coret: dirender server, tidak disentuh klien =====
     Dulu di sini setiap produk di keranjang ditarik ulang lewat
     ?section_id=variant-compare-data, lalu teks harga coret dan
     data-compare-at DITIMPA dengan nilai dari sana.

     Komentar lamanya keliru: konteks keranjang MEMANG mengekspos
     compare_at_price, dan snippets/CartItemCard.liquid sudah merendernya
     server-side. Lapisan ini tidak menambah kebenaran apa pun — ia hanya
     menyalin ulang angka yang sudah benar, sambil membuka satu jalan bagi
     angka yang salah untuk masuk: bila render section itu tersaji dari
     cache basi, ia menimpa harga coret yang benar dengan nilai lama.
     12 Agu 2026 justru itu yang terjadi — Protocol 60 Days berubah dari
     1.160.000 menjadi 1.450.000 di keranjang, dan "You're saving" ikut
     menggelembung 290.000.

     Sekarang server satu-satunya sumber; yang tersisa hanyalah menghitung
     ulang total hemat dari data-compare-at yang sudah terpasang. Nol
     permintaan jaringan per pembukaan drawer.

     Catatan: window.loadFBTRatings di bawah masih memakai section yang sama
     untuk badge rating Judge.me — itu tidak menyentuh harga, jadi tetap. */
  window.loadCompareAtPrices = function() {
    if (typeof window.recalcSavings === 'function') window.recalcSavings();
  };

  /* ===== Fetch Judge.me ratings for FBT products ===== */
  window.loadFBTRatings = function() {
    var fbtCards = document.querySelectorAll('.fbt-card[data-handle]');
    if (!fbtCards.length) return;

    fbtCards.forEach(function(card) {
      var handle = card.getAttribute('data-handle');
      if (!handle) return;

      fetch('/products/' + handle + '?section_id=variant-compare-data')
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');

          /* Try to extract data-average-rating from Judge.me badge */
          var badge = doc.querySelector('[data-rating-badge]');
          if (!badge) return;

          var ratingEl = badge.querySelector('[data-average-rating]');
          var rating = ratingEl ? ratingEl.getAttribute('data-average-rating') : null;

          /* Fallback: try to extract from badge text content */
          if (!rating) {
            var text = badge.textContent || '';
            var match = text.match(/([\d.]+)\s*\/\s*5/);
            if (match) rating = match[1];
          }

          if (!rating || parseFloat(rating) <= 0) return;

          /* Update the FBT card rating display */
          var ratingWrap = card.querySelector('.fbt-rating');
          var ratingText = card.querySelector('.fbt-rating-text');
          if (ratingWrap && ratingText) {
            ratingText.textContent = rating + '/5';
            ratingWrap.style.display = '';
          }
        })
        .catch(function(err) { console.warn('FBT rating fetch failed for', handle, err); });
    });
  };

  /* ===== FBT Add-to-Cart ==================================================
     Capture-phase intercept blocks app.bundle.js, whose ajaxCart() does
     innerHTML='' then innerHTML=html and flashes the whole drawer. We swap only
     .cart-items and .cart-footer so the header, progress bar and FBT survive.

     The card now leaves on the tap, before the network answers. The old order
     was: await /cart/add.js, THEN await cart?view=mini (serialised), crossfade
     120ms, show a checkmark, hold 500ms, and only then start the 250ms exit —
     roughly 870ms of scripted waiting stacked on top of two round-trips. The
     item appearing in the list above is the confirmation; the checkmark was
     confirming something the customer could already see. */
  (function() {
    /* Resolves once the card is actually hidden. transitionend alone isn't
       enough — a drawer re-render mid-flight detaches the node and the event
       never lands, which would strand the card half-faded. */
    function fbtExit(card) {
      if (!card) return;
      card.dataset.fbtInCart = '1';
      if (fbtReduced()) { card.style.display = 'none'; return; }

      card.classList.add('fbt-card-exit');
      var done = false;
      var finish = function () {
        if (done) return;
        done = true;
        card.style.display = 'none';
        card.classList.remove('is-success', 'fbt-card-exit');
        var track = card.closest('.fbt-track');
        if (track) track.scrollLeft = 0;
      };
      card.addEventListener('transitionend', function h(ev) {
        if (ev.propertyName !== 'opacity') return;
        card.removeEventListener('transitionend', h);
        finish();
      });
      setTimeout(finish, 420);
    }

    var FBT_FAILED = window.cartDecode({{ 'cart.atc_failed_generic' | t | json }});

    document.addEventListener('click', function(e) {
      var btn = e.target.closest && e.target.closest('.fbt-card-action');
      if (!btn || btn.dataset.fbtBusy) return;

      var variant = btn.dataset.variant;
      if (!variant) return;

      e.stopImmediatePropagation();
      e.preventDefault();
      btn.dataset.fbtBusy = '1';

      var card = btn.closest('.fbt-card');
      var prefix = (typeof Shopify !== 'undefined' && Shopify.locale === 'id') ? '/id/' : '/';

      /* Optimistic: the card goes now, the network catches up */
      fbtExit(card);

      /* Only a failed ADD justifies putting the card back. A crash in the
         post-add DOM work must not roll back a line the customer really did
         add — that reports "couldn't add to cart" over an item sitting in the
         cart, and restores an FBT card for a product that is now in it. */
      var addFailed = false;

      window.cartMutSeq++;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(variant, 10), quantity: 1 }] })
      })
      .then(function(r) {
        return r.json().then(function (j) { if (!r.ok) throw j; return j; });
      })
      .catch(function (err) {
        addFailed = true;
        throw err;
      })
      .then(function() {
        /* Parallel. These two don't depend on each other, and chaining them
           doubled the wait before the drawer showed the new line. */
        return Promise.all([
          fetch(prefix + 'cart?view=mini').then(function(r) { return r.text(); }),
          fetch('/cart.js').then(function(r) { return r.json(); })
        ]);
      })
      .then(function(res) {
        delete btn.dataset.fbtBusy;
        var html = res[0];
        var cart = res[1];

        var cartEl = document.getElementById('cart');
        if (!cartEl) return;

        var doc = new DOMParser().parseFromString(html, 'text/html');
        var newItems = doc.querySelector('.cart-items');
        var newFooter = doc.querySelector('.sub-total.cart-footer');
        var oldItems = cartEl.querySelector('.cart-items');
        var oldFooter = cartEl.querySelector('.sub-total.cart-footer');

        if (oldItems && newItems) {
          oldItems.style.transition = 'opacity 0.12s ease-out';
          oldItems.style.opacity = '0';
          setTimeout(function() {
            window.cartReconcileRows(oldItems, newItems);
            /* HTML mini diambil paralel dan bisa lebih tua daripada koreksi
               hadiah — cat ulang baris hadiah SETELAH penukaran supaya
               penulis terakhir jalur ini tetap membawa kebenaran termuda. */
            if (typeof window.giftRepaint === 'function') window.giftRepaint(cart);
            oldItems.style.transition = 'opacity 0.18s ease-in';
            oldItems.style.opacity = '1';
            setTimeout(function() { oldItems.style.transition = ''; }, 200);
          }, 120);
        }

        if (oldFooter && newFooter) {
          oldFooter.innerHTML = newFooter.innerHTML;
          window.initCartTrustSlider();
        }

        window.refreshCartUI(cart);
        if (cart.item_count > 0) window.loadCompareAtPrices();
        var indicator = document.getElementById('cart-indicator');
        if (indicator) indicator.classList.toggle('show', cart.item_count > 0);
      })
      .catch(function(err) {
        delete btn.dataset.fbtBusy;

        if (!addFailed) {
          /* The item IS in the cart; only the redraw broke. Say nothing to the
             customer, log it for us, and reconcile from the server so the
             drawer isn't left half-updated. */
          console.error('[cart] FBT post-add refresh failed', err);
          fetch('/cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) { window.refreshCartUI(cart); })
            .catch(function () {});
          return;
        }

        /* The optimistic exit was a promise we could not keep — put it back */
        if (card) {
          delete card.dataset.fbtInCart;
          card.classList.remove('fbt-card-exit');
          card.style.display = 'flex';
          fbtPlayReturn(card, 0);
        }
        if (window.cartToast) window.cartToast((err && err.description) || FBT_FAILED);
      });
    }, true); /* capture: runs before (and blocks) the app.bundle.js handler */
  })();
</script>

