<div class="mini-cart">
  <div class="overlay"></div>

  <!-- Remove item confirmation modal -->
  <div class="cart-remove-modal" id="cart-remove-modal">
    <div class="cart-remove-backdrop"></div>
    <div class="cart-remove-dialog">
      <div class="cart-remove-title">{{ 'cart.remove_title' | t }}</div>
      <div class="cart-remove-msg">{{ 'cart.remove_prefix' | t }} <span class="cart-remove-name" id="cart-remove-name"></span> {{ 'cart.remove_suffix' | t }}</div>
      <div class="cart-remove-actions">
        <button type="button" class="cart-remove-btn cart-remove-cancel" id="cart-remove-cancel">{{ 'cart.remove_cancel' | t }}</button>
        <button type="button" class="cart-remove-btn cart-remove-confirm" id="cart-remove-confirm">{{ 'cart.remove_confirm' | t }}</button>
      </div>
    </div>
  </div>

  <div class="mini-cart-wrapper" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <div class="up-selling fbt-section">
      <div class="fbt-header">
        {{ 'cart.fbt_title' | t }} <strong>{{ 'cart.fbt_title_bold' | t }}</strong>
      </div>
      {% if up_selling != null %}
        <div class="fbt-track">
          {% for product in up_selling %}
            <div
              class="fbt-card upsel-product-cart"
              id="upsel-product-{{ product.id }}"
              data-handle="{{ product.handle }}"
              style="display: none;"
            >
              <div class="fbt-card-image">
                <img
                  src="{{ product.media.first | img_url: '160x' }}"
                  alt="{{ product.title | escape }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </div>
              <div class="fbt-card-info">
                <div class="fbt-rating" style="display:none;">
                  <span class="fbt-star"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 0C5.80302 0 5.63472 0.0961647 5.5078 0.213572C5.38088 0.33098 5.27903 0.47454 5.18487 0.635508C4.99654 0.957443 4.83682 1.3563 4.68095 1.76327C4.52508 2.17024 4.37566 2.58362 4.23302 2.91318C4.09037 3.24274 3.92546 3.48566 3.88535 3.51613C3.84523 3.54659 3.57302 3.63634 3.22908 3.67631C2.88513 3.71627 2.4613 3.73567 2.04284 3.76486C1.62438 3.79405 1.21293 3.8321 0.861812 3.91983C0.686252 3.9637 0.523469 4.01877 0.377421 4.10866C0.231373 4.19855 0.091925 4.33478 0.0310553 4.5306C-0.0298147 4.72641 0.00641869 4.92552 0.0740254 5.08797C0.141632 5.25042 0.241827 5.3939 0.359191 5.53725C0.593919 5.82395 0.905579 6.10823 1.22771 6.38893C1.54984 6.66964 1.88211 6.94619 2.1379 7.18983C2.39368 7.43347 2.56269 7.67186 2.57801 7.72116C2.59334 7.77045 2.59064 8.06882 2.52072 8.42308C2.4508 8.77734 2.33831 9.20397 2.23555 9.62898C2.1328 10.054 2.03896 10.4744 2.01029 10.8505C1.99595 11.0386 1.99576 11.2167 2.03242 11.3897C2.06908 11.5626 2.15172 11.7453 2.31108 11.8663C2.47044 11.9873 2.66192 12.0122 2.83063 11.9952C2.99933 11.9782 3.16004 11.9243 3.32674 11.852C3.66013 11.7072 4.01478 11.4825 4.36974 11.249C4.7247 11.0155 5.07816 10.7729 5.37889 10.594C5.67962 10.415 5.95042 10.3205 6 10.3205C6.04958 10.3205 6.32039 10.415 6.62112 10.594C6.92184 10.7729 7.27531 11.0155 7.63026 11.249C7.98522 11.4825 8.33987 11.7072 8.67327 11.852C8.83997 11.9243 9.00067 11.9782 9.16938 11.9952C9.33808 12.0122 9.52957 11.9873 9.68892 11.8663C9.84828 11.7453 9.93092 11.5626 9.96758 11.3897C10.0042 11.2167 10.0041 11.0386 9.98971 10.8505C9.96103 10.4744 9.8672 10.054 9.76445 9.62898C9.66169 9.20397 9.5492 8.77734 9.47928 8.42308C9.40936 8.06882 9.40666 7.77045 9.42199 7.72116C9.43731 7.67186 9.60632 7.43347 9.86211 7.18983C10.1179 6.94619 10.4502 6.66964 10.7723 6.38893C11.0944 6.10823 11.4061 5.82395 11.6408 5.53725C11.7582 5.3939 11.8584 5.25042 11.926 5.08797C11.9936 4.92552 12.0298 4.72641 11.9689 4.5306C11.9081 4.33478 11.7686 4.19855 11.6226 4.10866C11.4765 4.01877 11.3138 3.9637 11.1382 3.91983C10.7871 3.8321 10.3756 3.79405 9.95716 3.76486C9.5387 3.73567 9.11487 3.71627 8.77093 3.67631C8.42698 3.63634 8.15477 3.54659 8.11465 3.51613C8.07454 3.48566 7.90963 3.24274 7.76699 2.91318C7.62434 2.58362 7.47492 2.17024 7.31906 1.76327C7.16319 1.3563 7.00346 0.957443 6.81513 0.635508C6.72097 0.47454 6.61913 0.33098 6.4922 0.213572C6.36528 0.0961647 6.19698 0 6 0Z" fill="#F8F8F2"/></svg></span>
                  <span class="fbt-rating-text"></span>
                </div>
                <div class="fbt-card-title">{{ product.title }}</div>
                <div class="fbt-card-variant">
                  {%- unless product.has_only_default_variant -%}
                    {{- product.variants.first.title -}}
                  {%- endunless -%}
                </div>
                <div class="fbt-card-price">{{ product.price | money }}</div>
              </div>
              <div
                class="fbt-card-action button-quick-add-cart button-cart-icon"
                data-variant="{{ product.variants.first.id }}"
              >
                <span class="fbt-btn-state fbt-btn-idle">{{ 'cart.fbt_add' | t }}</span>
                <span class="fbt-btn-state fbt-btn-loading">
                  <svg class="fbt-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity=".25"/>
                    <path d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  </svg>
                </span>
                <span class="fbt-btn-state fbt-btn-success">
                  <svg width="14" height="11" viewBox="0 0 14 11" fill="none">
                    <path d="M1 5.5L5 9.5L13 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <div id="cart">{% render 'CartDrawerContent' %}</div>
  </div>
</div>

<script>
  /* ===== Cart i18n strings (Liquid → JS) ===== */
  window._cartI18n = {
    allSet:            {{ 'cart.progress.all_set' | t | json }},
    progressAdd:       {{ 'cart.progress_add' | t | json }},
    progressMore:      {{ 'cart.progress_more' | t | json }},
    freeShippingBadge: {{ 'cart.free_shipping_badge' | t | json }},
    progressAway:      {{ 'cart.progress_away' | t | json }},
    shippingFree:      {{ 'cart.shipping_free' | t | json }},
    shippingCalc:      {{ 'cart.shipping_calculated' | t | json }}
  };

  const minShipping = {{ settings.min_shipping | default: 1000000 }};

  /* ===== Rp formatter (dots, no decimals) ===== */
  window.formatRp = function(amount) {
    var n = Math.round(Math.abs(amount));
    return 'Rp ' + n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  };

  /* ===== Loading overlay for cart ===== */
  window.cartShowLoading = function() {
    var c = document.getElementById('cart');
    if (!c) return;
    var existing = c.querySelector('.cart-loading-overlay');
    if (existing) { existing.style.display = 'flex'; return; }
    var ov = document.createElement('div');
    ov.className = 'cart-loading-overlay';
    ov.innerHTML = '<div class="cart-loading-spinner"></div>';
    c.appendChild(ov);
  };
  window.cartHideLoading = function() {
    var ov = document.querySelector('#cart .cart-loading-overlay');
    if (ov) ov.style.display = 'none';
  };

  /* ===== Sync FBT card visibility with current cart ===== */
  /* Shows FBT cards whose variant is NOT in the cart,     */
  /* hides FBT cards whose variant IS in the cart.         */
  window.syncFBTVisibility = function(cart) {
    /* Build a set of variant IDs currently in the cart */
    var inCart = {};
    (cart.items || []).forEach(function(item) {
      inCart[String(item.variant_id)] = true;
    });

    /* Check each FBT card */
    var fbtCards = document.querySelectorAll('.fbt-card.upsel-product-cart');
    var anyVisible = false;
    var anyReturned = false;
    fbtCards.forEach(function(card) {
      var btn = card.querySelector('.fbt-card-action');
      var variantId = btn ? btn.getAttribute('data-variant') : null;
      if (!variantId) return;

      if (inCart[variantId]) {
        /* Variant is in cart — keep hidden */
        card.style.display = 'none';
        card.classList.remove('fbt-card-enter', 'fbt-card-enter-active');
      } else {
        var wasHidden = card.style.display === 'none';
        /* Variant NOT in cart — restore to FBT */
        card.style.display = 'flex';
        card.classList.remove('fbt-card-exit');
        btn.classList.remove('is-success', 'is-loading');
        anyVisible = true;

        /* Animate entrance if card was previously hidden (removed from cart) */
        if (wasHidden) {
          anyReturned = true;
          card.classList.add('fbt-card-enter');
          card.classList.remove('fbt-card-enter-active');
          /* Force reflow so the initial state is applied before transitioning */
          void card.offsetWidth;
          card.classList.add('fbt-card-enter-active');
          /* Clean up classes after animation completes */
          card.addEventListener('transitionend', function handler(ev) {
            if (ev.propertyName !== 'opacity') return;
            card.removeEventListener('transitionend', handler);
            card.classList.remove('fbt-card-enter', 'fbt-card-enter-active');
          });
        }
      }
    });

    /* Show/hide the entire FBT section based on whether any cards are visible */
    var fbtSection = document.querySelector('.fbt-section');
    if (fbtSection) {
      fbtSection.style.display = anyVisible ? '' : 'none';
    }

    /* If any card returned, smooth-scroll the FBT track back to true zero */
    if (anyReturned) {
      var track = document.querySelector('.fbt-track');
      if (track) {
        /* Disable scroll-snap so it doesn't fight the scroll position */
        track.style.scrollSnapType = 'none';
        track.scrollTo({ left: 0, behavior: 'smooth' });

        /* Re-enable scroll-snap after the smooth scroll finishes */
        var onDone = function() {
          track.removeEventListener('scrollend', onDone);
          clearTimeout(fallback);
          track.style.scrollSnapType = '';
        };
        track.addEventListener('scrollend', onDone, { once: true });
        /* Fallback for browsers without scrollend */
        var fallback = setTimeout(onDone, 450);
      }
    }
  };

  /* ===== Central UI refresh ===== */
  window.refreshCartUI = function(cart) {
    var c = document.getElementById('cart');
    if (!c) return;

    var totalCents = cart.total_price;
    var total = totalCents / 100;
    var threshold = minShipping;
    var remaining = threshold - total;
    var isFree = remaining <= 0;

    // UTM override
    var utmFree = (typeof window.isUtmFreeShipping === 'function' && window.isUtmFreeShipping());
    if (utmFree) { isFree = true; remaining = 0; }

    /* -- Progress fill + indicator position -- */
    var pf = c.querySelector('.progress-fill');
    var pct = Math.min((total / threshold) * 100, 100);
    if (pf) {
      pf.style.width = pct + '%';
    }

    /* -- Slide the icon+badge indicator along the track -- */
    var indicator = c.querySelector('.progress-indicator');
    if (indicator) {
      /* Clamp between 12% and 88% to keep icon + badge on-screen */
      var pos = Math.max(12, Math.min(pct, 88));
      indicator.style.left = pos + '%';
    }

    /* -- Progress text -- */
    var label = c.querySelector('#shipping-progress-label');
    var i18n = window._cartI18n || {};
    if (label) {
      if (isFree) {
        label.textContent = i18n.allSet || 'All set!';
      } else {
        label.textContent = (i18n.progressAdd || 'Add') + ' ' + window.formatRp(remaining) + ' ' + (i18n.progressMore || 'more for Free Shipping');
      }
    }

    /* -- Badge -- */
    var bt = c.querySelector('#badge-text');
    if (bt) {
      bt.textContent = isFree ? (i18n.freeShippingBadge || 'Free Shipping') : window.formatRp(remaining) + ' ' + (i18n.progressAway || 'away');
    }

    /* -- Fulfilled class -- */
    var pw = c.querySelector('.free-shipping-progress');
    if (pw) {
      var wasFulfilled = pw.classList.contains('fulfilled');
      pw.classList.toggle('fulfilled', isFree);
      /* Re-trigger animations only on state change (not → fulfilled) */
      if (isFree && !wasFulfilled) {
        var icon = pw.querySelector('.progress-icon');
        var badge = pw.querySelector('.free-shipping-badge');
        if (icon) { icon.style.animation = 'none'; icon.offsetHeight; icon.style.animation = ''; }
        if (badge) { badge.style.animation = 'none'; badge.offsetHeight; badge.style.animation = ''; }
      }
    }

    /* -- Checkout total -- */
    var te = c.querySelector('#sub-total-mini');
    if (te) {
      te.dataset.total = totalCents;
      te.textContent = window.formatRp(total);
    }

    /* -- Shipping row: always visible -- */
    var shippingRow = c.querySelector('#cart-shipping-row');
    var sv = c.querySelector('#cart-shipping-value');
    if (sv) sv.textContent = isFree ? (i18n.shippingFree || 'FREE') : (i18n.shippingCalc || 'Calculated at checkout');
    if (shippingRow) shippingRow.classList.add('visible');

    /* -- Savings row: recalculate from DOM data attributes -- */
    window.recalcSavings();
  };

  /* ===== Qty change handler ===== */
  window.cartChangeQty = function(sel) {
    var key = sel.getAttribute('data-key') || sel.getAttribute('data-id');
    var qty = parseInt(sel.value);
    var row = sel.closest('.cart-item');

    window.cartShowLoading();

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      window.refreshCartUI(cart);
      window.syncFBTVisibility(cart);
      // If qty became 0 (shouldn't happen with select 1-10, but safety)
      if (qty === 0 && row) row.remove();
      if (cart.item_count === 0) window.location.reload();
      window.cartHideLoading();
    })
    .catch(function() { window.cartHideLoading(); });
  };

  /* ===== Remove item confirmation modal ===== */
  (function() {
    var _pendingBtn = null;
    var _closeTimer = null;
    var modal = document.getElementById('cart-remove-modal');
    var nameEl = document.getElementById('cart-remove-name');
    var cancelBtn = document.getElementById('cart-remove-cancel');
    var confirmBtn = document.getElementById('cart-remove-confirm');

    /* Move modal to <body> so it isn't affected by .mini-cart pointer-events
       or any stacking-context quirks of the cart drawer. */
    if (modal && modal.parentNode !== document.body) {
      document.body.appendChild(modal);
    }

    function openModal() {
      if (!modal) return;
      /* Cancel any pending close — prevents a stale timeout from hiding
         a freshly-opened modal when the user rapidly re-triggers remove. */
      if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
      modal.classList.add('active');
      /* Trigger reflow so the transition plays */
      void modal.offsetWidth;
      modal.classList.add('visible');
    }

    function closeModal() {
      if (!modal) return;
      if (_closeTimer) { clearTimeout(_closeTimer); _closeTimer = null; }
      modal.classList.remove('visible');
      /* Wait for the exit animation to finish, then hide */
      _closeTimer = setTimeout(function() {
        modal.classList.remove('active');
        _closeTimer = null;
      }, 250);
    }

    /* Show confirmation — called from trash button onclick */
    window.cartRemoveItem = function(btn) {
      _pendingBtn = btn;
      var row = btn.closest('.cart-item');
      var title = row ? (row.querySelector('.title') || {}).textContent : '';
      if (nameEl) nameEl.textContent = '"' + (title || 'this item').trim() + '"';
      openModal();
    };

    /* Cancel — close modal, do nothing */
    if (cancelBtn) {
      cancelBtn.addEventListener('click', function() {
        _pendingBtn = null;
        closeModal();
      });
    }

    /* Also close on backdrop click */
    if (modal) {
      modal.querySelector('.cart-remove-backdrop').addEventListener('click', function() {
        _pendingBtn = null;
        closeModal();
      });
    }

    /* Confirm — actually remove the item */
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function() {
        if (!_pendingBtn) return;
        var btn = _pendingBtn;
        _pendingBtn = null;
        closeModal();

        var key = btn.getAttribute('data-key');
        var row = btn.closest('.cart-item');

        /* Fade + shrink the row out */
        if (row) {
          row.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          row.style.opacity = '0';
          row.style.transform = 'scale(0.96)';
        }

        window.cartShowLoading();

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: key, quantity: 0 })
        })
        .then(function(r) { return r.json(); })
        .then(function(cart) {
          if (row) row.remove();
          window.refreshCartUI(cart);
          window.syncFBTVisibility(cart);
          if (cart.item_count === 0) window.location.reload();
          window.cartHideLoading();
        })
        .catch(function() {
          if (row) {
            row.style.opacity = '1';
            row.style.transform = '';
            row.style.transition = '';
          }
          window.cartHideLoading();
        });
      });
    }
  })();
</script>

<script>
  /* ===== Fetch compare_at_price via Section Rendering API ===== */
  /* Shopify cart context does NOT expose compare_at_price.        */
  /* Product page context DOES — so we fetch each product's       */
  /* variant-compare-data section to get the real values.         */
  window.loadCompareAtPrices = function() {
    var c = document.getElementById('cart');
    if (!c) return;

    var cartItems = c.querySelectorAll('.cart-item');
    if (!cartItems.length) return;

    /* Collect unique product handles from cart item links */
    var handleMap = {};
    cartItems.forEach(function(el) {
      var link = el.querySelector('a.thumb');
      if (!link) return;
      var href = link.getAttribute('href') || '';
      var match = href.match(/\/products\/([^?/#]+)/);
      if (match) {
        var handle = match[1];
        if (!handleMap[handle]) handleMap[handle] = [];
        handleMap[handle].push(el);
      }
    });

    var handles = Object.keys(handleMap);
    if (!handles.length) return;

    /* Fetch all products in parallel, then update DOM + savings */
    var fetches = handles.map(function(handle) {
      return fetch('/products/' + handle + '?section_id=variant-compare-data')
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var script = doc.querySelector('[data-variant-prices]');
          if (!script) return;
          var data;
          try { data = JSON.parse(script.textContent); } catch(e) { return; }
          if (!data || !data.variants) return;

          /* Build lookup: variantId → original_price (in IDR display units) */
          var lookup = {};
          data.variants.forEach(function(v) {
            var opSub = v.original_price * 100;
            if (opSub > 0 && opSub > v.price) {
              lookup[v.id] = { price: v.price, original_price: v.original_price, opSub: opSub };
            }
          });

          /* Update each matching cart-item element */
          handleMap[handle].forEach(function(el) {
            var vid = el.getAttribute('data-variant');
            if (!vid || !lookup[vid]) return;
            var v = lookup[vid];
            el.setAttribute('data-compare-at', v.opSub);

            /* Insert or update strikethrough price */
            var priceRow = el.querySelector('.price-row');
            if (!priceRow) return;
            var capSpan = priceRow.querySelector('.compare-at-price');
            var formatted = window.formatRp(v.original_price);
            if (capSpan) {
              capSpan.textContent = formatted;
            } else {
              capSpan = document.createElement('span');
              capSpan.className = 'price-wrapper compare-at-price';
              capSpan.textContent = formatted;
              priceRow.insertBefore(capSpan, priceRow.firstChild);
            }
          });
        })
        .catch(function(err) { console.warn('Original price fetch failed for', handle, err); });
    });

    /* After ALL fetches complete, recalculate total savings */
    Promise.all(fetches).then(function() {
      window.recalcSavings();
    });
  };

  /* ===== Fetch Judge.me ratings for FBT products ===== */
  window.loadFBTRatings = function() {
    var fbtCards = document.querySelectorAll('.fbt-card[data-handle]');
    if (!fbtCards.length) return;

    fbtCards.forEach(function(card) {
      var handle = card.getAttribute('data-handle');
      if (!handle) return;

      fetch('/products/' + handle + '?section_id=variant-compare-data')
        .then(function(r) { return r.text(); })
        .then(function(html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');

          /* Try to extract data-average-rating from Judge.me badge */
          var badge = doc.querySelector('[data-rating-badge]');
          if (!badge) return;

          var ratingEl = badge.querySelector('[data-average-rating]');
          var rating = ratingEl ? ratingEl.getAttribute('data-average-rating') : null;

          /* Fallback: try to extract from badge text content */
          if (!rating) {
            var text = badge.textContent || '';
            var match = text.match(/([\d.]+)\s*\/\s*5/);
            if (match) rating = match[1];
          }

          if (!rating || parseFloat(rating) <= 0) return;

          /* Update the FBT card rating display */
          var ratingWrap = card.querySelector('.fbt-rating');
          var ratingText = card.querySelector('.fbt-rating-text');
          if (ratingWrap && ratingText) {
            ratingText.textContent = rating + '/5';
            ratingWrap.style.display = '';
          }
        })
        .catch(function(err) { console.warn('FBT rating fetch failed for', handle, err); });
    });
  };

  /* ===== FBT Add-to-Cart: seamless in-place update ========================= */
  /* Capture-phase intercept blocks app.bundle.js (which does full innerHTML    */
  /* wipe → flash). Instead we surgically swap ONLY .cart-items & .cart-footer  */
  /* so the drawer, header, progress bar and FBT never disappear.              */
  /* After success the added card animates out and the next card slides in.     */
  (function() {
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.fbt-card-action');
      if (!btn || btn.classList.contains('is-loading') || btn.classList.contains('is-success')) return;

      var variant = btn.dataset.variant;
      if (!variant) return;

      /* Block app.bundle.js — its ajaxCart() does innerHTML='' then innerHTML=html */
      e.stopImmediatePropagation();
      e.preventDefault();

      var card = btn.closest('.fbt-card');

      /* — LOADING — */
      btn.classList.add('is-loading');

      /* 1. Add item to cart */
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(variant, 10), quantity: 1 }] })
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        /* 2. Fetch fresh cart HTML (respect locale prefix) */
        var prefix = (typeof Shopify !== 'undefined' && Shopify.locale === 'id') ? '/id/' : '/';
        return fetch(prefix + 'cart?view=mini').then(function(r) { return r.text(); });
      })
      .then(function(html) {
        var cartEl = document.getElementById('cart');
        if (!cartEl) return;

        /* Parse server response — extract only .cart-items and .cart-footer */
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var newItems = doc.querySelector('.cart-items');
        var newFooter = doc.querySelector('.sub-total.cart-footer');

        var oldItems = cartEl.querySelector('.cart-items');
        var oldFooter = cartEl.querySelector('.sub-total.cart-footer');

        /* 3. Crossfade cart-items only (drawer stays fully visible) */
        if (oldItems && newItems) {
          oldItems.style.transition = 'opacity 0.12s ease-out';
          oldItems.style.opacity = '0';

          setTimeout(function() {
            oldItems.innerHTML = newItems.innerHTML;
            oldItems.style.transition = 'opacity 0.18s ease-in';
            oldItems.style.opacity = '1';
            setTimeout(function() { oldItems.style.transition = ''; }, 200);
          }, 120);
        }

        /* 4. Swap footer (checkout btn, totals structure) */
        if (oldFooter && newFooter) {
          oldFooter.innerHTML = newFooter.innerHTML;
          /* Re-init trust slider after footer DOM swap */
          window.initCartTrustSlider();
        }

        /* 5. Fetch cart JSON → update progress bar, totals, shipping/savings rows */
        fetch('/cart.js').then(function(r) { return r.json(); }).then(function(cart) {
          window.refreshCartUI(cart);
          if (cart.item_count > 0) window.loadCompareAtPrices();
          var indicator = document.getElementById('cart-indicator');
          if (indicator) {
            if (cart.item_count > 0) indicator.classList.add('show');
            else indicator.classList.remove('show');
          }
        });

        /* 6. Button ✓ → card out → next card in (fast & snappy) */
        btn.classList.remove('is-loading');
        btn.classList.add('is-success');

        if (card) {
          setTimeout(function() {
            card.classList.add('fbt-card-exit');
            card.addEventListener('transitionend', function handler(ev) {
              if (ev.propertyName !== 'opacity') return;
              card.removeEventListener('transitionend', handler);
              card.style.display = 'none';
              card.classList.remove('is-success', 'fbt-card-exit');
              btn.classList.remove('is-success');
              /* Reset scroll so next visible card aligns to start */
              var track = card.closest('.fbt-track');
              if (track) track.scrollLeft = 0;
            });
          }, 500);
        }
      })
      .catch(function() {
        btn.classList.remove('is-loading');
      });
    }, true); /* ← capture phase: fires before app.bundle.js bubble-phase handler */
  })();
</script>

