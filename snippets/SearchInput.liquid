{%- comment -%}
  Search overlay — revamp premium 20 Agu 2026.

  KONTRAK app.bundle.js (kelas Search) — nama-nama ini WAJIB dipertahankan:
    .search-input-wrapper        wadah; bundle men-toggle .active dari .button-search
    .inner                       clickOutside terikat ke sini — semua isi harus di dalamnya
    .search-input#search-input   keyup (debounce 300ms) memicu fetch bundle; URL-nya
                                 ditulis ulang di sini ke /search/suggest (Predictive
                                 Search, tanpa match deskripsi) + section search-suggest
    [data-result]                nama kelas target hasil ("search-results")
    .search-results              bundle menulis innerHTML: "Searching...", kartu, atau
                                 "Error fetching results" — skrip di bawah menata ulang
                                 teks mentah itu jadi state premium TANPA mengubah bundle
    .button-search-close         tombol tutup; handler bundle membersihkan hasil di 500ms

  KONTRAK Header.liquid (skrip inline): #search-upsell-block disembunyikan saat mengetik,
  ditampilkan lagi saat input kosong — blok itu dihidupkan kembali di sini (dulu mati:
  assign upsell_collection tidak pernah dirender).

  Semua tambahan ter-scope .search-premium; motion = transform + opacity saja,
  stagger per grup ≤ 0.5s, tiga kepribadian easing (expo-out masuk, accelerate keluar,
  back-out untuk pop kecil), semuanya dimatikan di prefers-reduced-motion.
{%- endcomment -%}
<div class="search-input-wrapper search-premium"
  data-cs-capture
  data-t-searching="{{ 'search.searching' | t | escape }}"
  data-t-result="{{ 'search.result' | t | escape }}"
  data-t-results="{{ 'search.results' | t | escape }}"
  data-t-viewall="{{ 'search.view_all' | t | escape }}"
  data-t-nores="{{ 'search.no_results' | t | escape }}"
  data-t-noreshint="{{ 'search.no_results_hint' | t | escape }}"
  data-t-error="{{ 'search.error' | t | escape }}">
  <div class="inner">
    <div class="main-grid">
      <div class="input-container content">
        <div class="sp-eyebrow" aria-hidden="true">
          <span class="sp-eyebrow-rule"></span>
          {{ 'search.eyebrow' | t }}
        </div>

        <div class="button-colose button-search-close" role="button" tabindex="0" aria-label="{{ 'search.close' | t | escape }}">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1.26495L10.7351 0L6 4.73505L1.26495 0L0 1.26495L4.73505 6L0 10.7351L1.26495 12L6 7.26495L10.7351 12L12 10.7351L7.26495 6L12 1.26495Z" fill="#2B3C35" />
          </svg>
        </div>

        <div class="sp-input-row">
          {%- comment -%}
            Logomark moringa — di-trace langsung dari berkas logo referensi
            (potrace per komponen: batang+ranting dan 5 anak daun dipisah
            secara morfologis) sehingga siluetnya identik dengan aslinya,
            tapi tiap daun tetap simpul terpisah untuk animasi tumbuh.
          {%- endcomment -%}
          <svg class="sp-leaf" viewBox="91 97 759 759" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaf-stem" d="M467 826 c-26 -4 -57 -33 -75 -70 -13 -27 -21 -63 -18 -83 4 -29 22 -70 41 -96 6 -7 21 -25 31 -36 21 -22 19 -13 19 -75 0 -53 -1 -59 -3 -59 -2 0 -19 13 -21 16 -1 1 -2 6 -3 17 -1 16 -3 24 -9 42 -11 33 -24 46 -63 65 -25 12 -24 12 -37 15 -15 5 -37 5 -46 0 -15 -8 -24 -30 -22 -55 1 -11 6 -28 8 -31 1 -1 1 -2 1 -3 0 -3 12 -26 17 -31 12 -14 37 -26 65 -30 21 -4 30 -5 40 -3 4 1 10 1 14 2 3 1 10 2 14 3 19 3 34 -4 42 -20 2 -5 2 -5 2 -69 0 -60 0 -64 -2 -66 -2 -3 -8 -3 -17 1 -10 5 -14 10 -19 22 -5 9 -8 17 -17 31 -30 52 -65 68 -143 68 -30 0 -35 -1 -46 -5 -11 -5 -23 -18 -27 -29 -3 -11 -1 -37 3 -43 0 -1 1 -3 1 -4 2 -9 14 -28 25 -41 28 -34 53 -43 105 -38 30 2 45 7 80 27 19 10 20 10 26 10 10 -1 28 -13 30 -20 0 -2 0 -36 0 -75 l1 -71 5 -1 c6 0 6 0 6 22 0 12 0 41 1 65 1 49 0 47 9 50 30 12 34 12 47 4 33 -20 64 -29 102 -29 39 0 58 7 78 30 27 31 37 50 39 76 1 18 -4 32 -14 41 -16 15 -64 19 -110 9 -3 0 -8 -2 -12 -3 -11 -2 -21 -6 -29 -10 -21 -10 -50 -46 -60 -71 -8 -22 -15 -31 -30 -36 -9 -3 -15 -3 -17 -1 -2 2 -2 3 -2 59 0 32 0 59 1 62 0 4 8 12 18 19 10 6 11 6 49 7 36 0 39 0 59 5 11 4 32 13 38 16 15 11 23 20 29 34 10 22 13 31 12 56 0 18 0 19 -2 26 -11 28 -33 37 -65 26 -33 -11 -77 -39 -89 -57 -12 -18 -17 -38 -20 -73 -2 -24 -5 -30 -18 -36 -6 -3 -10 -4 -10 -1 -2 3 -1 129 1 134 1 6 4 10 11 15 17 12 28 25 42 49 33 54 38 67 41 94 4 37 -11 83 -38 115 -24 29 -47 42 -69 38z m27 -9 c25 -12 53 -47 66 -82 7 -19 9 -31 9 -50 0 -31 -4 -43 -40 -102 -13 -22 -23 -34 -36 -44 -3 -2 -7 -6 -9 -7 -4 -4 -19 -4 -21 -1 -1 1 -7 7 -13 14 -28 30 -39 45 -52 71 -8 17 -11 23 -17 47 -3 10 -3 31 -1 42 6 23 10 34 16 47 15 31 41 58 64 67 8 3 25 2 34 -2z m-169 -258 c2 -1 6 -3 8 -3 8 -3 42 -19 53 -26 21 -12 33 -30 43 -64 3 -11 5 -20 6 -33 0 -14 0 -14 -6 -14 -3 0 -9 -1 -13 -2 -4 0 -10 -2 -13 -2 -11 -2 -38 -2 -49 1 -30 6 -51 17 -63 30 -5 5 -17 28 -17 31 0 1 0 2 -1 3 -3 3 -7 21 -7 35 0 23 10 41 27 45 4 1 26 0 32 -1z m328 -14 c12 -6 19 -14 24 -27 2 -7 2 -9 2 -22 0 -21 -2 -32 -12 -52 -6 -14 -14 -23 -29 -34 -3 -2 -19 -9 -26 -12 -25 -9 -38 -10 -74 -9 l-27 0 0 18 c1 43 11 74 28 90 20 17 56 39 79 46 13 5 28 6 35 2z m-350 -170 c20 -3 33 -6 42 -9 30 -13 50 -34 71 -77 6 -11 6 -12 6 -20 0 -8 0 -8 -4 -9 -2 -1 -8 -4 -13 -8 -38 -20 -53 -25 -86 -27 -33 -2 -48 1 -68 14 -19 13 -41 41 -49 62 0 2 -2 5 -2 7 -12 29 2 58 34 67 10 3 51 3 69 0z m402 -17 c30 -7 41 -19 41 -45 0 -25 -10 -44 -38 -76 -17 -19 -29 -25 -54 -29 -36 -4 -77 4 -109 23 -11 6 -16 9 -18 9 -2 1 -2 2 -2 9 0 21 23 59 50 83 16 14 31 19 75 26 13 3 44 2 55 0z" fill="#6D715C" fill-rule="evenodd"/></g>
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaflet sp-lf1" d="M230 379 c-18 -5 -32 -17 -36 -32 -4 -10 -2 -33 2 -43 0 -2 2 -5 2 -7 8 -21 30 -49 49 -62 21 -14 39 -17 81 -14 28 2 45 8 81 27 5 4 11 7 13 8 4 1 4 1 4 13 0 13 0 13 -6 24 -35 69 -68 88 -155 88 -24 0 -30 0 -35 -2z" fill="#6D715C" fill-rule="evenodd"/></g>
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaflet sp-lf2" d="M646 362 c-44 -7 -59 -12 -75 -26 -21 -18 -37 -41 -46 -66 -4 -9 -4 -10 -4 -21 0 -11 0 -12 2 -13 2 0 7 -3 18 -9 27 -16 58 -24 93 -24 39 0 58 7 78 30 29 33 38 51 38 80 0 31 -9 42 -41 49 -12 2 -50 3 -63 0z" fill="#6D715C" fill-rule="evenodd"/></g>
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaflet sp-lf3" d="M289 564 c-11 -3 -20 -12 -25 -28 -5 -13 -1 -54 5 -60 1 -1 1 -2 1 -3 0 -3 12 -26 17 -31 12 -13 33 -24 63 -30 11 -3 46 -3 57 -1 3 0 9 2 13 2 4 1 10 2 13 2 6 0 6 0 6 18 -1 12 -2 20 -3 26 -9 39 -23 61 -46 75 -11 7 -45 23 -53 26 -2 0 -6 2 -8 3 -6 1 -35 3 -40 1z" fill="#6D715C" fill-rule="evenodd"/></g>
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaflet sp-lf4" d="M614 547 c-23 -7 -59 -29 -79 -46 -4 -4 -12 -16 -15 -22 -9 -19 -12 -39 -13 -72 l0 -22 29 0 c36 -1 47 0 68 5 11 4 32 13 38 16 15 11 23 20 29 34 10 22 13 31 12 56 0 18 0 19 -2 26 -6 13 -12 21 -24 27 -7 4 -29 3 -43 -2z" fill="#6D715C" fill-rule="evenodd"/></g>
            <g transform="translate(0.000000,936.000000) scale(1.000000,-1.000000)"><path class="sp-leaflet sp-lf5" d="M456 823 c-28 -11 -59 -49 -72 -86 -3 -9 -4 -13 -8 -28 -2 -11 -2 -40 1 -50 7 -24 9 -30 17 -47 13 -26 24 -41 52 -71 6 -7 12 -13 13 -14 1 -2 2 -2 14 -2 12 0 12 0 15 3 2 1 6 5 9 7 13 10 23 22 36 44 21 34 31 53 34 63 6 17 6 19 6 43 0 23 -1 34 -9 54 -13 35 -41 70 -66 82 -7 3 -8 4 -22 4 -13 0 -16 0 -20 -2z" fill="#6D715C" fill-rule="evenodd"/></g>
          </svg>
          <label class="sp-visually-hidden" for="search-input">{{ 'search.placeholder' | t }}</label>
          <input
            type="text"
            id="search-input"
            placeholder="{{ 'search.hint' | t | escape }}"
            class="search-input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            data-result="search-results">
          <button type="button" class="sp-clear" aria-label="{{ 'search.clear' | t | escape }}">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 1.26495L10.7351 0L6 4.73505L1.26495 0L0 1.26495L4.73505 6L0 10.7351L1.26495 12L6 7.26495L10.7351 12L12 10.7351L7.26495 6L12 1.26495Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
        <div class="sp-underline" aria-hidden="true">
          <i class="sp-underline-draw"></i>
          <i class="sp-underline-focus"></i>
          <i class="sp-underline-shimmer"></i>
        </div>

        <div class="sp-chips">
          <span class="sp-chips-label">{{ 'search.popular' | t }}</span>
          <button type="button" class="sp-chip" data-q="capsules" aria-pressed="false">Capsules</button>
          <button type="button" class="sp-chip" data-q="powder" aria-pressed="false">Powder</button>
          <button type="button" class="sp-chip" data-q="oil" aria-pressed="false">Oil</button>
          <button type="button" class="sp-chip" data-q="protocol" aria-pressed="false">Protocol</button>
          <button type="button" class="sp-chip" data-q="ritual set" aria-pressed="false">Ritual Set</button>
        </div>

        <div class="sp-status" aria-live="polite"></div>
      </div>

      <!--SP_UPSELL_START-->
      {%- assign upsell_collection = collections['highlighted-product'] -%}
      {%- if upsell_collection.products.size > 0 -%}
        <div id="search-upsell-block" class="content sp-upsell">
          <div class="sp-label">{{ 'search.featured' | t }}</div>
          <div class="sp-upsell-rail">
            {%- for p in upsell_collection.products limit: 4 -%}
              {%- if p.vendor == 'TEST' or p.tags contains 'lp-only' -%}{%- continue -%}{%- endif -%}
              <a class="sp-upsell-card" href="{{ p.url }}">
                <span class="sp-upsell-thumb">
                  {{- p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', alt: p.title -}}
                </span>
                <span class="sp-upsell-meta">
                  <span class="sp-upsell-title">{{ p.title }}</span>
                  <span class="sp-upsell-price">
                    {%- if p.price_varies %}{{ 'products.general.from' | t }} {% endif -%}
                    {{- p.price_min | money -}}
                  </span>
                </span>
                <svg class="sp-upsell-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 10L10 2M10 2H4M10 2V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      <!--SP_UPSELL_END-->

      <div class="search-results content"></div>
    </div>
  </div>
</div>

<style>
  /* ===== Search premium — semua ter-scope .search-premium ===== */
  .search-input-wrapper.search-premium {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    --sp-ink: #2B3C35;
    --sp-ink-70: rgba(43, 60, 53, 0.7);
    --sp-ink-45: rgba(43, 60, 53, 0.45);
    --sp-hair: rgba(43, 60, 53, 0.16);
    --sp-cream: #F8F8F2;
    --sp-sage: #A5BB87;
    --sp-olive: #6D715C;
    --sp-expo: cubic-bezier(0.16, 1, 0.3, 1);      /* masuk: decelerate panjang */
    --sp-accel: cubic-bezier(0.7, 0, 0.84, 0);      /* keluar: accelerate (doktrin drawer) */
    --sp-spring: cubic-bezier(0.34, 1.56, 0.64, 1); /* pop kecil: back-out */
    background: linear-gradient(rgba(24, 34, 29, 0.38), rgba(24, 34, 29, 0.28));
    -webkit-backdrop-filter: blur(16px) saturate(1.05);
    backdrop-filter: blur(16px) saturate(1.05);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .search-input-wrapper.search-premium { background: rgba(24, 34, 29, 0.55); }
  }
  html.sp-search-open { overflow: hidden; }

  /* Panel: tirai clip-path + settle turun; scroll internal, halaman tidak ikut */
  .search-input-wrapper.search-premium .inner {
    padding: 44px 0 40px;
    max-height: calc(100dvh - 95px);
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    border-bottom: 1px solid var(--sp-hair);
    box-shadow: 0 44px 90px -48px rgba(24, 34, 29, 0.5);
    clip-path: inset(0 0 100% 0);
    transform: translateY(-10px);
    transition: clip-path 0.34s var(--sp-accel) 0.04s, transform 0.34s var(--sp-accel) 0.04s;
  }
  .search-input-wrapper.search-premium.active .inner {
    clip-path: inset(0 0 0% 0);
    transform: translateY(0);
    transition: clip-path 0.52s var(--cb), transform 0.52s var(--cb);
  }

  /* ===== Beat masuk: anak-anak panel (transition + delay bertingkat) ===== */
  .search-input-wrapper.search-premium .sp-eyebrow,
  .search-input-wrapper.search-premium .sp-input-row,
  .search-input-wrapper.search-premium .sp-chips,
  .search-input-wrapper.search-premium .sp-status,
  .search-input-wrapper.search-premium .sp-upsell,
  .search-input-wrapper.search-premium .button-search-close {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.24s var(--sp-accel), transform 0.24s var(--sp-accel);
  }
  .search-input-wrapper.search-premium.active .sp-eyebrow,
  .search-input-wrapper.search-premium.active .sp-input-row,
  .search-input-wrapper.search-premium.active .sp-chips,
  .search-input-wrapper.search-premium.active .sp-status,
  .search-input-wrapper.search-premium.active .sp-upsell,
  .search-input-wrapper.search-premium.active .button-search-close {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.5s var(--sp-expo), transform 0.5s var(--sp-expo);
  }
  .search-input-wrapper.search-premium.active .sp-eyebrow { transition-delay: 0.1s; }
  .search-input-wrapper.search-premium.active .sp-input-row { transition-delay: 0.16s; }
  .search-input-wrapper.search-premium.active .sp-chips { transition-delay: 0.24s; }
  .search-input-wrapper.search-premium.active .sp-status { transition-delay: 0.28s; }
  .search-input-wrapper.search-premium.active .sp-upsell { transition-delay: 0.3s; }
  .search-input-wrapper.search-premium.active .button-search-close { transition-delay: 0.2s; }

  /* Chip individual: menyusul berurutan di dalam beat chips */
  .search-input-wrapper.search-premium .sp-chip {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s var(--sp-accel), transform 0.2s var(--sp-accel),
                background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .search-input-wrapper.search-premium.active .sp-chip {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.42s var(--sp-expo), transform 0.42s var(--sp-expo),
                background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .search-input-wrapper.search-premium.active .sp-chip:nth-of-type(1) { transition-delay: 0.26s; }
  .search-input-wrapper.search-premium.active .sp-chip:nth-of-type(2) { transition-delay: 0.32s; }
  .search-input-wrapper.search-premium.active .sp-chip:nth-of-type(3) { transition-delay: 0.38s; }
  .search-input-wrapper.search-premium.active .sp-chip:nth-of-type(4) { transition-delay: 0.44s; }
  .search-input-wrapper.search-premium.active .sp-chip:nth-of-type(5) { transition-delay: 0.5s; }

  /* Kartu rail unggulan menyusul */
  .search-input-wrapper.search-premium .sp-upsell-card {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.2s var(--sp-accel), transform 0.2s var(--sp-accel);
  }
  .search-input-wrapper.search-premium.active .sp-upsell-card {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.46s var(--sp-expo), transform 0.46s var(--sp-expo);
  }
  .search-input-wrapper.search-premium.active .sp-upsell-card:nth-of-type(1) { transition-delay: 0.34s; }
  .search-input-wrapper.search-premium.active .sp-upsell-card:nth-of-type(2) { transition-delay: 0.41s; }
  .search-input-wrapper.search-premium.active .sp-upsell-card:nth-of-type(3) { transition-delay: 0.48s; }
  .search-input-wrapper.search-premium.active .sp-upsell-card:nth-of-type(4) { transition-delay: 0.55s; }

  /* ===== Eyebrow ===== */
  .search-input-wrapper.search-premium .sp-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sp-ink-70);
    margin-bottom: 22px;
  }
  .search-input-wrapper.search-premium .sp-eyebrow-rule {
    width: 28px;
    height: 1px;
    background: var(--sp-sage);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.2s var(--sp-accel);
  }
  .search-input-wrapper.search-premium.active .sp-eyebrow-rule {
    transform: scaleX(1);
    transition: transform 0.6s var(--sp-expo) 0.18s;
  }

  /* ===== Baris input ===== */
  .search-input-wrapper.search-premium .sp-input-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .search-input-wrapper.search-premium .sp-leaf {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    transform: rotate(0deg);
    transition: transform 0.5s var(--sp-expo);
  }
  .search-input-wrapper.search-premium .sp-leaf-stem {
    transform-box: fill-box;
    /* ruang lokal potrace terbalik Y — origin 0% = pangkal visual */
    transform-origin: 50% 0%;
    opacity: 0;
    transform: scaleY(0.15);
    transition: opacity 0.18s var(--sp-accel), transform 0.18s var(--sp-accel), fill 0.3s ease;
  }
  .search-input-wrapper.search-premium.active .sp-leaf-stem {
    opacity: 1;
    transform: scaleY(1);
    transition: opacity 0.45s var(--sp-expo) 0.16s, transform 0.6s var(--sp-expo) 0.16s, fill 0.3s ease;
  }
  /* Anak daun tumbuh dari titik tempelnya. Kelas animasi ada di PATH (tanpa
     atribut transform sendiri — transform potrace ada di <g> induk), jadi
     CSS transform tidak menimpa apa pun. */
  .search-input-wrapper.search-premium .sp-leaflet {
    transform-box: fill-box;
    opacity: 0;
    transform: scale(0.25);
    transition: opacity 0.18s var(--sp-accel), transform 0.18s var(--sp-accel), fill 0.3s ease;
  }
  .search-input-wrapper.search-premium .sp-lf1 { transform-origin: 88% 82%; }
  .search-input-wrapper.search-premium .sp-lf2 { transform-origin: 12% 82%; }
  .search-input-wrapper.search-premium .sp-lf3 { transform-origin: 88% 20%; }
  .search-input-wrapper.search-premium .sp-lf4 { transform-origin: 12% 20%; }
  .search-input-wrapper.search-premium .sp-lf5 { transform-origin: 50% 6%; }
  .search-input-wrapper.search-premium.active .sp-leaflet {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.4s var(--sp-expo), transform 0.42s var(--sp-spring), fill 0.3s ease;
  }
  .search-input-wrapper.search-premium.active .sp-lf1 { transition-delay: 0.3s; }
  .search-input-wrapper.search-premium.active .sp-lf2 { transition-delay: 0.35s; }
  .search-input-wrapper.search-premium.active .sp-lf3 { transition-delay: 0.4s; }
  .search-input-wrapper.search-premium.active .sp-lf4 { transition-delay: 0.45s; }
  .search-input-wrapper.search-premium.active .sp-lf5 { transition-delay: 0.52s; }
  .search-input-wrapper.search-premium.is-focus .sp-leaf { transform: rotate(-9deg); }
  .search-input-wrapper.search-premium.is-focus .sp-leaflet,
  .search-input-wrapper.search-premium.is-focus .sp-leaf-stem { fill: var(--sp-ink); }

  .search-input-wrapper.search-premium .inner .content input.search-input {
    border: 0;
    border-bottom: 0;
    height: auto;
    padding: 6px 0 14px;
    font-size: clamp(26px, 3.2vw, 38px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--sp-ink);
    caret-color: var(--sp-ink);
    background: transparent;
    flex: 1 1 auto;
    min-width: 0;
    outline: none;
  }
  .search-input-wrapper.search-premium .inner .content input.search-input::placeholder {
    color: var(--sp-ink-45);
    transition: opacity 0.3s ease;
  }
  .search-input-wrapper.search-premium.is-focus .inner .content input.search-input::placeholder { opacity: 0.55; }
  .search-input-wrapper.search-premium .inner .content input.search-input::selection {
    background: rgba(165, 187, 135, 0.45);
  }

  /* Tombol clear: pop back-out saat ada isi */
  .search-input-wrapper.search-premium .sp-clear {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
