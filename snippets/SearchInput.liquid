<script>
  /* Search premium — pendamping kelas Search milik app.bundle.js.
     Tidak menggantikan satu pun perilaku bundle; hanya menambah state di
     sekelilingnya. Idempoten, semua elemen di-guard, tanpa global bocor. */
  (function () {
    var wrap = document.querySelector('.search-input-wrapper.search-premium');
    if (!wrap || wrap.dataset.spInit) return;
    wrap.dataset.spInit = '1';

    var input = wrap.querySelector('#search-input');
    var results = wrap.querySelector('.search-results');
    var status = wrap.querySelector('.sp-status');
    var clearBtn = wrap.querySelector('.sp-clear');
    var closeBtn = wrap.querySelector('.button-search-close');
    var upsell = wrap.querySelector('#search-upsell-block');
    if (!input || !results) return;

    var T = {
      searching: wrap.getAttribute('data-t-searching') || 'Searching…',
      result: wrap.getAttribute('data-t-result') || 'result for',
      results: wrap.getAttribute('data-t-results') || 'results for',
      viewall: wrap.getAttribute('data-t-viewall') || 'See all results',
      nores: wrap.getAttribute('data-t-nores') || 'Nothing found for',
      noreshint: wrap.getAttribute('data-t-noreshint') || '',
      error: wrap.getAttribute('data-t-error') || 'Search failed — please try again.'
    };
    var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

    /* ---- alihkan fetch bundle ke Predictive Search ----
       Akar bug "powder memunculkan Capsules": /search?view=card adalah
       full-text search yang ikut mencocokkan DESKRIPSI produk. Predictive
       Search API mencocokkan field default title, product_type,
       variants.title, vendor — tanpa body — jadi URL milik bundle ditulis
       ulang ke /search/suggest + section SearchSuggest, yang membalas dengan
       wrapper #search-results yang sama sehingga parseData bundle tidak
       melihat perbedaan apa pun. limit 8 (bukan 4) memberi ruang untuk
       baris lp-only yang dibuang section sebelum render. */
    if (!window.__spSuggestHook) {
      window.__spSuggestHook = true;
      var prevFetch = window.fetch;
      window.fetch = function (u, o) {
        try {
          if (typeof u === 'string' && u.indexOf('view=card') !== -1) {
            var qi = u.indexOf('search?q=');
            if (qi !== -1) {
              var q = u.slice(qi + 9).split('&')[0];
              u = root + 'search/suggest?q=' + q +
                '&resources[type]=product&resources[limit]=8' +
                '&resources[options][unavailable_products]=last' +
                '&section_id=search-suggest';
            }
          }
        } catch (e) { /* biarkan URL asli */ }
        return prevFetch.call(this, u, o);
      };
    }
    var esc = function (s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    };

    /* ---- state kelas kecil ---- */
    var setHasValue = function () {
      wrap.classList.toggle('has-value', input.value.trim().length > 0);
      syncChips();
    };
    /* Chip "terpilih" mengikuti ISI QUERY, bukan hover/fokus — tanpa ini chip
       yang kebetulan di-hover tampak terpilih padahal query-nya lain. */
    var chipEls = wrap.querySelectorAll('.sp-chip');
    function syncChips() {
      var q = input.value.trim().toLowerCase();
      chipEls.forEach(function (c) {
        var on = !!q && (c.getAttribute('data-q') || '').toLowerCase() === q;
        c.classList.toggle('sp-chip--on', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    input.addEventListener('focus', function () { wrap.classList.add('is-focus'); });
    input.addEventListener('blur', function () { wrap.classList.remove('is-focus'); });
    input.addEventListener('input', function () {
      setHasValue();
      if (!input.value.trim()) {
        wrap.classList.remove('is-searching');
        if (status) status.textContent = '';
      }
    });

    /* ---- interpretasi isi .search-results (ditulis bundle via innerHTML) ---- */
    var skelTTL = null;
    var clearTTLTimer = function () { if (skelTTL) { clearTimeout(skelTTL); skelTTL = null; } };
    var showSkeletons = function () {
      var one = '<div class="sp-skel" aria-hidden="true"><span class="sp-skel-thumb"></span><span class="sp-skel-line w1"></span><span class="sp-skel-line w2"></span></div>';
      results.innerHTML = one + one + one + one;
    };
    var showState = function (title, hint) {
      results.innerHTML =
        '<div class="sp-state" role="status"><span class="sp-state-rule"></span>' +
        '<span class="sp-state-title">' + title + '</span>' +
        (hint ? '<span class="sp-state-hint">' + hint + '</span>' : '') +
        '</div>';
    };
    var showError = function () {
      wrap.classList.remove('is-searching');
      clearTTLTimer();
      if (status) status.textContent = '';
      showState(esc(T.error), '');
    };

    var interpret = function () {
      /* Tulisan milik sendiri: jangan ditafsirkan ulang (hindari loop observer). */
      if (results.querySelector('.sp-skel, .sp-state')) return;

      var text = (results.textContent || '').trim();
      var cards = results.querySelectorAll('.card');

      if (!results.firstChild) {
        /* Bundle mengosongkan target saat respons tak memuat #search-results
           (mis. section 404) ATAU saat pembersihan tutup — dua-duanya terminal,
           status "Searching..." tidak boleh tertinggal menggantung. */
        wrap.classList.remove('is-searching');
        clearTTLTimer();
        if (status) status.textContent = '';
        return;
      }
      if (cards.length > 0) {
        wrap.classList.remove('is-searching');
        clearTTLTimer();
        var q = input.value.trim();
        if (status) {
          status.innerHTML =
            cards.length + ' ' + esc(cards.length === 1 ? T.result : T.results) +
            ' <q>' + esc(q) + '</q>' +
            '<a class="sp-viewall" href="' + esc(root) + 'search?q=' + encodeURIComponent(q) + '">' +
            esc(T.viewall) + ' →</a>';
        }
        return;
      }
      if (text === 'Searching...') {
        wrap.classList.add('is-searching');
        if (status) status.textContent = T.searching;
        showSkeletons();
        clearTTLTimer();
        skelTTL = setTimeout(showError, 8000); /* jaring pengaman: fetch menggantung */
        return;
      }
      if (text === 'Error fetching results') {
        showError();
        return;
      }
      if (text.indexOf('No results!') !== -1) {
        wrap.classList.remove('is-searching');
        clearTTLTimer();
        if (status) status.textContent = '';
        showState(
          esc(T.nores) + ' <q>' + esc(input.value.trim()) + '</q>',
          esc(T.noreshint)
        );
        return;
      }
    };
    new MutationObserver(interpret).observe(results, { childList: true });

    /* ---- buka / tutup (kelas .active milik bundle; kami hanya bereaksi) ---- */
    var wasActive = wrap.classList.contains('active');
    var cleanupTimer = null;
    var onOpen = function () {
      if (cleanupTimer) { clearTimeout(cleanupTimer); cleanupTimer = null; }
      document.documentElement.classList.add('sp-search-open');
      setTimeout(function () {
        if (wrap.classList.contains('active')) {
          try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
        }
      }, 340);
    };
    var onClose = function () {
      document.documentElement.classList.remove('sp-search-open');
      wrap.classList.remove('is-searching');
      clearTTLTimer();
      try { input.blur(); } catch (e) { /* abaikan */ }
      /* Selaras dengan pembersihan hasil milik bundle di 500ms: kosongkan input
         dan pulihkan rail supaya pembukaan berikutnya mulai dari keadaan murni
         (sebelumnya teks lama menempel — state basi terasa seperti bug). */
      cleanupTimer = setTimeout(function () {
        cleanupTimer = null;
        if (wrap.classList.contains('active')) return;
        input.value = '';
        setHasValue();
        if (status) status.textContent = '';
        if (upsell) upsell.style.display = '';
      }, 520);
    };
    var syncButtons = function (open) {
      document.querySelectorAll('.button-search').forEach(function (b) {
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    };
    var lastCloseAt = 0;
    new MutationObserver(function () {
      var active = wrap.classList.contains('active');
      if (active === wasActive) return;
      wasActive = active;
      if (!active) lastCloseAt = Date.now();
      syncButtons(active);
      if (active) onOpen(); else onClose();
    }).observe(wrap, { attributes: true, attributeFilter: ['class'] });
    syncButtons(wasActive);

    /* Jendela basi bundle: setelah tutup, flag internal inputOpened miliknya
       baru direset 500ms kemudian, jadi klik BUKA di jendela itu langsung
       ditutup lagi oleh clickOutside-nya (tombol header memang di luar .inner)
       — di produksi terasa sebagai "harus klik dua kali". Klik buka di jendela
       itu dihentikan propagasinya ke document supaya clickOutside tidak
       melihatnya; handler toggle bundle di elemen yang sama tetap jalan.
       Di luar jendela 600ms ini propagasi normal — perilaku overlay lain
       (mis. tutup-di-luar milik cart) tidak berubah. */
    document.querySelectorAll('.button-search').forEach(function (b) {
      b.addEventListener('click', function (e) {
        if (!wrap.classList.contains('active') && (Date.now() - lastCloseAt) < 600) {
          e.stopPropagation();
        }
      });
    });

    /* ---- chip: isi nilai lalu pinjam pipeline bundle (keyup debounce) ---- */
    wrap.querySelectorAll('.sp-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        input.value = chip.getAttribute('data-q') || chip.textContent.trim();
        setHasValue();
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('keyup', { bubbles: true }));
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
      });
    });

    /* ---- clear ---- */
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        input.value = '';
        input.dispatchEvent(new Event('input', { bubbles: true })); /* skrip Header memulihkan rail + mengosongkan hasil */
        try { input.focus({ preventScroll: true }); } catch (e) { input.focus(); }
      });
    }

    /* ---- keyboard ---- */
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        var q = input.value.trim();
        if (q) window.location.href = root + 'search?q=' + encodeURIComponent(q);
      } else if (e.key === 'ArrowDown') {
        var first = results.querySelector('a[href]') || wrap.querySelector('.sp-chip');
        if (first) { e.preventDefault(); first.focus(); }
      }
    });
    /* Tombol tutup punya role=button — layani Enter/Spasi (handler klik tetap milik bundle). */
    if (closeBtn) {
      closeBtn.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); closeBtn.click(); }
      });
    }
    document.addEventListener('keydown', function (e) {
      var active = wrap.classList.contains('active');
      if (e.key === 'Escape' && active) {
        if (closeBtn) closeBtn.click(); /* jalur tutup resmi milik bundle */
        return;
      }
      var t = e.target;
      var typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
      var comboK = (e.metaKey || e.ctrlKey) && !e.shiftKey && !e.altKey && (e.key === 'k' || e.key === 'K');
      var slash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey;
      if (!active && (comboK || (slash && !typing))) {
        var opener = document.querySelector('.button-search');
        if (opener) { e.preventDefault(); opener.click(); }
      }
    });
  })();
</script>
