{% doc %}
  Kartu kode diskon yang bisa disalin sekali ketuk.

  Semua teks diterima SUDAH diterjemahkan oleh pemanggil (`... | t`), supaya
  kunci locale-nya tetap terlihat statis oleh gerbang QA i18n.

  Aksesibilitas (checklist ui-ux-pro-max):
  - `<button>` beneran, bukan div — jadi bisa di-Tab dan ditekan Enter/Space.
  - Target sentuh minimal 44px sungguhan, bukan hanya di kanvas desain.
  - `:focus-visible` punya cincin fokus sendiri, tidak dihapus tanpa ganti.
  - Status hasil salin diumumkan lewat `role="status"` (aria-live polite), dan
    tingginya dikunci supaya teksnya berubah tanpa menggeser layout.
  - Warna bukan satu-satunya penanda: ikon berubah jadi centang DAN teks status
    berubah.

  Gerak: port dari rule `press-release-spring` (HyperFrames) ke CSS —
  tekan = kompresi linear cepat, lepas = pegas `back.out` dengan overshoot,
  ditambah burst ring di belakang chip saat berhasil. Hanya `transform` dan
  `opacity` yang dianimasikan (tidak pernah width/height/top/left), dan semua
  gerak mati di `prefers-reduced-motion`.

  @param {string} code - kode diskon, mis. "HARGATETAP"
  @param {string} aria - label tombol untuk screen reader
  @param {string} hint - status awal, mis. "Ketuk untuk menyalin"
  @param {string} copied - status setelah berhasil
  @param {string} manual - status kalau clipboard ditolak peramban

  @example
  {% render 'og-copy-code', code: code, aria: aria, hint: hint, copied: copied, manual: manual %}
{% enddoc %}

<copy-code
  class="og-copy"
  data-code="{{ code | escape }}"
  data-hint="{{ hint | escape }}"
  data-copied="{{ copied | escape }}"
  data-manual="{{ manual | escape }}"
>
  <button type="button" class="og-copy__btn" aria-label="{{ aria }}">
    <span class="og-copy__burst" aria-hidden="true"></span>
    <span class="og-copy__value">{{ code }}</span>
    <span class="og-copy__icon" aria-hidden="true">
      <svg class="og-copy__glyph og-copy__glyph--copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="12" height="12" rx="2.5"></rect>
        <path d="M6 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V6"></path>
      </svg>
      <svg class="og-copy__glyph og-copy__glyph--check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path class="og-copy__tick" d="M4.5 12.5 9.5 17.5 19.5 6.5"></path>
      </svg>
    </span>
  </button>

  <p class="og-copy__status" role="status" aria-live="polite">{{ hint }}</p>
</copy-code>

{% style %}
  .og-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .og-copy__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: calc(28 * var(--og-u));
    box-sizing: border-box;
    /* target sentuh nyata >= 44px, bukan cuma 44 satuan kanvas */
    min-height: max(44px, calc(104 * var(--og-u)));
    padding: calc(22 * var(--og-u)) calc(48 * var(--og-u));
    border: max(1.5px, calc(3 * var(--og-u))) solid var(--og-ink);
    border-radius: calc(24 * var(--og-u));
    background: #ffffff;
    color: var(--og-ink);
    font-family: var(--og-font);
    font-size: var(--og-fs-lead);
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* lepas = pegas back.out(1.7); ditimpa jadi kompresi linear saat :active */
    transition:
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .og-copy__btn:hover {
    background: var(--og-cream);
  }

  .og-copy__btn:focus-visible {
    outline: max(2px, calc(4 * var(--og-u))) solid var(--og-accent);
    outline-offset: calc(6 * var(--og-u));
  }

  .og-copy__btn:active {
    transform: scale(0.965);
    transition-duration: 90ms;
    transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
  }

  .og-copy.is-copied .og-copy__btn {
    background: color-mix(in srgb, var(--og-accent) 26%, #ffffff);
    border-color: var(--og-accent);
  }

  .og-copy__value {
    letter-spacing: 0.05em;
  }

  /* burst ring di BELAKANG chip, footprint sama, hanya transform + opacity */
  .og-copy__burst {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--og-accent);
    opacity: 0;
    transform: scale(1);
  }

  .og-copy.is-copied .og-copy__burst {
    animation: og-copy-burst 560ms cubic-bezier(0.22, 1, 0.36, 1) 1;
  }

  @keyframes og-copy-burst {
    0% { opacity: 0.45; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.22); }
  }

  .og-copy__icon {
    position: relative;
    display: inline-flex;
    width: calc(44 * var(--og-u));
    height: calc(44 * var(--og-u));
    flex: none;
  }

  .og-copy__glyph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition:
      opacity 180ms ease,
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .og-copy__glyph--check {
    opacity: 0;
    transform: scale(0.4);
    color: #2f6b3f;
  }

  .og-copy.is-copied .og-copy__glyph--copy {
    opacity: 0;
    transform: scale(0.6);
  }

  .og-copy.is-copied .og-copy__glyph--check {
    opacity: 1;
    transform: scale(1);
  }

  /* centang digambar, bukan muncul begitu saja */
  .og-copy__tick {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
  }

  .og-copy.is-copied .og-copy__tick {
    animation: og-copy-tick 320ms cubic-bezier(0.65, 0, 0.35, 1) 90ms forwards;
  }

  @keyframes og-copy-tick {
    to { stroke-dashoffset: 0; }
  }

  /* tinggi dikunci: teks status berganti tanpa menggeser apa pun di bawahnya */
  .og-copy__status {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(64 * var(--og-u));
    margin: 0;
    font-size: var(--og-fs-small);
    font-weight: 400;
    line-height: 1.3;
    color: color-mix(in srgb, var(--og-ink) 65%, transparent);
    transition: color 200ms ease;
  }

  .og-copy.is-copied .og-copy__status {
    color: #2f6b3f;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .og-copy__btn,
    .og-copy__glyph,
    .og-copy__status {
      transition: none;
    }

    .og-copy.is-copied .og-copy__burst,
    .og-copy.is-copied .og-copy__tick {
      animation: none;
    }

    .og-copy__tick {
      stroke-dashoffset: 0;
    }
  }
{% endstyle %}

<script>
  if (!customElements.get('copy-code')) {
    customElements.define(
      'copy-code',
      class extends HTMLElement {
        connectedCallback() {
          this.btn = this.querySelector('.og-copy__btn');
          this.status = this.querySelector('.og-copy__status');
          if (!this.btn || !this.status) return;
          this.btn.addEventListener('click', () => this.copy());
        }

        disconnectedCallback() {
          clearTimeout(this.timer);
        }

        async copy() {
          var code = this.dataset.code || '';
          var ok = false;
          try {
            await navigator.clipboard.writeText(code);
            ok = true;
          } catch (e) {
            /* clipboard API ditolak (izin, konteks tidak aman, peramban lama) */
            ok = this.legacyCopy(code);
          }
          this.report(ok);
        }

        legacyCopy(code) {
          var ta = document.createElement('textarea');
          ta.value = code;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '0';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try {
            ok = document.execCommand('copy');
          } catch (e) {
            ok = false;
          }
          document.body.removeChild(ta);
          return ok;
        }

        report(ok) {
          this.classList.remove('is-copied');
          if (ok) {
            /* reflow sekali supaya animasi burst/centang bisa diputar ulang */
            void this.offsetWidth;
            this.classList.add('is-copied');
          }
          this.status.textContent = ok ? this.dataset.copied : this.dataset.manual;
          clearTimeout(this.timer);
          this.timer = setTimeout(() => {
            this.classList.remove('is-copied');
            this.status.textContent = this.dataset.hint;
          }, 2800);
        }
      }
    );
  }
</script>
