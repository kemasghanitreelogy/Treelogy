{% doc %}
  Cart drawer v3 (Figma: Treelogy Development 2026 · Cart v3, node 2558:553).
  Server-rendered from the cart on every change — shared by the initial
  drawer (snippets/CartDrawer) and templates/cart.mini.liquid, which
  cart-drawer-v3.js re-fetches after each mutation. No price is ever
  computed in JavaScript. Arm B of the cart-drawer A/B test; arm A is the
  untouched snippets/CartDrawerContent (see snippets/cart-drawer-arm).

  Layout: header (title, free-shipping progress) and checkout dock are
  fixed; items, offer, summary, reassurance and add-on scroll between them.

  @example
  {% render 'CartDrawerV3Content' %}
{% enddoc -%}
{%- liquid
  assign paid_units = 0
  for item in cart.items
    assign is_gift = false
    if item.final_line_price == 0
      if item.properties['_Gifted'] != blank or item.line_level_discount_allocations.size > 0
        assign is_gift = true
      endif
    endif
    unless is_gift
      assign paid_units = paid_units | plus: item.quantity
    endunless
  endfor

  assign show_ship = false
  if localization.market.handle == 'id' and paid_units > 0
    assign show_ship = true
    assign fs_min = settings.min_shipping | default: 700000 | times: 100
    assign fs_left = fs_min | minus: cart.items_subtotal_price
    assign fs_pct = cart.items_subtotal_price | times: 100 | divided_by: fs_min | at_most: 100
  endif
-%}
<div class="cv3" data-cv3 data-item-count="{{ cart.item_count }}" data-total="{{ cart.total_price }}">
  <header class="cv3-head">
    <div class="cv3-head__row">
      <h2 class="cv3-head__title">
        {{- 'cart_v3.title' | t -}}
        {%- if paid_units > 0 %}
          <span class="cv3-head__count">{{ 'cart_v3.count' | t: count: paid_units }}</span>
        {%- endif -%}
      </h2>
      <button type="button" class="cv3-close" data-cv3-close aria-label="{{ 'cart_v3.close' | t }}">×</button>
    </div>
    {%- if show_ship -%}
      <p class="cv3-head__ship">
        {%- if fs_left > 0 -%}
          {%- capture fs_amount -%}{% render 'cart-v3-money', amount: fs_left %}{%- endcapture -%}
          {{- 'cart_v3.ship_remaining' | t: amount: fs_amount -}}
        {%- else -%}
          {{- 'cart_v3.ship_free' | t -}}
        {%- endif -%}
      </p>
      <div
        class="cv3-progress"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="{{ fs_pct }}"
        aria-label="{{ 'cart_v3.ship_progress' | t }}"
      >
        <span class="cv3-progress__fill" style="width: {{ fs_pct }}%"></span>
      </div>
    {%- endif -%}
  </header>

  {%- if paid_units == 0 -%}
    <div class="cv3-empty">
      <p class="cv3-empty__title">{{ 'cart.empty_title' | t }}</p>
      <p class="cv3-empty__sub">{{ 'cart.empty_subtitle' | t }}</p>
      <a class="cv3-cta" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}</a>
    </div>
  {%- else -%}
    <div class="cv3-scroll">
      <div class="cv3-items">
        {%- for item in cart.items -%}
          {%- liquid
            if item.final_line_price == 0
              if item.properties['_Gifted'] != blank or item.line_level_discount_allocations.size > 0
                continue
              endif
            endif
            assign pack = nil
            for p in metaobjects.cart_pack.values
              if p.variant.value.id == item.variant_id
                assign pack = p
                break
              endif
            endfor
          -%}
          {%- render 'cart-v3-line', item: item, pack: pack -%}
        {%- endfor -%}
      </div>
      {%- render 'cart-v3-offer', slot: 'offer' -%}
      {%- render 'cart-v3-summary' -%}
      {%- render 'cart-v3-reassurance' -%}
      {%- render 'cart-v3-offer', slot: 'addon' -%}
    </div>

    <form class="cv3-dock" action="{{ routes.cart_url }}" method="post" novalidate>
      <button type="submit" name="checkout" id="cart-checkout-btn" class="cv3-checkout">
        {%- capture total_amount -%}<span data-cv3-roll="checkout">{% render 'cart-v3-money', amount: cart.total_price %}</span>{%- endcapture -%}
        <span class="cv3-checkout__label">{{- 'cart_v3.checkout_html' | t: amount: total_amount -}}</span>
      </button>
      <img
        class="cv3-payments"
        src="{{ 'cart-v3-payments.svg' | asset_url }}"
        width="284"
        height="28"
        alt="{{ 'cart_v3.payments_alt' | t | escape }}"
        loading="lazy"
      >
      <p class="cv3-status" data-cv3-status role="status" aria-live="polite"></p>
    </form>

    {%- for item in cart.items -%}
      {%- if item.product.variants.size > 1 and item.final_line_price > 0 -%}
        {%- liquid
          assign unit = blank
          for p in metaobjects.cart_pack.values
            if p.variant.value.id == item.variant_id
              assign unit = p.unit.value
              break
            endif
          endfor
        -%}
        {%- render 'cart-v3-sheet', item: item, unit: unit -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>
