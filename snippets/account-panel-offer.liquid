{% doc %}
  Kartu penawaran kapsul di panel akun, untuk pelanggan yang BELUM pernah order
  (menggantikan empty state). Dirender di dalam sections/account-panel.liquid,
  jadi ikut diambil lewat Section Rendering API; interaksinya (pilih paket,
  rotasi ulasan, tambah ke keranjang) dijalankan snippets/account-panel-shell.liquid.

  Sumber isi — semuanya data yang SUDAH tayang di PDP, tidak ada klaim baru:
  - hook  = metafield pdp3.hero_heading (headline PDP, terjemahan ID via metafield)
  - badge = registrasi BPOM obat tradisional (locale pdp3.why.*)
  - ulasan = metafield pdp3.reviews (testimoni PDP, terjemahan ID via metafield)
  - paket = metafield varian pdp3.pack_image / pdp3.description / pdp3.badge
  - rating = metafield standar reviews.rating / reviews.rating_count (Judge.me)
  Label "Favorit pembeli baru" di varian pertama: data order 1 Sep–30 Okt 2026,
  pembeli pertama paling banyak memilih 90 kapsul (406 baris vs 335 & 185).

  @param {product} product - Produk kapsul

  @example
  {% render 'account-panel-offer', product: all_products['organic-moringa-capsules'] %}
{% enddoc %}

{%- liquid
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value
  assign rating_txt = rating | round: 2 | append: ''
  if request.locale.iso_code == 'id'
    assign rating_txt = rating_txt | replace: '.', ','
  endif
  assign star_pct = rating | times: 20
  assign is_id_market = false
  if localization.country.iso_code == 'ID'
    assign is_id_market = true
  endif

  assign selected = product.selected_or_first_available_variant
  for v in product.variants
    if v.available and v.metafields.pdp3.set_default.value == true
      assign selected = v
    endif
  endfor
  assign reviews = product.metafields.pdp3.reviews.value
-%}

<div class="aco acp-in" style="--d:1" data-aco>
  <p class="aco__eyebrow">{{ 'customer.panel.offer_eyebrow' | t }}</p>

  <article class="aco__card">
    <a class="aco__top" href="{{ product.url }}">
      <span class="aco__thumb">
        {%- comment -%}
          Foto banner Shop the Look (tanpa teks tertanam), di-zoom ke kaleng kapsul.
          Foto media produk semuanya bertulisan; pack_image varian cuma 248px.
        {%- endcomment -%}
        {%- assign hero = images['treelogy-organic-moringa-oil-and-capsules-product-set.png'] -%}
        {%- if hero != blank -%}
          {{ hero | image_url: width: 900 | image_tag: widths: '600, 900', sizes: '200px', loading: 'lazy', decoding: 'async', alt: '', class: 'aco__hero' }}
        {%- else -%}
          {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', class: 'aco__hero aco__hero--plain' }}
        {%- endif -%}
      </span>
      <span class="aco__info">
        <span class="aco__hook">{{ product.metafields.pdp3.hero_heading | default: product.title }}</span>
        <span class="aco__meta">
          {%- if rating_count > 0 -%}
            <span class="aco__star" aria-hidden="true">★</span> {{ rating_txt }} · {{ 'customer.panel.offer_reviews' | t: count: rating_count }} ·
          {% endif -%}
          BPOM
        </span>
      </span>
    </a>

    {%- if reviews != blank -%}
      <div class="aco__reviews" data-aco-reviews aria-label="{{ 'customer.panel.offer_reviews_label' | t | escape }}">
        {%- assign shown = 0 -%}
        {%- for r in reviews -%}
          {%- comment -%} Testimoni berkonteks penyakit (kemoterapi) tidak dipasang di panel seluruh situs. {%- endcomment -%}
          {%- if r.quote contains 'chemo' or r.quote contains 'kemo' -%}{%- continue -%}{%- endif -%}
          <figure class="aco__quote" data-aco-quote {% if shown > 0 %}hidden{% endif %}>
            <blockquote>“{{ r.quote | escape }}”</blockquote>
            <figcaption>{{ r.name | escape }}</figcaption>
          </figure>
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="aco__plans" role="radiogroup" aria-label="{{ 'customer.panel.offer_choose' | t | escape }}">
      {%- for v in product.variants -%}
        {%- liquid
          assign plan = v.metafields.custom.staged_plan_label | default: v.title
          assign is_on = false
          if v.id == selected.id
            assign is_on = true
          endif
        -%}
        <button
          type="button" role="radio" class="aco__plan"
          aria-checked="{{ is_on }}"
          {% unless v.available %}disabled{% endunless %}
          data-aco-plan="{{ v.id }}"
          data-aco-price="{{ v.price | money | escape }}"
        >
          {%- if v.metafields.pdp3.badge != blank -%}<span class="aco__dot" title="{{ 'customer.panel.offer_most_chosen' | t | escape }}"></span>{%- endif -%}
          {{ plan }}
        </button>
      {%- endfor -%}
    </div>

    {%- for v in product.variants -%}
      {%- liquid
        assign desc_lines = v.metafields.pdp3.description.value | default: v.metafields.pdp3.description | newline_to_br | split: '<br />'
        assign caps = v.title | split: ' ' | first | plus: 0
        assign per_day = 0
        if caps > 0
          assign per_day = v.price | times: 3 | divided_by: caps
        endif
      -%}
      <ul class="aco__perks" data-aco-perks="{{ v.id }}" {% unless v.id == selected.id %}hidden{% endunless %}>
        {%- if v.metafields.pdp3.badge != blank -%}
          <li class="aco__perk--hot">{{ 'customer.panel.offer_most_chosen' | t }}</li>
        {%- elsif forloop.first -%}
          <li class="aco__perk--hot">{{ 'customer.panel.offer_first_pick' | t }}</li>
        {%- endif -%}
        {%- if per_day > 0 -%}
          {%- assign per_day_money = per_day | money -%}
          <li>{{ 'customer.panel.offer_per_day' | t: price: per_day_money }}</li>
        {%- endif -%}
        {%- if v.compare_at_price > v.price -%}
          {%- assign save = v.compare_at_price | minus: v.price | money -%}
          <li class="aco__perk--save">{{ 'customer.panel.offer_save' | t: amount: save }}</li>
        {%- endif -%}
        {%- for line in desc_lines offset: 1 -%}
          {%- assign parts = line | strip_html | strip | split: '|' -%}
          {%- assign flag = parts[2] | strip -%}
          {%- if parts[0] == blank -%}{%- continue -%}{%- endif -%}
          {%- comment -%} Ruas |ship = gratis ongkir, hanya benar di market id. {%- endcomment -%}
          {%- if flag == 'ship' and is_id_market == false -%}{%- continue -%}{%- endif -%}
          <li>{{ parts[0] | strip }}</li>
        {%- endfor -%}
      </ul>
    {%- endfor -%}

    <button
      type="button"
      class="acp-btn acp-btn--block aco__cta"
      data-acp-add='[{"id":{{ selected.id }},"quantity":1}]'
      data-acp-offer
      data-acp-name="{{ product.title | escape }}"
    >
      <span class="acp-btn__label">{{ 'customer.panel.offer_add' | t }}</span>
      <span class="aco__cta-price" data-aco-cta-price>{{ selected.price | money }}</span>
    </button>
  </article>

  <style>
    .aco{display:grid;gap:8px}
    .aco__eyebrow{font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
    .aco__card{display:grid;gap:10px;padding:12px;border-radius:16px;background:var(--surface);border:1px solid var(--line)}

    .acp-root a.aco__top{display:grid;grid-template-columns:48px minmax(0,1fr);gap:11px;align-items:center;text-decoration:none}
    .aco__thumb{position:relative;width:48px;height:48px;border-radius:10px;overflow:hidden;background:linear-gradient(180deg,#d6d5d2,#e3e3e4)}
    .acp-root .aco__hero{position:absolute;inset:0;transform-origin:79% 64%;transform:scale(2.1);animation:aco-kb 1.6s var(--ease) both}
    .acp-root .aco__hero--plain{transform:none;animation:none}
    @keyframes aco-kb{from{transform:scale(2.3);opacity:0}to{transform:scale(2.1);opacity:1}}
    .aco__info{display:grid;gap:2px;min-width:0}
    .aco__hook{font-size:14px;line-height:1.3;font-weight:600;letter-spacing:-.01em;text-wrap:balance}
    .aco__top:hover .aco__hook{text-decoration:underline;text-underline-offset:3px;text-decoration-color:rgba(42,59,52,.35)}
    .aco__meta{font-size:11px;font-weight:500;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .aco__star{color:var(--ink)}

    .aco__reviews{display:grid}
    .aco__quote{grid-area:1/1;margin:0;display:flex;gap:6px;align-items:baseline;min-width:0}
    .aco__quote[hidden]{display:flex;visibility:hidden;opacity:0}
    .aco__quote[data-in]{animation:aco-q-in .45s var(--ease) both}
    @keyframes aco-q-in{from{opacity:0;transform:translateY(4px)}}
    .aco__quote blockquote{margin:0;padding:0;border:0;flex:1;min-width:0;font-size:12px;font-style:italic;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .aco__quote figcaption{flex:none;font-size:11px;color:var(--muted)}
    .aco__quote figcaption::before{content:"— "}

    .aco__plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3px;padding:3px;border-radius:11px;background:#eff0eb}
    .aco__plan{all:unset;box-sizing:border-box;cursor:pointer;position:relative;display:flex;align-items:center;justify-content:center;gap:5px;min-height:34px;padding:0 6px;border-radius:8px;font-size:12.5px;font-weight:600;color:var(--muted);white-space:nowrap;transition:background .2s,color .2s,box-shadow .2s}
    .aco__plan:hover{color:var(--ink)}
    .aco__plan:focus-visible{outline:2px solid var(--ink);outline-offset:1px}
    .aco__plan[aria-checked="true"]{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(42,59,52,.18)}
    .aco__plan[disabled]{opacity:.45;cursor:not-allowed}
    .aco__dot{width:5px;height:5px;border-radius:50%;background:#7d9a55}

    .aco__perks{display:flex;flex-wrap:wrap;gap:2px 10px;font-size:11px;font-weight:500;color:var(--muted);margin-top:-2px!important}
    .aco__perks[hidden]{display:none}
    .aco__perks[data-in]{animation:acp-rise .3s var(--ease) both}
    .aco__perks .aco__perk--hot{color:#5f7a3f;font-weight:600}
    .aco__perks .aco__perk--save{color:var(--ink);font-weight:600}

    .aco__cta{justify-content:space-between;min-height:42px!important;border-radius:11px!important;padding:0 14px!important}
    .aco__cta:active{transform:scale(.985)}
    .aco__cta-price{font-weight:600;opacity:.9}
    .aco__cta[aria-busy="true"]{opacity:.7;pointer-events:none}

    @media (prefers-reduced-motion:reduce){
      .aco__quote[data-in],.aco__perks[data-in],.acp-root .aco__hero{animation:none}
    }
  </style>
</div>
