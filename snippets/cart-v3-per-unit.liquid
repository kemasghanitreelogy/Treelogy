{% doc %}
  Price per unit of a pack ("Rp13.250 a day", "Rp9.500 a serving",
  "About Rp13.200 per ml"). IDR is rounded to the nearest Rp100, the same
  rounding as everywhere else (snippets/cart-v3-rate). Outputs nothing when
  the pack has no unit data.

  @param {number} price - Price in the currency subunit
  @param {metaobject} pack - cart_pack entry of the variant

  @example
  {% render 'cart-v3-per-unit', price: variant.price, pack: pack %}
{% enddoc -%}
{%- liquid
  assign cv3_units = pack.units.value | default: 0
  assign cv3_unit = pack.unit.value
  if cv3_units > 0 and cv3_unit != blank
    capture cv3_amount
      render 'cart-v3-rate', amount: price, units: cv3_units
    endcapture
    case cv3_unit
      when 'day'
        echo 'cart_v3.per_day' | t: amount: cv3_amount
      when 'serving'
        echo 'cart_v3.per_serving' | t: amount: cv3_amount
      when 'ml'
        echo 'cart_v3.per_ml' | t: amount: cv3_amount
    endcase
  endif
-%}
