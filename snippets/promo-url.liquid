{% doc %}
  Promo kampanye iklan (mis. Meta Ads 11.11) yang hanya tampil bila URL memuat
  kata kunci dari setelan tema "Promo URL", contoh ?utm_campaign=promo-1111.

  Markup promo dirender server tapi disembunyikan CSS. Slot `gate` memasang
  skrip inline sinkron SEBELUM judul dilukis: bila URL cocok (atau pernah cocok
  dalam 24 jam terakhir, disimpan di localStorage) ia memasang kelas `tl-promo-url` di <html>. Tanpa request
  tambahan, tanpa kedip, tanpa geser tata letak, dan cache halaman tetap jalan
  karena Liquid tidak membaca query string.

  Kapsul: badge judul + badge kartu paket terbesar; slot `global` (semua
  halaman, dari snippets/gift-auto-add.liquid) menukar hadiah paket itu jadi
  hadiah promo dan menandai baris kapsul `_Promo: 11.11`.
  Inside Out: PDP aslinya dialihkan ke produk promo (setelan
  promo_url_bundle_promo, vendor "11.11 Promo", varian 60ml) yang selalu
  menampilkan badge + teks 30ml → 60ml.

  @param {string} slot - 'global' | 'gate' | 'title' | 'card' | 'perk'
  @param {object} [product] - Produk yang dirender (default: produk halaman)
  @param {string} [heading_html] - Markup H1 yang dibungkus (slot 'title')
  @param {string} [text] - Teks baris manfaat kartu varian (slot 'perk')

  @example
  {% render 'promo-url', slot: 'global' %}
  {% render 'promo-url', slot: 'gate' %}
  {% render 'promo-url', slot: 'title', heading_html: h1_markup %}
  {% render 'promo-url', slot: 'card' %}
  {% render 'promo-url', slot: 'perk', product: product, text: perk_text %}
{% enddoc %}

{%- capture p11_detect -%}
  (function (k, m, e) {
    try {
      var s = localStorage, now = Date.now();
      if (e && !(Date.parse(e) > now)) return s.removeItem(k);
      var q = decodeURIComponent(location.search).toLowerCase();
      if (m.some(function (w) { return w && q.indexOf(w) > -1; })) s.setItem(k, now + 864e5);
      if (+s.getItem(k) > now) document.documentElement.classList.add('tl-promo-url');
      else s.removeItem(k);
    } catch (x) {}
  })('tl_promo_url', {{ settings.promo_url_match | downcase | remove: ' ' | split: ',' | json }}, {{ settings.promo_url_ends | strip | json }});
{%- endcapture -%}

{%- if slot == 'global' -%}
  {%- if settings.promo_url_enable -%}
    {%- liquid
      assign p11_gift_id = 'null'
      if settings.promo_url_gift != blank
        assign p11_gift_id = settings.promo_url_gift.variants.first.id
      endif
      assign p11_mark_ids = '[]'
      assign p11_swap_id = 'null'
      if settings.promo_url_capsule != blank
        assign p11_mark_ids = settings.promo_url_capsule.variants | map: 'id' | json
        assign p11_cap = settings.promo_url_capsule.variants | sort: 'price' | last
        assign p11_swap_id = p11_cap.id
      endif
    -%}
    <script>
      {{ p11_detect }}
      (function (g, v) {
        var el = document.querySelector('[data-gift-map]');
        if (!g || !v || !el || !document.documentElement.classList.contains('tl-promo-url')) return;
        try {
          var map = JSON.parse(el.textContent);
          map[v] = [g];
          el.textContent = JSON.stringify(map);
        } catch (e) {}
      })({{ p11_gift_id }}, {{ p11_swap_id }});

      /* Tiap baris kapsul yang ditambahkan selama promo aktif
         diberi properti tersembunyi `_Promo: 11.11` (muncul per produk di
         order admin, seperti `_Gifted`). Terpasang SEBELUM assets/gift-auto-add.js
         (defer), jadi engine hadiah membungkus di luar: hadiah ditumpangkan
         dulu, lalu hanya baris kapsul yang ditandai. */
      (function (ids, key, value) {
        var nativeFetch = window.fetch;
        if (!nativeFetch || !ids.length) return;
        var isPromo = function (id) { return ids.indexOf(Number(id)) > -1; };
        window.fetch = function (input, init) {
          try {
            var url = String(typeof input === 'string' ? input : (input && input.url) || '').split('?')[0];
            var body = init && init.body;
            if (body && /\/cart\/add(\.js)?$/.test(url) && document.documentElement.classList.contains('tl-promo-url')) {
              if (typeof body === 'string' && body.charAt(0) === '{') {
                var json = JSON.parse(body), hit = false;
                (json.items || [json]).forEach(function (item) {
                  if (!item || !isPromo(item.id)) return;
                  item.properties = item.properties || {};
                  item.properties[key] = value;
                  hit = true;
                });
                if (hit) init = Object.assign({}, init, { body: JSON.stringify(json) });
              } else if (body instanceof FormData && isPromo(body.get('id')) && !body.has('properties[' + key + ']')) {
                body.append('properties[' + key + ']', value);
              }
            }
          } catch (e) {}
          return nativeFetch.call(this, input, init);
        };
      })({{ p11_mark_ids }}, '_Promo', '11.11');
    </script>
  {%- endif -%}
{%- else -%}

{%- liquid
  assign p11_kind = ''
  if settings.promo_url_enable and product != blank
    if product.id == settings.promo_url_capsule.id
      assign p11_kind = 'capsule'
    elsif product.id == settings.promo_url_bundle_promo.id
      assign p11_kind = 'bundle'
    elsif product.id == settings.promo_url_bundle.id and settings.promo_url_bundle_promo != blank
      assign p11_kind = 'redirect'
    endif
  endif
  assign p11_value = ''
  if p11_kind == 'capsule' and slot == 'title' or p11_kind == 'capsule' and slot == 'card'
    assign p11_price = settings.promo_url_oil.variants.first.price
    if p11_price and cart.currency.iso_code == 'IDR'
      assign p11_value = p11_price | money_without_currency | replace: ',', '.'
    elsif p11_price
      assign p11_value = p11_price | money
    endif
  endif
-%}

{%- if p11_kind == 'redirect' and slot == 'gate' -%}
  {%- comment -%}
    PDP Inside Out ASLI: saat promo aktif (URL cocok / flag 24 jam), pembeli
    langsung dipindah ke PDP promo (vendor "11.11 Promo", varian 60ml) —
    halaman disembunyikan dulu supaya tidak sempat terlihat. Query & bahasa ikut.
  {%- endcomment -%}
  {%- liquid
    assign p11_root = routes.root_url
    if p11_root == '/'
      assign p11_root = ''
    endif
    assign p11_target = p11_root | append: '/products/' | append: settings.promo_url_bundle_promo.handle
  -%}
  <script>
    {{ p11_detect }}
    if (document.documentElement.classList.contains('tl-promo-url')) {
      document.documentElement.style.visibility = 'hidden';
      location.replace({{ p11_target | json }} + location.search + location.hash);
    }
  </script>
{%- elsif p11_kind == blank or p11_kind == 'redirect' -%}
  {%- if slot == 'title' -%}{{ heading_html }}{%- elsif slot == 'perk' -%}{{ text | escape }}{%- endif -%}
{%- else -%}
{%- case slot -%}
  {%- when 'gate' -%}
    <style>
      .tl-p11-badge,.tl-p11-card{display:none}
      .tl-p11-head{display:flow-root;--tl-p11-mt:0px}
      .tl-p11-badge{--d:82px;--f:10px;--l:11px}
      .tl-p11-badge{float:right;width:var(--d);height:var(--d);margin:calc(var(--tl-p11-mt) + 2.5px) 0 4px 8px;padding:0;border-radius:50%;background:#f5d053;color:#213d29;align-items:center;justify-content:center;text-align:center;font:500 var(--f)/var(--l) Inter,var(--font-body-family,sans-serif);letter-spacing:-.07px;text-transform:none;shape-outside:circle(50%);shape-margin:4px;pointer-events:none}
      .tl-p11-badge > span{display:block;text-box:trim-both cap alphabetic}
      .tl-p11-head .tl-p11-badge--bundle{transform:translateY(-15px)}
      .tl-promo-url #product-detail-content:has(.tl-p11-badge--bundle) > .rating{padding-right:98px}
      .tl-p11-card{position:absolute;inset:0;pointer-events:none}
      .tl-p11-card .tl-p11-badge{position:absolute;right:calc(65px - var(--d) / 2);bottom:59px;z-index:0;margin:0}
      .tl-p11-oil{position:absolute;right:-11px;bottom:0;z-index:2;width:38px;height:auto;max-width:none}
      .tl-p11-perk mark{background:#f5d053;color:#213d29;border-radius:999px;padding:0 5px}
      .tl-promo-url .tl-p11-badge{display:flex}
      .tl-promo-url .tl-p11-card{display:block}
      .tl-promo-url .pdp-pack__vis:has(> .tl-p11-card){position:relative}
      .tl-promo-url .pdp-pack__vis:has(> .tl-p11-card) > .pdp-gift{visibility:hidden}
      .tl-promo-url .pdp-pack__vis:has(> .tl-p11-card) > .pdp-tins{position:relative;z-index:1}
      .tl-promo-url .pdp-pack:has(.tl-p11-card) > .pdp-pack__top{position:relative;z-index:3}
      @media (max-width:959px){
        .pdp4-page.p5 .tl-p11-head{--tl-p11-mt:17px}
        .tl-p11-head .tl-p11-badge{--d:clamp(82px,21.026vw,94px);--f:clamp(10px,2.564vw,11.46px);--l:clamp(11px,2.821vw,12.6px)}
        .tl-p11-card .tl-p11-badge{--d:clamp(82px,25.309cqi,94px);--f:clamp(10px,3.086cqi,11.46px);--l:clamp(11px,3.395cqi,12.6px)}
      }
    </style>
    <script>
      {%- if p11_kind == 'bundle' -%}
        document.documentElement.classList.add('tl-promo-url');
      {%- else -%}
        {{ p11_detect }}
      {%- endif -%}
    </script>

  {%- when 'title' -%}
    <div class="tl-p11-head">
      <p class="tl-p11-badge tl-p11-badge--{{ p11_kind }}"><span>
        {%- if p11_kind == 'capsule' -%}
          {{- 'promo_url.title_capsule_html' | t: value: p11_value -}}
        {%- else -%}
          {{- 'promo_url.title_bundle_html' | t -}}
        {%- endif -%}
      </span></p>
      {{- heading_html -}}
    </div>

  {%- when 'card' -%}
    {%- if p11_kind == 'capsule' -%}
      <span class="tl-p11-card">
        <span class="tl-p11-badge"><span>{{ 'promo_url.card_capsule_html' | t: value: p11_value }}</span></span>
        <img class="tl-p11-oil" src="{{ 'promo-1111-oil-30ml.webp' | asset_url }}" alt="" loading="lazy" width="38" height="94">
      </span>
    {%- endif -%}

  {%- when 'perk' -%}
    {%- liquid
      assign p11_text = text | escape
      assign p11_find = 'promo_url.perk_find' | t
      if p11_kind == 'bundle' and text contains p11_find
        assign p11_swap = 'promo_url.perk_html' | t
        echo '<span class="tl-p11-perk">' | append: p11_text | replace: p11_find, p11_swap | append: '</span>'
      else
        echo p11_text
      endif
    -%}
{%- endcase -%}
{%- endif -%}
{%- endif -%}
