        @keyframes utmPulse {
          0%, 100% { opacity: 1; transform: scale(1); }
          50% { opacity: 0.5; transform: scale(0.85); }
        }

        .utm-toast__body {
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 13px;
          color: #2B3C35;
          line-height: 1.4;
          opacity: 0;
          transform: scale(0.96);
          transition:
            opacity 200ms ease-out,
            transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        #utm-toast.active .utm-toast__body {
          opacity: 1;
          transform: scale(1);
          transition-delay: 260ms;
        }
        .utm-toast__body p { margin: 0; }
        .utm-toast__body strong { font-weight: 900; }

        .utm-toast__close {
          position: absolute;
          top: 11px;
          right: 13px;
          width: 32px;
          height: 32px;
          display: flex;
          align-items: center;
          justify-content: center;
          background: transparent;
          border: 0;
          border-radius: 16px;
          cursor: pointer;
          padding: 0;
          pointer-events: none;
          transition: background 150ms ease;
          z-index: 2;
        }
        #utm-toast.active .utm-toast__close { pointer-events: auto; }
        .utm-toast__close:hover,
        .utm-toast__close:focus-visible {
          background: rgba(86, 115, 79, 0.08);
          outline: none;
        }

        .utm-toast__claim {
          position: relative;
          display: flex;
          align-items: center;
          justify-content: center;
          width: 100%;
          height: 48px;
          background: #56734F;
          color: #ffffff;
          border: 0;
          border-radius: 12px;
          font-family: 'Inter', sans-serif;
          font-weight: 700;
          font-size: 14px;
          letter-spacing: 0.3px;
          cursor: pointer;
          pointer-events: none;
          box-shadow: 0 6px 16px -6px rgba(86, 115, 79, 0.6);
          overflow: hidden;
          opacity: 0;
          transform: translateY(6px);
          transition:
            opacity 220ms ease-out,
            transform 220ms ease-out,
            background 200ms ease,
            box-shadow 200ms ease;
        }
        #utm-toast.active .utm-toast__claim {
          opacity: 1;
          transform: translateY(0);
          pointer-events: auto;
          transition-delay: 580ms;
        }
        .utm-toast__claim:hover,
        .utm-toast__claim:focus-visible {
          background: #455e41;
          outline: none;
          box-shadow: 0 10px 24px -8px rgba(86, 115, 79, 0.7);
        }
        .utm-toast__claim:active {
          transform: translateY(1px);
        }
        .utm-toast__claim-idle,
        .utm-toast__claim-success {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          transition: opacity 200ms ease, transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .utm-toast__claim-success {
          position: absolute;
          inset: 0;
          justify-content: center;
          opacity: 0;
          transform: scale(0.6);
        }
        .utm-toast__claim-success .utm-toast__claim-check path {
          stroke-dasharray: 30;
          stroke-dashoffset: 30;
        }
        .utm-toast__claim.is-claimed {
          background: #56734F;
          pointer-events: none;
          animation: utmClaimPulse 450ms ease-out;
        }
        .utm-toast__claim.is-claimed .utm-toast__claim-idle {
          opacity: 0;
          transform: scale(0.8);
        }
        .utm-toast__claim.is-claimed .utm-toast__claim-success {
          opacity: 1;
          transform: scale(1);
          transition-delay: 120ms;
        }
        .utm-toast__claim.is-claimed .utm-toast__claim-check path {
          animation: utmDrawCheck 380ms ease-out 220ms forwards;
        }
        @keyframes utmClaimPulse {
          0%   { transform: scale(1); box-shadow: 0 6px 16px -6px rgba(86, 115, 79, 0.6); }
          40%  { transform: scale(1.04); box-shadow: 0 0 0 10px rgba(86, 115, 79, 0.25), 0 6px 16px -6px rgba(86, 115, 79, 0.6); }
          100% { transform: scale(1); box-shadow: 0 6px 16px -6px rgba(86, 115, 79, 0.6); }
        }
        @keyframes utmDrawCheck {
          to { stroke-dashoffset: 0; }
        }

        .utm-toast__bonus {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 8px 14px;
          background: rgba(86, 115, 79, 0.08);
          border-radius: 999px;
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 13px;
          color: #2B3C35;
          opacity: 0;
          transform: translateY(4px);
          transition:
            opacity 200ms ease-out,
            transform 200ms ease-out;
        }
        .utm-toast__bonus strong {
          font-weight: 700;
          color: #56734F;
        }
        #utm-toast.active .utm-toast__bonus {
          opacity: 1;
          transform: translateY(0);
          transition-delay: 460ms;
        }

        .utm-toast__confirm {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 6px;
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 11px;
          color: #6b7c6b;
          opacity: 0;
          transition: opacity 220ms ease-out;
        }
        #utm-toast.active .utm-toast__confirm { opacity: 1; transition-delay: 580ms; }
        .utm-toast__check path {
          stroke-dasharray: 30;
          stroke-dashoffset: 30;
          transition: stroke-dashoffset 280ms ease-out;
        }
        #utm-toast.active .utm-toast__check path { stroke-dashoffset: 0; transition-delay: 620ms; }

        @media (max-width: 480px) {
          .utm-toast__card { padding: 24px 22px 18px; max-width: 320px; border-radius: 20px; }
          .utm-toast__body { font-size: 12.5px; }
          .utm-toast__bonus { font-size: 12px; padding: 7px 12px; }
          .utm-toast__claim { height: 46px; font-size: 13.5px; }
        }

        @media (prefers-reduced-motion: reduce) {
          .utm-toast__overlay,
          .utm-toast__card,
          .utm-toast__body,
          .utm-toast__bonus,
          .utm-toast__claim,
          .utm-toast__claim-idle,
          .utm-toast__claim-success,
          .utm-toast__confirm,
          .utm-toast__check path {
            transition: opacity 180ms ease !important;
            transition-delay: 0ms !important;
          }
          .utm-toast__card,
          .utm-toast__body,
          .utm-toast__bonus,
          .utm-toast__claim,
          .utm-toast__claim-success { transform: none !important; }
          .utm-toast__claim.is-claimed { animation: none; }
          .utm-toast__claim.is-claimed .utm-toast__claim-check path { animation: none; stroke-dashoffset: 0; }
          .utm-toast__kicker-dot { animation: none; opacity: 1; }
        }
      </style>

      <script>
            (function() {
              var TOAST_COOLDOWN_MS = 10 * 60 * 1000; // 10 minutes

              // URL gate: current URL must carry a utm_source that matches an active rule
              var params = new URLSearchParams(window.location.search);
              var urlUtm = params.get('utm_source');
              if (!urlUtm) return;

              // Campaign gate: if eligible list is configured, utm_campaign must be in it
              var eligibleRaw = {{ settings.utm_free_shipping_eligible_campaigns | default: '' | json }};
              var eligibleCampaigns = (eligibleRaw || '')
                .split(',')
                .map(function(s) { return s.trim().toLowerCase(); })
                .filter(Boolean);
              if (eligibleCampaigns.length) {
                var urlCampaignLc = (params.get('utm_campaign') || '').toLowerCase();
                if (!urlCampaignLc || eligibleCampaigns.indexOf(urlCampaignLc) === -1) return;
              }

              var urlCampaign = params.get('utm_campaign') || '';
              var rule = typeof window.__findUtmRule === 'function'
                ? window.__findUtmRule(urlUtm, urlCampaign)
                : null;
              if (!rule || !rule.discountCode) return;

              // Cooldown gate: skip if toast was shown within the last 10 minutes
              try {
                var shownAt = parseInt(sessionStorage.getItem('utm_toast_shown_ts') || '0', 10);
                if (shownAt && (Date.now() - shownAt) < TOAST_COOLDOWN_MS) return;
              } catch (e) {}

              document.addEventListener('DOMContentLoaded', function() {
                var toast = document.getElementById('utm-toast');
                if (!toast) return;

                // Inject dynamic discount label from metafield. Strip trailing " OFF" and
                // normalize "Rp100" → "Rp 100" so inline display matches Figma.
                var labelEl = document.getElementById('utm-toast__discount-label');
                if (labelEl && rule.discountLabel) {
                  var clean = String(rule.discountLabel)
                    .replace(/\s*OFF\s*$/i, '')
                    .replace(/^Rp(?=\d)/i, 'Rp ')
                    .trim();
                  labelEl.textContent = clean;
                }

                try { sessionStorage.setItem('utm_toast_shown_ts', String(Date.now())); } catch (e) {}

                function onKey(e) {
                  if (e.key === 'Escape') dismiss();
                }
                function dismiss() {
                  toast.classList.remove('active');
                  document.removeEventListener('keydown', onKey);
                  setTimeout(function() { if (toast.parentNode) toast.remove(); }, 260);
                }
                document.addEventListener('keydown', onKey);

                // Close button
                var closeBtn = toast.querySelector('.utm-toast__close');
                if (closeBtn) closeBtn.addEventListener('click', dismiss);

                // Claim flow — manual action for psychological ownership
                var claimBtn = document.getElementById('utm-toast__claim');
                if (claimBtn) {
                  claimBtn.addEventListener('click', function() {
                    if (claimBtn.classList.contains('is-claimed')) return;
                    claimBtn.classList.add('is-claimed');
                    claimBtn.setAttribute('aria-label', 'Diskon terklaim');
                    try { sessionStorage.setItem('utm_toast_claimed', '1'); } catch (e) {}
                    // Hold the "Terklaim!" celebration, then exit
                    setTimeout(dismiss, 1500);
                  });
                }

                // Enter (snappy) — no auto-dismiss, user must claim or close
                toast.removeAttribute('hidden');
                setTimeout(function() { toast.classList.add('active'); }, 80);
              });
            })();
      </script>
    {%- endif -%}

