    {% assign utm_rules = shop.metafields['custom']['utm_rules'].value %}
    <script>
          (function() {
      var UTM_FREE_SHIP_TTL = 15 * 60 * 1000; // 15 minutes

      // Global helper: check if utm_free_shipping is still valid (15-min TTL)
      window.isUtmFreeShipping = function() {
        var ts = parseInt(sessionStorage.getItem('utm_free_shipping_ts') || '0', 10);
        if (ts && (Date.now() - ts) < UTM_FREE_SHIP_TTL) return true;
        sessionStorage.removeItem('utm_free_shipping_ts');
        return false;
      };

      try {
        var rules = {% if utm_rules %}{{ utm_rules | json }}{% else %}[]{% endif %};
        window.__utmRules = rules;

        // Match rule on (utmSource, utmCampaign). Prefer exact campaign match;
        // fall back to a rule with empty / "*" utmCampaign (default for that source).
        window.__findUtmRule = function(source, campaign) {
          if (!source) return null;
          campaign = campaign || '';
          var exact = rules.find(function(r) {
            return r.isActive && r.utmSource === source && (r.utmCampaign || '') === campaign;
          });
          if (exact) return exact;
          return rules.find(function(r) {
            return r.isActive && r.utmSource === source && (!r.utmCampaign || r.utmCampaign === '*');
          }) || null;
        };

        var params = new URLSearchParams(window.location.search);
        var utm = params.get('utm_source');
        var campaign = params.get('utm_campaign');
        if (utm) sessionStorage.setItem('utm_source', utm);
        if (campaign) sessionStorage.setItem('utm_campaign', campaign);
        var savedSource = sessionStorage.getItem('utm_source');
        var savedCampaign = sessionStorage.getItem('utm_campaign') || '';
        if (savedSource) {
          var rule = window.__findUtmRule(savedSource, savedCampaign);
          if (rule && rule.discountCode) {
            sessionStorage.setItem('utm_free_shipping_ts', String(Date.now()));
            sessionStorage.setItem('utm_discount_code', rule.discountCode);
            sessionStorage.setItem('utm_source_matched', savedSource);
            sessionStorage.setItem('utm_campaign_matched', rule.utmCampaign || '');
            var appliedKey = 'utm_applied_' + savedSource + '__' + (rule.utmCampaign || '*');
            if (!sessionStorage.getItem(appliedKey)) {
              sessionStorage.setItem(appliedKey, '1');
              window.location.href = '/discount/'
                + encodeURIComponent(rule.discountCode)
                + '?redirect='
                + encodeURIComponent(window.location.pathname + window.location.search);
            }
          }
        }
      } catch(e) {}
          })();
    </script>
    <script>
      (function () {
        var KEY = 'app_utm_attrs';
        var TTL_MS = 30 * 60 * 1000; // 30 minutes
        var UTM_KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
        // Captured BEFORE this script wraps window.fetch. pushToCart MUST use
        // this reference: through its own wrapper, every re-apply would match
        // /cart/update and schedule another re-apply — an endless POST loop
        // after the first cart mutation (confirmed live 29 Jul, one request
        // every ~2.5s per tab until close).
        var rawFetch = window.fetch;

        // 1. Capture from URL, save to localStorage
        var params = new URLSearchParams(window.location.search);
        var fromUrl = {};
        UTM_KEYS.forEach(function (k) {
          var v = params.get(k);
          if (v) fromUrl[k] = v;
        });
        if (Object.keys(fromUrl).length) {
          try { localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), attrs: fromUrl })); } catch (e) {}
        }

        // 2. Read stored attrs (respect TTL)
        function readStored() {
          try {
      var raw = localStorage.getItem(KEY);
      if (!raw) return null;
      var obj = JSON.parse(raw);
      if (!obj || !obj.at || Date.now() - obj.at > TTL_MS) {
        localStorage.removeItem(KEY);
        return null;
      }
      return obj.attrs || null;
          } catch (e) { return null; }
        }

        // 2b. GA ids for the purchase backstop: the orders/paid webhook reads
        // _ga_cid/_ga_sid from the order's note_attributes and sends the GA4
        // Measurement Protocol purchase as the real visitor + session, so
        // backstop-only orders (QRIS/VA redirect never returns) keep their
        // attribution and journey instead of landing as synthetic direct
        // users. Cookies exist only with analytics consent — absent, skip.
        // Read fresh on every push: the GA cookie appears only after the tag
        // boots, and the session cookie changes across sessions.
        function gaAttrs() {
          var out = {};
          var m = document.cookie.match(/(?:^|;\s*)_ga=([^;]+)/);
          var cid = m && decodeURIComponent(m[1]).match(/(\d+\.\d+)$/);
          if (!cid) return out;
          out._ga_cid = cid[1];
          var sm = document.cookie.match(/(?:^|;\s*)_ga_N28QHJH222=([^;]+)/);
          var sid = sm && decodeURIComponent(sm[1]).match(/^GS\d+\.\d+\.s?(\d+)/);
          if (sid) out._ga_sid = sid[1];
          return out;
        }

        // 2c. Klik CTA WhatsApp. Saat tombol itu ditekan pembeli MENINGGALKAN
        // situs dan percakapannya terjadi di luar jangkauan kita — klik itulah
        // hal terakhir yang masih bisa dicatat. Ditulis ke atribut keranjang,
        // bukan sekadar ke GA4, karena GA4 Data API TIDAK membuka clientId
        // sebagai dimensi laporan: tanpa ini, klik dan order-nya tidak akan
        // pernah bisa disambungkan kembali. Disimpan 30 hari, menyamai jendela
        // atribusi Shopify sendiri.
        var WA_KEY = 'app_wa_click';
        var WA_TTL_MS = 30 * 24 * 60 * 60 * 1000;

        function waStored() {
          try {
            var raw = localStorage.getItem(WA_KEY);
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (!o || !o.at || Date.now() - new Date(o.at).getTime() > WA_TTL_MS) {
              localStorage.removeItem(WA_KEY);
              return null;
            }
            return o;
          } catch (e) { return null; }
        }

        // 2d. Klik CTA "Get The Full Size" di halaman guide. Pola yang sama
        // dengan klik WA di atas: GA4 sudah melihat kliknya (select_item +
        // from_section) tapi tidak bisa dipetakan ke nomor order, jadi jejaknya
        // dititipkan ke atribut keranjang. UTM di link internal DILARANG
        // (aturan keras #12) — atribut inilah padanannya yang tidak merusak
        // sesi GA4 maupun utm_* iklan yang sudah tersimpan. Klik PERTAMA,
        // umur 30 hari (jendela yang sama dengan wa_click).
        var GUIDE_KEY = 'app_guide_cta';

        function guideStored() {
          try {
            var raw = localStorage.getItem(GUIDE_KEY);
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (!o || !o.at || Date.now() - new Date(o.at).getTime() > WA_TTL_MS) {
              localStorage.removeItem(GUIDE_KEY);
              return null;
            }
            return o;
          } catch (e) { return null; }
        }

        // 3. Push UTM + GA ids to cart attributes
        //
        // Satu sumber untuk kedua jalur penulisan: POST /cart/update.js (jalur
        // normal) dan penitipan lewat URL permalink (3c). Kalau keduanya
        // membangun atributnya sendiri-sendiri, cepat atau lambat isinya
        // berbeda dan datanya tidak bisa dibandingkan.
        function buildAttrs() {
          var attrs = gaAttrs();
          var stored = readStored();
          if (stored) { for (var k in stored) attrs[k] = stored[k]; }
          var wa = waStored();
          if (wa) {
            attrs.wa_click_at = wa.at;
            attrs.wa_click_page = wa.page;
          }
          var gd = guideStored();
          if (gd) {
            attrs.guide_cta_at = gd.at;
            attrs.guide_cta_page = gd.page;
          }
          var wc = wcStored();
          if (wc) {
            attrs.wc_cta_at = wc.at;
            attrs.wc_cta_page = wc.page;
          }
          return attrs;
        }

        function pushToCart() {
          var attrs = buildAttrs();
          if (!Object.keys(attrs).length) return;
          rawFetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributes: attrs }),
          }).catch(function () {});
        }
        pushToCart();

        // 3b. Penangkap kliknya. Dipasang di WINDOW fase capture, bukan di
        // document: interceptor seamless-ATC memanggil stopImmediatePropagation
        // di document-capture, sehingga listener setingkat document bisa tidak
        // pernah melihat klik yang melewatinya (aturan keras #6 TRACKING-MASTER).
        // Klik PERTAMA yang disimpan — yang ingin diketahui adalah "pernahkah ia
        // menyeberang ke WhatsApp", bukan berapa kali. Ditulis langsung saat itu
        // juga supaya atributnya sudah menempel walau pembeli belum menaruh
        // apa pun di keranjang.
        function onWhatsappClick(e) {
          var t = e.target;
          var link = t && t.closest && t.closest(
            'a[href*="wa.me/"], a[href*="api.whatsapp.com"], a[href^="whatsapp:"]'
          );
          if (!link) return;
          if (waStored()) return;
          try {
            localStorage.setItem(WA_KEY, JSON.stringify({
              at: new Date().toISOString(),
              page: location.pathname
            }));
          } catch (err) { return; }
          pushToCart();
        }

        // auxclick ikut didengar: klik tengah / "buka di tab baru" TIDAK
        // memicu event click, dan tanpa ini penyeberangan ke WhatsApp lewat
        // cara itu tidak pernah tercatat.
        window.addEventListener('click', onWhatsappClick, true);
        window.addEventListener('auxclick', onWhatsappClick, true);

        // Penangkap klik CTA guide. Window-capture + isTrusted (aturan keras
        // #6 & #16). Ditulis saat klik, bukan saat ATC: pembeli menyeberang ke
        // PDP dulu dan baru menambahkan ke keranjang di sana — jejaknya harus
        // sudah menempel sebelum itu terjadi.
        function onGuideCtaClick(e) {
          if (!e.isTrusted) return;
          var t = e.target;
          var link = t && t.closest && t.closest('a.og-proof__cta');
          if (!link) return;
          if (guideStored()) return;
          try {
            localStorage.setItem(GUIDE_KEY, JSON.stringify({
              at: new Date().toISOString(),
              page: location.pathname
            }));
          } catch (err) { return; }
          pushToCart();
        }
        window.addEventListener('click', onGuideCtaClick, true);
        window.addEventListener('auxclick', onGuideCtaClick, true);

        // Klik CTA halaman why-capsules (kampanye email). Pola & alasan sama
        // dengan guide di atas; kuncinya sendiri supaya kedua halaman bisa
        // dibaca terpisah. Listener ini TERDAFTAR SEBELUM decorateCartPermalink
        // sehingga klik checkout yang sama sudah membawa wc_cta_* saat
        // atribut dititipkan ke URL permalink.
        var WC_KEY = 'app_wc_cta';

        function wcStored() {
          try {
            var raw = localStorage.getItem(WC_KEY);
            if (!raw) return null;
            var o = JSON.parse(raw);
            if (!o || !o.at || Date.now() - new Date(o.at).getTime() > WA_TTL_MS) {
              localStorage.removeItem(WC_KEY);
              return null;
            }
            return o;
          } catch (e) { return null; }
        }

        function onWcCtaClick(e) {
          if (!e.isTrusted) return;
          var t = e.target;
          var link = t && t.closest && t.closest('a.wc-cta');
          if (!link) return;
          if (wcStored()) return;
          try {
            localStorage.setItem(WC_KEY, JSON.stringify({
              at: new Date().toISOString(),
              page: location.pathname
            }));
          } catch (err) { return; }
          pushToCart();
        }
        window.addEventListener('click', onWcCtaClick, true);
        window.addEventListener('auxclick', onWcCtaClick, true);

        // 3c. Permalink keranjang — CTA beli di landing page — MENGGANTI isi
        // keranjang dan MEMBUANG seluruh atributnya, lalu melompat langsung ke
        // /checkouts/cn/...  Tidak ada satu pun page load tema di antaranya,
        // jadi pushToCart tidak pernah kebagian giliran menulis ulang.
        // Terukur pada order Agustus 2026: order LP murni (line item-nya hanya
        // produk LP, jadi benar-benar lewat permalink) 0% ber-_ga_cid,
        // sementara order yang keranjangnya sempat tersentuh halaman tema 95%.
        //
        // Obatnya: permalink MENERIMA ?attributes[key]=value (diuji langsung di
        // toko live), jadi atributnya dititipkan pada URL-nya sendiri. Alur beli
        // LP tidak berubah sama sekali — tetap tanpa keranjang, tetap langsung
        // ke checkout.
        //
        // Dipasang site-wide, bukan hanya di halaman LP: begitu ada LP baru
        // atau permalink dipasang di tempat lain, lubangnya tidak terbuka lagi.
        var CART_PERMALINK_RE = /^(?:\/[\w-]+)?\/cart\/\d+:\d+/;

        function decorateCartPermalink(e) {
          var t = e.target;
          var link = t && t.closest && t.closest('a[href]');
          if (!link) return;

          var href = link.getAttribute('href') || '';
          // Sudah dititipi (mis. pembeli menekan tombol yang sama dua kali).
          if (href.indexOf('attributes%5B') !== -1 || href.indexOf('attributes[') !== -1) return;
          if (!CART_PERMALINK_RE.test(href.split('?')[0])) return;

          var attrs = buildAttrs();
          var parts = [];
          for (var k in attrs) {
            var v = String(attrs[k]);
            // Nilai raksasa (utm_content sebagian iklan bisa ratusan karakter)
            // tidak ikut dititipkan: kehilangan satu parameter jauh lebih baik
            // daripada URL ditolak dan pembeli gagal masuk checkout.
            if (!v || v.length > 200) continue;
            parts.push('attributes%5B' + encodeURIComponent(k) + '%5D=' + encodeURIComponent(v));
          }
          if (!parts.length) return;

          // Ditulis balik ke href, bukan e.preventDefault() + location.assign:
          // navigasi bawaan browser tetap yang menjalankan, sehingga klik
          // tengah, Cmd-klik, dan "buka di tab baru" berperilaku normal.
          link.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + parts.join('&'));
        }

        window.addEventListener('click', decorateCartPermalink, true);
        window.addEventListener('auxclick', decorateCartPermalink, true);

        // 4. Re-apply after cart mutations (pushToCart bypasses this wrapper
        // via rawFetch, so it can never re-trigger itself; /cart/clear in the
        // buy-now flow wipes attributes, this restores them)
        var origFetch = window.fetch;
        if (origFetch) {
          window.fetch = function (input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      var promise = origFetch(input, init);
      if (/\/cart\/(add|change|update|clear)(\.js)?/.test(url)) {
        promise.then(function () { setTimeout(pushToCart, 50); });
      }
      return promise;
          };
        }
      })();
    </script>

    <script>
      // UTM Variant Discount Renderer
      // When a matched UTM rule has `variantDiscounts`, rewrite each variant card's
      // displayed price to (original - discount) and inject a strikethrough of the original.
      (function () {
        if (typeof window.__findUtmRule !== 'function') return;

        var params = new URLSearchParams(window.location.search);
        var urlUtm = params.get('utm_source') || sessionStorage.getItem('utm_source');
        var urlCampaign = params.get('utm_campaign') || sessionStorage.getItem('utm_campaign') || '';
        if (!urlUtm) return;

        function formatIDR(amount) {
          return 'Rp ' + Math.round(amount).toLocaleString('id-ID');
        }

        function apply() {
          var rule = window.__findUtmRule(urlUtm, urlCampaign);
          if (!rule || !rule.isActive) return;
          var list = rule.variantDiscounts;
          if (!Array.isArray(list) || !list.length) return;

          var map = {};
          list.forEach(function (d) {
            if (d && d.variantId != null) {
              map[String(d.variantId)] = parseInt(d.discountAmount, 10) || 0;
            }
          });

          var lang = (document.documentElement.lang || 'en').toLowerCase();
          var savingWord = (lang === 'id') ? 'hemat ' : 'save ';

          var cards = document.querySelectorAll('.protocol-variant-card[data-variant-price]');
          cards.forEach(function (card) {
            var vid = card.getAttribute('data-value');
            var discount = map[String(vid)];
            if (!discount) return;

            var originalPrice = parseInt(card.getAttribute('data-variant-price'), 10);
            if (!originalPrice || originalPrice <= 0) return;

            var newPrice = Math.max(0, originalPrice - discount);

            var prices = card.querySelector('.pv-prices');
            if (!prices) return;
            var saleEl = prices.querySelector('.pv-sale');
            if (!saleEl) return;

            // Inject strikethrough of original price if not already shown (e.g., from compare_at_price)
            var originalEl = prices.querySelector('.pv-original');
            if (!originalEl) {
              originalEl = document.createElement('div');
              originalEl.className = 'pv-original';
              originalEl.textContent = formatIDR(originalPrice);
              prices.insertBefore(originalEl, saleEl);
            }

            saleEl.textContent = formatIDR(newPrice);

            // Override custom badge with savings amount from UTM discount
            var badgeText = savingWord + formatIDR(discount);
            var badge = card.querySelector('.pv-badge');
            if (badge) {
              badge.textContent = badgeText;
            } else {
              badge = document.createElement('div');
              badge.className = 'pv-badge';
              badge.textContent = badgeText;
              card.insertBefore(badge, card.firstChild);
            }

            card.setAttribute('data-utm-discounted', '1');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', apply);
        } else {
          apply();
        }
      })();
    </script>

