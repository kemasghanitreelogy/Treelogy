      <style>
        /* Treelogy policy pages — long-form legal reading. Markup is fixed by
           Shopify (.shopify-policy__*); everything must be CSS-only. */
        :root {
          --policy-ink: #2a3b34;
          --policy-accent: #a5bb86;
          --policy-muted: #6b7256;
          --policy-hairline: rgba(165, 187, 134, 0.35);
        }
        html {
          scroll-behavior: smooth;
        }
        .shopify-policy__container {
          max-width: 70ch !important;
          margin: 0 auto !important;
          padding: clamp(72px, 10vw, 120px) 20px 140px !important;
          color: var(--policy-ink);
          font-family: var(--font-base, 'Inter', sans-serif);
          font-size: 1.0625rem;
          line-height: 1.75;
          -webkit-font-smoothing: antialiased;
          text-rendering: optimizeLegibility;
        }
        .shopify-policy__title {
          text-align: left;
          margin-bottom: 0;
        }
        .shopify-policy__title h1 {
          color: var(--policy-accent);
          font-size: clamp(30px, 5vw, 40px);
          font-weight: 700;
          line-height: 1.2;
          letter-spacing: -0.015em;
          margin: 0 0 10px;
          padding-bottom: 18px;
          border-bottom: 1px solid var(--policy-hairline);
        }
        .shopify-policy__body .policy-updated {
          color: var(--policy-muted);
          font-size: 0.875rem;
          letter-spacing: 0.01em;
          margin: 18px 0 40px;
        }
        .shopify-policy__body h2 {
          color: var(--policy-accent);
          font-size: 1.375rem;
          font-weight: 650;
          line-height: 1.35;
          letter-spacing: -0.01em;
          margin: 52px 0 14px;
          scroll-margin-top: 110px;
        }
        .shopify-policy__body h2:first-of-type {
          margin-top: 36px;
        }
        .shopify-policy__body h3 {
          color: var(--policy-accent);
          font-size: 1.125rem;
          font-weight: 650;
          margin: 32px 0 10px;
          scroll-margin-top: 110px;
        }
        .shopify-policy__body p {
          margin: 0 0 16px;
          overflow-wrap: break-word;
        }
        .shopify-policy__body ul {
          list-style: disc outside !important;
