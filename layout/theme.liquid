    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script src="{{ 'app.bundle.js' | asset_url }}"></script>
    <script src="{{ 'review.bundle.js' | asset_url }}" defer></script>
    <script src="{{ 'lugus-custom.js' | asset_url }}" defer></script>

    <script src="https://t.contentsquare.net/uxa/b315e3b428943.js" async></script>

    <script>
      window.texts = {
          allSet: '{{ 'cart.progress.all_set' | t }}',
          leftText: '{{ 'cart.progress.left_text' | t }}',
          onlyText: '{{ 'cart.progress.only_text' | t }}',
          cartTitle: '{{ 'cart.title' | t }}',
          cartEmpty: '{{ 'cart.empty_cart_text' | t }}',
        };
      window.faqs = [];
    </script>

    {% assign utm_rules = shop.metafields['custom']['utm_rules'].value %}
    <script>
          (function() {
      var UTM_FREE_SHIP_TTL = 15 * 60 * 1000; // 15 minutes

      // Global helper: check if utm_free_shipping is still valid (15-min TTL)
      window.isUtmFreeShipping = function() {
        var ts = parseInt(sessionStorage.getItem('utm_free_shipping_ts') || '0', 10);
        if (ts && (Date.now() - ts) < UTM_FREE_SHIP_TTL) return true;
        sessionStorage.removeItem('utm_free_shipping_ts');
        return false;
      };

      try {
        var rules = {% if utm_rules %}{{ utm_rules | json }}{% else %}[]{% endif %};
        window.__utmRules = rules;

        // Match rule on (utmSource, utmCampaign). Prefer exact campaign match;
        // fall back to a rule with empty / "*" utmCampaign (default for that source).
        window.__findUtmRule = function(source, campaign) {
          if (!source) return null;
          campaign = campaign || '';
          var exact = rules.find(function(r) {
            return r.isActive && r.utmSource === source && (r.utmCampaign || '') === campaign;
          });
          if (exact) return exact;
          return rules.find(function(r) {
            return r.isActive && r.utmSource === source && (!r.utmCampaign || r.utmCampaign === '*');
          }) || null;
        };

        var params = new URLSearchParams(window.location.search);
        var utm = params.get('utm_source');
        var campaign = params.get('utm_campaign');
        if (utm) sessionStorage.setItem('utm_source', utm);
        if (campaign) sessionStorage.setItem('utm_campaign', campaign);
        var savedSource = sessionStorage.getItem('utm_source');
        var savedCampaign = sessionStorage.getItem('utm_campaign') || '';
        if (savedSource) {
          var rule = window.__findUtmRule(savedSource, savedCampaign);
          if (rule && rule.discountCode) {
            sessionStorage.setItem('utm_free_shipping_ts', String(Date.now()));
            sessionStorage.setItem('utm_discount_code', rule.discountCode);
            sessionStorage.setItem('utm_source_matched', savedSource);
            sessionStorage.setItem('utm_campaign_matched', rule.utmCampaign || '');
            var appliedKey = 'utm_applied_' + savedSource + '__' + (rule.utmCampaign || '*');
            if (!sessionStorage.getItem(appliedKey)) {
              sessionStorage.setItem(appliedKey, '1');
              window.location.href = '/discount/'
                + encodeURIComponent(rule.discountCode)
                + '?redirect='
                + encodeURIComponent(window.location.pathname + window.location.search);
            }
          }
        }
      } catch(e) {}
          })();
    </script>
    <script>
      (function () {
        var KEY = 'app_utm_attrs';
        var TTL_MS = 30 * 60 * 1000; // 30 minutes
        var UTM_KEYS = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content'];

        // 1. Capture from URL, save to localStorage
        var params = new URLSearchParams(window.location.search);
        var fromUrl = {};
        UTM_KEYS.forEach(function (k) {
          var v = params.get(k);
          if (v) fromUrl[k] = v;
        });
        if (Object.keys(fromUrl).length) {
          try { localStorage.setItem(KEY, JSON.stringify({ at: Date.now(), attrs: fromUrl })); } catch (e) {}
        }

        // 2. Read stored attrs (respect TTL)
        function readStored() {
          try {
      var raw = localStorage.getItem(KEY);
      if (!raw) return null;
      var obj = JSON.parse(raw);
      if (!obj || !obj.at || Date.now() - obj.at > TTL_MS) {
        localStorage.removeItem(KEY);
        return null;
      }
      return obj.attrs || null;
          } catch (e) { return null; }
        }
        var stored = readStored();
        if (!stored) return;

        // 3. Push to cart attributes
        function pushToCart() {
          return fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attributes: stored }),
          }).catch(function () {});
        }
        pushToCart();

        // 4. Re-apply after cart mutations
        var origFetch = window.fetch;
        if (origFetch) {
          window.fetch = function (input, init) {
      var url = typeof input === 'string' ? input : (input && input.url) || '';
      var promise = origFetch(input, init);
      if (/\/cart\/(add|change|update|clear)(\.js)?/.test(url)) {
        promise.then(function () { setTimeout(pushToCart, 50); });
      }
      return promise;
          };
        }
      })();
    </script>

  </head>

  <body>
    {%- if settings.show_utm_free_shipping_toast -%}
      <!-- UTM Reward Toast -->
      <div
        id="utm-toast"
        aria-live="polite"
        role="status">
        <div class="utm-toast__overlay"></div>
        <div class="utm-toast__card" aria-label="Kamu hemat seratus ribu rupiah plus gratis ongkir, otomatis terpakai di checkout">
          <div class="utm-toast__ribbon" aria-hidden="true"></div>
          <span class="utm-toast__spark utm-toast__spark--1" aria-hidden="true"></span>
          <span class="utm-toast__spark utm-toast__spark--2" aria-hidden="true"></span>

          <div class="utm-toast__kicker">
            <span class="utm-toast__kicker-dot" aria-hidden="true"></span>
            DISKON AKTIF
          </div>

          <div class="utm-toast__save-label">Kamu hemat</div>
          <div class="utm-toast__hero" id="utm-toast__discount-label">
            <span class="utm-toast__hero-currency">Rp</span><span class="utm-toast__hero-amount">100.000</span>
          </div>

          <div class="utm-toast__bonus">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9 1.96 2.5H17V9.5h2.5zM18 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="#56734F"/>
            </svg>
            <span><strong>+ Gratis Ongkir</strong> se-Indonesia</span>
          </div>

          <div class="utm-toast__confirm">
            <svg class="utm-toast__check" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12l5 5L20 7" stroke="#56734F" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Otomatis terpakai di checkout</span>
          </div>
        </div>
      </div>

      <style>
        #utm-toast {
          position: fixed;
          inset: 0;
          z-index: 2147483647;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 20px;
          pointer-events: none;
        }
        .utm-toast__overlay {
          position: absolute;
          inset: 0;
          background: rgba(43, 60, 53, 0.6);
          opacity: 0;
          transition: opacity 180ms ease-out;
          backdrop-filter: blur(3px);
          -webkit-backdrop-filter: blur(3px);
        }
        #utm-toast.active .utm-toast__overlay { opacity: 1; }

        .utm-toast__card {
          position: relative;
          text-align: center;
          padding: 28px 32px 22px;
          border-radius: 22px;
          background: #f8f8f2;
          box-shadow:
            0 0 0 1px rgba(86, 115, 79, 0.2),
            0 40px 80px -20px rgba(86, 115, 79, 0.45),
            0 20px 40px -20px rgba(0, 0, 0, 0.3);
          max-width: 360px;
          width: 100%;
          opacity: 0;
          transform: scale(0.85);
          transition:
            opacity 220ms ease-out,
            transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
          overflow: hidden;
        }
        #utm-toast.active .utm-toast__card {
          opacity: 1;
          transform: scale(1);
          transition-delay: 80ms;
        }

        .utm-toast__ribbon {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          height: 4px;
          background: linear-gradient(90deg, #56734F, #a8c39a, #56734F);
        }

        .utm-toast__kicker {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          font-family: 'Inter', sans-serif;
          font-weight: 700;
          font-size: 10px;
          letter-spacing: 2px;
          text-transform: uppercase;
          color: #56734F;
          padding: 5px 10px 5px 8px;
          background: rgba(86, 115, 79, 0.1);
          border-radius: 999px;
          margin-bottom: 18px;
        }
        .utm-toast__kicker-dot {
          width: 6px;
          height: 6px;
          border-radius: 50%;
          background: #56734F;
          animation: utmPulse 1.6s ease-in-out infinite;
        }
        @keyframes utmPulse {
          0%, 100% { opacity: 1; transform: scale(1); }
          50% { opacity: 0.5; transform: scale(0.85); }
        }

        .utm-toast__save-label {
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 13px;
          color: #6b7c6b;
          margin-bottom: 2px;
        }

        .utm-toast__hero {
          display: inline-flex;
          align-items: baseline;
          justify-content: center;
          font-family: 'Inter', sans-serif;
          font-weight: 900;
          color: #2B3C35;
          letter-spacing: -2px;
          line-height: 1;
          margin-bottom: 14px;
          opacity: 0;
          transform: scale(1.25);
          transition:
            opacity 200ms ease-out,
            transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        #utm-toast.active .utm-toast__hero {
          opacity: 1;
          transform: scale(1);
          transition-delay: 260ms;
        }
        .utm-toast__hero-currency {
          font-size: 28px;
          font-weight: 700;
          margin-right: 4px;
          color: #56734F;
          letter-spacing: -0.5px;
        }
        .utm-toast__hero-amount {
          font-size: 56px;
          font-weight: 900;
        }

        .utm-toast__bonus {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 8px 14px;
          background: rgba(86, 115, 79, 0.08);
          border-radius: 999px;
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 13px;
          color: #2B3C35;
          margin-bottom: 14px;
          opacity: 0;
          transform: translateY(4px);
          transition:
            opacity 200ms ease-out,
            transform 200ms ease-out;
        }
        .utm-toast__bonus strong {
          font-weight: 700;
          color: #56734F;
        }
        #utm-toast.active .utm-toast__bonus {
          opacity: 1;
          transform: translateY(0);
          transition-delay: 460ms;
        }

        .utm-toast__confirm {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 6px;
          font-family: 'Inter', sans-serif;
          font-weight: 500;
          font-size: 11px;
          color: #6b7c6b;
          opacity: 0;
          transition: opacity 220ms ease-out;
        }
        #utm-toast.active .utm-toast__confirm { opacity: 1; transition-delay: 580ms; }
        .utm-toast__check path {
          stroke-dasharray: 30;
          stroke-dashoffset: 30;
          transition: stroke-dashoffset 280ms ease-out;
        }
        #utm-toast.active .utm-toast__check path { stroke-dashoffset: 0; transition-delay: 620ms; }

        .utm-toast__spark {
          position: absolute;
          width: 5px;
          height: 5px;
          border-radius: 50%;
          background: #a8c39a;
          opacity: 0;
          pointer-events: none;
        }
        .utm-toast__spark--1 { top: 22%; left: 12%; }
        .utm-toast__spark--2 { top: 28%; right: 14%; background: #56734F; width: 4px; height: 4px; }
        #utm-toast.active .utm-toast__spark { animation: utmTwinkle 1.8s ease-in-out infinite; animation-delay: 700ms; }
        #utm-toast.active .utm-toast__spark--2 { animation-delay: 900ms; }

        @keyframes utmTwinkle {
          0%, 100% { opacity: 0; transform: scale(0.5); }
          50% { opacity: 0.9; transform: scale(1.1); }
        }

        @media (max-width: 480px) {
          .utm-toast__card { padding: 24px 24px 18px; max-width: 320px; border-radius: 20px; }
          .utm-toast__hero-amount { font-size: 46px; }
          .utm-toast__hero-currency { font-size: 22px; }
          .utm-toast__bonus { font-size: 12px; padding: 7px 12px; }
        }

        @media (prefers-reduced-motion: reduce) {
          .utm-toast__overlay,
          .utm-toast__card,
          .utm-toast__hero,
          .utm-toast__bonus,
          .utm-toast__confirm,
          .utm-toast__check path {
            transition: opacity 180ms ease !important;
            transition-delay: 0ms !important;
          }
          .utm-toast__card,
          .utm-toast__hero,
          .utm-toast__bonus { transform: none !important; }
          #utm-toast.active .utm-toast__spark,
          .utm-toast__kicker-dot { animation: none; opacity: 1; }
        }
      </style>

      <script>
            (function() {
              var TOAST_COOLDOWN_MS = 10 * 60 * 1000; // 10 minutes

              // URL gate: current URL must carry a utm_source that matches an active rule
              var params = new URLSearchParams(window.location.search);
              var urlUtm = params.get('utm_source');
              if (!urlUtm) return;

              // Campaign gate: if eligible list is configured, utm_campaign must be in it
              var eligibleRaw = {{ settings.utm_free_shipping_eligible_campaigns | default: '' | json }};
              var eligibleCampaigns = (eligibleRaw || '')
                .split(',')
                .map(function(s) { return s.trim().toLowerCase(); })
                .filter(Boolean);
              if (eligibleCampaigns.length) {
                var urlCampaignLc = (params.get('utm_campaign') || '').toLowerCase();
                if (!urlCampaignLc || eligibleCampaigns.indexOf(urlCampaignLc) === -1) return;
              }

              var urlCampaign = params.get('utm_campaign') || '';
              var rule = typeof window.__findUtmRule === 'function'
                ? window.__findUtmRule(urlUtm, urlCampaign)
                : null;
              if (!rule || !rule.discountCode) return;

              // Cooldown gate: skip if toast was shown within the last 10 minutes
              try {
                var shownAt = parseInt(sessionStorage.getItem('utm_toast_shown_ts') || '0', 10);
                if (shownAt && (Date.now() - shownAt) < TOAST_COOLDOWN_MS) return;
              } catch (e) {}

              document.addEventListener('DOMContentLoaded', function() {
                var toast = document.getElementById('utm-toast');
                if (!toast) return;

                // Inject dynamic discount label from metafield, preserving currency/amount split
                var labelEl = document.getElementById('utm-toast__discount-label');
                if (labelEl && rule.discountLabel) {
                  var m = String(rule.discountLabel).match(/^(\D*)(.*)$/);
                  var currency = (m && m[1] ? m[1].trim() : '');
                  var amount = (m && m[2] ? m[2].trim() : String(rule.discountLabel));
                  labelEl.innerHTML = '';
                  if (currency) {
                    var c = document.createElement('span');
                    c.className = 'utm-toast__hero-currency';
                    c.textContent = currency;
                    labelEl.appendChild(c);
                  }
                  var a = document.createElement('span');
                  a.className = 'utm-toast__hero-amount';
                  a.textContent = amount;
                  labelEl.appendChild(a);
                }

                try { sessionStorage.setItem('utm_toast_shown_ts', String(Date.now())); } catch (e) {}

                // Allow Esc to dismiss early (a11y)
                function onKey(e) {
                  if (e.key === 'Escape') dismiss();
                }
                function dismiss() {
                  toast.classList.remove('active');
                  document.removeEventListener('keydown', onKey);
                  setTimeout(function() { if (toast.parentNode) toast.remove(); }, 260);
                }
                document.addEventListener('keydown', onKey);

                // Enter (snappy) — hold for readability, then exit
                setTimeout(function() { toast.classList.add('active'); }, 80);
                setTimeout(dismiss, 2800);
              });
            })();
      </script>
    {%- endif -%}

    {% section 'Header' %}

    <main id="landing-page" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'Footer' %}
    {% comment %} {% section 'CookieBannerCustom' %} {% endcomment %}
    <script>
      window.addEventListener("klaviyoForms", function(e) {
        if (e.detail.type == 'submit') {
          var vipFormIds = ['WM9fu2', 'WhhKjp'];
          if (vipFormIds.includes(e.detail.formId)) {
            if (typeof fbq !== 'undefined') {
              fbq('track', 'Lead', {
                content_name: 'VIP Early Access Signup',
                content_category: 'Lead',
                content_ids: [e.detail.formId],
                status: 'success'
              });
            }
          }
        }
      });
    </script>

  </body>
</html>