      (function () {
        var loaded = false;
        function loadContentsquare() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.src = 'https://t.contentsquare.net/uxa/b315e3b428943.js';
          s.async = true;
          document.head.appendChild(s);
        }
        function arm() {
          ['scroll', 'touchstart', 'mousemove', 'keydown'].forEach(function (evt) {
            addEventListener(evt, loadContentsquare, { once: true, passive: true });
