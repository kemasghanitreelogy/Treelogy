<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if blogs['news'] != blank -%}
      {% # theme-check-disable RemoteAsset %}
      <link rel="alternate" type="application/atom+xml" title="{{ blogs['news'].title | escape }}" href="{{ blogs['news'].url }}.atom">
      {% # theme-check-enable RemoteAsset %}
    {%- endif -%}

    {% if request.path == '/collections/all' %}
      <title>Treelogy | All Products</title>
      <meta name="description" content="Browse all Treelogy products made with organic moringa, including powders, capsules, oils, and wellness bundles.">
    {% elsif request.path == '/blogs/news' %}
      <title>Treelogy | Blog</title>
      <meta name="description" content="Read the Treelogy Journal for wellness tips, moringa recipes, product insights, and stories from our farm and community.">
    {% else %}
      <title>{{ page_title }}</title>
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- liquid
      assign og_type = 'website'
      if request.page_type == 'product'
        assign og_type = 'product'
      elsif request.page_type == 'article'
        assign og_type = 'article'
      endif
      assign og_title = page_title | default: shop.name
      assign og_desc = page_description
      if request.path == '/collections/all'
        assign og_title = 'Treelogy | All Products'
        assign og_desc = 'Browse all Treelogy products made with organic moringa, including powders, capsules, oils, and wellness bundles.'
      elsif request.path == '/blogs/news'
        assign og_title = 'Treelogy | Blog'
        assign og_desc = 'Read the Treelogy Journal for wellness tips, moringa recipes, product insights, and stories from our farm and community.'
      endif
      if og_desc == blank and collection.description != blank
        assign og_desc = collection.description | strip_html | strip_newlines | truncate: 200
      endif
      if og_desc == blank
        assign og_desc = shop.description
      endif
      if request.locale.iso_code == 'id'
        assign og_locale = 'id_ID'
        assign og_locale_alt = 'en_US'
      else
        assign og_locale = 'en_US'
        assign og_locale_alt = 'id_ID'
      endif
    -%}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:type" content="{{ og_type }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:description" content="{{ og_desc | escape }}">
    <meta property="og:locale" content="{{ og_locale }}">
    <meta property="og:locale:alternate" content="{{ og_locale_alt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    <meta name="twitter:description" content="{{ og_desc | escape }}">

    {% if request.path contains '/pages/vip-early-access' %}
      <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0668/4776/8764/files/The_Movement_Relief_1__11zon.png?v=1764405259">
      <meta name="twitter:image" content="https://cdn.shopify.com/s/files/1/0668/4776/8764/files/The_Movement_Relief_1__11zon.png?v=1764405259">
    {% endif %}

    {%- if settings.favicon_light_mode != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon_dark_mode | image_url: width: 32, height: 32 }}&v=3">
    {%- endif -%}
    {% if settings.favicon_light_mode != blank %}
      <link
        rel="icon"
        href="{{ settings.favicon_light_mode | image_url: width: 32, height: 32 }}&v=3"
        type="image/png"
        media="(prefers-color-scheme: light)">
    {% endif %}
    {% if settings.favicon_dark_mode != blank %}
      <link
        rel="icon"
        href="{{ settings.favicon_dark_mode | image_url: width: 32, height: 32 }}&v=3"
        type="image/png"
        media="(prefers-color-scheme: dark)">
    {% endif %}

    {%- if settings.favicon_light_mode != blank -%}
      <link rel="apple-touch-icon" href="{{ settings.favicon_light_mode | image_url: width: 180, height: 180 }}&v=3">
    {%- endif -%}

    {{ 'inter-variable-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('{{ 'inter-variable-latin.woff2' | asset_url }}') format('woff2');
      }
      @font-face {
        font-family: 'Inter Fallback';
        src: local('Arial');
        size-adjust: 107%;
        ascent-override: 90.49%;
        descent-override: 22.56%;
        line-gap-override: 0%;
      }

      /* Smooth cross-page transitions (progressive enhancement, Chromium/Safari 26+) */
      @view-transition {
        navigation: auto;
      }

      /* Site chrome stays perfectly still during navigation (app-like).
         `header` element selector only — .header-popup shares the class and a
         duplicate name would make the browser skip the whole transition. */
      header.header-nav {
        view-transition-name: site-header;
      }
      ::view-transition-old(site-header),
      ::view-transition-new(site-header) {
        animation: none;
      }

      /* Content: old page fades out fast, new page enters with a soft rise */
      @keyframes vt-fade-out {
        to { opacity: 0; }
      }
      @keyframes vt-rise-in {
        from { opacity: 0; transform: translateY(14px); }
      }
      ::view-transition-old(root) {
        animation: vt-fade-out 150ms cubic-bezier(0.4, 0, 1, 1) both;
      }
      ::view-transition-new(root) {
        animation: vt-rise-in 300ms 50ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      /* Product image morph: springy ease, keeps its rounded corners */
      ::view-transition-group(product-hero) {
        animation-duration: 340ms;
        animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
      }
      ::view-transition-old(product-hero),
      ::view-transition-new(product-hero) {
        animation-duration: 340ms;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
    </style>

    <script>
      // Tag the clicked product image so the View Transition morphs it into
      // the PDP gallery (shared-element transition). No-op where unsupported.
      // view-transition-name must be unique per page or the browser skips the
      // whole transition, so any previously named element is cleared first.
      (function () {
        var candidate = null;
        document.addEventListener('click', function (e) {
          var link = e.target.closest && e.target.closest('a[href*="/products/"]');
          if (!link || e.metaKey || e.ctrlKey || e.shiftKey || link.target === '_blank') return;
          candidate = link.querySelector('img');
        }, true);
        // Names are applied only at pageswap (the snapshot moment), so a click
        // intercepted by a modal/quick-view leaves no stray styles behind.
        addEventListener('pageswap', function (e) {
          if (!candidate || !e.viewTransition) return;
          var pdpHero = document.querySelector('.native-gallery__slide[data-index="0"] img');
          if (pdpHero && pdpHero !== candidate) pdpHero.style.viewTransitionName = 'none';
          candidate.style.viewTransitionName = 'product-hero';
          candidate.style.borderRadius = '8px';
        });
      })();
    </script>

    <script>
      (function () {
        function neutralize() {
          var el = document.getElementById('kl-custom-fonts');
          if (el && el.textContent.indexOf('family=Inter') !== -1) el.textContent = '';
        }
        new MutationObserver(neutralize).observe(document.documentElement, { childList: true, subtree: true });
        neutralize();
      })();
    </script>

