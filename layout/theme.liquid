<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <link rel="canonical" href="{{ canonical_url }}">

    <link
      rel="preconnect"
      href="https://cdn.shopify.com"
      crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>
    <link
      rel="preconnect"
      href="https://t.contentsquare.net"
      crossorigin>
    <link
      rel="preconnect"
      href="https://cdn.jsdelivr.net"
      crossorigin>

    {% if request.path == '/collections/all' %}
      <title>Treelogy | All Products</title>
      <meta name="description" content="Browse all Treelogy products made with organic moringa, including powders, capsules, oils, and wellness bundles.">
    {% elsif request.path == '/blogs/news' %}
      <title>Treelogy | Blog</title>
      <meta name="description" content="Read the Treelogy Journal for wellness tips, moringa recipes, product insights, and stories from our farm and community.">
    {% else %}
      <title>{{ page_title }}</title>
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if request.path contains '/pages/vip-early-access' %}
      <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0668/4776/8764/files/The_Movement_Relief_1__11zon.png?v=1764405259">
      <meta name="twitter:image" content="https://cdn.shopify.com/s/files/1/0668/4776/8764/files/The_Movement_Relief_1__11zon.png?v=1764405259">
    {% endif %}

    {%- if settings.favicon_light_mode != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon_dark_mode | image_url: width: 32, height: 32 }}&v=3">
    {%- endif -%}
    {% if settings.favicon_light_mode != blank %}
      <link
        rel="icon"
        href="{{ settings.favicon_light_mode | image_url: width: 32, height: 32 }}&v=3"
        type="image/png"
        media="(prefers-color-scheme: light)">
    {% endif %}
    {% if settings.favicon_dark_mode != blank %}
      <link
        rel="icon"
        href="{{ settings.favicon_dark_mode | image_url: width: 32, height: 32 }}&v=3"
        type="image/png"
        media="(prefers-color-scheme: dark)">
    {% endif %}

    {%- if settings.favicon_light_mode != blank -%}
      <link
        rel="apple-touch-icon"
        href="{{ settings.favicon_light_mode | image_url: width: 180, height: 180 }}&v=3">
    {%- endif -%}

    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'lugus-custom.css' | asset_url | stylesheet_tag }} 

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script src="{{ 'app.bundle.js' | asset_url }}"></script>
    <script src="{{ 'review.bundle.js' | asset_url }}" defer></script>
    <script src="{{ 'lugus-custom.js' | asset_url }}" defer></script>

    <script src="https://t.contentsquare.net/uxa/b315e3b428943.js" async></script>

    <script>
      window.texts = {
          allSet: '{{ 'cart.progress.all_set' | t }}',
          leftText: '{{ 'cart.progress.left_text' | t }}',
          onlyText: '{{ 'cart.progress.only_text' | t }}',
          cartTitle: '{{ 'cart.title' | t }}',
          cartEmpty: '{{ 'cart.empty_cart_text' | t }}',
        };
      window.faqs = [];
    </script>

    {% assign utm_rules = shop.metafields['custom']['utm_rules'].value %}
    <script>
    (function() {
      var UTM_FREE_SHIP_TTL = 15 * 60 * 1000; // 15 minutes

      // Global helper: check if utm_free_shipping is still valid (15-min TTL)
      window.isUtmFreeShipping = function() {
        var ts = parseInt(sessionStorage.getItem('utm_free_shipping_ts') || '0', 10);
        if (ts && (Date.now() - ts) < UTM_FREE_SHIP_TTL) return true;
        sessionStorage.removeItem('utm_free_shipping_ts');
        return false;
      };

      try {
        var rules = {% if utm_rules %}{{ utm_rules | json }}{% else %}[]{% endif %};
        var params = new URLSearchParams(window.location.search);
        var utm = params.get('utm_source');
        if (utm) sessionStorage.setItem('utm_source', utm);
        var saved = sessionStorage.getItem('utm_source');
        if (saved) {
          var rule = rules.find(function(r) {
            return r.utmSource === saved && r.isActive;
          });
          if (rule && rule.discountCode) {
            sessionStorage.setItem('utm_free_shipping_ts', String(Date.now()));
            sessionStorage.setItem('utm_discount_code', rule.discountCode);
            sessionStorage.setItem('utm_source_matched', saved);
            if (!sessionStorage.getItem('utm_applied_' + saved)) {
              sessionStorage.setItem('utm_applied_' + saved, '1');
              window.location.href = '/discount/'
                + encodeURIComponent(rule.discountCode)
                + '?redirect='
                + encodeURIComponent(window.location.pathname + window.location.search);
            }
          }
        }
      } catch(e) {}
    })();
    </script>

  </head>

  <body>
    {%- if settings.show_utm_free_shipping_toast -%}
    <!-- UTM Free Shipping Toast -->
    <div id="utm-toast" aria-live="polite" role="status">
      <div class="utm-toast__overlay"></div>
      <div class="utm-toast__card">
        <div class="utm-toast__label">Khusus untukmu</div>
        <div class="utm-toast__headline">GRATIS ONGKIR</div>
        <div class="utm-toast__sub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9 1.96 2.5H17V9.5h2.5zM18 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" fill="#56734F"/>
          </svg>
          <span>Free delivery applied</span>
        </div>
      </div>
    </div>

    <style>
      #utm-toast {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.35s ease;
      }
      #utm-toast.active { opacity: 1; }

      .utm-toast__overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
      }

      .utm-toast__card {
        position: relative;
        text-align: center;
        padding: 32px 48px 28px;
        border-radius: 16px;
        background: #f8f8f2;
        box-shadow:
          0 0 0 1px rgba(86, 115, 79, 0.15),
          0 25px 80px rgba(0, 0, 0, 0.5);
      }

      .utm-toast__label {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #56734F;
        margin-bottom: 6px;
      }

      .utm-toast__headline {
        font-family: 'Inter', sans-serif;
        font-weight: 800;
        font-size: 32px;
        letter-spacing: 1px;
        color: #2B3C35;
        line-height: 1;
        text-shadow:
          0 1px 2px rgba(0, 0, 0, 0.08);
      }

      .utm-toast__sub {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-top: 12px;
        font-family: 'Inter', sans-serif;
        font-weight: 400;
        font-size: 13px;
        color: #6b7c6b;
      }

      @media (max-width: 480px) {
        .utm-toast__card { padding: 28px 32px 24px; }
        .utm-toast__headline { font-size: 26px; }
      }

      @media (prefers-reduced-motion: reduce) {
        #utm-toast { transition: none; }
      }
    </style>

    <script>
    (function() {
      if (typeof window.isUtmFreeShipping !== 'function' || !window.isUtmFreeShipping()) return;

      document.addEventListener('DOMContentLoaded', function() {
        var toast = document.getElementById('utm-toast');
        if (!toast) return;

        setTimeout(function() { toast.classList.add('active'); }, 400);
        setTimeout(function() { toast.classList.remove('active'); }, 2600);
        setTimeout(function() { toast.remove(); }, 3000);
      });
    })();
    </script>
    {%- endif -%}

    {% section 'Header' %}

    <main id="landing-page" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'Footer' %}
    {% comment %} {% section 'CookieBannerCustom' %} {% endcomment %}
    <script>
      window.addEventListener("klaviyoForms", function(e) {
        if (e.detail.type == 'submit') {
          var vipFormIds = ['WM9fu2', 'WhhKjp'];
          if (vipFormIds.includes(e.detail.formId)) {
            if (typeof fbq !== 'undefined') {
              fbq('track', 'Lead', {
                content_name: 'VIP Early Access Signup',
                content_category: 'Lead',
                content_ids: [e.detail.formId],
                status: 'success'
              });
            }
          }
        }
      });
    </script>

  </body>
</html>