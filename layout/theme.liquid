          list-style: inherit !important;
          margin: 0 0 10px !important;
          padding-left: 6px !important;
          text-indent: 0 !important;
        }
        .shopify-policy__body li::marker {
          color: var(--policy-accent);
        }
        .shopify-policy__body ul.policy-contact {
          list-style: none !important;
          padding: 18px 22px !important;
          margin: 8px 0 24px !important;
          background: rgba(165, 187, 134, 0.09);
          border-left: 3px solid var(--policy-accent);
          border-radius: 0 8px 8px 0;
        }
        .shopify-policy__body ul.policy-contact li {
          padding-left: 0 !important;
          margin-bottom: 8px !important;
        }
        .shopify-policy__body ul.policy-contact li:last-child {
          margin-bottom: 0 !important;
        }
        .shopify-policy__body a {
          color: var(--policy-accent);
          font-weight: 550;
          text-decoration: underline;
          text-decoration-color: var(--policy-hairline);
          text-decoration-thickness: 1.5px;
          text-underline-offset: 3px;
